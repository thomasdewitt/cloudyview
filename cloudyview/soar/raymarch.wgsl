// --- component: windowlife (windowlife.wgsl) ---
// windowlife — what stands between the light and the glass.
//
// A lit pane is 2.45 m wide by 2.23 m tall (CITY_WIN_PITCH_U and
// CITY_FLOOR_H times the pane fractions). Most rooms show nothing but their
// light. A quarter have something drawn across them. One in seven holds a
// person, dark against the room behind them — the thing that makes a wall
// read as inhabited rather than as a lamp array. One in a hundred holds
// something whose eyes are lit from inside.
//
// Everything here is a transmission MULTIPLIER on the pane's own emission,
// so it can only take light away — except the android's eyes, which return
// a multiplier above 1 and so read as emission through the same interface.
//
// LOD is the whole discipline here. These glyphs are sub-window detail:
// they must be gone by the time a pixel holds more than a window (the
// core's facade then sums whole windows through this hook at the pixel's
// footprint, and past a few of them uses cc_windowlife_glyph_mean). Each
// case blends to its OWN mean
// transmission over a footprint window sized to that case's FINEST feature,
// not to the pane — a blind's 0.4 m stripe and an android's 5 cm eye alias
// long before a curtain's edge does, so they die sooner. Past its window a
// case returns a constant, which is what lets the core's own dissolve stay
// smooth. Nothing here ever just vanishes.
//
// The means are measured, not guessed: 4e6 Monte Carlo draws of (window
// hash, pane_uv) against a numpy port of this file, so the hand-off from
// pattern to mean is invisible and the far-field facade statistics are
// exactly what they were before this component existed.

const cc_windowlife_PANE_W: f32 = 2.448;   // CITY_WIN_PITCH_U * (U_HI - U_LO)
const cc_windowlife_PANE_H: f32 = 2.232;   // CITY_FLOOR_H * (V_HI - V_LO)
const cc_windowlife_ASPECT: f32 = 1.0968;  // W / H; makes circles round

// Case shares. Nothing takes the rest (60%).
const cc_windowlife_T_DRAPE: f32 = 0.60;    // .60-.85  drapes    25%
const cc_windowlife_T_FIGURE: f32 = 0.85;   // .85-.99  figures   14%
const cc_windowlife_T_ANDROID: f32 = 0.99;  // .99-1.0  androids   1%

// Transmissions through each thing, and the ensemble mean each dissolves
// into. Curtain cloth is warm (it is lit from behind by a warm room and
// eats blue); a body is near-neutral and much darker; aluminium blinds are
// neutral. See the header on how the means were obtained.
const cc_windowlife_CURTAIN_T: vec3<f32> = vec3<f32>(0.32, 0.26, 0.19);
const cc_windowlife_CURTAIN_MEAN: vec3<f32> = vec3<f32>(0.686, 0.660, 0.631);
const cc_windowlife_BLIND_T: f32 = 0.42;
const cc_windowlife_BLIND_MEAN: vec3<f32> = vec3<f32>(0.733);
const cc_windowlife_BODY_T: vec3<f32> = vec3<f32>(0.10, 0.09, 0.09);
const cc_windowlife_FIGURE_MEAN: vec3<f32> = vec3<f32>(0.822, 0.820, 0.820);
// The eyes: a multiplier well above 1 in G and B and near zero in R, so the
// dot lands cyan whatever colour the room behind it is.
const cc_windowlife_EYE_GAIN: vec3<f32> = vec3<f32>(0.05, 3.0, 2.8);
const cc_windowlife_EYE_SEP: f32 = 0.028;   // half-separation, pane widths
const cc_windowlife_EYE_SIGMA: f32 = 0.0060; // ~0.02 pane: a point, not a lamp

// Footprint windows (m/px) over which each case blends into its mean. Set
// by the case's finest feature, all of them closed by a footprint of about
// a pane (1.6 m); past it the flat facade's exact sum shows each pane at
// its case's mean.
const cc_windowlife_LOD_CURTAIN: vec2<f32> = vec2<f32>(0.40, 1.50);
const cc_windowlife_LOD_BLIND: vec2<f32> = vec2<f32>(0.18, 0.60);
const cc_windowlife_LOD_FIGURE: vec2<f32> = vec2<f32>(0.30, 1.20);
const cc_windowlife_LOD_EYE: vec2<f32> = vec2<f32>(0.05, 0.18);

struct cc_windowlife_Pose {
    head: vec2<f32>,   // head centre in pane_uv
    head_r: f32,       // head radius in u units (u is the round one)
    torso_x: f32,      // torso centre in u
    torso_w: f32,      // torso half-width in u
    shoulder: f32,     // v of the shoulder line
    tilt: f32,         // shoulder line slope; one side rides higher
}

// wh's components already carry the core's meanings — x decides lit, y the
// palette, z the brightness — so a draw taken straight off them would be
// conditioned on the window being lit and correlated with its colour. Mix
// all four back through the city's own hash instead.
fn cc_windowlife_hash(wh: vec4<f32>) -> vec4<f32> {
    let a = (u32(wh.x * 16777216.0) * 0x9e3779b9u)
          ^ (u32(wh.w * 16777216.0) * 0x85ebca6bu);
    let b = (u32(wh.y * 16777216.0) * 0xc2b2ae35u)
          ^ (u32(wh.z * 16777216.0) * 0x27d4eb2fu);
    return city_rand4(vec2<u32>(a ^ 0x7f4a7c15u, b ^ 0x1b56c4e9u));
}

// Half a pixel in pane-width units: every soft edge below opens by this, so
// an edge stays about a pixel wide instead of crawling as the camera moves.
fn cc_windowlife_aa_u(fp: f32) -> f32 {
    return min(0.6 * fp / cc_windowlife_PANE_W, 0.30);
}

fn cc_windowlife_aa_v(fp: f32) -> f32 {
    return min(0.6 * fp / cc_windowlife_PANE_H, 0.30);
}

// Curtains drawn part-way, or blinds. Both are whole-pane furniture, so
// both hold to a coarser footprint than a figure does — but the blind's
// stripe is finer than the curtain's edge, and it dies first.
fn cc_windowlife_drape(h: vec4<f32>, uv: vec2<f32>, fp: f32) -> vec3<f32> {
    if (h.y < 0.55) {
        // Two masses closing in from the sides, 20-70% of the pane between
        // them, split unevenly — one side is nearly always drawn further.
        let lod = smoothstep(cc_windowlife_LOD_CURTAIN.x,
                             cc_windowlife_LOD_CURTAIN.y, fp);
        if (lod >= 1.0) {
            return cc_windowlife_CURTAIN_MEAN;
        }
        let cov = 0.20 + 0.50 * h.z;
        let split = 0.15 + 0.70 * h.w;
        let soft = 0.022 + cc_windowlife_aa_u(fp);
        // Cloth hangs: the drawn edge leans a few centimetres off vertical,
        // and that lean is most of what separates a curtain from a gradient.
        let lean = (0.055 * (h.z - 0.5)) * (uv.y - 0.5);
        let l = cov * split + lean;
        let r = 1.0 - cov * (1.0 - split) + lean;
        let m = clamp(max(1.0 - smoothstep(l - soft, l + soft, uv.x),
                          smoothstep(r - soft, r + soft, uv.x)),
                      0.0, 1.0);
        // The hem leaks a little more light than the rod end. Two touches
        // of cloth, both monotone in position and so free of any repeat
        // frequency to alias: the vertical lean of the light, and a denser
        // gather in the first few centimetres behind the drawn edge, which
        // is what a curtain has and a gradient does not.
        let din = max(max(l - uv.x, uv.x - r), 0.0);
        let bunch = 1.0 - 0.25 * exp(-din * 18.0);
        let cloth = cc_windowlife_CURTAIN_T
                  * ((0.89 + 0.22 * (1.0 - uv.y)) * bunch);
        return mix(mix(vec3<f32>(1.0), cloth, m),
                   cc_windowlife_CURTAIN_MEAN, lod);
    }
    // Blinds: 4-6 slats. The duty cycle is symmetric about its edges so
    // widening them for the footprint blurs without darkening.
    let lod = smoothstep(cc_windowlife_LOD_BLIND.x,
                         cc_windowlife_LOD_BLIND.y, fp);
    if (lod >= 1.0) {
        return cc_windowlife_BLIND_MEAN;
    }
    let nb = floor(4.0 + 2.99 * h.z);
    let s = fract(uv.y * nb + h.w);
    let e = 0.07 + cc_windowlife_aa_v(fp) * nb;
    let band = smoothstep(0.20 - e, 0.20 + e, s)
             * (1.0 - smoothstep(0.66 - e, 0.66 + e, s));
    return mix(mix(vec3<f32>(1.0), vec3<f32>(cc_windowlife_BLIND_T), band),
               cc_windowlife_BLIND_MEAN, lod);
}

// Three poses. Not three people — three ways a body stands against a lit
// room, which is all that survives 30 m of night air anyway. The shoulder
// line is always tilted and the head always carried a little off the torso
// centre: a square-on symmetric figure reads as a pictogram, not a person,
// and that is the failure mode this case has to avoid.
fn cc_windowlife_pose(h: vec4<f32>) -> cc_windowlife_Pose {
    let g = city_rand4(vec2<u32>(u32(h.y * 16777216.0) ^ 0x68e31da4u,
                                 u32(h.z * 16777216.0) ^ 0xb5297a4du));
    let side = select(-1.0, 1.0, g.x < 0.5);
    let scale = 0.86 + 0.30 * g.z;
    let tilt = side * (0.05 + 0.13 * g.w);
    if (h.w < 0.45) {
        // Standing at one edge of the pane, looking out; often half out of
        // frame, which is how you actually catch someone at a window.
        let hx = 0.5 + side * (0.22 + 0.17 * g.y);
        let hy = 0.66 + 0.10 * g.w;
        return cc_windowlife_Pose(vec2<f32>(hx, hy), 0.085 * scale,
                                  hx - side * (0.02 + 0.03 * g.y),
                                  0.190 * scale, hy - 0.080 * scale, tilt);
    }
    if (h.w < 0.80) {
        // Sitting: low in the frame and wide, the shoulders nearer the sill
        // than the head is to the lintel.
        let hx = 0.5 + (g.y - 0.5) * 0.58;
        let hy = 0.40 + 0.12 * g.w;
        return cc_windowlife_Pose(vec2<f32>(hx, hy), 0.082 * scale,
                                  hx + side * (0.02 + 0.04 * g.y),
                                  0.215 * scale, hy - 0.076 * scale, tilt * 0.7);
    }
    // Leaning: the head carried well off the line of the torso.
    let hx = 0.5 + (g.y - 0.5) * 0.55;
    let hy = 0.62 + 0.09 * g.w;
    return cc_windowlife_Pose(vec2<f32>(hx, hy), 0.084 * scale,
                              hx - side * (0.06 + 0.04 * g.w),
                              0.170 * scale, hy - 0.078 * scale, tilt * 1.3);
}

// Head plus shoulders-and-torso, both soft-edged. A hard-edged version of
// this reads as a sticker; the soft edge is what makes it a person seen
// through glass.
fn cc_windowlife_figure_mask(p: cc_windowlife_Pose, uv: vec2<f32>,
                             fp: f32) -> f32 {
    let au = cc_windowlife_aa_u(fp);
    // Heads are taller than they are wide.
    let d = vec2<f32>(uv.x - p.head.x,
                      (uv.y - p.head.y) / (cc_windowlife_ASPECT * 1.12));
    let head = 1.0 - smoothstep(p.head_r * 0.76,
                                p.head_r * 1.14 + au, length(d));
    // The shoulder line is tilted and starts INSIDE the head, so the body
    // grows out from behind it — a shoulder line below the jaw leaves a gap
    // of light at the neck and turns the whole thing into a lollipop. Full
    // width about 17 cm down, narrowing again toward the waist.
    let dx = uv.x - p.torso_x;
    let below = p.shoulder - uv.y + p.tilt * dx;
    let w = p.torso_w * smoothstep(-0.015, 0.105, below)
                      * (1.0 - 0.16 * smoothstep(0.12, 0.45, below));
    let soft = 0.028 + au;
    let torso = (1.0 - smoothstep(w - soft, w + soft, abs(dx)))
              * smoothstep(-0.02 - au, 0.03 + au, below);
    return clamp(max(head, torso), 0.0, 1.0);
}

// Two points of light where the eyes are. The gaussian is widened by the
// footprint with its integral held fixed, so the dots dim honestly as they
// go sub-pixel instead of flickering, and are gone by 0.18 m/px — this is a
// thing you find by flying close, not a feature of the skyline.
fn cc_windowlife_eyes(p: cc_windowlife_Pose, uv: vec2<f32>,
                      fp: f32) -> vec3<f32> {
    let fade = 1.0 - smoothstep(cc_windowlife_LOD_EYE.x,
                                cc_windowlife_LOD_EYE.y, fp);
    if (fade <= 0.0) {
        return vec3<f32>(0.0);
    }
    let s0 = cc_windowlife_EYE_SIGMA;
    let px = 0.5 * fp / cc_windowlife_PANE_W;
    let s = sqrt(s0 * s0 + px * px);
    let amp = (s0 * s0) / (s * s);      // conserve the integral
    let cy = p.head.y + 0.014 * (p.head_r / 0.085);
    let d1 = vec2<f32>(uv.x - p.head.x + cc_windowlife_EYE_SEP,
                       (uv.y - cy) / cc_windowlife_ASPECT);
    let d2 = vec2<f32>(uv.x - p.head.x - cc_windowlife_EYE_SEP,
                       (uv.y - cy) / cc_windowlife_ASPECT);
    let k = -0.5 / (s * s);
    let g = exp(k * dot(d1, d1)) + exp(k * dot(d2, d2));
    return cc_windowlife_EYE_GAIN * (g * amp * fade);
}

fn cc_windowlife_figure(h: vec4<f32>, uv: vec2<f32>, fp: f32,
                        android: bool) -> vec3<f32> {
    let lod = smoothstep(cc_windowlife_LOD_FIGURE.x,
                         cc_windowlife_LOD_FIGURE.y, fp);
    if (lod >= 1.0) {
        return cc_windowlife_FIGURE_MEAN;   // the eyes average into nothing
    }
    let p = cc_windowlife_pose(h);
    let m = cc_windowlife_figure_mask(p, uv, fp);
    let body = mix(vec3<f32>(1.0), cc_windowlife_BODY_T, m);
    if (!android) {
        return mix(body, cc_windowlife_FIGURE_MEAN, lod);
    }
    // The eyes ride on top of the silhouette and above 1: they are the one
    // thing in this file that adds light rather than taking it.
    let lit = body + cc_windowlife_eyes(p, uv, fp) * m;
    return mix(lit, cc_windowlife_FIGURE_MEAN, lod);
}

// Drapes hang at the glass, so they take the glass uv; an occupant stands
// in the room, so it takes the uv where the ray crosses the occupant's
// plane (deep_uv) — which is what slides them against each other as the
// camera moves past a close window. On a flat facade the two are equal.
// The glyph's population mean, for a facade whose windows are too small to
// draw one by one (the core's storey-by-storey expectation,
// city_windows_rows): h.x picks the class
// (uniform, the hash decorrelates it from wh), and each class dissolves to
// its own mean. 60% plain; 25% drapes, of which 55% curtains and 45% blinds;
// 15% figures and androids, which share the figure's mean.
fn cc_windowlife_glyph_mean() -> vec3<f32> {
    let drape = 0.55 * cc_windowlife_CURTAIN_MEAN
                + 0.45 * cc_windowlife_BLIND_MEAN;
    return cc_windowlife_T_DRAPE * vec3<f32>(1.0)
           + (cc_windowlife_T_FIGURE - cc_windowlife_T_DRAPE) * drape
           + (1.0 - cc_windowlife_T_FIGURE) * cc_windowlife_FIGURE_MEAN;
}

fn cc_windowlife_glyph(cc: CityCell, wh: vec4<f32>, pane_uv: vec2<f32>,
                       deep_uv: vec2<f32>, fp: f32) -> vec3<f32> {
    let h = cc_windowlife_hash(wh);
    if (h.x < cc_windowlife_T_DRAPE) {
        return vec3<f32>(1.0);      // most windows are just light
    }
    if (h.x < cc_windowlife_T_FIGURE) {
        return cc_windowlife_drape(h, pane_uv, fp);
    }
    return cc_windowlife_figure(h, deep_uv, fp,
                                h.x >= cc_windowlife_T_ANDROID);
}

// --- component: facadeworks (facadeworks.wgsl) ---
// facadeworks — additive facade detail on top of the core's windows.
//
// VERTICAL NEON SIGNAGE. The cyberpunk cue. A hashed minority of buildings
// (~12%) carries one narrow vertical sign box mounted on a corner of the
// main mass, so both walls meeting there show it: saturated amber / cyan /
// magenta at radiance 5-8, broken into glyph-like blocks that suggest
// characters without being any script. A mid-rise gets a 12-40 m strip
// starting 6 m up; a tower gets a ribbon proportional to its own height. At
// street range it should read as typography, and from kilometres out it
// should still be a colored vertical line, which is what makes a skyline
// read as a CITY and not a lit grid.
//
// (Balconies and fire escapes used to be drawn here as light on a flat wall;
// they are the core facade shell's now, in 3D, with their flat twins in
// city_facade_flat.)
//
// LOD discipline (SPEC rule 3). Every layer states its own mean and blends
// to it as the pixel footprint grows; nothing switches off. Two subtleties
// this file cares about:
//
//   * The sign strip is 1.2 m wide, so past ~2.5 m/px it is thinner than a
//     pixel and a naive gate would make it strobe. Instead the cross-section
//     WIDENS to the pixel while its amplitude drops by the same factor, so
//     the integrated energy across the strip is invariant. That is why a
//     sign is still a clean colored line at 3 km instead of a sparkle.
//   * The core hands us `fp`, not its own `fp_eff` (which divides by the
//     view/normal cosine); we have no `dir` here. So our thresholds are on
//     the un-foreshortened footprint and are set a little conservatively.
//
// The composer's namespace rule covers function-local `var` too, so this
// file is written without mutable locals — which is no loss: every layer is
// a mask times a color.

// --- Vertical neon signage -------------------------------------------------
const cc_facadeworks_SIGN_FRAC: u32 = 31u;      // of 256 buildings (~12%)
const cc_facadeworks_SIGN_HW: f32 = 0.60;      // half-width of the strip (m)
const cc_facadeworks_SIGN_V0: f32 = 6.0;       // strip starts this high (m)
const cc_facadeworks_SEG_PITCH: f32 = 1.15;    // glyph block pitch (m)
const cc_facadeworks_SEG_H: f32 = 0.90;        // lit height within the pitch
const cc_facadeworks_SEG_DUTY: f32 = 0.7826;   // SEG_H / SEG_PITCH
// Mean ink coverage of the 5-stroke glyph alphabet below, each stroke drawn
// with probability 1/2. Integrated over the alphabet rather than guessed:
// this is the value a block collapses to once its strokes go sub-pixel.
const cc_facadeworks_GLYPH_MEAN: f32 = 0.312;
// Both of these are calibrated against exposure 6, where anything over
// ~0.05 radiance is already a clearly visible grey: the first version of
// this halo ran at 0.33 and rendered the sign as a solid tan panel.
const cc_facadeworks_SIGN_HALO_AMP: f32 = 0.014; // wall spill, x the strip mean
const cc_facadeworks_SIGN_HALO_SIG: f32 = 0.85;  // spill sigma (m)
// A dim backing panel behind the glyphs, so a sign block reads as an
// illuminated box with writing on it rather than as free-floating strokes.
const cc_facadeworks_SIGN_PANEL: f32 = 0.005;

// Which tier of the building this facade pixel belongs to, and how far the
// wall runs in facade-u. The u-extent is what lets signage sit a fixed
// distance from a CORNER rather than at a hashed offset that
// would sometimes land mid-wall and sometimes off the end of it.
struct cc_facadeworks_Face {
    u0: f32,
    u1: f32,
    z1: f32,      // top of this tier
    base: bool,   // this is tier 1, the main mass
    side: i32,    // 0 = +x wall, 1 = -x, 2 = +y, 3 = -y
}

// The core's own face lookup, so our uc (metres from the face's start
// corner) is exactly the core's. A frustum skin is no one's base wall.
fn cc_facadeworks_face(cc: CityCell, h: CityHit) -> cc_facadeworks_Face {
    let f = city_face_at(cc, h.pos, h.normal);
    return cc_facadeworks_Face(0.0, f.len, f.z1, f.aligned && f.tier == 0,
                               f.side);
}

// One glyph block: up to five strokes from an alphabet of three horizontals
// and two verticals, each present with probability 1/2. Not a script — the
// point is that a stack of them reads as writing at a glance and as nothing
// in particular on inspection, which is what neon signage in a language you
// do not speak looks like.
fn cc_facadeworks_glyph(bits: u32, gu: f32, gv: f32) -> f32 {
    let inl = gu > 0.12 && gu < 0.88;   // horizontal strokes stop short
    let inb = gv > 0.10 && gv < 0.90;   // vertical strokes stop short
    let on = (inl && (bits & 1u) != 0u && abs(gv - 0.86) < 0.10)
          || (inl && (bits & 2u) != 0u && abs(gv - 0.50) < 0.10)
          || (inl && (bits & 4u) != 0u && abs(gv - 0.14) < 0.10)
          || (inb && (bits & 8u) != 0u && abs(gu - 0.20) < 0.075)
          || (inb && (bits & 16u) != 0u && abs(gu - 0.80) < 0.075);
    return select(0.0, 1.0, on);
}

// Where this wall's sign strip sits, if it has one: (u of the strip's
// centre, half-width, v0, v1), half-width 0 for none. Shared by the sign
// and by the cover it reports, so the wall it blanks is the wall it lights.
fn cc_facadeworks_sign_box(cc: CityCell, f: cc_facadeworks_Face,
                           s: vec2<u32>) -> vec4<f32> {
    // Cheap rejects first: one bit-slice of the building draw, then whether
    // this wall carries the sign, then whether this mass can carry one at
    // all. Signs live on tier 1 only — one that climbed onto a setback would
    // hang off the inset wall's corner instead of the street's.
    //
    // The draw picks a CORNER of the plan, not a wall, and the sign box is
    // mounted on it, so both walls meeting there carry the strip, on
    // whichever of their two u-ends that corner is. One sign, two faces —
    // which is how corner signage actually works, and it is also what makes
    // the layer land at street level: gating on a single wall put a sign in
    // front of the camera roughly never, since 12% of buildings times one
    // wall in four is 3% of the walls in a frame and a street view holds
    // about a dozen.
    //
    // The wall->corner table: wall s has corner (0x0231 >> 4s) & 3 at its u0
    // end and that corner plus one at its u1 end, walking the plan corners
    // (xmin,ymin), (xmax,ymin), (xmax,ymax), (xmin,ymax) counterclockwise.
    let c0 = i32((0x0231u >> (4u * u32(f.side))) & 3u);
    let corner = i32((s.x >> 8u) & 3u);
    let right_edge = corner == ((c0 + 1) & 3);
    // No signs on a warehouse: the industry component owns its walls.
    if ((s.x & 255u) >= cc_facadeworks_SIGN_FRAC
        || cc.land_use == CITY_USE_INDUSTRIAL
        || !(right_edge || corner == c0)
        || !f.base || f.z1 <= 17.0 || (f.u1 - f.u0) <= 6.5) {
        return vec4<f32>(0.0);
    }
    // The sign is sized to the mass it hangs on. A fixed 12-40 m strip
    // starting at 6 m is right for a mid-rise and invisible on everything
    // else: soar is a fly-through whose camera lives well above 46 m, and
    // this city's megatower tier-1 walls are a KILOMETRE of facade that
    // would carry a 40 m mark at the very bottom and nothing above it. So a
    // tall wall takes a length proportional to itself instead — a ribbon
    // running most of the tower, which is the Cloudpunk cue — while a
    // mid-rise keeps the fixed law exactly. The cross-section and the glyph
    // blocks scale as the square root of the length ratio, which holds the
    // character aspect fixed while a tower's sign reads at a tower's size.
    let r_len = city_u01(s.y);
    let tall = mix(0.0, 0.85, smoothstep(60.0, 600.0, f.z1))
               * (0.5 + 0.5 * r_len);
    let len = max(12.0 + 28.0 * r_len, tall * f.z1);
    let gscale = sqrt(clamp(len / 26.0, 1.0, 12.0));
    let hw0 = cc_facadeworks_SIGN_HW * gscale;

    let v0 = cc_facadeworks_SIGN_V0;
    let v1 = min(v0 + len, f.z1 - 2.0);
    if (v1 - v0 < 6.0) {
        return vec4<f32>(0.0);
    }
    let uanch = select(f.u0 + 1.9 * gscale, f.u1 - 1.9 * gscale, right_edge);
    return vec4<f32>(uanch, hw0, v0, v1);
}

// Layer 1. `s` is the building's structural draw (see cc_facadeworks_detail).
fn cc_facadeworks_sign(cc: CityCell, f: cc_facadeworks_Face, s: vec2<u32>,
                       uc: f32, vc: f32, fp: f32) -> vec3<f32> {
    let sbox = cc_facadeworks_sign_box(cc, f, s);
    let hw0 = sbox.y;
    let v0 = sbox.z;
    let v1 = sbox.w;
    if (hw0 <= 0.0 || vc < v0 - 1.0 || vc > v1 + 1.0) {
        return vec3<f32>(0.0);
    }
    let gscale = hw0 / cc_facadeworks_SIGN_HW;
    let seg_pitch = cc_facadeworks_SEG_PITCH * gscale;
    let seg_h = cc_facadeworks_SEG_H * gscale;
    let uanch = sbox.x;
    let du = abs(uc - uanch);
    // The strip's cross-section, widened to the pixel once it is thinner
    // than one and dimmed by the same factor: the integral across u is
    // invariant, so a sign neither strobes nor washes out with range.
    let hw = max(hw0, 0.50 * fp);
    let soft = 0.30 * hw;
    let sig = max(cc_facadeworks_SIGN_HALO_SIG * gscale, 0.65 * fp);
    if (du > max(hw, 2.6 * sig)) {
        return vec3<f32>(0.0);
    }

    // The sign's own draw: color, brightness, and whether a third of its
    // tubes are out. No time in this shader, so a broken sign is permanently
    // broken rather than flickering — the dead blocks are the tell either way.
    let sh = city_rand4(cc.seed ^ vec2<u32>(0x1d8e4a37u, 0x6c9f2b05u));
    // Pushed draws: three explicit slots in city_window_color's palette at a
    // fixed bias, so signage lands on saturated amber / cyan / magenta and
    // never on the fluorescent white that would read as an office window.
    let sdraw = select(select(0.20, 0.89, sh.x > 0.34), 0.97, sh.x > 0.67);
    let scol = city_window_color(sdraw, 0.5);
    let rad = 5.0 + 3.0 * sh.y;
    let dead_frac = select(0.04, 0.35, sh.z < 0.15);

    // Glyph blocks up the strip.
    let sv = vc - v0;
    let iseg = i32(floor(sv / seg_pitch));
    let fsv = sv - f32(iseg) * seg_pitch;
    let sb = pcg2d(vec2<u32>(cc.seed.x ^ 0x51a3f7ddu,
                             bitcast<u32>(iseg) * 0x9e3779b9u));
    let alive = select(0.0, 1.0, city_u01(sb.y) >= dead_frac);
    let gu = (uc - (uanch - hw0)) / (2.0 * hw0);
    let ink = cc_facadeworks_glyph(sb.x, gu, fsv / seg_h);

    // The ladder. Strokes are ~0.2 m, so they go sub-pixel well before the
    // 1.15 m block pitch does: glyph interiors dissolve into the block mean
    // first, then blocks and their gaps dissolve into a continuous line
    // carrying the same mean energy. Both thresholds ride gscale, because a
    // tower's sign is physically bigger and stays resolved further out.
    let l1 = smoothstep(0.30 * gscale, 1.5 * gscale, fp);
    let l2 = smoothstep(1.2 * gscale, 6.0 * gscale, fp);
    let in_seg = select(0.0, 1.0, fsv < seg_h);
    let pan = cc_facadeworks_SIGN_PANEL;
    let lum = mix(ink, cc_facadeworks_GLYPH_MEAN, l1) * (1.0 - pan) + pan;
    let near = lum * in_seg * alive;
    let far = (cc_facadeworks_GLYPH_MEAN * (1.0 - pan) + pan)
              * cc_facadeworks_SEG_DUTY * (1.0 - dead_frac);
    let val = mix(near, far, l2);

    // Profile across the strip (integral 2*hw - soft, hence the amplitude)
    // and the wall spill either side of it, which is what tells the eye the
    // sign is a tube in front of a wall and not a painted rectangle.
    let prof = 1.0 - smoothstep(hw - soft, hw, du);
    let amp = hw0 / max(hw - 0.5 * soft, 1e-3);
    let halo = cc_facadeworks_SIGN_HALO_AMP
               * (cc_facadeworks_SIGN_HALO_SIG * gscale / sig) * far
               * exp(-0.5 * du * du / (sig * sig));
    // Both ends written ascending: smoothstep with edge0 > edge1 is undefined
    // in WGSL, however reasonably a given backend happens to evaluate it.
    let vgate = smoothstep(v0 - 0.3, v0 + 0.3, vc)
                * (1.0 - smoothstep(v1 - 0.3, v1 + 0.3, vc));
    return scol * (rad * vgate * (prof * amp * val + halo));
}

fn cc_facadeworks_draw(cc: CityCell) -> vec2<u32> {
    return pcg2d(cc.seed ^ vec2<u32>(0x7f4a7c15u, 0x2b3d8e11u));
}

fn cc_facadeworks_detail(cc: CityCell, h: CityHit, dir: vec3<f32>,
                         uc: f32, vc: f32, fp: f32) -> vec3<f32> {
    // One draw per building for the sign's structure. pcg2d gives 64 bits;
    // the continuous draws are taken later, behind the sign's own reject.
    //
    //   bits  0-7   sign presence      8-9   sign corner
    //   s.y         sign length
    let s = cc_facadeworks_draw(cc);
    let f = cc_facadeworks_face(cc, h);
    return cc_facadeworks_sign(cc, f, s, uc, vc, fp);
}

// The sign box is a box on the wall: where it hangs there are no windows
// and no relief behind it, only the sign.
fn cc_facadeworks_cover(cc: CityCell, h: CityHit, uc: f32, vc: f32,
                        fp: f32) -> f32 {
    let s = cc_facadeworks_draw(cc);
    if ((s.x & 255u) >= cc_facadeworks_SIGN_FRAC) {
        return 0.0;
    }
    let sb = cc_facadeworks_sign_box(cc, cc_facadeworks_face(cc, h), s);
    let inside = sb.y > 0.0 && abs(uc - sb.x) < sb.y
              && vc > sb.z && vc < sb.w;
    return select(0.0, 1.0, inside);
}

// --- component: skyway (skyway.wgsl) ---
// skyway — the elevated freeway network.
//
// One system the block grid does not own. Everything else in the city is a
// property of a cell; a freeway is a LINE that runs through thousands of
// them, so it is traced once per ray (`extra_trace`) rather than per visited
// cell, and its whole geometry is closed form: a handful of slab tests
// against a ribbon whose top surface is a piecewise-linear function of the
// distance along it. No marcher, no DDA, no per-cell state.
//
// LATTICE. Routes ride the avenue lattice, sparsely. Blocks are
// `u.ocean_params.x` metres (90 on the shipped tile) and avenues fall every
// `CITY_AVENUE_PERIOD` = 8 blocks, so the finest legal route spacing is 720 m
// — far too dense. The route period is 24 blocks (2160 m), three avenues
// apart, which is what makes the network read as sparse drama rather than as
// a second lattice competing with the streets:
//
//   * an x-running deck on every avenue line with block index y = 0 (mod 24)
//   * a y-running deck on every avenue line with block index x = 8 (mod 24)
//
// The brief asked for the two directions to be offset by 12 blocks. Twelve is
// not a multiple of the avenue period, so a y-route offset by 12 would run
// down the middle of a BLOCK — through the buildings. Eight is the nearest
// offset that keeps both families on avenues (8 and 16 are equidistant from
// 12 and are reflections of each other), so the crossings sit off the
// diagonal without any route ever leaving an avenue. The whole thing is
// defined in world coordinates, so it is endless and identical from every
// camera and on every frame.
//
// Why the avenue matters: `city_cell` insets each plot by CITY_STREET_HALF
// (6 m) plus CITY_AVENUE_EXTRA (10 m) on an avenue boundary, so an avenue is
// a 32 m corridor of guaranteed empty air centred on the line. A 16 m deck on
// the centreline therefore clears the facades by 8 m on each side BY
// CONSTRUCTION, at any height — the flat-roof rule in SPEC's "Respect the
// architecture" is satisfied without a single building test. (Multi-block
// lots cannot break this either: cloudyview/city_lots.py never lets a lot
// contain an avenue line, and city_cell clamps growth buds to the plot on
// avenue edges.)
//
// PROFILE. The x-family runs dead flat at 26 m. Where the two families cross,
// the y-family climbs to 34 m and passes over — a real interchange decision,
// and the thing that stops the network being a flat plaid. The rise is
// modelled as the deck's top plane being piecewise linear in the along
// coordinate: flat base, a 200 m linear ramp, 124 m flat at the top, a ramp
// back down. Each piece is an exact slab test in the SHEARED coordinate
// h = z - z_top(a), so the ramps are true sloped slabs, not stair steps, and
// consecutive pieces share their end planes exactly — there is nowhere for a
// gap to open.
//
// Under the raised span the pylons would spear the deck they are crossing, so
// pylons inside CROSS_CLEAR of a crossing are simply absent: the high span
// carries itself across a 110 m gap, which is what a real overpass does.
//
// STRUCTURE. Three things, and no more, because the calibration is wiper
// blades and not tire brands: paired columns on 55 m bays, a pier CAP spanning
// each pair (a column running into the underside of a slab is the detail whose
// absence reads as unbuilt — the crosshead is what turns a row of sticks into
// a colonnade), and an expansion JOINT in the running surface over every bay,
// which is the only thing that says a viaduct is a chain of spans rather than
// a poured ribbon. Bearings, drainage, parapet posts and sign gantries are all
// below that line and are not here.
//
// CANDIDATE ROUTES. The expensive mistake here would be looping over route
// lines. Instead: the whole component lives in z ∈ [0, 35.1], so clip the ray
// to that slab first (this alone rejects every sky ray and most cloud rays
// for free), read off the interval of the lateral coordinate the ray spans
// inside it, and convert that interval directly into a range of route
// indices. For any ray that is not both near-horizontal AND inside the slab
// that range holds 0, 1 or 2 entries. Rays that are — a camera parked on the
// deck looking down it — get the nearest three, ordered by t, which is
// exactly the ordering that matters for an opaque first hit.
//
// LIGHT. The artery read from altitude is NOT the lamp heads: a 0.36 m rail
// at 4 m/px covers a tenth of a pixel and delivers a tenth of its radiance.
// It is what those strings put on the 16 m of DECK — the wash — which is
// what actually makes a lit road photograph as a continuous bright ribbon
// from the air. The string dashes (radiance 5, warm white, every 9 m along
// both rail tops, collapsing into a continuous line of the same mean energy
// once a dash is sub-pixel) are the close read; the deck's own mean radiance
// is the far one. There is no traffic: the deck carried "frozen traffic",
// the light of cars painted on the asphalt with no car under it, until
// Thomas flew it (2026-11): "they dont have a source". Real cars on the
// decks were the alternative; he chose an empty road.
//
// A note on what "bright" can mean here. At exposure 6 the tone map is
// nearly flat above radiance 1: 0.47 renders at 0.85 display and 1.7 (a
// downtown sodium pool at its peak) at 0.97. No honest deck radiance makes an
// artery outshine a lit avenue, and chasing one only blows out the close
// views. What separates the network from the lattice at a kilometre is
// therefore CONTINUITY and COLOUR — an unbroken near-white ribbon cutting
// diagonally across chains of orange dots, at its own altitude, three avenues
// from the next one. That is also how a real freeway reads from a plane.
//
// COST. Per ray: one z-slab clip (which returns immediately for anything
// looking at the sky), then per family one lateral-interval-to-index
// derivation and at most three corridor rejects, each two divides. A corridor
// the ray actually enters costs, worst case, five envelope slabs (only one of
// which can be non-empty for a ray that is not running along the deck), three
// detail slabs for the piece that hit, and — over at most three bays — one
// cap box and two column boxes each. The common city pixel, looking at a
// facade 2 km from any route, pays the z clip and six corridor rejects and
// nothing else.
//
// Measured on a 5080 at 200 accumulated passes, 960x540, registry entry on vs
// off, three interleaved repetitions per camera (interleaved because the box
// is SHARED and a block of A followed by a block of B measures the drift
// between them; the numbers below are the minimum of three and are contended
// regardless, so read them as an upper bound):
//
//     sky only   0.860 on / 0.850 off        artery aerial  0.470 / 0.460
//     on deck    0.350 on / 0.350 off        under deck     0.380 / 0.370
//
// That is +0.01 s on 200 passes where it is non-zero at all — 50 microseconds
// a pass, and exactly one tick of the harness's 10 ms print granularity. The
// honest reading is that the component's cost is at or below what this rig can
// measure, not that it is precisely 50 us.
//
// One caveat on the last two rows, since it would be easy to quote them as an
// occlusion win: with skyway disabled those cameras are not looking at the
// same scene at all — they are parked in mid-air over an empty avenue — so
// they are not an A/B of anything. An earlier revision of this header claimed
// a canyon view got twice as FAST with the network, from that same confound.
// It does not reproduce, and the claim is withdrawn.

// --- lattice ---------------------------------------------------------------
// In blocks, so the network scales with the tile's own cell size.
const cc_skyway_ROUTE_BLOCKS: f32 = 24.0;   // 3 avenues between routes
const cc_skyway_OFFSET_BLOCKS: f32 = 8.0;   // y-family phase (one avenue)

// --- deck ------------------------------------------------------------------
const cc_skyway_HW: f32 = 8.0;        // half width: a 16 m deck in a 32 m avenue
const cc_skyway_THICK: f32 = 1.4;
const cc_skyway_DECK_Z: f32 = 26.0;   // top of the base deck
const cc_skyway_HIGH_Z: f32 = 34.0;   // top of a raised crossing
const cc_skyway_RAMP: f32 = 200.0;    // linear approach length
const cc_skyway_FLAT_HALF: f32 = 62.0; // half the flat run over a crossing
const cc_skyway_RAIL_H: f32 = 1.1;
const cc_skyway_RAIL_W: f32 = 0.36;
const cc_skyway_PYL_SP: f32 = 55.0;   // pylon bays
const cc_skyway_PYL_HW: f32 = 0.6;    // 1.2 m square
const cc_skyway_PYL_OFF: f32 = 5.2;   // paired, in from the deck edges
// Pier cap: the crosshead the two columns of a bay carry, and what the deck
// actually sits on. A column meeting a slab edge-on is the thing that reads as
// unbuilt — every real viaduct puts a transverse beam in between, and at
// wiper-blades calibration that beam IS the feature (no bearings, no pintles,
// no plaque). It spans the pair and oversails each column by CAP_OS, so the
// colonnade under a deck reads as a row of T's rather than a row of sticks.
const cc_skyway_CAP_H: f32 = 1.05;    // depth of the crosshead
const cc_skyway_CAP_HL: f32 = 1.15;   // half-length along the deck
const cc_skyway_CAP_OS: f32 = 0.55;   // oversail beyond the outer column face
// No pylon within this of a crossing centre: the span it would land in is the
// one the other deck occupies.
const cc_skyway_CROSS_CLEAR: f32 = 22.0;
// The along-range used to choose WHICH crossing a corridor is near. Bounded
// so a near-horizontal ray running kilometres down a deck picks the
// interchange in front of the camera rather than one 15 km away.
const cc_skyway_MC_SPAN: f32 = 1400.0;
// Stands in for "endless" on the along axis. World coordinates are ~1e5 and
// CITY_TRACE_RANGE is 3e4, so this is out of reach without costing precision.
const cc_skyway_FAR: f32 = 1.0e6;
const cc_skyway_Z_TOP: f32 = 35.1;    // HIGH_Z + RAIL_H: the component's slab

// --- light -----------------------------------------------------------------
// SPEC rule 5 yardsticks: lit window 3.5, storefront 2.2, sodium pool 0.7.
const cc_skyway_STR_COLOR: vec3<f32> = vec3<f32>(1.00, 0.85, 0.60);
// The brief's number. It is also, at this exposure, an unfalsifiable one: the
// lit face of a rail lands at radiance 3 either way and the tone map has
// nothing left above 2, so 5 and the 6.5 this file used to carry are the same
// pixel. The rail is 0.36 m of a 17 m cross-section, so the far-field mean
// does not notice either. Kept at the contract value because deviating from it
// buys nothing.
const cc_skyway_STR_RAD: f32 = 5.0;
const cc_skyway_STR_P: f32 = 9.0;     // light-string period along the rail
const cc_skyway_STR_L: f32 = 3.3;     // lit length of each dash
// Where a dash stops being resolvable and becomes a continuous line of the
// same mean energy. A 3.3 m dash is one pixel at ~3.3 m/px, so the hand-off
// straddles the brief's 4 m.
const cc_skyway_STR_FP_LO: f32 = 2.4;
const cc_skyway_STR_FP_HI: f32 = 4.8;
// How much of the string a rail face carries. The strip fixture sits on the
// rail top; the road side sees more of it than the outside does. It is a
// BAND, not the whole face — a 1.1 m barrier lit end to end reads as a broken
// white wall, whereas the same light in the top 0.35 m reads as what it is: a
// dark concrete barrier with a lamp strip running along it.
const cc_skyway_RAIL_FACE_IN: f32 = 0.60;
const cc_skyway_RAIL_FACE_OUT: f32 = 0.34;
const cc_skyway_RAIL_BAND: f32 = 0.35;  // lit depth below the rail top (m)
// The spill: what the strip throws down the OUTSIDE of the barrier and on
// down the deck's fascia below it. Without it the side of a deck was near-
// black from the band to the soffit — a 2.5 m slab with nothing on it once
// the fascia was drawn at all (Thomas's flights, 2026-11). It falls off
// with depth below the rail top, it is scalloped along the deck under each
// lamp exactly as the wash on the road is (the same rhythm, and so the same
// far mean), and an expansion joint breaks it, which is what lets you read
// from the side where one span ends and the next begins. Dim on purpose: a
// third of display at the fascia's top, near-black at its foot, against a
// road that runs to white under the same lamps.
const cc_skyway_SPILL_AMP: f32 = 0.05;
const cc_skyway_SPILL_E: f32 = 0.60;    // e-folding down the face (m)
// The wash the strings throw across the deck. This is half the artery — but
// it is a GRADIENT, not a bar, and the difference is everything. At exposure
// 6 with a white point of 15 the tone map has already spent most of its range
// by radiance 1.5 (0.1 renders at 0.55 display, 1.0 at 0.93, 3.5 at white),
// so a deck lit evenly at 1.3 arrives as a featureless white ribbon.
// E-folded over 1.9 m instead, the same deck runs 0.95 display under a lamp
// at the rail down to about 0.2 along the centreline: bright margins and
// dark lanes.
//
// A string of lamps 9 m apart also does not light a road evenly — it scallops
// it, and that rhythm running away toward the vanishing point is most of what
// says "lit road at night" rather than "glowing strip". SCALLOP is the floor
// between lamps, and WASH_AMP is pre-divided by the pattern's own mean (0.857)
// so adding the rhythm does not move the deck's far-field brightness.
const cc_skyway_WASH_AMP: f32 = 1.30;
const cc_skyway_WASH_E: f32 = 1.90;   // e-folding in from the rail (m)
const cc_skyway_SCALLOP: f32 = 0.35;  // between-lamp floor
const cc_skyway_SCALLOP_S: f32 = 2.80; // pool sigma along the deck (m)
const cc_skyway_ASPHALT: f32 = 0.05;  // deck albedo against the skyglow
const cc_skyway_CONCRETE: f32 = 0.055;
// Uplight: the sodium pools on the street 25 m below, thrown back onto the
// underside and the pylons. `city_street_pools` is the same function the
// ground uses, sampled at the point directly below — so the scallops along an
// underside land exactly over the lamps that cause them.
//
// The coefficient is small because what it multiplies is not: `pools` sums
// four lamp terms and carries a x3 factor on an avenue, so it peaks near 6
// right where a deck sits, and `street_scale` multiplies that by up to 2.4
// downtown. The 0.3 the brief suggested puts the soffit at radiance 4 — a
// glowing cream ceiling, brighter than the road on top of it. At 0.010 the
// same geometry peaks near 0.14, which is a dark concrete soffit with warm
// scallops picked out along the lamp line: what the brief actually asked for.
const cc_skyway_UPLIGHT: f32 = 0.010;
const cc_skyway_PYL_UP_E: f32 = 16.0; // uplight e-folds up a pylon (m)
// Transverse girders under the deck. Zero-mean modulation, so it is texture
// and not brightness, and it hands over to flat once it is sub-pixel.
const cc_skyway_RIB_P: f32 = 3.2;
const cc_skyway_RIB: f32 = 0.34;
const cc_skyway_RIB_FP: f32 = 1.20;

// --- lane paint ------------------------------------------------------------
const cc_skyway_PAINT_W: f32 = 0.18;
const cc_skyway_PAINT_AMP: f32 = 0.55;
const cc_skyway_LANE_DIV: f32 = 4.0;  // four 4 m lanes across the 16 m deck
const cc_skyway_EDGE_LINE: f32 = 7.35;
const cc_skyway_CENTRE_LINE: f32 = 0.45;
const cc_skyway_DASH_P: f32 = 12.0;
const cc_skyway_DASH_DUTY: f32 = 0.42;
const cc_skyway_PAINT_FP_LO: f32 = 0.30;
const cc_skyway_PAINT_FP_HI: f32 = 1.10;

// --- expansion joints -------------------------------------------------------
// A viaduct is not a ribbon, it is a chain of spans, and the joint over each
// pier is where that fact becomes visible. One per pylon bay (55 m), the full
// width of the deck, in the running surface and carried down the fascia — the
// same s for both, so the line on the side is the end of the line on top.
//
// Two-tone, because a joint is two things: the GAP (a slot with nothing in it
// — the darkest thing on a lit deck, and the part the eye actually reads) and
// the COMB plates either side of it (bare steel, which under a warm lamp
// strip is a shade brighter than asphalt, not darker). One without the other
// reads as a crack or as a stripe; together they read as hardware.
//
// Derived from s alone, so it does not care whether the bay under it has a
// pylon: segments still butt over a suppressed pier, and the chain stays
// unbroken across a crossing.
// Sized as what a 55 m span actually needs. A span that long moves 40-60 mm
// between summer and winter, which is past what a single sealed gap will take,
// so the joint is a MODULAR one: a wide steel frame with the movement split
// across several seals. That is a genuine 0.7 m of deck hardware — the first
// draft here used 0.38 m, which is a joint for a 20 m span and, at this
// renderer's footprints, one that is never once resolved.
const cc_skyway_JNT_GAP: f32 = 0.11;    // half-width of the sealed slot (m)
const cc_skyway_JNT_PLATE: f32 = 0.35;  // half-width of the whole frame (m)
const cc_skyway_JNT_DARK: f32 = 0.80;   // how much of the wash the slot eats
const cc_skyway_JNT_STEEL: f32 = 0.22;  // plate lift, as a fraction of wash
// Where the 0.70 m frame stops being resolvable, in the ALONG footprint
// (fp_eff, not fp — see the note in the shader). Under the app's default LOD
// slider that puts the last legible joint about 25 m ahead and the pattern
// fully collapsed by 75 m, which is roughly one span and a half: you see the
// joint you are crossing and the one after it, and beyond that the deck is
// honestly smooth rather than dishonestly striped.
const cc_skyway_JNT_FP_LO: f32 = 0.65;
const cc_skyway_JNT_FP_HI: f32 = 2.00;

// --- hit kinds --------------------------------------------------------------
// kind = 200 + 8*family + part. SPEC allows local in [0, 15]; a stride of 8
// with five parts spends 200..212 of it and leaves the arithmetic to a shift.
// The family bit is what lets the shader rebuild the local frame from nothing
// but the kind and the world position — no per-hit payload to carry.
const cc_skyway_KIND_BASE: i32 = 200;
const cc_skyway_FAM_STRIDE: i32 = 8;
const cc_skyway_P_DECK: i32 = 0;   // running surface
const cc_skyway_P_UNDER: i32 = 1;  // soffit and fascia
const cc_skyway_P_PYL: i32 = 2;    // column
const cc_skyway_P_RAIL: i32 = 3;   // edge barrier
const cc_skyway_P_CAP: i32 = 4;    // pier cap

// The local frame of a route: x = along the deck, y = lateral, z = up. The
// two families differ only by which world axis is "along", so one x/y swap is
// the whole transform — and it is its own inverse, which is why the same call
// maps a normal back to world.
fn cc_skyway_swap(v: vec3<f32>, fam: i32) -> vec3<f32> {
    return select(vec3<f32>(v.y, v.x, v.z), v, fam == 0);
}

// A ray interval being whittled down by slabs. `axis` and `sgn` remember
// which slab last raised the near end, which is the face the ray enters
// through and therefore the one whose normal it wears.
struct cc_skyway_Span {
    t0: f32,
    t1: f32,
    axis: i32,
    sgn: f32,
}

// One slab: keep the part of the interval where a + b*t lies in [lo, hi].
// Works for a sheared coordinate as readily as for a world axis, which is the
// whole trick behind the sloped ramps.
fn cc_skyway_clip(sp: cc_skyway_Span, a: f32, b: f32, lo: f32, hi: f32,
                  axis: i32) -> cc_skyway_Span {
    var r = sp;
    if (abs(b) < 1.0e-9) {
        if (a < lo || a > hi) {
            r.t1 = r.t0 - 1.0;   // parallel and outside: empty forever
        }
        return r;
    }
    let ta = (lo - a) / b;
    let tb = (hi - a) / b;
    let tn = min(ta, tb);
    if (tn > r.t0) {
        r.t0 = tn;
        r.axis = axis;
        r.sgn = select(1.0, -1.0, b > 0.0);
    }
    r.t1 = min(r.t1, max(ta, tb));
    return r;
}

// The entering face's outward normal, in world space. Axes 0 and 1 are the
// along and lateral slabs; axis 2 is the sheared one, whose gradient is
// (-m, 0, 1) in the local frame — that tilt is what makes a ramp shade as a
// ramp rather than as a flat deck at the wrong height.
fn cc_skyway_normal(axis: i32, sgn: f32, m: f32, fam: i32) -> vec3<f32> {
    var nl = vec3<f32>(0.0, 0.0, 1.0);
    if (axis == 0) {
        nl = vec3<f32>(sgn, 0.0, 0.0);
    } else if (axis == 1) {
        nl = vec3<f32>(0.0, sgn, 0.0);
    } else {
        nl = normalize(vec3<f32>(-m, 0.0, 1.0)) * sgn;
    }
    return cc_skyway_swap(nl, fam);
}

struct cc_skyway_Best {
    t: f32,
    nrm: vec3<f32>,
    kind: i32,
}

// The deck's top surface as a function of the along coordinate. The x-family
// never rises; the y-family rises over its crossing with the x-family. Kept
// LINEAR on purpose — it has to agree exactly with the sloped slabs below, or
// the pylons would not meet the underside they hold up.
fn cc_skyway_ztop(a: f32, ac: f32, raised: bool) -> f32 {
    if (!raised) {
        return cc_skyway_DECK_Z;
    }
    let d = abs(a - ac);
    if (d <= cc_skyway_FLAT_HALF) {
        return cc_skyway_HIGH_Z;
    }
    if (d >= cc_skyway_FLAT_HALF + cc_skyway_RAMP) {
        return cc_skyway_DECK_Z;
    }
    return cc_skyway_HIGH_Z
        + (cc_skyway_DECK_Z - cc_skyway_HIGH_Z)
          * (d - cc_skyway_FLAT_HALF) / cc_skyway_RAMP;
}

// One piece of ribbon: the deck slab over [a0, a1] with top plane
// z = zb + m*(a - ab), and the two rails riding on it. An envelope test
// covering deck and rails together gates the three detail tests, so a piece
// the ray never reaches costs three clips and stops.
fn cc_skyway_ribbon(lo3: vec3<f32>, ld3: vec3<f32>, ta: f32, tb: f32,
                    a0: f32, a1: f32, ab: f32, zb: f32, m: f32,
                    fam: i32, best: cc_skyway_Best) -> cc_skyway_Best {
    var r = best;
    let h0 = lo3.z - zb - m * (lo3.x - ab);
    let hd = ld3.z - m * ld3.x;
    let seed = cc_skyway_Span(ta, tb, -1, 1.0);

    var env = cc_skyway_clip(seed, lo3.x, ld3.x, a0, a1, 0);
    env = cc_skyway_clip(env, lo3.y, ld3.y, -cc_skyway_HW, cc_skyway_HW, 1);
    env = cc_skyway_clip(env, h0, hd, -cc_skyway_THICK, cc_skyway_RAIL_H, 2);
    if (env.t0 > env.t1 || env.t0 >= r.t) {
        return r;
    }

    // The deck itself: everything from the running surface down to the
    // fascia's lower edge.
    var d = cc_skyway_clip(seed, lo3.x, ld3.x, a0, a1, 0);
    d = cc_skyway_clip(d, lo3.y, ld3.y, -cc_skyway_HW, cc_skyway_HW, 1);
    d = cc_skyway_clip(d, h0, hd, -cc_skyway_THICK, 0.0, 2);
    if (d.t0 <= d.t1 && d.axis >= 0 && d.t0 < r.t) {
        let top = d.axis == 2 && d.sgn > 0.0;
        r = cc_skyway_Best(d.t0,
                           cc_skyway_normal(d.axis, d.sgn, m, fam),
                           cc_skyway_KIND_BASE + cc_skyway_FAM_STRIDE * fam
                           + select(1, 0, top));
    }

    // Edge rails, one either side, standing on the deck top.
    for (var side: i32 = 0; side < 2; side = side + 1) {
        let l0 = select(-cc_skyway_HW,
                        cc_skyway_HW - cc_skyway_RAIL_W, side == 1);
        let l1 = select(-cc_skyway_HW + cc_skyway_RAIL_W,
                        cc_skyway_HW, side == 1);
        var q = cc_skyway_clip(seed, lo3.x, ld3.x, a0, a1, 0);
        q = cc_skyway_clip(q, lo3.y, ld3.y, l0, l1, 1);
        q = cc_skyway_clip(q, h0, hd, 0.0, cc_skyway_RAIL_H, 2);
        if (q.t0 <= q.t1 && q.axis >= 0 && q.t0 < r.t) {
            r = cc_skyway_Best(q.t0,
                               cc_skyway_normal(q.axis, q.sgn, m, fam),
                               cc_skyway_KIND_BASE + cc_skyway_FAM_STRIDE * fam
                               + cc_skyway_P_RAIL);
        }
    }
    return r;
}

// Paired pylons, ground to underside. The along position is quantized, so the
// nearest few are found by rounding the ray's own along coordinate rather
// than by searching: take the bay at the entry to the under-deck z-band and
// walk at most three of them in the direction of travel. That is the whole
// colonnade a ray can see before the near pylons occlude the far ones.
fn cc_skyway_pylons(lo3: vec3<f32>, ld3: vec3<f32>, ct0: f32, ct1: f32,
                    ac: f32, raised: bool, fam: i32,
                    best: cc_skyway_Best) -> cc_skyway_Best {
    var r = best;
    var pt0 = ct0;
    var pt1 = ct1;
    let ztop_max = cc_skyway_HIGH_Z - cc_skyway_THICK;
    if (abs(ld3.z) > 1.0e-9) {
        let ta = (0.0 - lo3.z) / ld3.z;
        let tb = (ztop_max - lo3.z) / ld3.z;
        pt0 = max(pt0, min(ta, tb));
        pt1 = min(pt1, max(ta, tb));
    } else if (lo3.z < 0.0 || lo3.z > ztop_max) {
        return r;
    }
    if (pt0 > pt1 || pt0 >= r.t) {
        return r;
    }

    let sa = lo3.x + pt0 * ld3.x;
    let sb = lo3.x + pt1 * ld3.x;
    let na = i32(round(sa / cc_skyway_PYL_SP));
    let nb = i32(round(sb / cc_skyway_PYL_SP));
    let dn = select(-1, 1, nb >= na);
    let seed = cc_skyway_Span(ct0, ct1, -1, 1.0);
    for (var q: i32 = 0; q < 3; q = q + 1) {
        let n = na + q * dn;
        if ((dn > 0 && n > nb) || (dn < 0 && n < nb)) {
            break;
        }
        let s_n = f32(n) * cc_skyway_PYL_SP;
        // The bay a crossing occupies carries no pylon: the high span crosses
        // it clean.
        if (raised && abs(s_n - ac) < cc_skyway_CROSS_CLEAR) {
            continue;
        }
        // The underside at this bay. On a ramp it is sloped, but the cap is
        // only 2.3 m long, so evaluating the profile at the bay centre puts
        // the cap's flat top within 5 cm of it — and that discrepancy is
        // BURIED, because the cap is narrower than the deck on both axes and
        // the deck is the nearer surface wherever the two overlap.
        let soffit = cc_skyway_ztop(s_n, ac, raised) - cc_skyway_THICK;
        let cap_bot = soffit - cc_skyway_CAP_H;

        // The crosshead, spanning the pair.
        let cap_hw = cc_skyway_PYL_OFF + cc_skyway_PYL_HW + cc_skyway_CAP_OS;
        var cp = cc_skyway_clip(seed, lo3.x, ld3.x,
                                s_n - cc_skyway_CAP_HL,
                                s_n + cc_skyway_CAP_HL, 0);
        cp = cc_skyway_clip(cp, lo3.y, ld3.y, -cap_hw, cap_hw, 1);
        cp = cc_skyway_clip(cp, lo3.z, ld3.z, cap_bot, soffit, 2);
        if (cp.t0 <= cp.t1 && cp.axis >= 0 && cp.t0 < r.t) {
            r = cc_skyway_Best(cp.t0,
                               cc_skyway_normal(cp.axis, cp.sgn, 0.0, fam),
                               cc_skyway_KIND_BASE
                               + cc_skyway_FAM_STRIDE * fam
                               + cc_skyway_P_CAP);
        }

        // The columns, ground to the underside of the crosshead.
        for (var side: i32 = 0; side < 2; side = side + 1) {
            let lc = select(-cc_skyway_PYL_OFF, cc_skyway_PYL_OFF, side == 1);
            var p = cc_skyway_clip(seed, lo3.x, ld3.x,
                                   s_n - cc_skyway_PYL_HW,
                                   s_n + cc_skyway_PYL_HW, 0);
            p = cc_skyway_clip(p, lo3.y, ld3.y,
                               lc - cc_skyway_PYL_HW,
                               lc + cc_skyway_PYL_HW, 1);
            p = cc_skyway_clip(p, lo3.z, ld3.z, 0.0, cap_bot, 2);
            if (p.t0 <= p.t1 && p.axis >= 0 && p.t0 < r.t) {
                r = cc_skyway_Best(p.t0,
                                   cc_skyway_normal(p.axis, p.sgn, 0.0, fam),
                                   cc_skyway_KIND_BASE
                                   + cc_skyway_FAM_STRIDE * fam
                                   + cc_skyway_P_PYL);
            }
        }
    }
    return r;
}

// One route line: the corridor reject, then the ribbon pieces and the pylons.
fn cc_skyway_route(o: vec3<f32>, dir: vec3<f32>, fam: i32, lat_c: f32,
                   tz0: f32, tz1: f32, period: f32,
                   best: cc_skyway_Best) -> cc_skyway_Best {
    var r = best;
    let lw = cc_skyway_swap(o, fam);
    let ld3 = cc_skyway_swap(dir, fam);
    // Lateral coordinates measured from the route's own centreline, so every
    // constant below is a half-width and the two families share the code.
    let lo3 = vec3<f32>(lw.x, lw.y - lat_c, lw.z);

    var ct0 = tz0;
    var ct1 = tz1;
    if (abs(ld3.y) > 1.0e-9) {
        let ta = (-cc_skyway_HW - lo3.y) / ld3.y;
        let tb = (cc_skyway_HW - lo3.y) / ld3.y;
        ct0 = max(ct0, min(ta, tb));
        ct1 = min(ct1, max(ta, tb));
    } else if (abs(lo3.y) > cc_skyway_HW) {
        return r;
    }
    if (ct0 > ct1 || ct0 >= r.t) {
        return r;
    }

    // The ribbon pieces clip from the z slab's entry, not the corridor's:
    // the deck's fascia and the outer faces of its rails lie ON the
    // corridor's lateral bounds, and a piece whose clip started at ct0 could
    // never raise its entry there, so it never learned the face it entered
    // by — and dropped the hit. From outside the corridor the fascia and the
    // rails' outer faces were not drawn at all; a ray went through to the
    // deck top or the soffit behind them (found by the collider's mirror
    // test, 2026-11). The corridor bound still rejects everything else.
    let raised = fam == 1;
    if (!raised) {
        // Flat from horizon to horizon.
        return cc_skyway_pylons(
            lo3, ld3, ct0, ct1, 0.0, false, fam,
            cc_skyway_ribbon(lo3, ld3, tz0, ct1,
                             -cc_skyway_FAR, cc_skyway_FAR,
                             0.0, cc_skyway_DECK_Z, 0.0, fam, r));
    }

    // Which crossing this corridor is near. For anything but a ray running
    // along the deck the corridor is metres long and this is exact; for one
    // that is, MC_SPAN picks the interchange ahead of the camera. Farther
    // crossings on the same line stay flat — 2 km down a deck, behind fog and
    // towers, and the pieces still tile the line with no gap.
    let tm = ct0 + 0.5 * min(ct1 - ct0, cc_skyway_MC_SPAN);
    let ac = round((lo3.x + tm * ld3.x) / period) * period;
    let e = cc_skyway_FLAT_HALF;
    let rp = cc_skyway_RAMP;
    let slope = (cc_skyway_HIGH_Z - cc_skyway_DECK_Z) / rp;

    // Five pieces sharing four end planes exactly: base, ramp up, high flat,
    // ramp down, base.
    r = cc_skyway_ribbon(lo3, ld3, tz0, ct1, -cc_skyway_FAR, ac - e - rp,
                         0.0, cc_skyway_DECK_Z, 0.0, fam, r);
    r = cc_skyway_ribbon(lo3, ld3, tz0, ct1, ac - e - rp, ac - e,
                         ac - e - rp, cc_skyway_DECK_Z, slope, fam, r);
    r = cc_skyway_ribbon(lo3, ld3, tz0, ct1, ac - e, ac + e,
                         0.0, cc_skyway_HIGH_Z, 0.0, fam, r);
    r = cc_skyway_ribbon(lo3, ld3, tz0, ct1, ac + e, ac + e + rp,
                         ac + e, cc_skyway_HIGH_Z, -slope, fam, r);
    r = cc_skyway_ribbon(lo3, ld3, tz0, ct1, ac + e + rp, cc_skyway_FAR,
                         0.0, cc_skyway_DECK_Z, 0.0, fam, r);
    return cc_skyway_pylons(lo3, ld3, ct0, ct1, ac, true, fam, r);
}

// `inv_dir` is the hook's, and deliberately unused: the core builds it with
// 1e30 standing in for a zero component, which is fine for an axis-aligned box
// but not for the sheared slab a ramp needs. Every divide below is guarded at
// the point of use instead.
fn cc_skyway_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>)
        -> CityHit {
    var miss: CityHit;
    miss.hit = false;
    miss.t = 1e30;
    miss.pos = vec3<f32>(0.0);
    miss.normal = vec3<f32>(0.0, 0.0, 1.0);
    miss.kind = 0;
    miss.cell = vec2<i32>(0);

    // Gate 1, and the one that pays for the component: everything skyway owns
    // lives between the ground and 35.1 m. A ray that never enters that slab
    // — every sky ray, every ray already above the deck and climbing — is
    // done in four operations.
    var tz0 = 1.0e-3;
    var tz1 = CITY_TRACE_RANGE;
    if (abs(dir.z) > 1.0e-9) {
        let ta = (0.0 - o.z) / dir.z;
        let tb = (cc_skyway_Z_TOP - o.z) / dir.z;
        tz0 = max(tz0, min(ta, tb));
        tz1 = min(tz1, max(ta, tb));
    } else if (o.z < 0.0 || o.z > cc_skyway_Z_TOP) {
        return miss;
    }
    if (tz0 >= tz1) {
        return miss;
    }

    let cell = u.ocean_params.x;
    let period = cc_skyway_ROUTE_BLOCKS * cell;
    var best = cc_skyway_Best(1e30, vec3<f32>(0.0, 0.0, 1.0), -1);

    for (var fam: i32 = 0; fam < 2; fam = fam + 1) {
        let ld3 = cc_skyway_swap(dir, fam);
        let lw = cc_skyway_swap(o, fam);
        let phase = select(0.0, cc_skyway_OFFSET_BLOCKS * cell, fam == 1);
        // The lateral interval the ray spans while inside the z slab, widened
        // by the deck half-width, converted straight into route indices. This
        // is the analytic step that replaces a loop over lines.
        let wa = lw.y + tz0 * ld3.y;
        let wb = lw.y + tz1 * ld3.y;
        let w_lo = min(wa, wb) - cc_skyway_HW;
        let w_hi = max(wa, wb) + cc_skyway_HW;
        let m_lo = i32(ceil((w_lo - phase) / period));
        let m_hi = i32(floor((w_hi - phase) / period));
        let n_cand = min(m_hi - m_lo + 1, 3);
        // Nearest first: with an opaque network that ordering is what makes
        // the three-line cap harmless.
        let step = select(-1, 1, ld3.y >= 0.0);
        let m_start = select(m_hi, m_lo, ld3.y >= 0.0);
        for (var k: i32 = 0; k < n_cand; k = k + 1) {
            let lat_c = phase + f32(m_start + k * step) * period;
            best = cc_skyway_route(o, dir, fam, lat_c, tz0, tz1, period, best);
        }
    }

    if (best.kind < 0) {
        return miss;
    }
    var res: CityHit;
    res.hit = true;
    res.t = best.t;
    res.pos = o + best.t * dir;
    res.normal = best.nrm;
    res.kind = best.kind;
    res.cell = vec2<i32>(floor(res.pos.xy / cell));
    return res;
}

fn cc_skyway_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let code = h.kind - cc_skyway_KIND_BASE;
    let fam = code / cc_skyway_FAM_STRIDE;
    let part = code % cc_skyway_FAM_STRIDE;
    let cell = u.ocean_params.x;
    let period = cc_skyway_ROUTE_BLOCKS * cell;
    let phase = select(0.0, cc_skyway_OFFSET_BLOCKS * cell, fam == 1);

    let lp = cc_skyway_swap(h.pos, fam);
    let lat = lp.y - (phase + round((lp.y - phase) / period) * period);
    let s = lp.x;

    let glow = city_glow_sample(h.pos.xy, 3.0);
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * glow);

    // A footprint for detail that runs ACROSS the deck rather than along it.
    //
    // `fp` is isotropic — the pixel angle times the range — but a deck is a
    // surface nobody looks at squarely, and at grazing incidence a pixel is
    // long in the along direction and unchanged in the lateral one. The two
    // families of detail here therefore do not share a footprint, and giving
    // them one is the mistake to avoid in both directions: charge the lane
    // lines the grazing factor and the paint dissolves five times too early
    // (their WIDTH is lateral and foreshortens not at all); charge the
    // expansion joints the plain `fp` and a transverse band that is a fifth
    // of a pixel still believes itself resolved, and crawls.
    //
    // So: lateral-extent detail (lane-line widths) keeps `fp`; along-extent
    // detail that is thin — the joints —
    // gets this. Clamped at 5x like `city_shade`'s window grid, because at
    // true grazing the exact factor stops meaning anything.
    //
    // Worth knowing when sizing any of these windows: `fp` is NOT the naive
    // pixel footprint. `pixel_angle` is `max(2*tan(fov/2)/width, u.periodic.z)`
    // and the LOD floor wins by 3.6x at 960 px with the app's default slider,
    // so every window below is exercised at 3.6x the range you would guess.
    let fp_eff = fp / clamp(abs(dot(dir, h.normal)), 0.20, 1.0);
    // The deck's top surface here, re-derived from the same profile the
    // tracer used — so heights measured against it (the rail's lamp band, the
    // fascia's depth) hold on the ramps as well as on the flats.
    let ztop = select(cc_skyway_DECK_Z,
                      cc_skyway_ztop(s, round(s / period) * period, true),
                      fam == 1);
    let duty = cc_skyway_STR_L / cc_skyway_STR_P;
    // The dash collapses into a continuous line of the same mean energy —
    // which is what a light string a kilometre off actually is.
    let str_lod = smoothstep(cc_skyway_STR_FP_LO, cc_skyway_STR_FP_HI, fp);
    let dash = select(0.0, 1.0, fract(s / cc_skyway_STR_P) < duty);
    let strength = mix(dash, duty, str_lod);

    // The expansion joint over the nearest pier, as a signed profile: -1 in
    // the slot, +1 on the comb plates, 0 on open deck. One round and two
    // compares, and it is shared by the running surface and the fascia so the
    // two agree on where a segment ends.
    let jd = abs(s - round(s / cc_skyway_PYL_SP) * cc_skyway_PYL_SP);
    let j_raw = select(select(0.0, 1.0, jd < cc_skyway_JNT_PLATE),
                       -1.0, jd < cc_skyway_JNT_GAP);
    // Its area mean over a bay, for the footprint where the assembly stops
    // being resolvable. Written from the same three constants the profile is,
    // so widening the slot cannot drift the two ends of the LOD apart.
    let j_mean = (2.0 * (cc_skyway_JNT_PLATE - cc_skyway_JNT_GAP)
                  - 2.0 * cc_skyway_JNT_GAP) / cc_skyway_PYL_SP;
    let joint = mix(j_raw, j_mean,
                    smoothstep(cc_skyway_JNT_FP_LO, cc_skyway_JNT_FP_HI, fp_eff));
    // Slot eats light, plate adds a little. Both are multipliers on whatever
    // is lighting the surface, so a joint in the dark stays dark.
    let j_mul = 1.0 + cc_skyway_JNT_STEEL * max(joint, 0.0)
                    + cc_skyway_JNT_DARK * min(joint, 0.0);

    // The strings' rhythm along the deck: scalloped under the individual
    // lamps, a between-lamp floor plus a pool, handed to the pattern's own
    // mean at the same footprint where the dashes themselves dissolve. The
    // wash across the road and the spill down the outside share it.
    let q = fract(s / cc_skyway_STR_P - 0.5 * duty);
    let dd = min(q, 1.0 - q) * cc_skyway_STR_P;
    let pool = exp(-dd * dd
                   / (2.0 * cc_skyway_SCALLOP_S * cc_skyway_SCALLOP_S));
    let pool_mean = 2.5066 * cc_skyway_SCALLOP_S / cc_skyway_STR_P;
    let rhythm = cc_skyway_SCALLOP
        + (1.0 - cc_skyway_SCALLOP) * mix(pool, pool_mean, str_lod);
    // The spill at this depth below the rail top (zero above it: the rail's
    // own top and the road are lit by the strip and the wash), joint-broken.
    let below = ztop + cc_skyway_RAIL_H - h.pos.z;
    let spill = cc_skyway_STR_COLOR
        * (cc_skyway_SPILL_AMP * rhythm * j_mul
           * exp(-max(below, 0.0) / cc_skyway_SPILL_E));

    if (part == cc_skyway_P_RAIL) {
        var face = 1.0;
        var outside = false;
        if (h.normal.z < 0.5) {
            let nl = cc_skyway_swap(h.normal, fam);
            // A face that looks across the deck, away from its centre line.
            // (A rail's end, at a joint between two pieces of ribbon, looks
            // along it, and is neither outside nor in.)
            outside = abs(nl.y) > 0.5 && nl.y * lat > 0.0;
            let side = select(cc_skyway_RAIL_FACE_IN,
                              cc_skyway_RAIL_FACE_OUT, outside);
            // Only the top band of the barrier carries the fixture.
            face = side * (1.0 - smoothstep(cc_skyway_RAIL_BAND * 0.5,
                                            cc_skyway_RAIL_BAND, below));
        }
        return cc_skyway_CONCRETE * fill
               + cc_skyway_STR_COLOR * (cc_skyway_STR_RAD * strength * face)
               + select(vec3<f32>(0.0), spill, outside);
    }

    if (part == cc_skyway_P_DECK) {
        // The wash: the strings' light across the deck, and the reason the
        // network reads as an artery from altitude. Exponential across, and
        // scalloped along under the individual lamps.
        let din = max(cc_skyway_HW - abs(lat), 0.0);
        let wash = exp(-din / cc_skyway_WASH_E) * rhythm;
        var e = cc_skyway_ASPHALT * fill
                + cc_skyway_STR_COLOR * (cc_skyway_WASH_AMP * wash);

        // Lane paint: a double centre line, dashed lane dividers, solid edge
        // lines. Sub-pixel almost everywhere, so it hands over to its own
        // area mean rather than shimmering.
        let aw = cc_skyway_PAINT_W;
        let al = abs(lat);
        var paint = 0.0;
        paint = paint + select(0.0, 1.0,
                               abs(al - cc_skyway_CENTRE_LINE) < aw);
        paint = paint + select(0.0, 1.0,
                               abs(al - cc_skyway_EDGE_LINE) < aw);
        paint = paint + select(0.0, 1.0,
                               abs(al - cc_skyway_LANE_DIV) < aw
                               && fract(s / cc_skyway_DASH_P)
                                  < cc_skyway_DASH_DUTY);
        let paint_mean = (4.0 * aw + 4.0 * aw
                          + 4.0 * aw * cc_skyway_DASH_DUTY)
                         / (2.0 * cc_skyway_HW);
        let paint_l = mix(paint, paint_mean,
                          smoothstep(cc_skyway_PAINT_FP_LO,
                                     cc_skyway_PAINT_FP_HI, fp));
        e = e + cc_skyway_STR_COLOR
                * (cc_skyway_PAINT_AMP * paint_l * (0.20 + wash));

        // The joint crosses the paint and the wash — a comb plate is bare
        // steel, so the lane line stops at it.
        return e * j_mul;
    }

    // Underside, fascia, pylons: near-black structure carrying the sodium
    // thrown up at it from the street directly below. The pools are the same
    // ones the ground draws, so an underside's scallops sit exactly over the
    // lamps that make them.
    let pools = city_street_pools(h.pos.xy);
    let district = city_glow_sample(h.pos.xy, 2.0);
    let street_scale = 0.20 + 2.2 * smoothstep(0.02, 0.45, district);
    var up = cc_skyway_UPLIGHT * pools * street_scale;
    var side_light = vec3<f32>(0.0);
    if (part == cc_skyway_P_PYL) {
        // Column: brightest at its foot, standing in the pool itself.
        up = up * exp(-max(h.pos.z, 0.0) / cc_skyway_PYL_UP_E);
    } else if (part == cc_skyway_P_CAP) {
        // Crosshead. It sits as high as the soffit but is not the soffit:
        // its own soffit faces the street squarely and catches the same
        // uplight, while its ends and sides are sheer. The 1.35 is the one
        // place this component brightens anything — a projecting beam catches
        // light on three faces where the flat soffit above it catches one,
        // and without it the caps read as holes rather than as hardware.
        up = up * select(0.45, 1.35, h.normal.z < -0.5)
                * exp(-max(h.pos.z, 0.0) / (2.0 * cc_skyway_PYL_UP_E));
    } else if (h.normal.z > -0.5) {
        // Fascia, not soffit: it faces sideways, so it catches much less of
        // the street's light — and the strip's spill from above, which runs
        // on down from the barrier's outside, carries the end of the deck's
        // expansion joint: the thing that says where one span stops and the
        // next starts when you are looking at it from the side.
        up = up * 0.35 * j_mul;
        side_light = spill;
    } else {
        // Soffit: the girders the deck is carried on, as shading rather than
        // as geometry — the read is entirely in the banding. The joint runs
        // across them, and being a real gap it is darker here than the ribs.
        let rib = 1.0 + cc_skyway_RIB
            * select(-1.0, 1.0, fract(s / cc_skyway_RIB_P) < 0.5);
        up = up * mix(rib, 1.0, smoothstep(0.0, cc_skyway_RIB_FP, fp)) * j_mul;
    }
    return cc_skyway_CONCRETE * fill + CITY_LAMP_COLOR * up + side_light;
}

// --- component: rooftopworks (rooftopworks.wgsl) ---
// rooftopworks — the machinery on the roofs.
//
// A skyline is not a row of clean rectangles. What separates a real one from
// an extruded-footprint one is the last two metres: water tanks, condenser
// banks, vent stacks, a lit penthouse, a parapet with a strip of light along
// it. From a kilometre out none of it is resolved and all of it matters —
// the roofline goes from a ruled edge to a serrated one, and the eye reads
// "buildings people work in" from the serration alone.
//
// RESPECT THE ARCHITECTURE (SPEC, the rule above all others here). Roof
// furniture needs a flat top to stand on:
//   * arch 0 (setback stack) — the full set, on EVERY tier top. A wedding
//     cake has three roofs, not one, and the lower ones are where the tanks
//     go. The tier standing on a deck is carried as a hole in it, so nothing
//     is ever placed inside the mass above.
//   * arch 2 (growth) — the main roof AND the cantilevered bud tops, which
//     are flat shelves hanging over the street and read beautifully with a
//     tank on them.
//   * arch 3 (tapered shaft) — the crown cap ONLY: the footprint scaled by
//     cc.fscale about the frustum's centre. The podium ledge is a metre of
//     sloped shoulder and gets nothing.
//   * arch 4 (spire crown) — NOTHING. Not one box, and the component returns
//     before it draws a hash.
//
// WHAT IS HERE, in the order it matters to the shot:
//
//   1. MECHANICAL CLUSTERS. 2-4 dark boxes per eligible roof: square water
//      tanks (3 x 3 x 4 m, with the rim band that makes them read as tanks
//      and not as crates), condenser rows (three 2 x 2 x 1 m units in a
//      line, sometimes doubled), vent stacks (1 x 1 x 5 m, in pairs). Dark:
//      their whole job at distance is silhouette. ~30% carry one warm
//      service lamp — a bulkhead light on the housing, radiance 2 — which is
//      what puts a few sparks up on the roofs above the core's windows.
//   2. PARAPET. A real low wall around the top deck of ~55% of buildings
//      (the core only fakes one by brightening the roof albedo near the
//      edge), and on ~12% of roofs overall a strip of light along its
//      coping: cool white, or the building's own house colour where it has
//      one. The wall is a hollow box — two slab tests, not four — and it is
//      deliberately NOT clipped to the DDA cell, because it belongs to the
//      building rather than to the cell: every member cell of a merged
//      superblock derives the same ring and catches whatever part of it
//      falls in its own ray segment.
//   3. PENTHOUSE CROWNS. ~20% of tall flat-topped buildings get a 2-3 storey
//      inset glass box on the roof, lit warm at 1.8. On a merged superblock
//      two of the four quadrant cells may carry one, so a big roof reads as
//      a plant room and a penthouse rather than as one centred lump.
//   4. HELIPADS. On the biggest flat roofs only (a merged superblock, or a
//      footprint over 60 m): a pad slab 0.3 m proud with four warm corner
//      lights at radiance 3. Rare on purpose — a helipad on every tower is
//      a video-game city.
//   5. EXTERNAL PIPEWORK. 1-3 risers, 0.4 m across, running down a facade
//      corner of 30-150 m buildings — the mid-rise band where services are
//      bolted on the outside rather than buried in a core. Dark with a faint
//      rim, gated to close range: it is a texture on the wall, not a
//      silhouette, and past ~230 m there is nothing there to resolve.
//
// DETAIL CALIBRATION (SPEC, global): wiper blades, not tire brands. A tank
// gets its rim band and its legs; a condenser row gets its unit gaps and
// grille bands. Nothing gets a logo, a warning label, or a hatch handle.
//
// COST. Every cell pays: two compares (built, arch 4) and one z-interval
// test against [lowest deck, roof + 12 m]. A cell whose ray segment misses
// that band — most of them, since most city pixels are looking at a wall or
// at the road — costs exactly that. Inside the band each piece has its own
// tighter z window and its own eligibility test BEFORE it draws a hash: the
// parapet's 1.25 m band, the clutter's 5 m one, and a crown that never
// hashes on a building too short to carry one. Worst case is 4 slots x 2
// boxes + 2 parapet + 1 crown = 11 slab tests, and that only on a large roof
// filling the segment; the typical accepted cell runs 3-4. Pipework adds one
// box behind a footprint gate that keeps it inside ~230 m.
//
// Measured on the harness (RTX 5080, CONTENDED — other agents and the pilot
// share the card, so these are upper bounds), 960x540 x 48 passes, A/B by
// toggling `enabled` and interleaving the runs: a downward view over a
// district of roofs costs 0.16 s off / 0.18 s on, and the 900 m `base` view
// 0.28 s off / 0.33 s on — call it 12-18% of the city frame where roofs fill
// the screen. A street-level view, where the roof band is behind the walls,
// measures 0.13 s either way. The parapet is the widest-reaching piece: two
// slab tests on nearly every roof cell a downward ray visits, and that IS
// where the money goes. It buys a wall that is actually there.

// --- kinds (kind_base 600, local 0..15) -------------------------------------
// 600 + slot  mechanical body        604 + slot  its accessory piece
const cc_rooftopworks_K_MECH: i32 = 600;
const cc_rooftopworks_K_ACC: i32 = 604;
const cc_rooftopworks_K_PARAPET: i32 = 608;
const cc_rooftopworks_K_PENT: i32 = 609;
const cc_rooftopworks_K_PAD: i32 = 611;
const cc_rooftopworks_K_PIPE: i32 = 612;

// --- mechanical clusters ----------------------------------------------------
const cc_rooftopworks_MECH_FRAC: f32 = 0.86;   // buildings with any clutter
// Slot occupancy. Slot 0 is unconditional on a deck that fits it; the rest
// thin out, so the modal roof carries two or three objects and a big one
// four. Confetti is the failure mode being avoided here: a roof with a
// uniform sprinkle of boxes reads as noise, a roof with a tank, a condenser
// row and a gap reads as a roof.
const cc_rooftopworks_SLOT_P1: f32 = 0.88;
const cc_rooftopworks_SLOT_P2: f32 = 0.62;
const cc_rooftopworks_SLOT_P3: f32 = 0.34;
const cc_rooftopworks_TANK_CUT: f32 = 0.38;    // type draw: tank below this
const cc_rooftopworks_AC_CUT: f32 = 0.76;      // condenser row below this
const cc_rooftopworks_TANK_HW: f32 = 1.50;     // 3 x 3 m
const cc_rooftopworks_TANK_H: f32 = 4.00;
const cc_rooftopworks_TANK_RIM_HW: f32 = 1.78;
const cc_rooftopworks_TANK_RIM_T: f32 = 0.38;
const cc_rooftopworks_AC_HL: f32 = 3.60;       // three 2 m units, 2.6 pitch
const cc_rooftopworks_AC_HW: f32 = 1.00;
const cc_rooftopworks_AC_H: f32 = 1.00;
const cc_rooftopworks_AC_ROW: f32 = 3.10;      // second row offset
const cc_rooftopworks_AC_P2: f32 = 0.45;       // draw above this: doubled row
const cc_rooftopworks_VENT_HW: f32 = 0.50;
const cc_rooftopworks_VENT_H: f32 = 5.00;
const cc_rooftopworks_VENT2_H: f32 = 3.40;
const cc_rooftopworks_VENT_GAP: f32 = 1.70;
const cc_rooftopworks_EDGE_M: f32 = 1.10;      // keep off the parapet line
// Close-range refinement (SPEC's SDF-in-a-box). A tank is the one object here
// the camera can end up standing next to, and a bare box is exactly what a
// bare box looks like. Inside its envelope, and only inside it, the tank is
// sphere-traced: a rounded tub on four legs with a chamfered rim band. The
// rounding is the point — rays graze past the corners and the silhouette
// stops being a rectangle. 42 m at the harness lens, so the wide scene pays
// one box test and nothing else.
const cc_rooftopworks_SDF_FP: f32 = 0.22;
const cc_rooftopworks_SDF_ITERS: i32 = 24;
const cc_rooftopworks_TANK_LEG: f32 = 0.55;    // stand-off from the deck
const cc_rooftopworks_TANK_R: f32 = 0.20;      // corner rounding
const cc_rooftopworks_LAMP_FRAC: f32 = 0.30;
const cc_rooftopworks_LAMP_RAD: f32 = 2.0;
const cc_rooftopworks_LAMP_SIG: f32 = 0.30;    // source radius (m)
const cc_rooftopworks_LAMP_SPILL: f32 = 1.70;  // what the housing catches (m)
const cc_rooftopworks_LAMP_COL: vec3<f32> = vec3<f32>(1.00, 0.58, 0.24);
const cc_rooftopworks_MECH_ALBEDO: f32 = 0.140;

// --- parapet ----------------------------------------------------------------
const cc_rooftopworks_PAR_FRAC: f32 = 0.55;    // roofs with a real wall
const cc_rooftopworks_PAR_LIT: f32 = 0.21;     // ...of which lit (~12% of roofs)
const cc_rooftopworks_PAR_H: f32 = 1.25;
const cc_rooftopworks_PAR_W: f32 = 0.38;
const cc_rooftopworks_PAR_TRIM: f32 = 0.28;    // lit band under the coping
const cc_rooftopworks_TRIM_RAD: f32 = 1.20;
const cc_rooftopworks_TRIM_COOL: vec3<f32> = vec3<f32>(0.72, 0.86, 1.00);
const cc_rooftopworks_TRIM_PITCH: f32 = 6.50;  // fixture centres (m)
const cc_rooftopworks_TRIM_DUTY: f32 = 0.82;   // lit fraction of the run
// The trim is a 0.28 m band on a 1.25 m wall: past this footprint the band is
// thinner than a pixel and hands over to its mean over the whole wall face,
// which is the same energy spread out. Nothing switches off (SPEC rule 3).
const cc_rooftopworks_TRIM_LOD_START: f32 = 1.60;
const cc_rooftopworks_TRIM_LOD_FULL: f32 = 4.00;
const cc_rooftopworks_TRIM_MEAN_COMP: f32 = 0.20;  // see PENT_MEAN_COMP

// --- penthouse --------------------------------------------------------------
const cc_rooftopworks_PENT_FRAC: f32 = 0.20;
const cc_rooftopworks_PENT_MIN_H: f32 = 105.0; // "tall": tower, not mid-rise
const cc_rooftopworks_PENT_MIN_DECK: f32 = 15.0;
const cc_rooftopworks_PENT_INSET: f32 = 0.28;
const cc_rooftopworks_PENT_RAD: f32 = 1.80;
const cc_rooftopworks_PENT_COL: vec3<f32> = vec3<f32>(1.00, 0.72, 0.42);
const cc_rooftopworks_PENT_PITCH: f32 = 2.10;  // mullion pitch (m)
const cc_rooftopworks_PENT_MULL: f32 = 0.13;   // dark fraction of the pitch
const cc_rooftopworks_PENT_SILL: f32 = 0.80;   // dark spandrel at its foot
const cc_rooftopworks_PENT_LIT: f32 = 0.58;    // bays with the light on
// Tone-map compensation on the far-field means (the core's facade now
// averages in display space instead, city_windows_seen): a
// mean taken in linear radiance ahead of a Reinhard curve renders CREAM,
// because a lit bay at 1.8 is already near the knee and its average is not.
// Solved rather than guessed: match tone(mean * E) to lit_frac * tone(B * E)
// at E = 6, which puts the coefficient near a quarter.
const cc_rooftopworks_PENT_MEAN_COMP: f32 = 0.26;

// --- helipad ----------------------------------------------------------------
const cc_rooftopworks_PAD_FRAC: f32 = 0.13;
const cc_rooftopworks_PAD_BIG: f32 = 60.0;     // footprint that qualifies
const cc_rooftopworks_PAD_MIN_H: f32 = 55.0;   // and a building worth landing on
const cc_rooftopworks_PAD_T: f32 = 0.30;
const cc_rooftopworks_PAD_LAMP_RAD: f32 = 3.00;
const cc_rooftopworks_PAD_LAMP_SIG: f32 = 0.26;
const cc_rooftopworks_PAD_LAMP_COL: vec3<f32> = vec3<f32>(1.00, 0.66, 0.30);
const cc_rooftopworks_PAD_MARK: f32 = 0.34;    // paint albedo (a ring + bar)

// --- pipework ---------------------------------------------------------------
const cc_rooftopworks_PIPE_FRAC: f32 = 0.45;
const cc_rooftopworks_PIPE_H_LO: f32 = 30.0;
const cc_rooftopworks_PIPE_H_HI: f32 = 150.0;
const cc_rooftopworks_PIPE_D: f32 = 0.40;      // one riser
const cc_rooftopworks_PIPE_GAP: f32 = 0.18;
const cc_rooftopworks_PIPE_OUT: f32 = 0.42;    // stand-off from the wall
const cc_rooftopworks_PIPE_CORNER: f32 = 1.20; // in from the building corner
// Footprint gate: a 0.4 m riser at 1.5 m/px is a quarter pixel of dark line
// on a lit wall and contributes nothing but cost. The emission and the
// contrast ramp to the wall's own value over the run-up, so it dissolves
// rather than pops.
const cc_rooftopworks_PIPE_FP: f32 = 1.20;
const cc_rooftopworks_PIPE_FADE: f32 = 0.75;

// Headroom above the main roof that everything here fits under: a 3-storey
// penthouse is the tallest thing (10.8 m).
const cc_rooftopworks_HEADROOM: f32 = 12.0;

fn cc_rooftopworks_miss(ci: vec2<i32>) -> CityHit {
    return CityHit(false, 1e30, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0),
                   0, ci);
}

// Nearest-hit accumulator over one box. Every piece of geometry in this file
// except the parapet ring goes through here, which is also where the segment
// discipline lives: a hit outside [t0, t1] belongs to another cell's visit
// and must not be returned, because the core's DDA stops the moment a cell
// reports anything.
fn cc_rooftopworks_box(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                       inv_dir: vec3<f32>, t0: f32, t1: f32,
                       bmin: vec3<f32>, bmax: vec3<f32>, kind: i32,
                       ci: vec2<i32>) -> CityHit {
    let s = city_box_hit(o, inv_dir, bmin, bmax);
    if (s.x <= s.y && s.x > max(t0, 1e-3) && s.x <= t1 && s.x < best.t) {
        let p = o + s.x * dir;
        return CityHit(true, s.x, p, city_box_normal(p, bmin, bmax), kind,
                       ci);
    }
    return best;
}

fn cc_rooftopworks_overlap(alo: vec2<f32>, ahi: vec2<f32>,
                           blo: vec2<f32>, bhi: vec2<f32>) -> bool {
    return alo.x < bhi.x && ahi.x > blo.x && alo.y < bhi.y && ahi.y > blo.y;
}

// The DDA cell's own column in world xy. Per-cell-hashed props are placed
// inside it so that the cell that draws a thing is the cell that contains it
// — which is what the DDA requires, and what gives a merged superblock four
// independently furnished quadrants instead of one roof drawn four times.
fn cc_rooftopworks_column(ci: vec2<i32>) -> vec4<f32> {
    let cell = u.ocean_params.x;
    let cmin = vec2<f32>(ci) * cell;
    return vec4<f32>(cmin, cmin + vec2<f32>(cell, cell));
}

// --- decks ------------------------------------------------------------------
// A flat top you may stand something on: its rect, its height, and the hole
// punched in it by whatever tier stands on it.
struct cc_rooftopworks_Deck {
    ok: bool,
    lo: vec2<f32>,
    hi: vec2<f32>,
    z: f32,
    hlo: vec2<f32>,
    hhi: vec2<f32>,
}

fn cc_rooftopworks_no_deck() -> cc_rooftopworks_Deck {
    return cc_rooftopworks_Deck(false, vec2<f32>(0.0), vec2<f32>(0.0), 0.0,
                                vec2<f32>(1e30), vec2<f32>(-1e30));
}

fn cc_rooftopworks_mk_deck(lo: vec2<f32>, hi: vec2<f32>, z: f32,
                           hlo: vec2<f32>, hhi: vec2<f32>)
        -> cc_rooftopworks_Deck {
    return cc_rooftopworks_Deck(true, lo, hi, z, hlo, hhi);
}

// Deck `i` of this building, index 0 being the topmost. This function IS the
// architecture rule; everything else in the file only asks it for a rect.
fn cc_rooftopworks_deck(cc: CityCell, i: i32) -> cc_rooftopworks_Deck {
    let nohole_lo = vec2<f32>(1e30);
    let nohole_hi = vec2<f32>(-1e30);
    if (cc.arch == 4) {
        return cc_rooftopworks_no_deck();   // a spire has no roof. Ever.
    }
    if (cc.arch == 3) {
        // The crown cap of the tapered shaft: the frustum's cross-section at
        // its top, which is the base rect scaled by fscale about its centre.
        if (i != 0) {
            return cc_rooftopworks_no_deck();
        }
        let c = 0.5 * (cc.fmin.xy + cc.fmax.xy);
        let hf = 0.5 * (cc.fmax.xy - cc.fmin.xy) * cc.fscale;
        return cc_rooftopworks_mk_deck(c - hf, c + hf, cc.fmax.z,
                                       nohole_lo, nohole_hi);
    }
    if (cc.arch == 2) {
        // Growth: the main roof, plus each cantilevered bud's top. The buds
        // overlap the main mass by a metre at their root and punch no hole
        // in it (they hang below the roof), so no holes here either.
        if (i == 0) {
            return cc_rooftopworks_mk_deck(cc.b1min.xy, cc.b1max.xy,
                                           cc.b1max.z, nohole_lo, nohole_hi);
        }
        if (i == 1 && cc.tiers >= 2) {
            return cc_rooftopworks_mk_deck(cc.b2min.xy, cc.b2max.xy,
                                           cc.b2max.z, nohole_lo, nohole_hi);
        }
        if (i == 2 && cc.tiers >= 3) {
            return cc_rooftopworks_mk_deck(cc.b3min.xy, cc.b3max.xy,
                                           cc.b3max.z, nohole_lo, nohole_hi);
        }
        return cc_rooftopworks_no_deck();
    }
    // Setback stack. Deck 0 is the summit; the ones below it are annular,
    // and carry the tier above as their hole.
    if (cc.tiers == 1) {
        if (i == 0) {
            return cc_rooftopworks_mk_deck(cc.b1min.xy, cc.b1max.xy,
                                           cc.b1max.z, nohole_lo, nohole_hi);
        }
        return cc_rooftopworks_no_deck();
    }
    if (cc.tiers == 2) {
        if (i == 0) {
            return cc_rooftopworks_mk_deck(cc.b2min.xy, cc.b2max.xy,
                                           cc.b2max.z, nohole_lo, nohole_hi);
        }
        if (i == 1) {
            return cc_rooftopworks_mk_deck(cc.b1min.xy, cc.b1max.xy,
                                           cc.b1max.z, cc.b2min.xy,
                                           cc.b2max.xy);
        }
        return cc_rooftopworks_no_deck();
    }
    if (i == 0) {
        return cc_rooftopworks_mk_deck(cc.b3min.xy, cc.b3max.xy, cc.b3max.z,
                                       nohole_lo, nohole_hi);
    }
    if (i == 1) {
        return cc_rooftopworks_mk_deck(cc.b2min.xy, cc.b2max.xy, cc.b2max.z,
                                       cc.b3min.xy, cc.b3max.xy);
    }
    if (i == 2) {
        return cc_rooftopworks_mk_deck(cc.b1min.xy, cc.b1max.xy, cc.b1max.z,
                                       cc.b2min.xy, cc.b2max.xy);
    }
    return cc_rooftopworks_no_deck();
}

// The lowest deck this building owns: the bottom of the z band the whole
// roof section gates on. For a setback stack that is the first tier's top,
// for a growth tower the lower bud, otherwise the roof itself.
fn cc_rooftopworks_deck_low(cc: CityCell) -> f32 {
    var z = cc.height;
    if (cc.arch != 3 && cc.tiers >= 2) {
        z = min(z, min(cc.b1max.z, cc.b2max.z));
        if (cc.tiers >= 3) {
            z = min(z, cc.b3max.z);
        }
    }
    return z;
}

// --- the crown: a penthouse, or a helipad, or neither -----------------------
struct cc_rooftopworks_Crown {
    kind: i32,   // 0 none, 1 penthouse, 2 helipad
    lo: vec2<f32>,
    hi: vec2<f32>,
    z0: f32,
    z1: f32,
}

fn cc_rooftopworks_crown(cc: CityCell, ci: vec2<i32>)
        -> cc_rooftopworks_Crown {
    var res: cc_rooftopworks_Crown;
    res.kind = 0;
    res.lo = vec2<f32>(1e30);
    res.hi = vec2<f32>(-1e30);
    res.z0 = 0.0;
    res.z1 = 0.0;
    let d = cc_rooftopworks_deck(cc, 0);
    if (!d.ok) {
        return res;
    }
    let col = cc_rooftopworks_column(ci);
    let rlo = max(d.lo, col.xy);
    let rhi = min(d.hi, col.zw);
    let size = rhi - rlo;
    if (min(size.x, size.y) < cc_rooftopworks_PENT_MIN_DECK) {
        return res;
    }
    // Eligibility before entropy: a building too short for either a
    // penthouse or a pad never draws a hash. This is the gate that keeps the
    // low-rise majority of the tile out of the crown's cost entirely.
    let foot0 = max(d.hi.x - d.lo.x, d.hi.y - d.lo.y);
    let pad_size = cc.merged || foot0 > cc_rooftopworks_PAD_BIG;
    if (cc.height <= cc_rooftopworks_PENT_MIN_H
        && !(pad_size && cc.height > cc_rooftopworks_PAD_MIN_H)) {
        return res;
    }
    // Building-level draws (shared by every cell of a merged group) decide
    // WHETHER; a cell-level draw decides the shape, so the two penthouses on
    // a superblock are not identical twins.
    let gh = city_rand4(cc.seed ^ vec2<u32>(0x1b56c4e9u, 0x0d2f1a37u));
    // Tile-wrapped, like every cell-index draw (city_tile_cell); the
    // quadrant test below is wrap-invariant on its own (n is even).
    let cw = city_tile_cell(ci);
    let lh = city_rand4(vec2<u32>(
        bitcast<u32>(cw.x) * 0x9e3779b9u + 0x2545f491u,
        bitcast<u32>(cw.y) * 0x85ebca6bu + 0x27d4eb2fu));
    // Helipad first: it wants the same real estate and it is the rarer
    // thing. A building gets one pad, in the member cell under a point of
    // its top deck that the building-level draw picks — lots span up to 4x4
    // and a tower's crown covers only some of their cells, so neither a
    // parity rule nor a pick among the lot's cells would do.
    let pad_at = mix(d.lo, d.hi, vec2<f32>(0.25) + 0.5 * gh.zw);
    let pad_here = all(ci == vec2<i32>(floor(pad_at / u.ocean_params.x)));
    if (pad_size && pad_here
        && cc.height > cc_rooftopworks_PAD_MIN_H
        && gh.x < cc_rooftopworks_PAD_FRAC) {
        let half = clamp(0.30 * min(size.x, size.y), 4.5, 11.0);
        let c = mix(rlo + half + 1.0, rhi - half - 1.0,
                    vec2<f32>(0.30 + 0.40 * lh.x, 0.30 + 0.40 * lh.y));
        let plo = c - half;
        let phi = c + half;
        // Not on top of the mast, and not hanging over the hole.
        let clear_mast = !cc.has_mast
            || !cc_rooftopworks_overlap(plo, phi, cc.mast_min.xy - 1.0,
                                        cc.mast_max.xy + 1.0);
        if (clear_mast && !cc_rooftopworks_overlap(plo, phi, d.hlo, d.hhi)) {
            res.kind = 2;
            res.lo = plo;
            res.hi = phi;
            res.z0 = d.z;
            res.z1 = d.z + cc_rooftopworks_PAD_T;
            return res;
        }
    }
    // Penthouse. On a multi-block roof only a checkerboard of its cells may
    // carry one, so neighbouring penthouses never share a party wall.
    let pent_here = !cc.merged || ((ci.x + ci.y) & 1) == 0;
    if (cc.height > cc_rooftopworks_PENT_MIN_H && pent_here
        && gh.y < cc_rooftopworks_PENT_FRAC) {
        let inset = max(cc_rooftopworks_PENT_INSET * min(size.x, size.y), 3.0);
        let plo = rlo + inset;
        let phi = rhi - inset;
        if (min(phi.x - plo.x, phi.y - plo.y) > 6.0
            && !cc_rooftopworks_overlap(plo, phi, d.hlo, d.hhi)) {
            res.kind = 1;
            res.lo = plo;
            res.hi = phi;
            res.z0 = d.z;
            res.z1 = d.z + select(7.2, 10.8, lh.z > 0.45);
            return res;
        }
    }
    return res;
}

// --- mechanical clusters ----------------------------------------------------
struct cc_rooftopworks_Mech {
    ok: bool,
    lo: vec3<f32>,
    hi: vec3<f32>,
    has_acc: bool,
    alo: vec3<f32>,
    ahi: vec3<f32>,
    kind: i32,         // 0 tank, 1 condenser row, 2 vent stacks
    lamp: bool,
    seat: vec3<f32>,   // the service lamp's own position
}

fn cc_rooftopworks_no_mech() -> cc_rooftopworks_Mech {
    return cc_rooftopworks_Mech(false, vec3<f32>(0.0), vec3<f32>(0.0), false,
                                vec3<f32>(0.0), vec3<f32>(0.0), 0, false,
                                vec3<f32>(0.0));
}

// Does this building carry rooftop clutter at all? One building-level draw,
// hoisted out of the slot loop so a cell pays it once rather than four times.
fn cc_rooftopworks_mech_on(cc: CityCell) -> bool {
    let gh = city_rand4(cc.seed ^ vec2<u32>(0x3c6ef372u, 0x165667b1u));
    return gh.w < cc_rooftopworks_MECH_FRAC;
}

fn cc_rooftopworks_slot_draw(ci: vec2<i32>, s: i32) -> vec4<f32> {
    let cw = city_tile_cell(ci);
    let l = u32(s);
    return city_rand4(vec2<u32>(
        bitcast<u32>(cw.x) * 0x85ebca6bu + l * 0x9e3779b9u + 0x7feb352du,
        bitcast<u32>(cw.y) * 0xc2b2ae35u + l * 0x51ed270bu + 0x846ca68bu));
}

// Slot `s` of cell `ci`: which deck it stands on, where, and what it is.
// Deterministic in (cc, ci, s), so the shader re-derives the object from the
// hit kind alone — nothing is smuggled through CityHit.
fn cc_rooftopworks_mech(cc: CityCell, ci: vec2<i32>, s: i32,
                        mech_on: bool, cr: cc_rooftopworks_Crown)
        -> cc_rooftopworks_Mech {
    if (!mech_on) {
        return cc_rooftopworks_no_mech();
    }
    let r = cc_rooftopworks_slot_draw(ci, s);
    var p_slot = 1.0;
    if (s == 1) { p_slot = cc_rooftopworks_SLOT_P1; }
    if (s == 2) { p_slot = cc_rooftopworks_SLOT_P2; }
    if (s == 3) { p_slot = cc_rooftopworks_SLOT_P3; }
    if (r.x >= p_slot) {
        return cc_rooftopworks_no_mech();
    }
    // Slots 0 and 1 take the summit; 2 and 3 look for a lower tier top or a
    // bud, and fall back to the summit when the building has none.
    var di = 0;
    if (s == 2) { di = 1; }
    if (s == 3) { di = 2; }
    var d = cc_rooftopworks_deck(cc, di);
    if (!d.ok) {
        d = cc_rooftopworks_deck(cc, 0);
    }
    if (!d.ok) {
        return cc_rooftopworks_no_mech();
    }

    // Type and footprint.
    var hx = vec2<f32>(cc_rooftopworks_TANK_HW);
    var hgt = cc_rooftopworks_TANK_H;
    var ty = 0;
    let axis_y = r.w > 0.5;
    if (r.y >= cc_rooftopworks_TANK_CUT && r.y < cc_rooftopworks_AC_CUT) {
        ty = 1;
        let along = cc_rooftopworks_AC_HL;
        let across = select(cc_rooftopworks_AC_HW,
                            cc_rooftopworks_AC_HW + 0.5 * cc_rooftopworks_AC_ROW,
                            r.z > cc_rooftopworks_AC_P2);
        hx = select(vec2<f32>(along, across), vec2<f32>(across, along),
                    axis_y);
        hgt = cc_rooftopworks_AC_H;
    } else if (r.y >= cc_rooftopworks_AC_CUT) {
        ty = 2;
        let along = cc_rooftopworks_VENT_HW + 0.5 * cc_rooftopworks_VENT_GAP;
        hx = select(vec2<f32>(along, cc_rooftopworks_VENT_HW),
                    vec2<f32>(cc_rooftopworks_VENT_HW, along), axis_y);
        hgt = cc_rooftopworks_VENT_H;
    }

    // Where it may stand: the deck, inset off the parapet line, clipped to
    // this cell's own column.
    let col = cc_rooftopworks_column(ci);
    let m = hx + cc_rooftopworks_EDGE_M + cc_rooftopworks_PAR_W;
    let plo = max(d.lo + m, col.xy + m - cc_rooftopworks_EDGE_M);
    let phi = min(d.hi - m, col.zw - m + cc_rooftopworks_EDGE_M);
    if (plo.x > phi.x || plo.y > phi.y) {
        return cc_rooftopworks_no_mech();   // deck too small for this object
    }
    let c = mix(plo, phi, vec2<f32>(fract(r.z * 13.7), fract(r.w * 7.31)));
    let lo2 = c - hx;
    let hi2 = c + hx;
    // Three exclusions, all cheap rect tests: the tier standing on this deck,
    // the mast, and whatever the crown put here.
    if (cc_rooftopworks_overlap(lo2, hi2, d.hlo - 1.0, d.hhi + 1.0)) {
        return cc_rooftopworks_no_mech();
    }
    if (cc.has_mast && abs(d.z - cc.height) < 0.5
        && cc_rooftopworks_overlap(lo2, hi2, cc.mast_min.xy - 0.8,
                                   cc.mast_max.xy + 0.8)) {
        return cc_rooftopworks_no_mech();
    }
    if (cr.kind != 0 && abs(d.z - cc.height) < 0.5
        && cc_rooftopworks_overlap(lo2, hi2, cr.lo - 1.5, cr.hi + 1.5)) {
        return cc_rooftopworks_no_mech();
    }

    var res: cc_rooftopworks_Mech;
    res.ok = true;
    res.lo = vec3<f32>(lo2, d.z);
    res.hi = vec3<f32>(hi2, d.z + hgt);
    res.kind = ty;
    res.has_acc = false;
    res.alo = vec3<f32>(0.0);
    res.ahi = vec3<f32>(0.0);
    if (ty == 0) {
        // The rim band: a tank without one is a crate.
        res.has_acc = true;
        let rw = vec2<f32>(cc_rooftopworks_TANK_RIM_HW);
        res.alo = vec3<f32>(c - rw,
                            d.z + hgt - cc_rooftopworks_TANK_RIM_T);
        res.ahi = vec3<f32>(c + rw, d.z + hgt + 0.10);
    } else if (ty == 2) {
        // A second, shorter stack beside the first.
        res.has_acc = true;
        let off = select(vec2<f32>(cc_rooftopworks_VENT_GAP, 0.0),
                         vec2<f32>(0.0, cc_rooftopworks_VENT_GAP), axis_y);
        res.alo = vec3<f32>(c + off - cc_rooftopworks_VENT_HW, d.z);
        res.ahi = vec3<f32>(c + off + cc_rooftopworks_VENT_HW,
                            d.z + cc_rooftopworks_VENT2_H);
        res.lo = vec3<f32>(c - off - cc_rooftopworks_VENT_HW, d.z);
        res.hi = vec3<f32>(c - off + cc_rooftopworks_VENT_HW, d.z + hgt);
    }
    // One warm bulkhead light on the housing, on the face the draw picks.
    res.lamp = fract(r.x * 31.7) < cc_rooftopworks_LAMP_FRAC;
    let face = fract(r.y * 17.3);
    var n = vec2<f32>(1.0, 0.0);
    if (face > 0.75) { n = vec2<f32>(-1.0, 0.0); }
    else if (face > 0.50) { n = vec2<f32>(0.0, 1.0); }
    else if (face > 0.25) { n = vec2<f32>(0.0, -1.0); }
    res.seat = vec3<f32>(c + n * (hx + 0.04), d.z + 0.72 * hgt);
    return res;
}

// --- the tank, close up: SDF in a box ---------------------------------------
fn cc_rooftopworks_rbox(p: vec3<f32>, b: vec3<f32>, r: f32) -> f32 {
    let q = abs(p) - b;
    return length(max(q, vec3<f32>(0.0)))
         + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}

// The tank in its own frame: origin at the centre of its footprint, z from
// the deck it stands on. Tub, rim band, four legs — the functional features
// and nothing below them (SPEC: wiper blades, not tire brands).
fn cc_rooftopworks_tank_sdf(p: vec3<f32>) -> f32 {
    let hw = cc_rooftopworks_TANK_HW;
    let hh = cc_rooftopworks_TANK_H;
    let leg = cc_rooftopworks_TANK_LEG;
    let r = cc_rooftopworks_TANK_R;
    let bz1 = hh - cc_rooftopworks_TANK_RIM_T;
    let body = cc_rooftopworks_rbox(
        p - vec3<f32>(0.0, 0.0, 0.5 * (leg + bz1)),
        vec3<f32>(hw - r, hw - r, max(0.5 * (bz1 - leg) - r, 0.05)), r);
    let rim = cc_rooftopworks_rbox(
        p - vec3<f32>(0.0, 0.0, hh - 0.5 * cc_rooftopworks_TANK_RIM_T),
        vec3<f32>(cc_rooftopworks_TANK_RIM_HW - 0.10,
                  cc_rooftopworks_TANK_RIM_HW - 0.10,
                  0.5 * cc_rooftopworks_TANK_RIM_T - 0.04), 0.07);
    // Four legs, folded into one quadrant by the absolute value.
    let legs = cc_rooftopworks_rbox(
        vec3<f32>(abs(p.xy) - vec2<f32>(hw - 0.32), p.z - 0.5 * leg),
        vec3<f32>(0.13, 0.13, 0.5 * leg), 0.04);
    return min(min(body, rim), legs);
}

fn cc_rooftopworks_tank_normal(p: vec3<f32>) -> vec3<f32> {
    let e = vec2<f32>(1.2e-3, -1.2e-3);
    // @domain: the SDF's gradient at a surface point: nonzero off the medial axis
    return normalize(
        e.xyy * cc_rooftopworks_tank_sdf(p + e.xyy)
      + e.yyx * cc_rooftopworks_tank_sdf(p + e.yyx)
      + e.yxy * cc_rooftopworks_tank_sdf(p + e.yxy)
      + e.xxx * cc_rooftopworks_tank_sdf(p + e.xxx));
}

// Sphere-trace the tank between the entry and exit of its envelope box.
// Returns the hit t, or -1 when the ray threads past the rounded hull —
// which is what makes the hull read as rounded.
fn cc_rooftopworks_tank_trace(o: vec3<f32>, dir: vec3<f32>, t_in: f32,
                              t_out: f32, base: vec3<f32>) -> f32 {
    var t = max(t_in, 0.0) + 1.0e-3;
    for (var i: i32 = 0; i < cc_rooftopworks_SDF_ITERS; i = i + 1) {
        if (t > t_out) {
            return -1.0;
        }
        let d = cc_rooftopworks_tank_sdf(o + t * dir - base);
        if (d < 2.0e-3) {
            return t;
        }
        t = t + max(d, 3.0e-3);
    }
    return -1.0;
}

// One mechanical object against the segment: two slab tests far out, the
// sphere-traced hull for a tank close in.
fn cc_rooftopworks_mech_hit(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                            inv_dir: vec3<f32>, t0: f32, t1: f32,
                            m: cc_rooftopworks_Mech, s: i32, ci: vec2<i32>,
                            fp: f32) -> CityHit {
    if (m.kind == 0 && fp < cc_rooftopworks_SDF_FP) {
        let elo = min(m.lo, m.alo);
        let ehi = max(m.hi, m.ahi);
        let sb = city_box_hit(o, inv_dir, elo, ehi);
        if (sb.x > sb.y || sb.y <= max(t0, 1e-3) || sb.x > t1) {
            return best;
        }
        let base = vec3<f32>(0.5 * (m.lo.xy + m.hi.xy), m.lo.z);
        let t = cc_rooftopworks_tank_trace(o, dir, max(sb.x, t0),
                                           min(sb.y, t1), base);
        if (t < 0.0 || t > t1 || t <= max(t0, 1e-3) || t >= best.t) {
            return best;
        }
        let p = o + t * dir;
        // The rim band keeps its own kind, so the shader still gives it the
        // galvanised albedo it had when it was a separate box.
        let is_rim = p.z > m.hi.z - cc_rooftopworks_TANK_RIM_T - 0.02;
        return CityHit(true, t, p,
                       cc_rooftopworks_tank_normal(p - base),
                       select(cc_rooftopworks_K_MECH, cc_rooftopworks_K_ACC,
                              is_rim) + s, ci);
    }
    var r = cc_rooftopworks_box(best, o, dir, inv_dir, t0, t1, m.lo, m.hi,
                                cc_rooftopworks_K_MECH + s, ci);
    if (m.has_acc) {
        r = cc_rooftopworks_box(r, o, dir, inv_dir, t0, t1, m.alo, m.ahi,
                                cc_rooftopworks_K_ACC + s, ci);
    }
    return r;
}

// --- the parapet ring -------------------------------------------------------
// A hollow box: outer minus inner, two slab tests. Both rects are the
// BUILDING's, not the cell's — see the header note — and correctness comes
// from accepting only a hit inside this visit's ray segment.
fn cc_rooftopworks_has_parapet(cc: CityCell) -> vec2<f32> {
    // .x: does the wall exist. .y: is its coping lit.
    let gh = city_rand4(cc.seed ^ vec2<u32>(0x9e3779b9u, 0x68e31da4u));
    return vec2<f32>(gh.x, gh.y);
}

fn cc_rooftopworks_parapet(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                           inv_dir: vec3<f32>, t0: f32, t1: f32,
                           d: cc_rooftopworks_Deck, ci: vec2<i32>)
        -> CityHit {
    let omin = vec3<f32>(d.lo, d.z);
    let omax = vec3<f32>(d.hi, d.z + cc_rooftopworks_PAR_H);
    let so = city_box_hit(o, inv_dir, omin, omax);
    if (so.x > so.y || so.y <= max(t0, 1e-3) || so.x > t1) {
        return best;
    }
    let w = cc_rooftopworks_PAR_W;
    let imin = vec3<f32>(d.lo + w, d.z - 1.0);
    let imax = vec3<f32>(d.hi - w, d.z + cc_rooftopworks_PAR_H + 1.0);
    let si = city_box_hit(o, inv_dir, imin, imax);
    let inner = si.x <= si.y;
    // The ring along the ray is [so.x, so.y] with (si.x, si.y) removed. Its
    // two possible front surfaces are the outer entry and the inner exit.
    let lo_t = max(t0, 1e-3);
    var bt = 1e30;
    var on_inner = false;
    if (!(inner && si.x < so.x && si.y > so.x) && so.x > lo_t && so.x <= t1) {
        bt = so.x;
    }
    if (inner && si.y > so.x && si.y < so.y && si.y > lo_t && si.y <= t1
        && si.y < bt) {
        bt = si.y;
        on_inner = true;
    }
    if (bt >= 1e30 || bt >= best.t) {
        return best;
    }
    let p = o + bt * dir;
    let n = select(city_box_normal(p, omin, omax),
                   -city_box_normal(p, imin, imax), on_inner);
    return CityHit(true, bt, p, n, cc_rooftopworks_K_PARAPET, ci);
}

// --- external pipework ------------------------------------------------------
struct cc_rooftopworks_Pipes {
    ok: bool,
    lo: vec3<f32>,
    hi: vec3<f32>,
    n: i32,
    axis_y: bool,   // the bundle runs along the y wall
}

fn cc_rooftopworks_pipes(cc: CityCell) -> cc_rooftopworks_Pipes {
    var res: cc_rooftopworks_Pipes;
    res.ok = false;
    res.lo = vec3<f32>(0.0);
    res.hi = vec3<f32>(0.0);
    res.n = 1;
    res.axis_y = false;
    // Mid-rise only, and only on the two archetypes whose base mass is a
    // plain vertical box: a riser cannot follow a sloped frustum wall.
    if (cc.arch != 0 && cc.arch != 2) {
        return res;
    }
    if (cc.height < cc_rooftopworks_PIPE_H_LO
        || cc.height > cc_rooftopworks_PIPE_H_HI) {
        return res;
    }
    let gh = city_rand4(cc.seed ^ vec2<u32>(0x27d4eb2fu, 0xb5297a4du));
    if (gh.x >= cc_rooftopworks_PIPE_FRAC) {
        return res;
    }
    let n = 1 + i32(gh.y * 2.999);
    let span = f32(n) * cc_rooftopworks_PIPE_D
             + f32(n - 1) * cc_rooftopworks_PIPE_GAP;
    let b = cc.b1min.xy;
    let bt = cc.b1max.xy;
    let top = cc.b1max.z - 0.8;
    if (top < 8.0) {
        return res;
    }
    let ay = gh.z > 0.5;
    let neg_x = gh.w < 0.5;
    let neg_y = fract(gh.w * 13.0) < 0.5;
    if (ay) {
        // Riding a wall whose normal is +-x, running up beside a corner.
        let xw = select(bt.x, b.x, neg_x);
        let x0 = select(xw, xw - cc_rooftopworks_PIPE_OUT, neg_x);
        let y0 = select(bt.y - cc_rooftopworks_PIPE_CORNER - span,
                        b.y + cc_rooftopworks_PIPE_CORNER, neg_y);
        res.lo = vec3<f32>(x0, y0, 2.0);
        res.hi = vec3<f32>(x0 + cc_rooftopworks_PIPE_OUT, y0 + span, top);
    } else {
        let yw = select(bt.y, b.y, neg_y);
        let y0 = select(yw, yw - cc_rooftopworks_PIPE_OUT, neg_y);
        let x0 = select(bt.x - cc_rooftopworks_PIPE_CORNER - span,
                        b.x + cc_rooftopworks_PIPE_CORNER, neg_x);
        res.lo = vec3<f32>(x0, y0, 2.0);
        res.hi = vec3<f32>(x0 + span, y0 + cc_rooftopworks_PIPE_OUT, top);
    }
    res.ok = true;
    res.n = n;
    res.axis_y = ay;
    return res;
}

// --- the trace hook ---------------------------------------------------------
fn cc_rooftopworks_props_trace(o: vec3<f32>, dir: vec3<f32>,
                               inv_dir: vec3<f32>, t0: f32, t1: f32,
                               ci: vec2<i32>, cc: CityCell) -> CityHit {
    // Gate 0, no hash, no arithmetic: unbuilt lots and spire crowns are not
    // ours, and neither are warehouse roofs (the industry component's
    // sawtooth and monitor ridges). The architecture rule is enforced here
    // first and in the deck function second, so neither can be got around.
    if (!cc.built || cc.arch == 4 || cc.land_use == CITY_USE_INDUSTRIAL) {
        return cc_rooftopworks_miss(ci);
    }
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    let z_lo = min(za, zb);
    let z_hi = max(za, zb);
    let fp = lod_pixel_angle() * max(t0, 0.0);
    var best = cc_rooftopworks_miss(ci);

    // Gate 1: the roof band, from the lowest deck this building owns to the
    // headroom above its summit. Most city rays never enter it.
    if (z_hi >= cc_rooftopworks_deck_low(cc) - 1.0
        && z_lo <= cc.height + cc_rooftopworks_HEADROOM) {
        let d0 = cc_rooftopworks_deck(cc, 0);
        let cr = cc_rooftopworks_crown(cc, ci);
        if (d0.ok) {
            // The parapet lives in a 1.25 m band on one deck: a tighter z
            // test than the section gate, and it comes before its hash.
            if (z_hi >= d0.z - 0.2
                && z_lo <= d0.z + cc_rooftopworks_PAR_H + 0.2) {
                let par = cc_rooftopworks_has_parapet(cc);
                if (par.x < cc_rooftopworks_PAR_FRAC) {
                    best = cc_rooftopworks_parapet(best, o, dir, inv_dir,
                                                   t0, t1, d0, ci);
                }
            }
            if (cr.kind != 0) {
                best = cc_rooftopworks_box(
                    best, o, dir, inv_dir, t0, t1,
                    vec3<f32>(cr.lo, cr.z0), vec3<f32>(cr.hi, cr.z1),
                    select(cc_rooftopworks_K_PAD, cc_rooftopworks_K_PENT,
                           cr.kind == 1),
                    ci);
            }
        }
        // Nothing mechanical stands more than 5 m off a deck, so the slot
        // loop gets its own band inside the section gate — the penthouse
        // headroom above it is the crown's business, not the clutter's.
        let mech_on = z_lo <= cc.height + cc_rooftopworks_VENT_H + 0.2
                      && cc_rooftopworks_mech_on(cc);
        for (var s: i32 = 0; s < 4; s = s + 1) {
            let m = cc_rooftopworks_mech(cc, ci, s, mech_on, cr);
            if (m.ok) {
                best = cc_rooftopworks_mech_hit(best, o, dir, inv_dir, t0, t1,
                                                m, s, ci, fp);
            }
        }
    }

    // Gate 2: pipework, close range only.
    if (fp < cc_rooftopworks_PIPE_FP && z_lo <= cc.b1max.z && z_hi >= 1.5) {
        let pp = cc_rooftopworks_pipes(cc);
        if (pp.ok) {
            best = cc_rooftopworks_box(best, o, dir, inv_dir, t0, t1,
                                       pp.lo, pp.hi,
                                       cc_rooftopworks_K_PIPE, ci);
        }
    }
    return best;
}

// --- shading ----------------------------------------------------------------
// A point source seen on a surface, with the energy-preserving widening the
// signage uses: as the footprint grows the spot spreads to a pixel and dims
// by the same factor, so a lamp never strobes and never vanishes.
fn cc_rooftopworks_spot(p: vec3<f32>, seat: vec3<f32>, sig: f32, fp: f32)
        -> f32 {
    let s = max(sig, 0.30 * fp);
    let k = (sig * sig) / (s * s);
    let d = p - seat;
    return k * exp(-dot(d, d) / (2.0 * s * s));
}

fn cc_rooftopworks_fill(p: vec3<f32>) -> vec3<f32> {
    return CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(p.xy, 3.0));
}

// Dark painted steel against the night: a little skyglow, a little moon, and
// a rim that brightens toward the horizontal because the light on a roof
// comes from the street below and from the city all around it.
fn cc_rooftopworks_dark(h: CityHit, albedo: f32) -> vec3<f32> {
    let fill = cc_rooftopworks_fill(h.pos);
    let side = 1.0 - abs(h.normal.z);
    return albedo * fill * (1.0 + 1.6 * side)
         + albedo * CITY_MOONLIGHT * max(dot(h.normal, u.sun_dir.xyz), 0.0);
}

// The house colour, where the building has one; cool white otherwise.
fn cc_rooftopworks_trim_color(cc: CityCell) -> vec3<f32> {
    if (cc.win_mono >= 0.0) {
        return city_room_color(cc.win_mono, cc.palette_bias);
    }
    return cc_rooftopworks_TRIM_COOL;
}

fn cc_rooftopworks_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    // --- parapet -----------------------------------------------------------
    if (h.kind == cc_rooftopworks_K_PARAPET) {
        let d0 = cc_rooftopworks_deck(cc, 0);
        var e = cc_rooftopworks_dark(h, CITY_ROOF_ALBEDO * 1.3);
        let par = cc_rooftopworks_has_parapet(cc);
        if (par.y < cc_rooftopworks_PAR_LIT) {
            // A strip of light under the coping. Sharp while the band is
            // wider than a pixel; past that it is the same energy spread
            // over the whole wall face, which is what a real coping light
            // looks like from two kilometres — a line, not a sparkle.
            let up = h.pos.z - d0.z;
            let band = select(
                0.0, 1.0,
                up > cc_rooftopworks_PAR_H - cc_rooftopworks_PAR_TRIM);
            let mean = (cc_rooftopworks_PAR_TRIM / cc_rooftopworks_PAR_H)
                       * cc_rooftopworks_TRIM_MEAN_COMP;
            let k = smoothstep(cc_rooftopworks_TRIM_LOD_START,
                               cc_rooftopworks_TRIM_LOD_FULL, fp);
            let face = select(1.0, 0.45, h.normal.z > 0.5);
            // Runs, not a continuous tube. An unbroken glowing rectangle
            // around every roof reads as wireframe; fixtures on a 6.5 m
            // centre with a dark joint between them read as hardware. The
            // run coordinate is the perimeter direction, taken from which
            // edge of the deck the hit is nearest.
            let dxy = min(h.pos.xy - d0.lo, d0.hi - h.pos.xy);
            let along_y = dxy.x < dxy.y;
            let uc = select(h.pos.x, h.pos.y, along_y);
            let seg = select(1.0, 0.0,
                             fract(uc / cc_rooftopworks_TRIM_PITCH)
                             > cc_rooftopworks_TRIM_DUTY);
            let segk = mix(seg, cc_rooftopworks_TRIM_DUTY,
                           smoothstep(0.9, 2.4, fp));
            e = e + cc_rooftopworks_trim_color(cc)
                    * (cc_rooftopworks_TRIM_RAD * face * segk
                       * mix(band, mean, k));
        }
        return e;
    }

    // --- penthouse ---------------------------------------------------------
    if (h.kind == cc_rooftopworks_K_PENT) {
        let cr = cc_rooftopworks_crown(cc, h.cell);
        if (h.normal.z > 0.5) {
            return cc_rooftopworks_dark(h, CITY_ROOF_ALBEDO);
        }
        // Glass on three-and-a-bit sides, with mullions and a dark spandrel
        // at its foot. The colour follows the house where there is one.
        // @domain: a wall's normal: |xy| = 1
        let nh = normalize(h.normal.xy + vec2<f32>(1e-9, 0.0));
        let tangent = vec2<f32>(-nh.y, nh.x);
        let uc = dot(h.pos.xy, tangent);
        let up = h.pos.z - cr.z0;
        let mull = select(
            1.0, 0.10,
            fract(uc / cc_rooftopworks_PENT_PITCH) < cc_rooftopworks_PENT_MULL);
        let sill = smoothstep(0.0, cc_rooftopworks_PENT_SILL, up);
        // Panes, not a slab. Lit uniformly at 1.8 the crown came out as the
        // brightest thing on the skyline — brighter in the mean than the
        // facade below it, which is backwards. It is a room: most of the
        // glass is lit, some is not, and each bay has its own level.
        let iu = i32(floor(uc / cc_rooftopworks_PENT_PITCH));
        let iv = i32(floor(up / CITY_FLOOR_H));
        let wh = city_rand4(vec2<u32>(
            cc.seed.x ^ (bitcast<u32>(iu) * 0x9e3779b9u) ^ 0x0d2f1a37u,
            cc.seed.y ^ (bitcast<u32>(iv) * 0x85ebca6bu) ^ 0x1b56c4e9u));
        let bay = select(0.0, 0.45 + 1.10 * wh.z,
                         wh.x < cc_rooftopworks_PENT_LIT);
        // Mullions are 13% of the pitch and a bay is 2.1 m: both are
        // sub-pixel past a couple of metres, where the wall settles to its
        // own mean rather than flickering.
        let k = smoothstep(0.7, 2.2, fp);
        let m = mix(mull * bay,
                    (1.0 - 0.9 * cc_rooftopworks_PENT_MULL)
                    * cc_rooftopworks_PENT_LIT
                    * cc_rooftopworks_PENT_MEAN_COMP, k);
        var col = cc_rooftopworks_PENT_COL;
        if (cc.win_mono >= 0.0) {
            col = city_room_color(cc.win_mono, cc.palette_bias);
        }
        return cc_rooftopworks_dark(h, CITY_FACADE_ALBEDO)
             + col * (cc_rooftopworks_PENT_RAD * m * sill);
    }

    // --- helipad -----------------------------------------------------------
    if (h.kind == cc_rooftopworks_K_PAD) {
        let cr = cc_rooftopworks_crown(cc, h.cell);
        var e = cc_rooftopworks_dark(h, CITY_ROOF_ALBEDO * 0.8);
        if (h.normal.z > 0.5) {
            // Paint: a ring and a bar. Albedo only — at night it is barely
            // there, which is right; the pad is read by its corner lights.
            let c = 0.5 * (cr.lo + cr.hi);
            let half = 0.5 * (cr.hi - cr.lo);
            let q = (h.pos.xy - c) / max(half, vec2<f32>(1e-3));
            let rr = length(q);
            let ring = select(0.0, 1.0, abs(rr - 0.62) < 0.06);
            let bar = select(0.0, 1.0,
                             abs(q.x) < 0.10 && abs(q.y) < 0.34);
            let paint = max(ring, bar) * (1.0 - smoothstep(0.4, 1.4, fp))
                      + 0.22 * smoothstep(0.4, 1.4, fp);
            e = e + vec3<f32>(cc_rooftopworks_PAD_MARK * paint)
                    * cc_rooftopworks_fill(h.pos) * 3.0;
            // Four corner lights, 1 m in from the corners.
            let s = half - 1.0;
            var lamps = 0.0;
            lamps = lamps + cc_rooftopworks_spot(
                h.pos, vec3<f32>(c + vec2<f32>(s.x, s.y), cr.z1),
                cc_rooftopworks_PAD_LAMP_SIG, fp);
            lamps = lamps + cc_rooftopworks_spot(
                h.pos, vec3<f32>(c + vec2<f32>(-s.x, s.y), cr.z1),
                cc_rooftopworks_PAD_LAMP_SIG, fp);
            lamps = lamps + cc_rooftopworks_spot(
                h.pos, vec3<f32>(c + vec2<f32>(s.x, -s.y), cr.z1),
                cc_rooftopworks_PAD_LAMP_SIG, fp);
            lamps = lamps + cc_rooftopworks_spot(
                h.pos, vec3<f32>(c + vec2<f32>(-s.x, -s.y), cr.z1),
                cc_rooftopworks_PAD_LAMP_SIG, fp);
            e = e + cc_rooftopworks_PAD_LAMP_COL
                    * (cc_rooftopworks_PAD_LAMP_RAD * lamps);
        }
        return e;
    }

    // --- pipework ----------------------------------------------------------
    if (h.kind == cc_rooftopworks_K_PIPE) {
        let pp = cc_rooftopworks_pipes(cc);
        // Across the bundle: each riser reads as a cylinder by shading, a
        // bright sliver where the wall light grazes it and dark at the seam.
        let across = select(h.pos.x - pp.lo.x, h.pos.y - pp.lo.y, pp.axis_y);
        let pitch = cc_rooftopworks_PIPE_D + cc_rooftopworks_PIPE_GAP;
        let fu = clamp(fract(across / pitch) / (cc_rooftopworks_PIPE_D / pitch),
                       0.0, 1.0);
        let round = sqrt(max(1.0 - (2.0 * fu - 1.0) * (2.0 * fu - 1.0), 0.0));
        let face = 1.0 - abs(h.normal.z);
        // The rim: the lit facade behind a riser wraps its edges.
        let k = 1.0 - smoothstep(cc_rooftopworks_PIPE_FADE,
                                 cc_rooftopworks_PIPE_FP, fp);
        let rim = mix(0.35, 1.0, round) * face * k;
        return cc_rooftopworks_dark(h, CITY_FACADE_ALBEDO * 1.4)
             + CITY_PALETTE_MEAN * (0.10 * rim);
    }

    // --- mechanical clusters ------------------------------------------------
    let is_acc = h.kind >= cc_rooftopworks_K_ACC;
    let s = h.kind - select(cc_rooftopworks_K_MECH, cc_rooftopworks_K_ACC,
                            is_acc);
    let m = cc_rooftopworks_mech(cc, h.cell, s,
                                 cc_rooftopworks_mech_on(cc),
                                 cc_rooftopworks_crown(cc, h.cell));
    var alb = cc_rooftopworks_MECH_ALBEDO;
    if (m.kind == 0 && is_acc) {
        alb = alb * 1.35;  // the rim band is galvanised: it catches more
    }
    var e = cc_rooftopworks_dark(h, alb);
    if (m.lamp) {
        // The fixture itself, plus the pool it throws on its own housing.
        let src = cc_rooftopworks_spot(h.pos, m.seat,
                                       cc_rooftopworks_LAMP_SIG, fp);
        let spill = cc_rooftopworks_spot(h.pos, m.seat,
                                         cc_rooftopworks_LAMP_SPILL, fp);
        e = e + cc_rooftopworks_LAMP_COL
                * (cc_rooftopworks_LAMP_RAD * (src + 0.10 * spill));
    }
    // Condenser rows: the unit gaps and the grille bands, drawn rather than
    // built. Three units on a 2.6 m pitch; the seams are dark, the grille a
    // shade lighter than the casing.
    if (m.kind == 1 && !is_acc) {
        let along = select(h.pos.y - m.lo.y, h.pos.x - m.lo.x,
                           (m.hi.x - m.lo.x) > (m.hi.y - m.lo.y));
        let fu = fract(along / 2.60);
        let seam = select(1.0, 0.35, fu < 0.12 || fu > 0.88);
        let grille = select(0.0, 1.0, h.normal.z > 0.5 && fu > 0.30
                            && fu < 0.70);
        // Both are modulations of the casing's own albedo, never additions:
        // a fan grille is lighter metal, not a light. (It was an additive
        // skyglow term once, and every condenser on the roof came out cyan.)
        let k = 1.0 - smoothstep(0.5, 1.6, fp);
        e = e * (mix(1.0, seam, k) * (1.0 + 0.8 * grille * k));
    }
    return e;
}

// --- component: skybridges (skybridges.wgsl) ---
// skybridges — the enclosed walkways that make two towers one address.
//
// THE PROBLEM. Every other piece of this city fits inside one block column,
// which is what lets the DDA test a cell's geometry only while the ray is
// inside that cell. A bridge does not: it spans the street, so half of it
// lives in one column and half in the next. The fix is not to make the
// tracer smarter. It is to make the bridge belong to the EDGE between two
// cells rather than to either cell, and to derive it from data both cells
// can read — so cell A and cell B independently construct the SAME box, to
// the bit. Each then reports whichever part of that box its own ray segment
// contains, and the two halves meet with nothing between them.
//
// The edge id is the whole trick. For the edge between (i,j) and (i+1,j)
// the id is (2i+1, 2j); between (i,j) and (i,j+1) it is (2i, 2j+1). Doubling
// the cell index leaves the even lattice for cells and puts each edge on the
// odd coordinate of the axis it crosses, so the id is a property of the edge
// and is computed identically from either side. A cell tests all four of its
// edges; the neighbour tests the same four ids from its side; the two agree
// by construction rather than by convention.
//
// The other half of the trick is CONTAINMENT. Determinism alone is not
// enough — the box must also lie inside the two columns that test it, or the
// ray would enter it while the DDA is in some third cell that never looks.
// Two rules enforce it: each end face must be within half a block of the
// shared boundary, and the deck's cross-extent is clipped to the edge's own
// row. Everything a bridge needs is then a function of (edge id, cell A,
// cell B), which is also why the shading hook can rebuild the exact span
// from a hit position alone: round the hit to the nearest block boundary on
// the bridge's axis and the two cells fall out.
//
// WHERE THEY GO. Only downtown (both blocks past the density gate, and it is
// the LOWER of the two that decides so both sides agree), only between two
// built buildings, and only where the deck fits under BOTH roofs with 15 m to
// spare. "Under the roof" means under the b1 box — the widest, lowest prim of
// every archetype. That one rule buys the whole architectural constraint the
// city asks for: a bridge lands on a slab or a growth tower's shaft, on a
// tapered shaft only below its podium cap, on a spire tower only below the
// spring line of the spire, and on nothing at all above a setback.
//
// WHAT THEY LOOK LIKE. A 0.5 m deck, a 2.6 m glass band, a thin roof: from a
// kilometre out a lit ribbon strung between two dark towers, which is the
// Cloudpunk image this component exists for. Close up the band resolves into
// mullions every 2.5 m, a scatter of dark bays, and now and then somebody
// walking across at two in the morning.

// kind = BASE + axis + 2 * type, type 0 shell, 1 glass band, 2 truss member.
// The axis rides in the low bit so the type is a plain shift, and both fit
// the 16 local kinds a component owns.
const cc_skybridges_KIND_BASE: i32 = 500;

// --- eligibility ----------------------------------------------------------
// The gate is the first thing evaluated per edge and costs one pcg2d. What
// survives it pays for one neighbour cell fetch; what survives THAT pays for
// three box tests. Measured over a 256x256-cell window on the megatower
// district (tools' probe, 41967 qualifying edges): 59% of gated edges end up
// carrying a bridge, the rest losing on fit — frontage, gap or headroom — so
// the gate is set to 0.118 to land the built share at 7.0% of the edges whose
// two blocks are both built and both past the density floor.
const cc_skybridges_GATE: f32 = 0.118;
const cc_skybridges_MIN_DENSITY: f32 = 0.25;
const cc_skybridges_GAP_MIN: f32 = 8.0;   // a street, not a seam
const cc_skybridges_GAP_MAX: f32 = 62.0;  // beyond this it is a viaduct
const cc_skybridges_Z_MIN: f32 = 25.0;
const cc_skybridges_Z_MAX: f32 = 380.0;   // above this a walkway is a stunt
const cc_skybridges_ROOF_MARGIN: f32 = 15.0;

// --- geometry (metres) ----------------------------------------------------
const cc_skybridges_DECK_T: f32 = 0.5;
const cc_skybridges_GLASS_H: f32 = 2.6;
const cc_skybridges_ROOF_T: f32 = 0.4;
const cc_skybridges_TUBE_H: f32 = 3.5;    // DECK_T + GLASS_H + ROOF_T
const cc_skybridges_HALF_W: f32 = 2.0;    // a 4 m tube: two people wide
const cc_skybridges_HALF_W_GRAND: f32 = 4.0;  // a sky lobby, 8 m across
const cc_skybridges_GRAND_FRAC: f32 = 0.22;
const cc_skybridges_GLASS_INSET: f32 = 0.12;  // deck lip proud of the glass
const cc_skybridges_ROOF_OVER: f32 = 0.18;    // fascia proud of the glass
const cc_skybridges_EMBED: f32 = 1.0;     // driven into each wall, so no end
                                          // can ever float in the gap
const cc_skybridges_ROW_MARGIN: f32 = 1.0;

// The hook's own z gate: the extreme deck is Z_MAX quantized up plus the
// tube, and the lowest is Z_MIN rounded down a storey. Nothing outside this
// band exists, so a segment that misses it costs one compare.
const cc_skybridges_Z_LO: f32 = 20.0;
const cc_skybridges_Z_HI: f32 = 395.0;

// --- the shell ------------------------------------------------------------
// Everything albedo-lit is near-black at night, so the deck and roof cannot
// be made to read by brightening them — only by structure. The underside is
// the surface that matters: from the street a bridge is a dark belly with a
// lamp string on it, and nothing else. Ribs sit on the glazing's own 2.5 m
// pitch, because one tube built once has one rhythm.
const cc_skybridges_SHELL_TINT: f32 = 0.012;  // corridor leak through the shell
const cc_skybridges_SHELL_FILL: f32 = 0.055;
const cc_skybridges_RIB_PITCH: f32 = 2.5;
const cc_skybridges_RIB_HALF: f32 = 0.16;   // a 0.32 m transverse web
const cc_skybridges_SPINE_HALF: f32 = 0.32; // the box girder down the belly
const cc_skybridges_LAMP_PITCH: f32 = 5.0;
const cc_skybridges_LAMP_R: f32 = 0.18;
const cc_skybridges_LAMP_RAD: f32 = 0.85;

// --- the open truss -------------------------------------------------------
// Not every span between two towers is a corridor: some are service crossings
// that never had a wall. The variant keeps the deck and the same three box
// tests, but the middle prim shrinks to a central web and the top prim to a
// chord, so the silhouette is genuinely open — sky on both sides above the
// handrail — and what carries it at night is a lamp string rather than a lit
// room. Rare, because the enclosed walkway is the thing this city is for.
const cc_skybridges_TRUSS_FRAC: f32 = 0.18;
const cc_skybridges_TRUSS_HALF: f32 = 0.30;   // the central web
const cc_skybridges_CHORD_FRAC: f32 = 0.55;   // top chord, as a share of half
const cc_skybridges_STRING_PITCH: f32 = 4.0;
const cc_skybridges_STRING_R: f32 = 0.16;
const cc_skybridges_STRING_RAD: f32 = 2.6;
const cc_skybridges_TRUSS_PITCH: f32 = 3.0;   // one Warren bay
const cc_skybridges_MEMBER_T: f32 = 0.20;     // diagonal, measured vertically
const cc_skybridges_POST_T: f32 = 0.10;
const cc_skybridges_CHORD_T: f32 = 0.17;
// Mean member cover of the web face, integrated off the constants above:
// two chords (2*0.17/2.6), the posts (2*0.10/3.0) and the diagonals
// (2*0.20 of vertical extent per 1.5 m of run, over 2.6 m), less overlap.
const cc_skybridges_TRUSS_COVER: f32 = 0.40;

// --- the band -------------------------------------------------------------
const cc_skybridges_MULLION_PITCH: f32 = 2.5;
const cc_skybridges_MULLION_HALF: f32 = 0.11;  // half the 0.22 m web
const cc_skybridges_GLASS_V0: f32 = 0.26;  // sill, above the deck surface
const cc_skybridges_GLASS_V1: f32 = 2.39;  // head
const cc_skybridges_RADIANCE: f32 = 2.0;
const cc_skybridges_DARK_SEG: f32 = 0.12;  // bays with the lights off
const cc_skybridges_FIG_FRAC: f32 = 0.15;  // bays with somebody in them
const cc_skybridges_BODY_T: f32 = 0.12;
const cc_skybridges_SPANDREL: f32 = 0.04;  // sill/head/mullion transmission

// Footprint windows (m/px) over which each layer blends into its own mean,
// each set by that layer's finest feature: a 0.1 m limb, a 0.22 m mullion
// web, a 2.5 m bay. Past its window a layer is a constant, so the next
// coarser one hands off smoothly and nothing vanishes.
const cc_skybridges_LOD_FIG: vec2<f32> = vec2<f32>(0.25, 1.10);
const cc_skybridges_LOD_MUL: vec2<f32> = vec2<f32>(0.60, 3.00);
const cc_skybridges_LOD_SEG: vec2<f32> = vec2<f32>(3.00, 10.0);
const cc_skybridges_LOD_RIB: vec2<f32> = vec2<f32>(0.50, 2.60);
const cc_skybridges_LOD_LAMP: vec2<f32> = vec2<f32>(0.30, 1.60);

// The band's mean cover, measured off the constants above rather than
// guessed: the glazed fraction of the box face (2.13 / 2.6), the mullion
// duty (1 - 0.22 / 2.5), the lit-bay fraction (1 - 0.12), and the mean
// transmission left by the figures (1 - 0.15 * 0.113 * 0.88, the 0.113 being
// a body's share of a glazed bay). The bay brightness draw has mean 1.
const cc_skybridges_MEAN_COVER: f32 = 0.647;
// Averaging radiance ahead of a compressive tone map runs bright; the same
// compensation the core's octave ladder carries, scaled for a ribbon that
// never fills more than a few pixels.
const cc_skybridges_MEAN_COMP: f32 = 0.80;

// One bridge's whole description. Both hooks build this and must agree.
struct cc_skybridges_Span {
    ok: bool,
    axis: i32,     // 0 the bridge runs along x, 1 along y
    lo: f32,       // start along the axis, inside wall A
    hi: f32,       // end along the axis, inside wall B
    ctr: f32,      // centre across the axis
    half: f32,     // half deck width
    z: f32,        // deck underside
    truss: bool,   // open service crossing rather than an enclosed walkway
    seed: vec2<u32>,
}

// The edge id: even coordinates are cells, the odd one names the axis the
// edge crosses. Computed from the LOWER cell of the pair, which both sides
// can name.
fn cc_skybridges_eid(clo: vec2<i32>, axis: i32) -> vec2<u32> {
    // Tile-wrapped (city_tile_cell) so an edge is a property of its tile
    // coordinate: both cells beside it name the same lower cell, wrapped
    // the same way, on every copy of the tile.
    let cw = city_tile_cell(clo);
    return vec2<u32>(
        bitcast<u32>(2 * cw.x + (1 - axis)) ^ 0x5bf03635u,
        bitcast<u32>(2 * cw.y + axis) ^ 0x9e3779b9u);
}

// The gate. This is the component's hottest instruction by a wide margin —
// four of them run in every cell the DDA visits inside CITY_PROP_RANGE,
// whether or not a bridge is anywhere near — and measuring said the per-cell
// hashing, not the geometry, was two thirds of what the component costs. So
// it is one multiply-xorshift round instead of pcg2d's two. It must be a pure
// function of the edge id, which is the entire determinism contract; it does
// NOT have to be a strong hash, because all it decides is a yes/no on an
// eighth of edges and everything that survives is redrawn with pcg2d.
// One multiply-xorshift round rather than pcg2d's two. Folding a cell's two
// owned edges into the halves of a single hash — four gates for three hashes
// — was tried and measured no faster on the one view whose bridge statistics
// are comparable across the change, so the per-edge hash stays: independent
// gates, and the simpler thing when the complicated thing cannot be shown to
// pay.
fn cc_skybridges_gate(clo: vec2<i32>, axis: i32) -> bool {
    var h = (bitcast<u32>(2 * clo.x + (1 - axis)) * 0x9e3779b9u)
          ^ (bitcast<u32>(2 * clo.y + axis) * 0x85ebca6bu);
    h = h ^ (h >> 16u);
    h = h * 0x7feb352du;
    h = h ^ (h >> 15u);
    return city_u01(h) < cc_skybridges_GATE;
}

fn cc_skybridges_bmin(axis: i32, a: f32, c: f32, z: f32) -> vec3<f32> {
    if (axis == 0) {
        return vec3<f32>(a, c, z);
    }
    return vec3<f32>(c, a, z);
}

// Everything about the bridge on one edge, from the two cells it joins and
// the edge's own draws. Deterministic in its arguments and nothing else,
// which is the entire contract this component rests on.
fn cc_skybridges_build(clo: vec2<i32>, axis: i32, ca: CityCell, cb: CityCell,
                       d: vec4<f32>) -> cc_skybridges_Span {
    var s: cc_skybridges_Span;
    s.ok = false;
    s.axis = axis;
    s.lo = 0.0; s.hi = 0.0; s.ctr = 0.0; s.half = 0.0; s.z = 0.0;
    s.truss = false;
    s.seed = vec2<u32>(0u);
    if (!ca.built || !cb.built) {
        return s;
    }
    // A merged superblock reports the same seed from every member cell: an
    // edge inside one building is not a bridge, it is a corridor.
    if (ca.seed.x == cb.seed.x && ca.seed.y == cb.seed.y) {
        return s;
    }
    if (min(ca.density, cb.density) <= cc_skybridges_MIN_DENSITY) {
        return s;
    }

    let cell = u.ocean_params.x;
    // Faces along the axis, and the row the edge lives in across it.
    var a_face: f32; var b_face: f32; var bnd: f32;
    var a_lo: f32; var a_hi: f32; var b_lo: f32; var b_hi: f32;
    var row: f32;
    if (axis == 0) {
        bnd = f32(clo.x + 1) * cell;
        a_face = ca.b1max.x; b_face = cb.b1min.x;
        a_lo = ca.b1min.y; a_hi = ca.b1max.y;
        b_lo = cb.b1min.y; b_hi = cb.b1max.y;
        row = f32(clo.y);
    } else {
        bnd = f32(clo.y + 1) * cell;
        a_face = ca.b1max.y; b_face = cb.b1min.y;
        a_lo = ca.b1min.x; a_hi = ca.b1max.x;
        b_lo = cb.b1min.x; b_hi = cb.b1max.x;
        row = f32(clo.x);
    }

    // Containment. Each wall must be within half a block of the boundary:
    // that keeps the whole tube inside the two columns that test it (so no
    // third cell can own the ray where the box begins) and it is also what
    // makes the shading hook's rounding recovery exact.
    let reach = 0.5 * cell - 2.0;
    if (abs(a_face - bnd) > reach || abs(b_face - bnd) > reach) {
        return s;
    }
    let gap = b_face - a_face;
    if (gap < cc_skybridges_GAP_MIN || gap > cc_skybridges_GAP_MAX) {
        return s;
    }

    // Across the axis: the two walls' shared frontage, clipped to the edge's
    // own row so the deck cannot wander into a neighbouring one.
    let c0 = max(max(a_lo, b_lo), row * cell + cc_skybridges_ROW_MARGIN);
    let c1 = min(min(a_hi, b_hi), (row + 1.0) * cell
                                  - cc_skybridges_ROW_MARGIN);
    let frontage = c1 - c0;
    // A service crossing is never also a sky lobby: the two draws are read in
    // order so the variant is decided before the width that depends on it.
    let truss = d.x < cc_skybridges_TRUSS_FRAC;
    var half = cc_skybridges_HALF_W;
    if (!truss && d.w < cc_skybridges_GRAND_FRAC
        && frontage > 2.0 * cc_skybridges_HALF_W_GRAND + 3.0) {
        half = cc_skybridges_HALF_W_GRAND;
    }
    let slack = frontage - 2.0 * (half + cc_skybridges_ROOF_OVER) - 1.0;
    if (slack < 0.0) {
        return s;
    }

    // Height: a storey between 25 m and the lower of the two b1 roofs less
    // its margin. b1 is the base box of every archetype, so this is the
    // "lands on the widest prim" rule stated once and obeyed everywhere.
    let z_top = min(ca.b1max.z, cb.b1max.z) - cc_skybridges_ROOF_MARGIN;
    let z_hi = min(z_top - cc_skybridges_TUBE_H, cc_skybridges_Z_MAX);
    if (z_hi < cc_skybridges_Z_MIN) {
        return s;
    }
    var z = floor((cc_skybridges_Z_MIN + (z_hi - cc_skybridges_Z_MIN) * d.y)
                  / CITY_FLOOR_H) * CITY_FLOOR_H;
    if (z < cc_skybridges_Z_MIN) {
        z = z + CITY_FLOOR_H;
    }

    s.ok = true;
    s.lo = a_face - cc_skybridges_EMBED;
    s.hi = b_face + cc_skybridges_EMBED;
    s.ctr = c0 + half + cc_skybridges_ROOF_OVER + 0.5 + slack * d.z;
    s.half = half;
    s.z = z;
    s.truss = truss;
    s.seed = pcg2d(cc_skybridges_eid(clo, axis) ^ vec2<u32>(0x68e31da4u,
                                                            0xb5297a4du));
    return s;
}

// --- the trace ------------------------------------------------------------
// All four edges of cell ci, cheap hash first. A hit counts only if its t
// falls inside this cell's segment, which is what splits the tube between
// the two cells with no overlap and no gap: the box's entry point lies in
// exactly one column, and that column's segment is the one that contains it.
fn cc_skybridges_props_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                             t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    // If this cell fails the gate it fails the min() on every one of its
    // edges too, so the neighbour reaches the same verdict.
    if (!cc.built || cc.density <= cc_skybridges_MIN_DENSITY) {
        return res;
    }
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    if (min(za, zb) > cc_skybridges_Z_HI || max(za, zb) < cc_skybridges_Z_LO) {
        return res;
    }

    for (var e: i32 = 0; e < 4; e = e + 1) {
        let axis = e >> 1;
        let neg = (e & 1) == 1;
        let stp = select(vec2<i32>(1, 0), vec2<i32>(0, 1), axis == 1);
        let clo = select(ci, ci - stp, neg);
        if (!cc_skybridges_gate(clo, axis)) {
            continue;
        }
        // One extra cell fetch, and only behind the gate.
        let p0 = pcg2d(cc_skybridges_eid(clo, axis));
        let nb = city_cell(select(clo + stp, clo, neg));
        var ca = cc;
        var cb = nb;
        if (neg) {
            ca = nb;
            cb = cc;
        }
        let s = cc_skybridges_build(clo, axis, ca, cb, city_rand4(p0));
        if (!s.ok) {
            continue;
        }

        let zd = s.z;
        let zg = zd + cc_skybridges_DECK_T;
        let zr = zg + cc_skybridges_GLASS_H;
        let zt = zd + cc_skybridges_TUBE_H;
        let gh = s.half - cc_skybridges_GLASS_INSET;
        let rh = s.half + cc_skybridges_ROOF_OVER;
        for (var p: i32 = 0; p < 3; p = p + 1) {
            var w: f32; var z_lo: f32; var z_hi: f32;
            if (p == 0) {
                w = s.half; z_lo = zd; z_hi = zg;        // deck
            } else if (p == 1) {
                // Glass band, or the truss's central web: same prim, same
                // test, a tenth of the width.
                w = select(gh, cc_skybridges_TRUSS_HALF, s.truss);
                z_lo = zg; z_hi = zr;
            } else {
                w = select(rh, s.half * cc_skybridges_CHORD_FRAC, s.truss);
                z_lo = zr; z_hi = zt;                    // roof, or top chord
            }
            let bmin = cc_skybridges_bmin(axis, s.lo, s.ctr - w, z_lo);
            let bmax = cc_skybridges_bmin(axis, s.hi, s.ctr + w, z_hi);
            let hb = city_box_hit(o, inv_dir, bmin, bmax);
            if (hb.x <= hb.y && hb.x > 0.0 && hb.x < res.t
                && hb.x >= t0 - 1e-3 && hb.x <= t1 + 1e-3) {
                res.hit = true;
                res.t = hb.x;
                res.pos = o + hb.x * dir;
                res.normal = city_box_normal(res.pos, bmin, bmax);
                res.cell = ci;
                let side = select(abs(res.normal.y), abs(res.normal.x),
                                  axis == 1);
                // The whole web is a truss member; only the band's vertical
                // faces are glazing (its sill and head are shell).
                var ty = 0;
                if (p == 1) {
                    if (s.truss) { ty = 2; }
                    else if (side > 0.5) { ty = 1; }
                }
                res.kind = cc_skybridges_KIND_BASE + axis + 2 * ty;
            }
        }
    }
    return res;
}

// --- shading --------------------------------------------------------------

fn cc_skybridges_capsule(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>, r: f32)
        -> f32 {
    let pa = p - a;
    let ba = b - a;
    let hh = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * hh) - r;
}

// Somebody crossing. Two capsules — a leaning body and a head — in bay
// metres, which is all a person is worth at the distance a bridge is
// usually seen from, and more than enough to turn a lit tube into an
// inhabited one.
fn cc_skybridges_figure(sh: vec4<f32>, pm: vec2<f32>, fp: f32) -> f32 {
    let sc = 0.90 + 0.22 * sh.w;
    let cx = 0.5 + (cc_skybridges_MULLION_PITCH - 1.0) * sh.y;
    let lean = (sh.z - 0.5) * 0.17;
    let body = cc_skybridges_capsule(
        pm, vec2<f32>(cx, 0.30 * sc), vec2<f32>(cx + lean, 1.40 * sc),
        0.20 * sc);
    let head = cc_skybridges_capsule(
        pm, vec2<f32>(cx + lean * 1.30, 1.58 * sc),
        vec2<f32>(cx + lean * 1.36, 1.65 * sc), 0.115 * sc);
    let aa = 0.03 + 0.5 * fp;
    return 1.0 - smoothstep(-aa, aa, min(body, head));
}

// The tube's shell: deck, roof and fascia. It is albedo-lit, so it is
// near-black and no amount of gain would change that honestly; what makes it
// read is structure. Ribs panelize the whole tube on the glazing pitch; the
// underside additionally carries the box girder and the service lamps, which
// are the only part of a bridge's belly the street ever actually sees.
fn cc_skybridges_shell(h: CityHit, s: cc_skybridges_Span, tint: vec3<f32>,
                       fill: vec3<f32>, moon: vec3<f32>, fp_eff: f32)
        -> vec3<f32> {
    var e = cc_skybridges_SHELL_FILL * fill
            + cc_skybridges_SHELL_TINT * tint
            + 0.045 * CITY_MOONLIGHT * max(dot(h.normal, moon), 0.0);
    if (!s.ok) {
        return e;   // the span could not be rebuilt: flat shell, never magenta
    }
    let along = select(h.pos.x, h.pos.y, s.axis == 1);
    let cross_m = select(h.pos.y, h.pos.x, s.axis == 1) - s.ctr;
    let ua = along - s.lo;
    let aa = min(0.5 * fp_eff, 0.30);
    let lod = smoothstep(cc_skybridges_LOD_RIB.x, cc_skybridges_LOD_RIB.y,
                         fp_eff);

    let rp = ua - floor(ua / cc_skybridges_RIB_PITCH)
             * cc_skybridges_RIB_PITCH;
    let web = min(rp, cc_skybridges_RIB_PITCH - rp);
    let rib = 1.0 - smoothstep(cc_skybridges_RIB_HALF - aa - 0.02,
                               cc_skybridges_RIB_HALF + aa + 0.02, web);
    let rib_l = mix(rib, 2.0 * cc_skybridges_RIB_HALF
                         / cc_skybridges_RIB_PITCH, lod);
    e = e * mix(0.72, 1.75, rib_l);

    if (h.normal.z > -0.5) {
        return e;
    }
    let spine = 1.0 - smoothstep(cc_skybridges_SPINE_HALF - aa - 0.02,
                                 cc_skybridges_SPINE_HALF + aa + 0.02,
                                 abs(cross_m));
    let spine_l = mix(spine,
                      min(cc_skybridges_SPINE_HALF / max(s.half, 0.5), 1.0),
                      lod);
    e = e * mix(1.0, 1.45, spine_l);

    // The lamp string. Sub-pixel it becomes its own mean over one lamp cell,
    // so a belly seen from a kilometre keeps exactly the light it had close.
    let li = floor(ua / cc_skybridges_LAMP_PITCH);
    let lu = ua - (li + 0.5) * cc_skybridges_LAMP_PITCH;
    let dl = length(vec2<f32>(lu, cross_m));
    let laa = clamp(0.5 * fp_eff, 0.02, 0.40);
    let lamp = 1.0 - smoothstep(cc_skybridges_LAMP_R - laa,
                                cc_skybridges_LAMP_R + laa, dl);
    let lamp_mean = 3.14159265 * cc_skybridges_LAMP_R * cc_skybridges_LAMP_R
                    / (cc_skybridges_LAMP_PITCH * 2.0 * max(s.half, 0.5));
    let lamp_l = mix(lamp, lamp_mean,
                     smoothstep(cc_skybridges_LOD_LAMP.x,
                                cc_skybridges_LOD_LAMP.y, fp_eff));
    return e + tint * (cc_skybridges_LAMP_RAD * lamp_l);
}

// The truss's central web. It is only 0.6 m thick, but its SIDE face is the
// whole span by the whole handrail height — the largest surface this variant
// owns — so it is where the truss has to actually look like a truss. The
// Warren lattice is shaded rather than built: members catch the district's
// fill, and the bays between them go to black, which is very nearly what
// looking through a truss at a night street gives you anyway.
fn cc_skybridges_truss(h: CityHit, s: cc_skybridges_Span, tint: vec3<f32>,
                       fill: vec3<f32>, moon: vec3<f32>, fp_eff: f32)
        -> vec3<f32> {
    let lit = 0.10 * fill + 0.010 * tint
              + 0.050 * CITY_MOONLIGHT * max(dot(h.normal, moon), 0.0);
    if (!s.ok) {
        return lit;
    }
    let ua = select(h.pos.x, h.pos.y, s.axis == 1) - s.lo;
    let pv = h.pos.z - s.z - cc_skybridges_DECK_T;
    let aa = min(0.5 * fp_eff, 0.25);
    let hgt = cc_skybridges_GLASS_H;

    // Warren lattice: a triangle wave of diagonals between top and bottom
    // chords, with a vertical post where the diagonals meet.
    let f = ua / cc_skybridges_TRUSS_PITCH;
    let zig = abs(2.0 * (f - floor(f)) - 1.0);
    let diag = 1.0 - smoothstep(cc_skybridges_MEMBER_T - aa,
                                cc_skybridges_MEMBER_T + aa,
                                abs(pv - hgt * zig));
    let vu = abs(ua - round(f) * cc_skybridges_TRUSS_PITCH);
    let post = 1.0 - smoothstep(cc_skybridges_POST_T - aa,
                                cc_skybridges_POST_T + aa, vu);
    let chord = 1.0 - smoothstep(cc_skybridges_CHORD_T - aa,
                                 cc_skybridges_CHORD_T + aa,
                                 min(pv, hgt - pv));
    let mem = mix(max(max(diag, post), chord), cc_skybridges_TRUSS_COVER,
                  smoothstep(cc_skybridges_LOD_RIB.x,
                             cc_skybridges_LOD_RIB.y, fp_eff));
    let e = lit * mem;

    let li = floor(ua / cc_skybridges_STRING_PITCH);
    let lu = ua - (li + 0.5) * cc_skybridges_STRING_PITCH;
    // The string hangs just under the top chord.
    let dl = length(vec2<f32>(lu, pv - cc_skybridges_GLASS_H * 0.82));
    let laa = clamp(0.5 * fp_eff, 0.02, 0.40);
    let lamp = 1.0 - smoothstep(cc_skybridges_STRING_R - laa,
                                cc_skybridges_STRING_R + laa, dl);
    let lamp_mean = 3.14159265 * cc_skybridges_STRING_R
                    * cc_skybridges_STRING_R
                    / (cc_skybridges_STRING_PITCH * cc_skybridges_GLASS_H);
    let lamp_l = mix(lamp, lamp_mean,
                     smoothstep(cc_skybridges_LOD_LAMP.x,
                                cc_skybridges_LOD_LAMP.y, fp_eff));
    return e + tint * (cc_skybridges_STRING_RAD * lamp_l);
}

fn cc_skybridges_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let moon = u.sun_dir.xyz;
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(h.pos.xy, 3.0));
    let k = h.kind - cc_skybridges_KIND_BASE;
    let axis = k & 1;
    let ty = k >> 1;
    let cell = u.ocean_params.x;

    // Rebuild the exact span from the hit. Containment guarantees the tube
    // straddles one block boundary and stays in one row, so rounding the hit
    // on the bridge's axis and flooring it across names the two cells.
    var clo: vec2<i32>;
    var stp: vec2<i32>;
    if (axis == 0) {
        clo = vec2<i32>(i32(round(h.pos.x / cell)) - 1,
                        i32(floor(h.pos.y / cell)));
        stp = vec2<i32>(1, 0);
    } else {
        clo = vec2<i32>(i32(floor(h.pos.x / cell)),
                        i32(round(h.pos.y / cell)) - 1);
        stp = vec2<i32>(0, 1);
    }
    let p0 = pcg2d(cc_skybridges_eid(clo, axis));
    let s = cc_skybridges_build(clo, axis, city_cell(clo),
                                city_cell(clo + stp), city_rand4(p0));

    // The house colour: mostly tungsten corridors, some fluorescent, the
    // odd cyan one. Warm-biased so a bridge reads against the cooler
    // curtain-wall towers it usually connects.
    let bh = city_rand4(s.seed);
    let tint = city_window_color(bh.x * 0.92, 0.75);

    // The footprint a slanted face actually presents: a tube seen end-on
    // smears its detail over far fewer pixels than its distance suggests.
    let fp_eff = fp / clamp(abs(dot(dir, h.normal)), 0.20, 1.0);

    if (ty == 0 || !s.ok) {
        return cc_skybridges_shell(h, s, tint, fill, moon, fp_eff);
    }
    if (ty == 2) {
        return cc_skybridges_truss(h, s, tint, fill, moon, fp_eff);
    }

    // Band coordinates in metres: along the span from wall A, and up from
    // the deck surface.
    let ua = select(h.pos.x, h.pos.y, axis == 1) - s.lo;
    let pv = h.pos.z - s.z - cc_skybridges_DECK_T;

    let ib = i32(floor(ua / cc_skybridges_MULLION_PITCH));
    let sh = city_rand4(vec2<u32>(s.seed.x ^ (bitcast<u32>(ib) * 0x9e3779b9u),
                                  s.seed.y ^ 0x85ebca6bu));
    let bright = 0.55 + 0.90 * sh.x;
    let bay = tint * (cc_skybridges_RADIANCE * bright);

    // Octave 2: the whole ribbon, one colour. Bays average out last.
    let e_far = tint * (cc_skybridges_RADIANCE * cc_skybridges_MEAN_COVER
                        * cc_skybridges_MEAN_COMP);
    // Octave 1: bays still separable, mullions and figures gone.
    let lit_seg = select(1.0, 0.0, sh.y < cc_skybridges_DARK_SEG);
    let e_bay = bay * (cc_skybridges_MEAN_COVER / (1.0 - cc_skybridges_DARK_SEG)
                       * cc_skybridges_MEAN_COMP * lit_seg);

    // Octave 0: the glazing itself.
    let pu = ua - f32(ib) * cc_skybridges_MULLION_PITCH;
    let aa_u = min(0.5 * fp_eff, 0.35);
    let web = min(pu, cc_skybridges_MULLION_PITCH - pu);
    let mull = smoothstep(cc_skybridges_MULLION_HALF - aa_u - 0.02,
                          cc_skybridges_MULLION_HALF + aa_u + 0.02, web);
    let aa_v = min(0.5 * fp_eff, 0.20);
    let glazed = smoothstep(cc_skybridges_GLASS_V0 - aa_v,
                            cc_skybridges_GLASS_V0 + aa_v + 0.03, pv)
               * (1.0 - smoothstep(cc_skybridges_GLASS_V1 - aa_v - 0.03,
                                   cc_skybridges_GLASS_V1 + aa_v, pv));
    var cover = mix(cc_skybridges_SPANDREL, 1.0, mull * glazed);
    if (sh.z < cc_skybridges_FIG_FRAC) {
        let f_lod = smoothstep(cc_skybridges_LOD_FIG.x,
                               cc_skybridges_LOD_FIG.y, fp_eff);
        if (f_lod < 1.0) {
            let fh = city_rand4(s.seed ^ vec2<u32>(bitcast<u32>(ib)
                                                   * 0x27d4eb2fu, 0x165667b1u));
            let m = cc_skybridges_figure(fh, vec2<f32>(pu, pv), fp_eff)
                    * (1.0 - f_lod);
            cover = cover * mix(1.0, cc_skybridges_BODY_T, m);
        }
    }
    let e_near = bay * (cover * lit_seg);

    let b1 = smoothstep(cc_skybridges_LOD_MUL.x, cc_skybridges_LOD_MUL.y,
                        fp_eff);
    let b2 = smoothstep(cc_skybridges_LOD_SEG.x, cc_skybridges_LOD_SEG.y,
                        fp_eff);
    return mix(e_near, mix(e_bay, e_far, b2), b1)
           + 0.02 * fill;
}

// --- component: streetlife (streetlife.wgsl) ---
// streetlife — the city at eye level: the poles the light already comes
// from, and the cars parked under them. (What stands on the sidewalk is
// streetfurniture's.)
//
// The core already lights the asphalt: city_street_pools puts a sodium pool
// every CITY_LAMP_SPACING (26 m) along two lines set CITY_LAMP_OFFSET (2.5 m)
// in from each block edge, three times brighter on avenues. Those pools had
// no lamps over them. This component puts the lamps there — on exactly that
// lattice, derived from the same arithmetic, so the light and its source
// cannot drift apart. Everything else here is what stands in that light.
//
// LAYOUT. A cell owns four KERBS, one per plot edge. Each kerb carries, in
// its own across-coordinate:
//   * the lamp line, at the block edge +- CITY_LAMP_OFFSET — the core's
//     lattice, not a new one. A mast at every lattice point inside the cell,
//     with the luminaire arm reaching AWAY from the plot, out over the
//     roadway, which is where a real one hangs.
//   * the parking line, CAR_PARK_OFF in from the plot edge (the kerb proper).
//     Slots on a 7 m lattice in world space, so a run of cars lines up
//     across cell boundaries; ~35% occupied, scaled by the cascade the way
//     the streetlights are.
// Every prop lives strictly inside the cell that draws it, because the DDA
// tests a cell only from the side it enters (a box straddling a cell
// boundary is tested from one side and vanishes from the other). For
// merged 2x2 superblocks the plot edge can fall in a sibling's column; that
// kerb simply has no parking, and the sibling whose column does contain it
// draws those cars.
//
// THE CARS ARE THE POINT. A parked car is the one object in this city the
// camera can stand next to, and boxes with circles on them would say so
// immediately. Inside its bounding box, at fp < CAR_SDF_FP, a car is
// sphere-traced from a real SDF: a tapering lifting-body hull, smooth-min'd
// to a cabin bubble set back from the nose, wheels in cut arches (or a hover
// plenum and intake scallops, 38% of them), mirror stalks, wiper blades
// across the base of the windshield, and lamp housings and a nose intake cut
// as recesses. Detail to wiper-blade level and no further (Thomas,
// 2026-08-20): door seams, shut lines and a rocker crease are SHADING bands
// in the hull's own frame, which is where panel lines belong — no badges, no
// text, nothing that would be noise at 10 m.
//
// Beyond CAR_SDF_FP the hull falls back to two axis-aligned boxes cut to the
// same silhouette (hull + greenhouse); the 5-degree yaw jitter goes with it,
// which at that footprint is a sub-pixel corner.
//
// LIGHT. One lamp, straight overhead, is the entire lighting situation on a
// night street, so the shading is built around it: the incident estimate is
// the core's own asphalt formula (pool x district scale x CITY_LAMP_RADIANCE
// x CITY_LAMP_COLOR) and the direction is the vector to the nearest lamp
// HEAD, recovered from the same lattice. Curvature reads through the
// specular lobe sliding along the hull shoulder — Lambert alone on a dark
// paint at night is nearly flat, and the glint is what says "this surface is
// round". 30% of cars carry an underglow strip, 60/25/15 cyan/magenta/amber.
//
// COST. In order, each gate cheaper than the one it protects:
//   1. the segment's z range against 12 m — no hash, two multiply-adds, and
//      it rejects the whole hook for every pixel looking at a facade, a roof,
//      a cloud or the sky, which is most of them;
//   2. one slab test per kerb (4), spanning lamp line to parking line;
//   3. inside a live kerb, a second z test that drops the ground props
//      (everything under 1.7 m) for a segment that only passes through the
//      lamp heads;
//   4. the along-range of the segment picks at most 2 pole slots and 4
//      parking slots, walked from the near end with an early break, each one
//      hash-gated before any box test;
//   5. the SDF runs only for a ray that has already entered a car's bounding
//      box at fp < 0.5 m/px.
// Worst case for a ray running the length of a kerb at eye level is 1 slab +
// 2 poles x 2 boxes + 4 slots x 1 box = 9 box tests for that kerb; the three
// other kerbs of the same cell are crossed, not followed, and cost 1-3 each.
// t1 is narrowed by every hit found so far, so later kerbs see shorter
// segments than earlier ones.

// --- the lamp lattice (the core's, restated) --------------------------------
const cc_streetlife_Z_GATE: f32 = 12.0;   // whole-hook z reject
const cc_streetlife_POLE_H: f32 = 9.0;    // mast top
const cc_streetlife_POLE_TOP: f32 = 9.15; // slab ceiling
const cc_streetlife_MAST_R: f32 = 0.085;
const cc_streetlife_ARM_Z: f32 = 8.72;    // the arm's own centre height
const cc_streetlife_ARM_HZ: f32 = 0.065;
const cc_streetlife_ARM_REACH: f32 = 1.35;
const cc_streetlife_HEAD_Z: f32 = 8.56;   // luminaire centre
const cc_streetlife_HEAD_HZ: f32 = 0.115;
const cc_streetlife_HEAD_HA: f32 = 0.17;  // half-extent along the kerb
const cc_streetlife_HEAD_HC: f32 = 0.40;  // half-extent along the arm
// A sodium luminaire seen from underneath is the brightest thing on the
// street by a wide margin — an order over the pool it throws (0.7) and twice
// a lit window (3.5). The housing above it is opaque and near-black, which
// is what stops a row of lamps reading as floating lozenges.
const cc_streetlife_HEAD_RAD: f32 = 6.0;
const cc_streetlife_HEAD_COLOR: vec3<f32> = vec3<f32>(1.0, 0.52, 0.18);
// The housing is a box, so the lens has to be found in the shader: the lower
// lip of each side face is the glass, the rest of the side and the whole top
// are painted aluminium. At a uniform 0.34 of RAD every side face clipped to
// white along with the underside, and a luminaire whose cowl is as bright as
// its lamp is the floating lozenge this was supposed to avoid.
const cc_streetlife_HEAD_SIDE: f32 = 0.62;  // lens lip, fraction of RAD
const cc_streetlife_HEAD_COWL: f32 = 0.030; // painted housing, same units
const cc_streetlife_HEAD_LIP: f32 = 0.072;  // how far the lens runs up (m)
// Galvanised steel, seen at night, lit by a lamp standing on its own axis.
// The Lambert term is deliberately tiny and the grazing edge does the work:
// at MAST_ALB 0.10 the first pass rendered a flat gold bar that read as a
// wooden telegraph pole, because a diffuse fraction of a clipped sodium road
// is a clipped sodium pole. A dark face between two bright edges is both the
// correct photometry for a cylinder under an axial source and the only thing
// that says "round" at this radius (see cc_streetlife_pole_shade).
const cc_streetlife_MAST_FILL: f32 = 0.06;
const cc_streetlife_MAST_ALB: f32 = 0.026;
const cc_streetlife_MAST_EDGE: f32 = 0.105;

// --- parking ----------------------------------------------------------------
// Cars park in the core's parking lane: the first CITY_PARK_W of carriageway
// outward from the kerb line (city_kerb_rect), on both kerbs of an avenue and
// on the one kerb city_park_side picks on a 6 m minor carriageway. The lamps
// stand on the sidewalk just inboard of that kerb, so a parked car is always
// in the brightest part of its pool.
//
// (Until 2026-09-23 the lane was set PARK_LANE outboard of the lamp line and
// required 1.6 m of clearance to the plot edge. The lamp-inset fix of
// 2026-08-20 put the lamp line 2.5 m from the plot edge on every street,
// which left 0.89 m, so no car parked anywhere in the city from then on —
// every kerb failed park_ok and the renders simply had no cars in them.)
const cc_streetlife_PARK_OFF: f32 = 1.20;   // kerb line to the car's centre
// No parking this close to the cross street's building line: the corner
// radius, the crosswalk and the stop line are all inside it.
const cc_streetlife_PARK_CLEAR: f32 = 6.0;
const cc_streetlife_SLOT: f32 = 7.0;
const cc_streetlife_OCC: f32 = 0.35;
const cc_streetlife_DENS_LO: f32 = 0.55;
const cc_streetlife_DENS_HI: f32 = 1.35;
const cc_streetlife_DENS_START: f32 = 0.005;
const cc_streetlife_DENS_FULL: f32 = 0.070;
const cc_streetlife_YAW: f32 = 0.0873;     // +- 5 degrees
const cc_streetlife_ALONG_JIT: f32 = 0.60;
const cc_streetlife_LAT_JIT: f32 = 0.16;

// Bounding box, in the car's own (along, across) frame. Wide enough for the
// hull yawed 5 degrees and for the mirror stalks; nothing but the reject test
// ever sees it, because the far silhouette is the two proxy boxes below.
const cc_streetlife_BB_A: f32 = 2.60;
const cc_streetlife_BB_C: f32 = 1.36;
const cc_streetlife_BB_Z: f32 = 1.74;
// The diagonal of a parked car's axis-aligned box at the full YAW (the box
// the walk tests: half-extents 2.71 x 1.58 x 1.74 m at 5 degrees), 6.51 m,
// rounded up: no ray is inside that box for longer, so none enters it more
// than this before the point where the walk starts looking.
const cc_streetlife_BB_DIAG: f32 = 6.6;
// Half-width of the parking band about park_c that a parked car's box can
// reach: LAT_JIT + BB_A sin(YAW) + BB_C cos(YAW) = 0.16 + 0.23 + 1.35 =
// 1.74 m, rounded up. The kerb slab covers it, and the slot walk looks only
// where the ray is inside it.
const cc_streetlife_PARK_BAND: f32 = 1.80;

// --- the hull ---------------------------------------------------------------
const cc_streetlife_HL: f32 = 2.32;    // hull half-length
const cc_streetlife_HW: f32 = 0.98;    // hull half-width, at its widest
const cc_streetlife_SILL: f32 = 0.26;  // hull underside
const cc_streetlife_BELT: f32 = 0.94;  // shoulder line
const cc_streetlife_ROOF: f32 = 1.46;
const cc_streetlife_HOVER_CUT: f32 = 0.65;  // draws above this hover
const cc_streetlife_HOVER_LIFT: f32 = 0.14;
const cc_streetlife_AXLE_X: f32 = 1.46;
const cc_streetlife_AXLE_Z: f32 = 0.35;
const cc_streetlife_TRACK: f32 = 0.82;   // wheel centreplane, |y|
const cc_streetlife_TYRE_R: f32 = 0.34;
const cc_streetlife_TYRE_HW: f32 = 0.135; // half the tread width
const cc_streetlife_ARCH_R: f32 = 0.43;
const cc_streetlife_ARCH_HW: f32 = 0.31;  // the arch cuts only the flank skin
const cc_streetlife_ARCH_Z: f32 = 0.29;
const cc_streetlife_RIM_R: f32 = 0.255;

// The SDF is approximate — the plan-form taper and the falling deck make the
// hull's half-extents functions of x, so |grad| runs above 1 near the nose.
// The march steps this fraction of the reported distance, which is what keeps
// it from stepping through the skin.
const cc_streetlife_STEP: f32 = 0.72;
// The march budget, and the reason it is not a compile-time constant. A
// literal bound here is unrolled by the driver, and because cell_props is
// inlined into a 512-iteration DDA loop the unrolled body costs occupancy on
// every city pixel in the frame — including the ones nowhere near a car. The
// measurement: 32 versus 12 iterations moved the `aerial` view, which never
// admits a single car to the SDF at all, from 0.52 s to 0.29 s. Selecting
// between two counts at run time keeps the loop rolled, and doubles as
// honest LOD: a car ten pixels across does not need a 34-step trace.
const cc_streetlife_ITERS: i32 = 34;
const cc_streetlife_ITERS_FAR: i32 = 16;
const cc_streetlife_ITER_FP: f32 = 0.09;
// How many car boxes one cell's near trace may try along a ray before it
// gives up: the first, and up to two more after a hull miss (see the
// fall-through in cc_streetlife_near_trace). Two were already enough on
// every pixel of test_parked_car_fall_through's views (one lost 308 to
// 1,058 car pixels a view of ~5,000); the third is margin, paid only by a
// ray that has missed two hulls.
const cc_streetlife_NEAR_TRIES: i32 = 3;

// --- LOD --------------------------------------------------------------------
// Below this footprint a car is sphere-traced; above it, two boxes. 0.5 m/px
// puts a car at ten pixels, which is where a curved shoulder stops being a
// thing you can see and starts being a thing you can only infer.
const cc_streetlife_CAR_SDF_FP: f32 = 0.50;
const cc_streetlife_FINE_FP: f32 = 0.10;   // wipers, and sharp seams
// Where cars and poles stop being traced at all, and where their emission
// has already ramped to zero so nothing pops. Set by cost, not by the eye:
// at fp 2.6 a car is under two pixels long and the sodium road behind it is
// what that pixel was going to be anyway, while every cell inside
// CITY_PROP_RANGE pays for the test. A pole is thinner but taller, and its
// luminaire is the brightest thing on the street, so it runs further.
const cc_streetlife_CAR_FAR_FP: f32 = 2.6;
const cc_streetlife_CAR_FAR_FADE: f32 = 1.6;
const cc_streetlife_POLE_FAR_FP: f32 = 4.0;
const cc_streetlife_POLE_FAR_FADE: f32 = 2.4;
// Seams, shut lines and lamp dots hand over to their own means here; past
// LOD_FULL a car's paint is one colour and its lamp is that lamp's mean over
// the face it sits on, which is what a long lens does to a parked car.
const cc_streetlife_DETAIL_LOD: vec2<f32> = vec2<f32>(0.06, 0.26);
const cc_streetlife_LAMP_LOD: vec2<f32> = vec2<f32>(0.10, 0.45);
// The population edge at CITY_PROP_RANGE, approached rather than stepped.
const cc_streetlife_FADE_START: f32 = 0.92;

// --- car light --------------------------------------------------------------
const cc_streetlife_GLOW_FRAC: f32 = 0.32; // cars carrying an underglow
const cc_streetlife_GLOW_RAD: f32 = 1.1;
const cc_streetlife_LAMP_RAD: f32 = 1.9;
// cc_streetlife_pool returns the core's own asphalt RADIANCE — what city_shade
// emits for the road, with no albedo applied at all. Everything here is a
// fraction of THAT, not of an irradiance, and the fractions are small on
// purpose. A downtown avenue's pool runs near radiance 10, and at exposure 6
// under a Reinhard with white point 15 anything past ~2.5 is white: the road
// under these cars is already clipped, so the whole readable range for a
// painted panel is radiance 0.02 to 0.4. The first pass shaded cars at a
// physical-looking reflectance of the pool and produced pale ceramic
// bathtubs. Dark cars against a hot sodium road is both the correct
// photometry and the shot.
const cc_streetlife_PAINT_GAIN: f32 = 0.10;
const cc_streetlife_GLOSS: f32 = 1.2;
const cc_streetlife_SHEEN: f32 = 0.025;
const cc_streetlife_GLASS_GLOSS: f32 = 4.0;
const cc_streetlife_GLASS_ROAD: f32 = 0.055;
const cc_streetlife_ROAD_BOUNCE: f32 = 0.055;
const cc_streetlife_TYRE_ALB: f32 = 0.0045;
const cc_streetlife_RIM_ALB: f32 = 0.055;

// ---------------------------------------------------------------------------
// SDF primitives
// ---------------------------------------------------------------------------

fn cc_streetlife_rbox(p: vec3<f32>, b: vec3<f32>, r: f32) -> f32 {
    let q = abs(p) - b + vec3<f32>(r);
    return length(max(q, vec3<f32>(0.0)))
         + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}

// Capped cylinder whose axis is y (the car's across direction: wheels, arches
// and intake scallops all share it).
fn cc_streetlife_cyl_y(p: vec3<f32>, rad: f32, h: f32) -> f32 {
    let d = vec2<f32>(length(vec2<f32>(p.x, p.z)) - rad, abs(p.y) - h);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2<f32>(0.0)));
}

fn cc_streetlife_seg(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, rad: f32)
        -> f32 {
    let pa = p - a;
    let ba = b - a;
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * t) - rad;
}

fn cc_streetlife_smin(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

fn cc_streetlife_smax(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 - 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) + k * h * (1.0 - h);
}

fn cc_streetlife_miss(ci: vec2<i32>) -> CityHit {
    return CityHit(false, 1e30, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0),
                   0, ci);
}

fn cc_streetlife_nearer(a: CityHit, b: CityHit) -> CityHit {
    if (b.hit && (!a.hit || b.t < a.t)) {
        return b;
    }
    return a;
}

// ---------------------------------------------------------------------------
// The kerb: where a cell's four edges put their lamp line and parking line
// ---------------------------------------------------------------------------

struct cc_streetlife_Side {
    ax: i32,          // 0 = the kerb runs along x, 1 = along y
    line: i32,        // the centreline this kerb faces
    lamp_c: f32,      // lamp line, across coordinate
    park_c: f32,      // parking line, across coordinate
    plot_sign: f32,   // which way the plot lies from the kerb
    a_min: f32, a_max: f32,   // the cell's extent along the kerb
    c_min: f32, c_max: f32,   // the cell's extent across it
    p_min: f32, p_max: f32,   // where along the kerb a car may stand
    park_ok: bool,
}

fn cc_streetlife_side(ci: vec2<i32>, cc: CityCell, side: i32)
        -> cc_streetlife_Side {
    let cellm = u.ocean_params.x;
    let cmin = vec2<f32>(ci) * cellm;
    let cmax = cmin + vec2<f32>(cellm);
    let kr = city_kerb_rect(cc);
    var s: cc_streetlife_Side;
    var kerb_c: f32;
    var line: i32;            // the centreline this kerb faces
    if (side == 0) {          // the plot's -x edge; kerb runs along y
        s.ax = 1;
        line = ci.x;
        s.lamp_c = cmin.x + city_lamp_inset(line);
        kerb_c = kr.x;
        s.plot_sign = 1.0;
    } else if (side == 1) {   // +x edge
        s.ax = 1;
        line = ci.x + 1;
        s.lamp_c = cmax.x - city_lamp_inset(line);
        kerb_c = kr.z;
        s.plot_sign = -1.0;
    } else if (side == 2) {   // -y edge; kerb runs along x
        s.ax = 0;
        line = ci.y;
        s.lamp_c = cmin.y + city_lamp_inset(line);
        kerb_c = kr.y;
        s.plot_sign = 1.0;
    } else {                  // +y edge
        s.ax = 0;
        line = ci.y + 1;
        s.lamp_c = cmax.y - city_lamp_inset(line);
        kerb_c = kr.w;
        s.plot_sign = -1.0;
    }
    s.line = line;
    s.park_c = kerb_c - s.plot_sign * cc_streetlife_PARK_OFF;
    s.a_min = select(cmin.y, cmin.x, s.ax == 0);
    s.a_max = select(cmax.y, cmax.x, s.ax == 0);
    s.c_min = select(cmin.x, cmin.y, s.ax == 0);
    s.c_max = select(cmax.x, cmax.y, s.ax == 0);
    // Along the kerb, clear of the two cross streets' corners.
    let cm = u.ocean_params.x;
    let k0 = i32(round(s.a_min / cm));
    let k1 = i32(round(s.a_max / cm));
    s.p_min = s.a_min + CITY_STREET_HALF
            + select(0.0, CITY_AVENUE_EXTRA, city_is_avenue(k0))
            + cc_streetlife_PARK_CLEAR;
    s.p_max = s.a_max - CITY_STREET_HALF
            - select(0.0, CITY_AVENUE_EXTRA, city_is_avenue(k1))
            - cc_streetlife_PARK_CLEAR;
    // The kerb this parking lane runs along sits on the plot's side of the
    // centreline: + for a -x/-y edge, - for the others. A minor street parks
    // on one side only.
    let side_ok = city_is_avenue(line)
               || city_park_side(line) == s.plot_sign;
    // A merged superblock's plot edge can sit in a sibling's column; that
    // kerb keeps its lamps (they are on the cell's own lattice) and loses its
    // parking to whichever member owns the ground.
    s.park_ok = side_ok
             && s.park_c > s.c_min + cc_streetlife_BB_C
             && s.park_c < s.c_max - cc_streetlife_BB_C;
    return s;
}

// The nearest lamp HEAD to a street point, on the core's own lattice: the
// four candidates city_street_pools sums over, and the one that wins. Used
// as the light direction for everything this component shades.
fn cc_streetlife_nearest_lamp(p: vec2<f32>) -> vec3<f32> {
    let cellm = u.ocean_params.x;
    let bx = round(p.x / cellm) * cellm;
    let by = round(p.y / cellm) * cellm;
    let kx = i32(round(p.x / cellm));
    let ky = i32(round(p.y / cellm));
    let inx = city_lamp_inset(kx);
    let iny = city_lamp_inset(ky);
    let lx = city_lamp_station(ky, p.x);
    let ly = city_lamp_station(kx, p.y);
    var best = vec2<f32>(bx - inx, ly);
    var bd = 1e30;
    for (var k: i32 = 0; k < 4; k = k + 1) {
        var c: vec2<f32>;
        if (k == 0) {
            c = vec2<f32>(bx - inx, ly);
        } else if (k == 1) {
            c = vec2<f32>(bx + inx, ly);
        } else if (k == 2) {
            c = vec2<f32>(lx, by - iny);
        } else {
            c = vec2<f32>(lx, by + iny);
        }
        let d = dot(c - p, c - p);
        if (d < bd) {
            bd = d;
            best = c;
        }
    }
    return vec3<f32>(best, cc_streetlife_HEAD_Z);
}

// The core's own asphalt radiance at a street point, reused verbatim as the
// incident estimate for anything standing on it. Sharing the formula is the
// point: a car in a pool is exactly as lit as the tarmac it is parked on.
fn cc_streetlife_pool(p: vec2<f32>) -> vec3<f32> {
    let district = city_glow_sample(p, 2.0);
    let scale = 0.20 + 2.2 * smoothstep(0.02, 0.45, district);
    return CITY_LAMP_COLOR
         * (CITY_LAMP_RADIANCE * scale * city_street_pools(p));
}

fn cc_streetlife_fill(p: vec3<f32>) -> vec3<f32> {
    return CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(p.xy, 3.0));
}

// ---------------------------------------------------------------------------
// Placement
// ---------------------------------------------------------------------------

struct cc_streetlife_Prop {
    ok: bool,
    ctr: vec2<f32>,   // ground point under the prop's centre
    fwd: vec2<f32>,   // the prop's own forward, yaw included
    rgt: vec2<f32>,
    r: vec4<f32>,
}

fn cc_streetlife_no_prop() -> cc_streetlife_Prop {
    return cc_streetlife_Prop(false, vec2<f32>(0.0),
                              vec2<f32>(1.0, 0.0), vec2<f32>(0.0, -1.0),
                              vec4<f32>(0.0));
}

// Tile-wrapped (city_tile_cell): a parked car belongs to its tile
// coordinate, so live and replay park the same cars in the same bays.
fn cc_streetlife_slot_draw(ci: vec2<i32>, side: i32, j: i32) -> vec4<f32> {
    let cw = city_tile_cell(ci);
    return city_rand4(vec2<u32>(
        bitcast<u32>(cw.x) * 0x9e3779b9u + u32(side) * 0x2545f491u
            + bitcast<u32>(j) * 0x85ebca6bu + 0x51ed270bu,
        bitcast<u32>(cw.y) * 0xc2b2ae35u + u32(side) * 0x27d4eb2fu
            + bitcast<u32>(j) * 0x165667b1u + 0x9e3779b9u));
}

// Whatever occupies slot `j` of kerb `side` — deterministic in (cell, side,
// slot) alone, so the shader re-derives a car from its hit position without
// anything being smuggled through CityHit.
fn cc_streetlife_prop(ci: vec2<i32>, cc: CityCell, s: cc_streetlife_Side,
                      side: i32, j: i32) -> cc_streetlife_Prop {
    if (!s.park_ok) {
        return cc_streetlife_no_prop();
    }
    let r = cc_streetlife_slot_draw(ci, side, j);
    let dens = mix(cc_streetlife_DENS_LO, cc_streetlife_DENS_HI,
                   smoothstep(cc_streetlife_DENS_START,
                              cc_streetlife_DENS_FULL, cc.density));
    let occ = cc_streetlife_OCC * dens;
    if (r.x >= occ) {
        return cc_streetlife_no_prop();
    }
    // Slot centre on the world lattice, so a run of cars lines up across the
    // cell boundary rather than restarting inside every block.
    let along = (f32(j) + 0.5) * cc_streetlife_SLOT
              + (r.y - 0.5) * 2.0 * cc_streetlife_ALONG_JIT;
    if (along - cc_streetlife_BB_A < s.p_min
        || along + cc_streetlife_BB_A > s.p_max) {
        return cc_streetlife_no_prop();
    }
    let across = s.park_c + (r.z - 0.5) * 2.0 * cc_streetlife_LAT_JIT;
    var base = vec2<f32>(1.0, 0.0);
    if (s.ax == 1) {
        base = vec2<f32>(0.0, 1.0);
    }
    // The across axis, positive: `across` is an absolute coordinate on the
    // other axis, so it must map onto it with a + sign on both kinds of kerb.
    // (A rotation, (-base.y, base.x), put every car of a y-running kerb at
    // x = -park_c, outside its cell and never drawn; no car parked anywhere
    // while that code was written, so nothing showed it.)
    let perp = vec2<f32>(base.y, base.x);
    let yaw = (r.w - 0.5) * 2.0 * cc_streetlife_YAW;
    var fwd = base * cos(yaw) + perp * sin(yaw);
    if (fract(r.y * 17.31) > 0.5) {
        fwd = -fwd;
    }
    var p: cc_streetlife_Prop;
    p.ok = true;
    p.ctr = base * along + perp * across;
    p.fwd = fwd;
    p.rgt = vec2<f32>(fwd.y, -fwd.x);
    p.r = r;
    return p;
}

// ---------------------------------------------------------------------------
// The car SDF
// ---------------------------------------------------------------------------
//
// Local frame: +x forward, +y left, z up from the road surface. Everything
// symmetric about the centreline is evaluated once on abs(y), and the wheels
// and lamp housings once on abs(x) too — four wheels for the price of one
// cylinder.

// Two draws of shape per car: an overall scale, and where the cabin sits
// fore and aft. Between them a row of parked cars stops being one model
// repeated — a short car with the cabin back is a coupe, a long one with it
// forward is a saloon, and the eye reads the difference before it reads any
// panel line.
fn cc_streetlife_car_shape(r: vec4<f32>) -> vec2<f32> {
    return vec2<f32>(0.92 + 0.13 * fract(r.z * 7.71),
                     -0.30 + (fract(r.w * 11.37) - 0.5) * 0.34);
}

// Which cars hover. This must NOT be read off r.x, and that it was is the one
// outright bug the salvaged draft carried: r.x is the OCCUPANCY draw, and a
// slot holds a car only where r.x < occ — at most 0.47 even downtown — so a
// hover test of `r.x > 0.62` was unreachable in every cell of the city. Nobody
// would ever have seen it fail; the plenum, the skirt and the intake scallops
// simply never ran. An independent draw off the other three components gives
// the ~35% the file always claimed.
fn cc_streetlife_is_hover(r: vec4<f32>) -> bool {
    return fract(r.y * 43.17 + r.z * 7.31 + r.w * 2.53)
           > cc_streetlife_HOVER_CUT;
}

fn cc_streetlife_car_sdf(p: vec3<f32>, r: vec4<f32>, fine: bool) -> f32 {
    let hover = cc_streetlife_is_hover(r);
    let lift = select(0.0, cc_streetlife_HOVER_LIFT, hover);
    let sh = cc_streetlife_car_shape(r);
    let q = vec3<f32>(p.x, p.y, p.z - lift) / sh.x;
    let cab_c = sh.y;
    let off = cab_c + 0.30;

    // Plan-form: the hull narrows toward both ends, hard at the very tips.
    let xn = clamp(q.x / cc_streetlife_HL, -1.0, 1.0);
    let xn2 = xn * xn;
    let xn4 = xn2 * xn2;
    let hw = cc_streetlife_HW * (1.0 - 0.34 * xn4);
    // Profile: the deck falls away toward the nose and, less, toward the
    // tail. A flat deck is what makes a box read as a box.
    let drop = select(0.08, 0.16, xn > 0.0);
    let deck = cc_streetlife_BELT - drop * xn2;
    let hc = 0.5 * (deck + cc_streetlife_SILL);
    let hh = 0.5 * (deck - cc_streetlife_SILL);
    var d = cc_streetlife_rbox(vec3<f32>(q.x, q.y, q.z - hc),
                               vec3<f32>(cc_streetlife_HL, hw, hh), 0.22);

    // The greenhouse: inset from the shoulder, set back from the nose, and
    // blended only just enough to give it a fillet. A soft blend here is what
    // turned the first pass into a loaf — the shoulder line has to survive.
    // Rounded hard, this reads as a bubble stuck on the deck rather than as
    // a cabin: the roof has to be flat enough to be a roof and the side glass
    // near enough to vertical to be glass.
    let cx = q.x - cab_c;
    var cab = cc_streetlife_rbox(
        vec3<f32>(cx, q.y, q.z - 1.20),
        vec3<f32>(0.92, 0.74, 0.26), 0.10);
    // TUMBLEHOME. The side glass leans in toward the roof, so the greenhouse
    // is a tapered turret rather than a box, and its widest point is the belt
    // line where it meets the shoulder. Without this the cabin read as a loaf
    // of bread set on the deck — full-width, vertical-sided, visibly a second
    // box. One slanted half-space does the whole job; the 0.958 is 1/|grad|,
    // which keeps the march from stepping through the lean.
    cab = cc_streetlife_smax(
        cab, 0.958 * (abs(q.y) - 0.74 + 0.30 * (q.z - 1.02)), 0.07);
    // Windshield and backlight rake: two half-spaces that take the front and
    // rear off the greenhouse, so the cabin is a cabin and not a second box.
    // Cut into the cabin alone — applied to the whole hull the front plane
    // would take the bonnet with it. The planes are placed to MEET THE BELT,
    // not to clip a corner: the first pass's intercepts put the start of the
    // windshield at cx 1.18, outside the cabin box entirely, so the rake took
    // only the top corner and everything below it stayed the box's own
    // vertical wall — which is exactly what the renders showed. Now the glass
    // starts within 5 mm of the shoulder and the roof comes out 1.14 m long
    // by 1.22 wide, which is a car; the first pass's would have been 0.66 by
    // 1.22, which is a bubble canopy.
    cab = cc_streetlife_smax(cab, 0.824 * cx + 0.567 * q.z - 1.339, 0.10);
    cab = cc_streetlife_smax(cab, -0.745 * cx + 0.667 * q.z - 1.361, 0.10);
    d = cc_streetlife_smin(d, cab, 0.11);

    // WHEELS AND ARCHES, both mirrored on abs(y) so there are four of them.
    //
    // The first pass mirrored only on abs(x) and gave the cylinders a
    // half-width of 0.86 — wider than the hull's own 0.98 half-width. That is
    // not four wheels, it is two drums spanning the full track, and the arch
    // that cut them free was 1.10 wide, which bored a tunnel clean through
    // the body. From the side the two errors cancelled and it read correctly;
    // head-on the drum showed under the nose as a hard dark bar with square
    // ends, wider than the car, and it is visible in every frontal frame the
    // draft ever produced. Splitting them fixes the frontal read and makes
    // the arch what an arch actually is: a cut in the outer skin of a flank.
    let qa = vec3<f32>(abs(q.x) - cc_streetlife_AXLE_X,
                       abs(q.y) - cc_streetlife_TRACK,
                       q.z - cc_streetlife_ARCH_Z);
    if (hover) {
        // A plenum instead of wheels, and the arches become intake scallops
        // cut into the flanks — the same silhouette cue read the other way.
        let skirt = cc_streetlife_rbox(
            vec3<f32>(q.x, q.y, q.z - 0.14),
            vec3<f32>(1.94, 0.80, 0.09), 0.08);
        d = cc_streetlife_smin(d, skirt, 0.13);
        let scallop = cc_streetlife_cyl_y(
            vec3<f32>(qa.x, qa.y - 0.10, qa.z), 0.30,
            cc_streetlife_ARCH_HW + 0.10);
        d = cc_streetlife_smax(d, -scallop, 0.05);
    } else {
        let arch = cc_streetlife_cyl_y(
            vec3<f32>(qa.x, qa.y - 0.13, qa.z),
            cc_streetlife_ARCH_R, cc_streetlife_ARCH_HW);
        d = cc_streetlife_smax(d, -arch, 0.035);
        let tyre = cc_streetlife_cyl_y(
            vec3<f32>(qa.x, qa.y, q.z - cc_streetlife_AXLE_Z),
            cc_streetlife_TYRE_R, cc_streetlife_TYRE_HW);
        d = min(d, tyre);
    }

    // Door mirrors, at the base of the A-pillar. A bare capsule reaching from
    // the cabin flank to the hull's widest point — which is what the first
    // pass had — renders as a dark bar floating clear of the car, because a
    // uniform 10 cm cylinder 30 cm long is a stick and nothing about it says
    // mirror. A mirror is a SHORT arm carrying a HOUSING, and the housing is
    // what the eye finds: a flat-backed pod, wider than it is tall.
    let qm = vec3<f32>(q.x - 0.74 - off, abs(q.y), q.z - 1.01);
    d = min(d, cc_streetlife_seg(qm, vec3<f32>(0.0, 0.60, 0.0),
                                 vec3<f32>(0.02, 0.76, 0.03), 0.032));
    d = min(d, cc_streetlife_rbox(qm - vec3<f32>(0.0, 0.855, 0.035),
                                  vec3<f32>(0.075, 0.095, 0.055), 0.038));

    // Lamp housings, cut as recesses at nose and tail, and an intake slot
    // low in the nose. The recess is a LETTERBOX — wider than tall — because
    // the lens the shader paints inside it is an ellipse of the same aspect,
    // and a round lens in a round hole is the headlight shape that made the
    // first pass read as a face with eyes.
    let ql = vec3<f32>(abs(q.x) - 2.15, abs(q.y) - 0.50, q.z - 0.71);
    d = cc_streetlife_smax(
        d, -cc_streetlife_rbox(ql, vec3<f32>(0.13, 0.27, 0.082), 0.04), 0.022);
    let qi = vec3<f32>(q.x - 2.06, q.y, q.z - 0.40);
    d = cc_streetlife_smax(
        d, -cc_streetlife_rbox(qi, vec3<f32>(0.16, 0.44, 0.055), 0.03), 0.03);

    if (fine) {
        // Wiper blades across the base of the windshield. At the footprint
        // that admits them a blade is two or three pixels of hard line on a
        // dark curved reflection, which is exactly what says "windscreen".
        let qw = vec3<f32>(q.x - off, abs(q.y), q.z);
        d = min(d, cc_streetlife_seg(qw, vec3<f32>(0.66, 0.07, 0.925),
                                     vec3<f32>(1.00, 0.52, 0.908), 0.021));
    }
    return d * sh.x;
}

// World point -> the car's own frame.
fn cc_streetlife_to_local(w: vec3<f32>, ctr: vec2<f32>, fwd: vec2<f32>,
                          rgt: vec2<f32>) -> vec3<f32> {
    let rel = w.xy - ctr;
    return vec3<f32>(dot(rel, fwd), dot(rel, rgt), w.z);
}

fn cc_streetlife_car_normal(pl: vec3<f32>, r: vec4<f32>, fine: bool, hh: f32)
        -> vec3<f32> {
    let e = vec2<f32>(1.0, -1.0) * hh;
    let n = vec3<f32>(1.0, -1.0, -1.0)
            * cc_streetlife_car_sdf(pl + vec3<f32>(e.x, e.y, e.y), r, fine)
          + vec3<f32>(-1.0, -1.0, 1.0)
            * cc_streetlife_car_sdf(pl + vec3<f32>(e.y, e.y, e.x), r, fine)
          + vec3<f32>(-1.0, 1.0, -1.0)
            * cc_streetlife_car_sdf(pl + vec3<f32>(e.y, e.x, e.y), r, fine)
          + vec3<f32>(1.0, 1.0, 1.0)
            * cc_streetlife_car_sdf(pl + vec3<f32>(e.x, e.x, e.x), r, fine);
    // @domain: the SDF's gradient at a surface point: nonzero off the medial axis
    return normalize(n);
}

// Sphere-trace one car inside a bounding box the ray has already entered.
// A miss inside the box is a real answer, not a failure: rays graze past a
// curved hull, and that is what makes the hull read as curved.
fn cc_streetlife_trace_car(o: vec3<f32>, dir: vec3<f32>, ta: f32, tb: f32,
                           v: cc_streetlife_Prop, ci: vec2<i32>, side: i32,
                           fp: f32) -> CityHit {
    let fine = fp < cc_streetlife_FINE_FP;
    let eps = max(0.0025, 0.30 * fp);
    let iters = select(cc_streetlife_ITERS, cc_streetlife_ITERS_FAR,
                       fp > cc_streetlife_ITER_FP);
    var t = ta + 0.001;
    var got = false;
    for (var i: i32 = 0; i < iters; i = i + 1) {
        let pl = cc_streetlife_to_local(o + t * dir, v.ctr, v.fwd, v.rgt);
        let d = cc_streetlife_car_sdf(pl, v.r, fine);
        if (d < eps) {
            got = true;
            break;
        }
        t = t + d * cc_streetlife_STEP;
        if (t > tb) {
            break;
        }
    }
    if (!got || t > tb) {
        // Past the hull and down to the road inside the car's box: where
        // the car shades it, the road says so (kind 106 + side,
        // cc_streetlife_under_shade) — without it a parked car floats.
        // Where it does not, this is a miss and the core's own ground (wet,
        // and reflecting) is what the ray meets, so the shadow ends where
        // its ramp does and not at the box.
        if (dir.z < 0.0) {
            // A millimetre in front of the road, because the core's own
            // ground hit lands at the same t and a prop must be strictly
            // nearer to win the DDA's comparison.
            let tg = -o.z / dir.z - 1e-3;
            if (tg >= ta && tg <= tb) {
                let pg = o + tg * dir;
                let pl = cc_streetlife_to_local(pg, v.ctr, v.fwd, v.rgt);
                if (cc_streetlife_under_occ(pl.xy, v.r) < 1.0) {
                    return CityHit(true, tg, pg, vec3<f32>(0.0, 0.0, 1.0),
                                   106 + side, ci);
                }
            }
        }
        return cc_streetlife_miss(ci);
    }
    let pos = o + t * dir;
    let pl = cc_streetlife_to_local(pos, v.ctr, v.fwd, v.rgt);
    let nl = cc_streetlife_car_normal(pl, v.r, fine, max(0.004, 0.4 * fp));
    let nw = vec3<f32>(v.fwd * nl.x + v.rgt * nl.y, nl.z);
    return CityHit(true, t, pos, nw, 102 + side, ci);
}

// The far read: hull and greenhouse as two axis-aligned boxes cut to the
// SDF's own silhouette. The yaw goes with the SDF, which at this footprint
// is a sub-pixel corner.
fn cc_streetlife_trace_car_box(o: vec3<f32>, inv_dir: vec3<f32>, dir: vec3<f32>,
                               t0: f32, t1: f32, v: cc_streetlife_Prop,
                               ci: vec2<i32>, side: i32) -> CityHit {
    let hover = cc_streetlife_is_hover(v.r);
    let lift = select(0.0, cc_streetlife_HOVER_LIFT, hover);
    let ea = abs(v.fwd) * 2.24 + abs(v.rgt) * 0.90;
    let eb = abs(v.fwd) * 1.06 + abs(v.rgt) * 0.76;
    let amin = vec3<f32>(v.ctr - ea, select(0.02, lift + 0.10, hover));
    let amax = vec3<f32>(v.ctr + ea, lift + 1.00);
    let bmin = vec3<f32>(v.ctr - eb + v.fwd * -0.24, lift + 0.94);
    let bmax = vec3<f32>(v.ctr + eb + v.fwd * -0.24,
                         lift + cc_streetlife_ROOF);
    var best = 1e30;
    var bmn = amin;
    var bmx = amax;
    let ha = city_box_hit(o, inv_dir, amin, amax);
    if (ha.x <= ha.y && ha.y > t0 && ha.x <= t1) {
        best = max(ha.x, t0);
    }
    let hb = city_box_hit(o, inv_dir, bmin, bmax);
    if (hb.x <= hb.y && hb.y > t0 && hb.x <= t1 && max(hb.x, t0) < best) {
        best = max(hb.x, t0);
        bmn = bmin;
        bmx = bmax;
    }
    if (best >= 1e30) {
        return cc_streetlife_miss(ci);
    }
    let pos = o + best * dir;
    return CityHit(true, best, pos, city_box_normal(pos, bmn, bmx),
                   102 + side, ci);
}

// ---------------------------------------------------------------------------
// One kerb
// ---------------------------------------------------------------------------

fn cc_streetlife_pole(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                      t0: f32, t1: f32, s: cc_streetlife_Side, a: f32,
                      ci: vec2<i32>, fp: f32) -> CityHit {
    // The arm hangs AWAY from the plot, out over the roadway.
    let arm = -s.plot_sign;
    let head_c = s.lamp_c + arm * cc_streetlife_ARM_REACH;
    var mmin: vec3<f32>;
    var mmax: vec3<f32>;
    var hmin: vec3<f32>;
    var hmax: vec3<f32>;
    if (s.ax == 0) {
        mmin = vec3<f32>(a - cc_streetlife_MAST_R,
                         s.lamp_c - cc_streetlife_MAST_R, 0.0);
        mmax = vec3<f32>(a + cc_streetlife_MAST_R,
                         s.lamp_c + cc_streetlife_MAST_R,
                         cc_streetlife_POLE_H);
        hmin = vec3<f32>(a - cc_streetlife_HEAD_HA,
                         head_c - cc_streetlife_HEAD_HC,
                         cc_streetlife_HEAD_Z - cc_streetlife_HEAD_HZ);
        hmax = vec3<f32>(a + cc_streetlife_HEAD_HA,
                         head_c + cc_streetlife_HEAD_HC,
                         cc_streetlife_HEAD_Z + cc_streetlife_HEAD_HZ);
    } else {
        mmin = vec3<f32>(s.lamp_c - cc_streetlife_MAST_R,
                         a - cc_streetlife_MAST_R, 0.0);
        mmax = vec3<f32>(s.lamp_c + cc_streetlife_MAST_R,
                         a + cc_streetlife_MAST_R, cc_streetlife_POLE_H);
        hmin = vec3<f32>(head_c - cc_streetlife_HEAD_HC,
                         a - cc_streetlife_HEAD_HA,
                         cc_streetlife_HEAD_Z - cc_streetlife_HEAD_HZ);
        hmax = vec3<f32>(head_c + cc_streetlife_HEAD_HC,
                         a + cc_streetlife_HEAD_HA,
                         cc_streetlife_HEAD_Z + cc_streetlife_HEAD_HZ);
    }
    var best = 1e30;
    var bmn = mmin;
    var bmx = mmax;
    var kind = 100;
    let hm = city_box_hit(o, inv_dir, mmin, mmax);
    if (hm.x <= hm.y && hm.y > t0 && hm.x <= t1) {
        best = max(hm.x, t0);
    }
    let hh = city_box_hit(o, inv_dir, hmin, hmax);
    if (hh.x <= hh.y && hh.y > t0 && hh.x <= t1 && max(hh.x, t0) < best) {
        best = max(hh.x, t0);
        bmn = hmin;
        bmx = hmax;
        kind = 101;
    }
    // The arm is a 0.13 m bar: it only earns a box test while it is a
    // resolvable line rather than an aliasing one. Past that the mast and the
    // luminaire carry the pole, which is what the eye reads anyway.
    if (fp < 0.30) {
        var amin: vec3<f32>;
        var amax: vec3<f32>;
        let c0 = min(s.lamp_c, head_c);
        let c1 = max(s.lamp_c, head_c);
        if (s.ax == 0) {
            amin = vec3<f32>(a - 0.055, c0,
                             cc_streetlife_ARM_Z - cc_streetlife_ARM_HZ);
            amax = vec3<f32>(a + 0.055, c1,
                             cc_streetlife_ARM_Z + cc_streetlife_ARM_HZ);
        } else {
            amin = vec3<f32>(c0, a - 0.055,
                             cc_streetlife_ARM_Z - cc_streetlife_ARM_HZ);
            amax = vec3<f32>(c1, a + 0.055,
                             cc_streetlife_ARM_Z + cc_streetlife_ARM_HZ);
        }
        let ha = city_box_hit(o, inv_dir, amin, amax);
        if (ha.x <= ha.y && ha.y > t0 && ha.x <= t1 && max(ha.x, t0) < best) {
            best = max(ha.x, t0);
            bmn = amin;
            bmx = amax;
            kind = 100;
        }
    }
    if (best >= 1e30) {
        return cc_streetlife_miss(ci);
    }
    let pos = o + best * dir;
    return CityHit(true, best, pos, city_box_normal(pos, bmn, bmx), kind, ci);
}

// What one kerb found. The sphere trace is deliberately NOT run here: a near
// car is returned as a CANDIDATE and resolved once per cell, after all four
// kerbs have reported. The reason is measured rather than stylistic — see the
// note in cc_streetlife_props_trace.
struct cc_streetlife_Kerb {
    hit: CityHit,      // already resolved: poles, far cars
    car_ok: bool,      // a near car whose bounding box the ray entered
    car: cc_streetlife_Prop,
    side: i32,
    ta: f32,
    tb: f32,           // the box interval to sphere-trace inside
}

// The core's LOD pixel angle, the one both surface stages' footprints are
// taken from (and so the one the per-car stage switch must use).
fn cc_streetlife_pa() -> f32 {
    return lod_pixel_angle();
}

// `near` picks the stage: false for the view ray's first stage (poles, and
// the cars far enough to be drawn as boxes), true for the street stage (the
// cars close enough to be sphere-traced, cc_streetlife_near_trace). Every
// call passes a constant, so each stage inlines only its own half.
fn cc_streetlife_kerb(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                      t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell,
                      side: i32, fp: f32, near: bool) -> cc_streetlife_Kerb {
    var out: cc_streetlife_Kerb;
    out.hit = cc_streetlife_miss(ci);
    out.car_ok = false;
    out.car = cc_streetlife_no_prop();
    out.side = side;
    out.ta = 0.0;
    out.tb = 0.0;

    let s = cc_streetlife_side(ci, cc, side);
    // One slab over the whole kerb: lamp line to parking line, ground to the
    // top of a mast, clipped to the cell's own column. This is the test the
    // wide scene pays, and the only one most cells ever reach.
    let arm_c = s.lamp_c - s.plot_sign * (cc_streetlife_ARM_REACH + 0.5);
    var lo = min(min(s.lamp_c, arm_c), s.park_c - cc_streetlife_PARK_BAND);
    var hi = max(max(s.lamp_c, arm_c), s.park_c + cc_streetlife_PARK_BAND);
    if (!s.park_ok) {
        lo = min(s.lamp_c, arm_c);
        hi = max(s.lamp_c, arm_c);
    }
    lo = max(lo - 0.2, s.c_min);
    hi = min(hi + 0.2, s.c_max);
    if (hi <= lo) {
        return out;
    }
    var bmin: vec3<f32>;
    var bmax: vec3<f32>;
    if (s.ax == 0) {
        bmin = vec3<f32>(s.a_min, lo, 0.0);
        bmax = vec3<f32>(s.a_max, hi, cc_streetlife_POLE_TOP);
    } else {
        bmin = vec3<f32>(lo, s.a_min, 0.0);
        bmax = vec3<f32>(hi, s.a_max, cc_streetlife_POLE_TOP);
    }
    let sb = city_box_hit(o, inv_dir, bmin, bmax);
    let ta = max(sb.x, t0);
    let tb = min(sb.y, t1);
    if (sb.x > sb.y || tb <= ta) {
        return out;
    }

    let pa = o + ta * dir;
    let pb = o + tb * dir;
    let sa = select(pa.y, pa.x, s.ax == 0);
    let sc = select(pb.y, pb.x, s.ax == 0);
    let s_lo = min(sa, sc);
    let s_hi = max(sa, sc);
    let z_lo = min(pa.z, pb.z);
    let fwd_first = select(dir.y, dir.x, s.ax == 0) >= 0.0;

    var res = cc_streetlife_miss(ci);
    var t_end = tb;

    // Poles, on the core's lamp lattice for this street
    // (city_lamp_lattice), restricted to those standing wholly inside this
    // cell.
    if (!near && fp < cc_streetlife_POLE_FAR_FP) {
        let lat = city_lamp_lattice(s.line);
        let sp = lat.x;
        var j0 = i32(ceil((s_lo - 0.45 - lat.y) / sp));
        var j1 = i32(floor((s_hi + 0.45 - lat.y) / sp));
        j0 = max(j0, i32(ceil((s.a_min + 0.45 - lat.y) / sp)));
        j1 = min(j1, i32(floor((s.a_max - 0.45 - lat.y) / sp)));
        if (j1 >= j0) {
            let jstart = select(j1, j0, fwd_first);
            let jstep = select(-1, 1, fwd_first);
            // Walked from the near end, so the first pole the ray actually
            // strikes is the nearest and the loop is done.
            for (var k: i32 = 0; k < 3; k = k + 1) {
                let j = jstart + k * jstep;
                if (j < j0 || j > j1) {
                    break;
                }
                let hp = cc_streetlife_pole(o, dir, inv_dir, ta, t_end, s,
                                            lat.y + f32(j) * sp, ci, fp);
                if (hp.hit) {
                    res = cc_streetlife_nearer(res, hp);
                    t_end = min(t_end, res.t);
                    break;
                }
            }
        }
    }

    // Ground props: everything below is under 1.8 m, so a segment that only
    // clips the lamp heads stops here.
    out.hit = res;
    if (!s.park_ok || z_lo > cc_streetlife_BB_Z + 0.1
        || fp > cc_streetlife_CAR_FAR_FP) {
        return out;
    }
    // The slots are walked over the stretch of the run below the car tops
    // only. The kerb slab is pole-tall, so a ray coming down from a few
    // metres up crosses it for tens of metres before it is low enough to
    // meet a car, and the five near-end slots used to be spent on slots it
    // passes high over: from 6 m up, the parked cars of the whole block
    // ahead were missing. (inv_dir.z is the core's, 1e30 when level, which
    // gives the right empty or unbounded window.)
    // And only where it is inside the parking band across the kerb: with
    // the z window this is the stretch where a car can be, so the walk's
    // slots are spent on cars and not on the lane either side of them.
    let tz0 = (0.0 - o.z) * inv_dir.z;
    let tz1 = (cc_streetlife_BB_Z - o.z) * inv_dir.z;
    let oc = select(o.x, o.y, s.ax == 0);
    let ic = select(inv_dir.x, inv_dir.y, s.ax == 0);
    let tc0 = (s.park_c - cc_streetlife_PARK_BAND - oc) * ic;
    let tc1 = (s.park_c + cc_streetlife_PARK_BAND - oc) * ic;
    let ca = max(max(ta, min(tz0, tz1)), min(tc0, tc1));
    let cb = min(min(tb, max(tz0, tz1)), max(tc0, tc1));
    if (cb <= ca) {
        return out;
    }
    // A car close enough for the SDF is the street stage's, the rest the
    // first stage's (which so never compiles the SDF — in the first stage it
    // cost 13% of the city's surface time even on views with barely a pixel
    // of near car in them). Each car decides by its OWN box entry,
    // max(hc.x, 0) against t_sw = CAR_SDF_FP / pa: both stages trace from the same
    // origin with the same inv_dir and box, so they compute the same number
    // and every car is exactly one stage's. (Deciding by the segment's entry
    // instead let a car fall through: the street stage starts its walk where
    // the ray comes down to 3 m, not at the cell's entry.) t_sw is where
    // that switch falls on this ray; each stage walks only its side of it,
    // and leaves when its side holds no car.
    let pxa = cc_streetlife_pa();
    let t_sw = cc_streetlife_CAR_SDF_FP / pxa;
    if (near && ca - cc_streetlife_BB_DIAG >= t_sw) {
        return out;   // every entry here is past the switch
    }
    if (!near && cb < t_sw) {
        return out;   // every entry here is short of it
    }
    let ws = select(clamp(t_sw, ca, cb), ca, near);
    let we = select(cb, clamp(t_sw, ca, cb), near);
    let qa = o + ws * dir;
    let qb = o + we * dir;
    let ua = select(qa.y, qa.x, s.ax == 0);
    let ub = select(qb.y, qb.x, s.ax == 0);
    let g0 = i32(floor((min(ua, ub) - cc_streetlife_BB_A)
                       / cc_streetlife_SLOT));
    let g1 = i32(floor((max(ua, ub) + cc_streetlife_BB_A)
                       / cc_streetlife_SLOT));
    let gstart = select(g1, g0, fwd_first);
    let gstep = select(-1, 1, fwd_first);
    // Same rule as the poles: near end first, stop at the first prop the ray
    // actually strikes. Five iterations is what an empty run costs in the
    // first stage, and at ~40% occupancy the loop usually ends on the first
    // or the second. The street stage only picks a candidate box here, so it
    // walks twelve (84 m of kerb): an eye at kerb height looking along the
    // parking lane passes many empty slots before the car it meets.
    let n_walk = select(5, 12, near);
    for (var k: i32 = 0; k < n_walk; k = k + 1) {
        let j = gstart + k * gstep;
        if (j < g0 || j > g1) {
            break;
        }
        let v = cc_streetlife_prop(ci, cc, s, side, j);
        if (!v.ok) {
            continue;
        }
        // The bounding box: the only cost the wide scene pays for a car.
        let e = abs(v.fwd) * cc_streetlife_BB_A
              + abs(v.rgt) * cc_streetlife_BB_C;
        let cmin = vec3<f32>(v.ctr - e, 0.0);
        let cmax = vec3<f32>(v.ctr + e, cc_streetlife_BB_Z);
        let hc = city_box_hit(o, inv_dir, cmin, cmax);
        if (hc.x > hc.y || hc.y <= ta || hc.x > t_end
            || (max(hc.x, 0.0) < t_sw) != near) {
            continue;
        }
        if (near) {
            out.car_ok = true;
            out.car = v;
            out.ta = max(hc.x, ta);
            out.tb = min(hc.y, t_end);
            t_end = min(t_end, out.ta);
            break;
        }
        let hit = cc_streetlife_trace_car_box(o, inv_dir, dir, ta, t_end, v,
                                              ci, side);
        if (hit.hit) {
            res = cc_streetlife_nearer(res, hit);
            t_end = min(t_end, res.t);
            break;
        }
    }
    out.hit = res;
    return out;
}

// ---------------------------------------------------------------------------
// The sidewalk slab
// ---------------------------------------------------------------------------
//
// The raised sidewalk around a plot that has one (city_has_walk): the prism
// over the core's kerb rectangle, CITY_KERB_H tall, its corners rounded
// exactly as city_kerb_sd rounds them. Its TOP is ground, returned as kind
// 0, so the core shades it — and reflects off it — with the same function
// that shades the z = 0 plane beyond this hook's reach; the step itself is
// sub-pixel by then, and the two cannot disagree about anything but it.
// Only the kerb FACE is this component's (kind 110).
//
// The prism is convex, so its entry is the box's entry — unless that entry
// lands in a corner square the rounding cut away. Then the only way into the
// prism is through that corner's capped cylinder: inside the box, leaving
// the cut-away sliver means crossing its arc or leaving the box. One slab
// test, and one cylinder for the rays that clip a corner.

const cc_streetlife_SLAB_FP: f32 = 1.2;   // past this the step is 0.1 px

fn cc_streetlife_slab(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                      t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    let miss = cc_streetlife_miss(ci);
    if (!city_has_walk(cc)) {
        return miss;
    }
    let kr = city_kerb_rect(cc);
    let bmin = vec3<f32>(kr.xy, 0.0);
    let bmax = vec3<f32>(kr.zw, CITY_KERB_H);
    let hb = city_box_hit(o, inv_dir, bmin, bmax);
    if (hb.x > hb.y || hb.y <= t0 || hb.x > t1 || hb.x < 0.0) {
        return miss;
    }
    var t = hb.x;
    let pe = o + t * dir;
    var n = city_box_normal(pe, bmin, bmax);
    if (city_kerb_sd(pe.xy, cc, kr) > 1e-3) {
        // A cut-away corner. Which one, and its circle.
        let c = 0.5 * (kr.xy + kr.zw);
        let hs = 0.5 * (kr.zw - kr.xy);
        let r = min(CITY_KERB_R, min(hs.x, hs.y));
        let sg = sign(pe.xy - c);
        let cc0 = c + sg * (hs - vec2<f32>(r));
        let oc = o.xy - cc0;
        let a = dot(dir.xy, dir.xy);
        let b = dot(oc, dir.xy);
        let disc = b * b - a * (dot(oc, oc) - r * r);
        if (disc < 0.0 || a < 1e-12) {
            return miss;
        }
        // @domain: the discriminant is tested positive (or non-negative) just above
        let sq = sqrt(disc);
        let tc0 = (-b - sq) / a;
        let tc1 = (-b + sq) / a;
        // z slab of the prism, [0, CITY_KERB_H].
        let tz0 = (0.0 - o.z) * inv_dir.z;
        let tz1 = (CITY_KERB_H - o.z) * inv_dir.z;
        let tzn = min(tz0, tz1);
        let tzf = max(tz0, tz1);
        let tin = max(tc0, tzn);
        if (tin > min(tc1, tzf) || tin < 0.0) {
            return miss;
        }
        t = tin;
        let pc = o + t * dir;
        // @domain: the hit lies on the pole's cylinder: |pc.xy - cc0| is its radius
        n = select(vec3<f32>(normalize(pc.xy - cc0), 0.0),
                   vec3<f32>(0.0, 0.0, 1.0), tin == tzn);
    }
    if (t < t0 - 1e-4 || t > t1) {
        return miss;
    }
    let pos = o + t * dir;
    // The top is ground; the side is the kerb face.
    let kind = select(110, 0, n.z > 0.5);
    return CityHit(true, t, pos, n, kind, ci);
}

// The kerb face: granite, lit by the lamps across the road it faces, with
// the arris along its top catching them — the bright line along every kerb
// in the wet-street photographs.
fn cc_streetlife_kerb_shade(h: CityHit, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let light = city_street_light(h.pos, h.normal);
    let fill = cc_streetlife_fill(h.pos);
    let wet = 1.0 - CITY_WET_DARKEN * CITY_WET_WALK;
    let arris = city_band(h.pos.z, CITY_KERB_H - 0.022, 0.022, fp);
    // A wet arris reflects the lamp it faces: tight, bright, and only where
    // the eye sits on the mirror side of it.
    let head = cc_streetlife_nearest_lamp(h.pos.xy);
    // @domain: a lamp head in the air minus a point on a surface: never zero
    let l = normalize(head - h.pos);
    // @domain: a kerb's normals face up or out, never straight down
    let rf = reflect(dir, normalize(h.normal + vec3<f32>(0.0, 0.0, 1.0)));
    let glint = pow(max(dot(rf, l), 0.0), 40.0);
    return light * (CITY_REL_KERB * wet * (1.0 + 1.5 * arris)
                    + 0.9 * arris * glint)
         + CITY_ASPHALT_ALBEDO * CITY_REL_KERB * wet * fill;
}

fn cc_streetlife_props_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                             t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    // WHERE THIS COMPONENT'S COST ACTUALLY IS, measured rather than guessed,
    // so the next reader does not repeat the experiments (RTX 5080, shared,
    // interleaved on/off, 64 accumulated frames at 960x540):
    //
    //     view      off      on     delta
    //     base     0.34 s  0.40 s   +18%
    //     aerial   0.22 s  0.30 s   +36%
    //     horizon  0.31 s  0.40 s   +29%
    //
    // All of it is in this hook, none in the shade hook: unregistering
    // `shade` and leaving `cell_props` reproduced the enabled timings to the
    // centisecond. And none of it is work — on all three views EVERY call
    // leaves at gate 1 below, because the nearest ground within
    // CITY_PROP_RANGE is still a kilometre under the ray. Three attempts to
    // shrink the inlined body moved nothing at all: hoisting the fp cutoff
    // above the four kerb slabs, rolling the four-kerb loop behind a bound
    // the driver cannot fold (the draft's own trick for the march budget),
    // and generating the normal's four tetrahedron taps in a loop instead of
    // spelling them out. Two of the three were reverted for being clutter
    // that bought nothing; the fp cutoff stayed because it is exact.
    //
    // What is left is the gate itself, two fused multiply-adds and two
    // compares, run once per DDA cell within CITY_PROP_RANGE — on the aerial
    // view roughly 26 million times a frame. 0.08 s over 64 frames is about
    // three flops per evaluation, which is the whole of it. This is the floor
    // for ANY cell_props hook in a 512-iteration DDA, not a streetlife
    // problem, and it is not reducible from inside a component.
    //
    // Gate 1, no hash and no memory: does this segment come within reach of
    // the ground at all? Every pixel looking at a facade, a roof, a cloud or
    // the sky leaves here.
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    if (min(za, zb) > cc_streetlife_Z_GATE || max(za, zb) < -0.5) {
        return cc_streetlife_miss(ci);
    }
    let fp = cc_streetlife_pa() * max(t0, 0.0);
    // Gate 2: past the pole cutoff nothing this component draws survives, and
    // every prop's emission has already faded to zero before reaching it
    // (POLE_FAR_FADE 2.4 -> 4.0, CAR_FAR_FADE 1.6 -> 2.6). Hoisting the test
    // above the four kerb slabs makes it exact rather than merely cheap: it
    // is the same answer those per-kerb fp tests would have reached, arrived
    // at before any of the four Side structs is built.
    if (fp > cc_streetlife_POLE_FAR_FP) {
        return cc_streetlife_miss(ci);
    }
    var res = cc_streetlife_miss(ci);
    var t_end = t1;
    // The sidewalk first: it is the nearest thing to the ground on most of
    // these rays, and whatever it stops shortens every test after it.
    if (fp < cc_streetlife_SLAB_FP && min(za, zb) < CITY_KERB_H) {
        res = cc_streetlife_slab(o, dir, inv_dir, t0, t1, ci, cc);
        if (res.hit) {
            t_end = res.t;
        }
    }
    for (var side: i32 = 0; side < 4; side = side + 1) {
        // Poles and parked cars stand only on a kerb that has a street
        // (the bake removes streets from open land and lot interiors).
        if (!city_edge_street(cc, side)) {
            continue;
        }
        let k = cc_streetlife_kerb(o, dir, inv_dir, t0, t_end, ci, cc, side,
                                   fp, false);
        if (k.hit.hit) {
            res = cc_streetlife_nearer(res, k.hit);
            t_end = min(t_end, res.t);
        }
    }
    return res;
}

// The parked cars close enough to be sphere-traced (fp < CAR_SDF_FP), for
// the street stage (fs_surface_street, the near_props hook), which walks
// only the stretch of the ray below CITY_FURNITURE_TOP up to the surface
// the first stages found — the road, since the first stage leaves these
// cars out. The contact shadow under a car (kind 106 + side) comes from the
// same trace.
fn cc_streetlife_near_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                            t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    if (min(za, zb) > cc_streetlife_BB_Z + 0.2 || max(za, zb) < -0.5) {
        return cc_streetlife_miss(ci);
    }
    let fp = cc_streetlife_pa() * max(t0, 0.0);
    // No car box entered in this segment can be near enough (see the kerb's
    // per-car switch): a box starts at most its diagonal before the segment.
    if (cc_streetlife_pa() * max(t0 - cc_streetlife_BB_DIAG, 0.0)
        >= cc_streetlife_CAR_SDF_FP) {
        return cc_streetlife_miss(ci);
    }
    // ONE sphere trace per cell, on the nearest car bounding box any kerb
    // accepted — never one per slot. This is the most consequential
    // structural decision in the file and it was forced by measurement.
    // The hook is inlined into the DDA, whose loop runs up to 512 times, and
    // the four-kerb by five-slot loops are small enough that the driver
    // unrolls them: written at the slot, the trace appeared twenty times in
    // that loop body, and the register pressure alone cost 1.0 s of a 1.6 s
    // frame set on the `base` view, where no car is anywhere near the
    // footprint that admits an SDF (measured when this lived in the first
    // stage). Hoisted here it appears once.
    //
    // FALL-THROUGH. A ray can enter a car's box and miss its hull — over
    // the roof (the box stands 1.74 m, a small car's roof 1.4), past a
    // flank, over the bonnet — and then the car BEHIND it is what it meets.
    // This once returned the miss, on the reasoning that cars sit 2.4 m
    // apart and the loss was a sliver on a silhouette. It was not a sliver:
    // from a few metres up, a ray down to the lower body of a parked car
    // passes through the box of the one parked in front of it, just above
    // that car's roof, so the whole body below the shoulder showed the road
    // through it, cut by the invisible box's vertical edge, with only the
    // roof left floating (Thomas's flight of dev 1853300, 2026-11-09: "it
    // looked as though there was an invisible object in front of the
    // car"). So a miss resumes the search past the box it missed in. The
    // boxes are disjoint (adjacent slots' centres are at least 5.8 m apart,
    // their boxes 5.42 m long at the full yaw), so each is entered at most
    // once and the next candidate starts at or after this one's exit. The
    // trace is still written once, inside a loop whose bound is a run-time
    // value (a literal one would be unrolled into the DDA, as above); the
    // tries after the first are paid only by rays that missed a hull.
    let tries = select(cc_streetlife_NEAR_TRIES, 0, t1 < t0);
    var t_from = t0;
    for (var n: i32 = 0; n < tries; n = n + 1) {
        var cand: cc_streetlife_Kerb;
        var have = false;
        var cand_t = 1e30;
        var t_end = t1;
        for (var side: i32 = 0; side < 4; side = side + 1) {
            if (!city_edge_street(cc, side)) {
                continue;
            }
            let k = cc_streetlife_kerb(o, dir, inv_dir, t_from, t_end, ci,
                                       cc, side, fp, true);
            if (k.car_ok && k.ta < cand_t) {
                cand = k;
                have = true;
                cand_t = k.ta;
                t_end = min(t_end, k.ta);
            }
        }
        if (!have) {
            break;
        }
        let h = cc_streetlife_trace_car(o, dir, cand.ta, cand.tb, cand.car,
                                        ci, cand.side, fp);
        if (h.hit) {
            return h;
        }
        t_from = cand.tb;
    }
    return cc_streetlife_miss(ci);
}

// ---------------------------------------------------------------------------
// Shading
// ---------------------------------------------------------------------------

// Underglow palette: 60% cyan, 25% magenta, 15% amber.
fn cc_streetlife_glow_color(d: f32) -> vec3<f32> {
    if (d < 0.60) {
        return vec3<f32>(0.16, 0.90, 1.00);
    }
    if (d < 0.85) {
        return vec3<f32>(1.00, 0.20, 0.70);
    }
    return vec3<f32>(1.00, 0.60, 0.16);
}

// Night car paint. Weighted dark on purpose: the road under these cars is a
// clipped sodium wash, so a car is a hole in it with a lit edge, and a
// palette of mid-greys renders a street of pale ceramic bathtubs. One car in
// seven is light enough to be the bright one in the row.
fn cc_streetlife_paint(d: f32) -> vec3<f32> {
    if (d < 0.30) {
        return vec3<f32>(0.055, 0.060, 0.070);  // graphite
    }
    if (d < 0.44) {
        return vec3<f32>(0.320, 0.335, 0.350);  // silver
    }
    if (d < 0.58) {
        return vec3<f32>(0.230, 0.055, 0.055);  // oxblood
    }
    if (d < 0.72) {
        return vec3<f32>(0.045, 0.090, 0.185);  // midnight blue
    }
    if (d < 0.82) {
        return vec3<f32>(0.300, 0.260, 0.170);  // sand
    }
    if (d < 0.93) {
        return vec3<f32>(0.040, 0.155, 0.130);  // deep teal
    }
    return vec3<f32>(0.235, 0.085, 0.150);      // faded plum
}

// A band of width `w` around `x0`, antialiased against the footprint and
// blended to its own mean coverage once the line is sub-pixel — a seam that
// simply vanished would take the panel's mean brightness with it.
fn cc_streetlife_seam(x: f32, x0: f32, w: f32, pitch: f32, fp: f32) -> f32 {
    let e = 0.5 * w + 0.6 * fp;
    let sharp = 1.0 - smoothstep(0.5 * w, e + 1e-4, abs(x - x0));
    let mean = w / max(pitch, 1e-3);
    return mix(sharp, mean,
               smoothstep(cc_streetlife_DETAIL_LOD.x,
                          cc_streetlife_DETAIL_LOD.y, fp));
}

// The footprint the CAR's own detail is resolved at, which is not the one the
// core hands the shade hook.
//
// The core passes `fp = pixel_angle * t`, where pixel_angle is floored by the
// app's view-step LOD slider — tan(0.3 deg) by default, four and a half times
// the actual pixel at 960 px and 60 degrees. That floor is right for what it
// was built for: it stops sub-pixel window LATTICES from moireing as the
// camera moves. A car's wiper blade, rim spoke or lamp lens is not a lattice,
// it is one feature, and blurring it across four pixels throws away detail
// the accumulation would otherwise resolve — the whole reason the LOD floor
// dropped to a quarter pixel in the first place.
//
// So: sharpen toward the true pixel, but never below about one and a half of
// them, which is what keeps a moving 1-spp frame from crawling. With the
// default slider this lands at ~1.5 px; with a fine slider the true-pixel
// term takes over and holds the floor at 1 px.
fn cc_streetlife_fp_px(fp: f32, t: f32) -> f32 {
    return max(0.35 * fp, true_pixel_angle() * max(t, 0.0));
}

// One lamp LENS on a face, resolved while it is bigger than a pixel and
// handed to the face's mean when it is not, so the face's average is the
// same either side of the hand-off. The lens is an ellipse, not a disc, and it is nested inside the
// letterbox recess the SDF cut for it: a circular lens of radius 0.12
// overflowed a housing only 0.16 tall, so it rendered as a white ball with a
// dark eyebrow, and a row of parked cars looked back at the camera. Real
// vehicle lamps are wide and shallow; the aspect alone does most of the work.
const cc_streetlife_LENS_A: f32 = 0.160;   // half-width, along the face
const cc_streetlife_LENS_B: f32 = 0.049;   // half-height
fn cc_streetlife_dot(a: f32, b: f32, sa: f32, sb: f32, span: f32, fp: f32)
        -> f32 {
    let e = vec2<f32>((a - sa) / cc_streetlife_LENS_A,
                      (b - sb) / cc_streetlife_LENS_B);
    let d = length(e);
    // The edge softens in the ellipse's OWN metric, with the footprint
    // normalised by the geometric mean of the two semi-axes and then clamped.
    // Both of the obvious alternatives failed on this shape: dividing fp by
    // the semi-MINOR axis alone inflates it eighteenfold and blew the lens
    // into a lobe covering the whole nose, while normalising by the implicit
    // gradient, (d-1)/|grad d|, looks exact but asymptotes to a constant —
    // LENS_B, 0.056 — far from an eccentric ellipse, so once the footprint
    // crossed that constant the test stopped bounding anything at all and the
    // lens grew vertically without limit. A clamped width in the normalised
    // metric cannot do either: the lens is never more than 1 + w across.
    // @domain: a product of two positive constants
    let w = clamp(fp / sqrt(cc_streetlife_LENS_A * cc_streetlife_LENS_B),
                  0.06, 0.42);
    let sharp = 1.0 - smoothstep(1.0 - w, 1.0 + w, d);
    let mean = 3.14159265 * cc_streetlife_LENS_A * cc_streetlife_LENS_B
             / max(span, 1e-3);
    return mix(sharp, mean,
               smoothstep(cc_streetlife_LAMP_LOD.x,
                          cc_streetlife_LAMP_LOD.y, fp));
}

// How far into the glazing a point on the greenhouse lies, in body units.
//
// The greenhouse is bounded by five planes — windshield, backlight, roof
// rail, belt line, tumblehome flank — and the window surround is the distance
// to the nearest of them. The catch is that the border you are STANDING on is
// at distance zero by definition, so a naive minimum reports "no glass"
// everywhere. Each border is therefore pushed out of the running in
// proportion to how closely the surface normal agrees with the border's own,
// and only when it agrees closely: the ramp starts at dot 0.82, so a
// windshield is excused from its own plane but not from the roof rail it runs
// up to, even though the two are only 55 degrees apart.
//
// Five dot products buys A-pillars, C-pillars, a roof rail and a belt line
// that are all the same band, on every face, with no branch and no per-face
// special case — which is what the first pass tried to get from one `ay`
// bound and one normal test, and got windowless cars instead.
fn cc_streetlife_glass_inset(cx: f32, q: vec3<f32>, nl: vec3<f32>) -> f32 {
    let ay = abs(q.y);
    let sy = select(-1.0, 1.0, q.y >= 0.0);
    let nf = vec3<f32>(0.824, 0.0, 0.567);          // windshield
    let nb = vec3<f32>(-0.745, 0.0, 0.667);         // backlight
    let ns = vec3<f32>(0.0, sy * 0.958, 0.287);     // flank, leaning in
    var m = 1.339 - (nf.x * cx + nf.z * q.z)
          + 12.0 * max(dot(nl, nf) - 0.82, 0.0);
    m = min(m, 1.361 - (nb.x * cx + nb.z * q.z)
               + 12.0 * max(dot(nl, nb) - 0.82, 0.0));
    m = min(m, 1.425 - q.z + 12.0 * max(nl.z - 0.82, 0.0));
    m = min(m, q.z - 1.045 + 12.0 * max(-nl.z - 0.82, 0.0));
    m = min(m, 0.958 * (0.74 - 0.30 * (q.z - 1.02) - ay)
               + 12.0 * max(dot(nl, ns) - 0.82, 0.0));
    return m;
}

fn cc_streetlife_pole_shade(h: CityHit, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let fill = cc_streetlife_fill(h.pos);
    // Two edges to approach, never to step over: the population edge at
    // CITY_PROP_RANGE, and the footprint at which poles stop being traced.
    // The second was declared (POLE_FAR_FADE) and then never applied, so a
    // luminaire at radiance 6 — the brightest thing on the street — simply
    // switched off the instant fp crossed POLE_FAR_FP. That is the one thing
    // the SPEC says outright must not happen: sub-pixel detail dissolves into
    // its own mean, it does not vanish.
    let fade = (1.0 - smoothstep(cc_streetlife_FADE_START * CITY_PROP_RANGE,
                                 CITY_PROP_RANGE, h.t))
             * (1.0 - smoothstep(cc_streetlife_POLE_FAR_FADE,
                                 cc_streetlife_POLE_FAR_FP, fp));
    if (h.kind == 101) {
        // The luminaire. Its underside is the lamp; its sides are the lens
        // edge; its top is a painted aluminium housing, and dark. A glowing
        // box would read as a floating lozenge, not as a light fitting.
        let district = city_glow_sample(h.pos.xy, 2.0);
        let out = 0.45 + 1.6 * smoothstep(0.02, 0.45, district);
        if (h.normal.z < -0.5) {
            return cc_streetlife_HEAD_COLOR
                   * (cc_streetlife_HEAD_RAD * out * fade);
        }
        if (h.normal.z > 0.5) {
            return 0.10 * fill + vec3<f32>(0.004, 0.003, 0.002);
        }
        // A side face is mostly painted cowl, with the lens showing as a lip
        // along its bottom edge. Uniformly bright, the sides clipped to white
        // with the lamp and the whole fitting became one glowing lozenge —
        // the exact failure the head geometry exists to avoid. Antialiased
        // against fp so the lip fades into the face's own mean rather than
        // strobing once it is thinner than a pixel.
        let zl = cc_streetlife_HEAD_Z - cc_streetlife_HEAD_HZ;
        let lip = 1.0 - smoothstep(zl + cc_streetlife_HEAD_LIP,
                                   zl + cc_streetlife_HEAD_LIP + 0.5 * fp
                                       + 0.012,
                                   h.pos.z);
        let mean = cc_streetlife_HEAD_LIP
                 / (2.0 * cc_streetlife_HEAD_HZ);
        let k = mix(lip, mean, smoothstep(0.010, 0.075, fp));
        return cc_streetlife_HEAD_COLOR
               * (cc_streetlife_HEAD_RAD * out * fade
                  * mix(cc_streetlife_HEAD_COWL,
                        cc_streetlife_HEAD_SIDE, k))
             + 0.08 * fill;
    }
    // Mast and arm: galvanised steel, lit almost entirely by its own lamp,
    // and more of it the closer to the head — the falloff up the pole is the
    // single cue that says the light is at the top.
    let up = clamp(h.pos.z / cc_streetlife_POLE_H, 0.0, 1.0);
    let near_lamp = 0.12 + 0.88 * up * up;
    let pool = cc_streetlife_pool(h.pos.xy);
    let lamp = cc_streetlife_nearest_lamp(h.pos.xy);
    // @domain: a lamp head in the air minus a point on a surface: never zero
    let l = normalize(lamp - h.pos);
    // The mast is a box because a box is what the DDA wants, but 17 cm of
    // steel is round, and from two metres away a flat-shaded rectangle says
    // so loudly. The silhouette stays square — sub-pixel at any distance you
    // would notice — while the NORMAL is remapped across the width of the
    // face to the cylinder the box circumscribes.
    //
    // The remap has to be driven by WHERE ON THE FACE the hit is, and the
    // draft drove it by the direction to the lamp instead. On a mast the lamp
    // is directly overhead, so that vector is nearly zero in xy, the remap
    // collapsed to the identity, and the note beside it recording that "the
    // remapped normal on its own changed nothing" was reporting a bug rather
    // than a fact about the geometry. Every face then carried ONE normal and
    // one grazing value, which is why a pole came out as a flat gold bar with
    // a dark side rather than as a cylinder with two bright edges.
    //
    // The axis is recoverable exactly: cc_streetlife_nearest_lamp returns the
    // lattice point, which is where the mast stands. The offset of the hit
    // from it, resolved along the face, is the cylinder angle.
    var n = h.normal;
    let rel = h.pos.xy - lamp.xy;
    if (abs(h.normal.z) < 0.5
        && dot(rel, rel) < cc_streetlife_MAST_R * cc_streetlife_MAST_R * 2.9) {
        let tang = vec2<f32>(-h.normal.y, h.normal.x);
        let uu = clamp(dot(rel, tang) / cc_streetlife_MAST_R, -1.0, 1.0);
        // @domain: n.xy sqrt(1 - u^2) + tang u with tang perpendicular to the unit n.xy: unit
        n = normalize(vec3<f32>(h.normal.xy * sqrt(max(1.0 - uu * uu, 0.0))
                                + tang * uu, 0.0));
    }
    let lam = 0.30 + 0.70 * max(dot(n, l), 0.0);
    // A vertical pole lit by a lamp on its own axis has almost no shading
    // variation around its circumference — that is the geometry, not a bug,
    // and it is why Lambert alone cannot draw a pole. What makes one look
    // round at night is the grazing edge: the two sides of the cylinder catch
    // the street at glancing incidence and the middle of the face returns
    // almost nothing. So the cylinder is read out through a Fresnel edge —
    // which needs a normal that actually turns across the face, hence the
    // remap above.
    let edge = pow(1.0 - clamp(abs(dot(dir, n)), 0.0, 1.0), 3.0);
    return (cc_streetlife_MAST_FILL * fill
            + cc_streetlife_MAST_ALB * pool * (near_lamp * lam)
            + pool * (cc_streetlife_MAST_EDGE * edge * near_lamp)) * fade;
}

// The road under and around a parked car: the core's own ground radiance,
// occluded by the car above it — near black under the sills, back to open
// road UNDER_REACH out from the hull. The reach must end inside the car's
// box (whose along margin is 0.16 m at the largest car scale), because past
// the ramp the trace hands the ray back to the core's ground. Occlusion
// takes the lamp pool, the glints and the fill alike; the wet reflection is
// not traced where the car shades the road, and under a car there is none.
const cc_streetlife_UNDER_REACH: f32 = 0.15;
const cc_streetlife_UNDER_FLOOR: f32 = 0.08;

// How much of the open road a point at pl (the car's own plan frame) keeps:
// the floor under the sills, 1 from UNDER_REACH outside the hull's plan (a
// rounded rectangle) and beyond.
fn cc_streetlife_under_occ(pl: vec2<f32>, r: vec4<f32>) -> f32 {
    let sh = cc_streetlife_car_shape(r);
    let q = abs(pl) - sh.x * vec2<f32>(cc_streetlife_HL - 0.25,
                                       cc_streetlife_HW - 0.25);
    let dout = length(max(q, vec2<f32>(0.0))) + min(max(q.x, q.y), 0.0)
             - 0.25 * sh.x;
    let open = smoothstep(-0.30, cc_streetlife_UNDER_REACH, dout);
    return mix(cc_streetlife_UNDER_FLOOR, 1.0, open * open);
}

fn cc_streetlife_under_shade(h: CityHit, cc: CityCell, dir: vec3<f32>,
                             fp: f32) -> vec3<f32> {
    let side = h.kind - 106;
    let s = cc_streetlife_side(h.cell, cc, side);
    let along = select(h.pos.y, h.pos.x, s.ax == 0);
    let j = i32(floor(along / cc_streetlife_SLOT));
    let v = cc_streetlife_prop(h.cell, cc, s, side, j);
    let pl = cc_streetlife_to_local(h.pos, v.ctr, v.fwd, v.rgt);
    return cc_streetlife_under_occ(pl.xy, v.r)
         * city_ground_radiance(h.pos, h.cell, cc, dir, fp);
}

fn cc_streetlife_car_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let side = h.kind - 102;
    let s = cc_streetlife_side(h.cell, cc, side);
    // Recover the slot from the hit itself: the car's centre is within 3.1 m
    // of its slot centre and the slots are 7 m apart, so the floor is exact.
    let along = select(h.pos.y, h.pos.x, s.ax == 0);
    let j = i32(floor(along / cc_streetlife_SLOT));
    let v = cc_streetlife_prop(h.cell, cc, s, side, j);
    let r = v.r;
    let hover = cc_streetlife_is_hover(r);
    let lift = select(0.0, cc_streetlife_HOVER_LIFT, hover);

    let sh = cc_streetlife_car_shape(r);
    let cab_c = sh.y;
    let off = cab_c + 0.30;
    // The same body frame the SDF works in, scale and all, so every band
    // below lands on the geometry it names.
    let q = (cc_streetlife_to_local(h.pos, v.ctr, v.fwd, v.rgt)
             - vec3<f32>(0.0, 0.0, lift)) / sh.x;
    let nl = vec3<f32>(dot(h.normal.xy, v.fwd), dot(h.normal.xy, v.rgt),
                       h.normal.z);
    let ay = abs(q.y);
    // Detail resolves at fpd; the distance FADES below still key off the
    // core's fp, because those follow the app's LOD slider by design and a
    // car must not outlive the population edge just because it is sharp.
    let fpd = cc_streetlife_fp_px(fp, h.t);

    let fill = cc_streetlife_fill(h.pos);
    let pool = cc_streetlife_pool(h.pos.xy);
    let lamp = cc_streetlife_nearest_lamp(h.pos.xy);
    // @domain: a lamp head in the air minus a point on a surface: never zero
    let l = normalize(lamp - h.pos);
    let fade = (1.0 - smoothstep(cc_streetlife_FADE_START * CITY_PROP_RANGE,
                                 CITY_PROP_RANGE, h.t))
             * (1.0 - smoothstep(cc_streetlife_CAR_FAR_FADE,
                                 cc_streetlife_CAR_FAR_FP, fp));

    // The one specular lobe is what carries curvature. A dark paint under a
    // single overhead source is nearly flat in Lambert; the glint sliding
    // along the shoulder is the whole read.
    let rf = reflect(dir, h.normal);
    let spec_c = max(dot(rf, l), 0.0);
    let lam = max(dot(h.normal, l), 0.0);

    // Tyres first: matte rubber, and the only part that wants none of the
    // clearcoat treatment. The wheel only reads at all because of the rim
    // face inside it — a black disc on a black car under a dim lamp is
    // nothing, and the first pass had cars that appeared to float.
    let qw = vec3<f32>(abs(q.x) - cc_streetlife_AXLE_X,
                       ay - cc_streetlife_TRACK,
                       q.z - cc_streetlife_AXLE_Z);
    let wheel = cc_streetlife_cyl_y(qw, cc_streetlife_TYRE_R,
                                    cc_streetlife_TYRE_HW);
    if (!hover && wheel < 0.035) {
        let rad = length(vec2<f32>(qw.x, qw.z));
        // The rim: the only part of a wheel that is legible at night, and the
        // first pass gave it a quarter of the tyre's radius, so it never
        // showed and the wheels read as flat pale discs. The face is most of
        // the wheel, as it is on a real one; the tyre is the band around it.
        if (qw.y > 0.085 && rad < cc_streetlife_RIM_R) {
            // Brushed metal, five spokes, a hub, and a rolled lip at the rim
            // edge that catches the road — that lip is what turns a disc into
            // something with depth.
            let ang = atan2(qw.z, qw.x) * 0.795774715;   // turns
            let spoke = cc_streetlife_seam(fract(ang * 5.0), 0.5, 0.30, 1.0,
                                           fpd * 3.0);
            let hub = 1.0 - smoothstep(0.048, 0.070, rad);
            let lip = smoothstep(cc_streetlife_RIM_R - 0.035,
                                 cc_streetlife_RIM_R - 0.008, rad);
            let face = max(max(1.0 - 0.80 * spoke, hub), 0.85 * lip);
            return vec3<f32>(0.94, 0.97, 1.00) * cc_streetlife_RIM_ALB
                   * pool * (0.26 + 0.74 * lam) * face
                 + 0.6 * fill;
        }
        // Rubber. Weathered tyre reflectance is about 0.02 in daylight and
        // less than that here, and it has to come out DARKER than graphite
        // paint or the car floats on four pale coins — which is precisely
        // what the first pass rendered, because 0.012 of a clipped sodium
        // road still beats 0.10 of a 0.055 paint.
        let tread = 1.0 - 0.42 * cc_streetlife_seam(
            fract(atan2(qw.z, qw.x) * 4.6), 0.5, 0.15, 1.0, fpd * 4.0);
        return vec3<f32>(cc_streetlife_TYRE_ALB) * pool * (0.18 + 0.82 * lam)
               * tread
             + 0.16 * fill
             + pool * (0.008 * pow(spec_c, 12.0));
    }

    // GLASS. This test decides whether a car has windows at all, and the
    // salvaged draft's version answered no everywhere in the city — the two
    // renders that motivated the rewrite showed a solid loaf of paint where
    // the cabin should be. Two independent reasons, both worth stating
    // because both are the kind of test that looks obviously right:
    //   * `ay < 0.71` against a cabin whose own half-width is 0.70, inflated
    //     outward by the shoulder's smooth-min: the side glass sat a few
    //     millimetres OUTSIDE its own window, so the flanks were never glass.
    //   * `nl.z < 0.72` on a raked windshield, whose normal is (0.82, 0,
    //     0.57) by construction: the more like a windscreen the windscreen
    //     got, the more certainly it was classified as bodywork.
    // So the region is now the greenhouse's own five-plane interior, inset by
    // a surround (cc_streetlife_glass_inset), with the roof panel taken back
    // out — a car may have a raked screen at every angle, but not a glass
    // roof.
    let cx = q.x - cab_c;
    let roof_face = q.z > 1.33 && nl.z > 0.80;
    let gin = cc_streetlife_glass_inset(cx, q, nl);
    // A B-pillar between the two side lights, while it is wide enough to be a
    // pillar rather than an aliasing line; past 6 cm/px the greenhouse is
    // uniform glass, which is that band's honest mean.
    let b_pillar = select(0.0,
                          1.0 - smoothstep(0.034, 0.062, abs(cx + 0.02)),
                          fpd < 0.06);
    let is_glass = q.z > 1.05 && gin > 0.055 + 0.35 * fpd
                && !roof_face && b_pillar < 0.5;
    if (is_glass) {
        let fres = pow(1.0 - clamp(abs(dot(dir, h.normal)), 0.0, 1.0), 4.0);
        // What a parked car's glass carries at night, in order of how much of
        // it there is: the road it is standing on (bright, and reflected by
        // every window that leans at all), the skyglow, and a wash of the
        // building opposite. Without the road term a dark car's greenhouse
        // is the same value as its paint and the whole cabin stops existing.
        let env = mix(cc_streetlife_GLASS_ROAD * pool,
                      3.0 * fill
                      + CITY_PALETTE_MEAN * (0.05 + 0.22 * cc.lit_frac),
                      clamp(rf.z * 1.8 + 0.45, 0.0, 1.0));
        let glint = pow(spec_c, 220.0) * cc_streetlife_GLASS_GLOSS;
        // Wiper blades cross the glass as hard dark lines; the windshield
        // also carries the demist banding at its base.
        let wip = cc_streetlife_seg(vec3<f32>(q.x - off, ay, q.z),
                                    vec3<f32>(0.66, 0.07, 0.925),
                                    vec3<f32>(1.00, 0.52, 0.908), 0.021);
        let wmask = select(1.0, 0.30, wip < 0.014);
        return ((1.0 + 2.2 * fres) * env + pool * glint) * wmask * fade;
    }

    // Paint.
    var col = cc_streetlife_paint(fract(r.z * 5.17 + r.w * 0.31));
    // Panel lines, in the hull's own frame. A shut line at the door, one at
    // the rear quarter, a rocker crease under the sill, and a hood seam on
    // the deck: functional lines only, nothing that would be noise at 10 m.
    var seam = 1.0;
    if (abs(nl.z) < 0.75) {
        seam = seam * (1.0 - 0.75 * cc_streetlife_seam(cx, 0.86, 0.05,
                                                       1.6, fpd));
        seam = seam * (1.0 - 0.75 * cc_streetlife_seam(cx, -0.78, 0.05,
                                                       1.6, fpd));
        seam = seam * (1.0 - 0.40 * cc_streetlife_seam(q.z, 0.46, 0.06,
                                                       1.0, fpd));
        // Door handles: one recess per door, on the belt line.
        let dh = (1.0 - smoothstep(0.10, 0.17, abs(cx + 0.18)))
               * (1.0 - smoothstep(0.02, 0.045, abs(q.z - 0.80)));
        seam = seam * (1.0 - 0.55 * select(0.0, dh, fpd < 0.05));
    } else {
        seam = seam * (1.0 - 0.55 * cc_streetlife_seam(cx, 1.28, 0.045,
                                                       2.0, fpd));
        seam = seam * (1.0 - 0.55 * cc_streetlife_seam(cx, -0.96, 0.045,
                                                       2.0, fpd));
    }
    var e = cc_streetlife_PAINT_GAIN * col * pool * (0.22 + 0.78 * lam) * seam
          + 1.4 * col * fill;
    // Clearcoat: a tight lobe on the sodium, plus a broad sheen that picks up
    // the whole lit street. Both scale with the pool, so a car parked between
    // lamps stays a silhouette.
    e = e + pool * (cc_streetlife_GLOSS * pow(spec_c, 60.0)
                    + cc_streetlife_SHEEN * pow(spec_c, 6.0));
    // Rim: the skyglow catching the top of a curved shoulder.
    let graze = pow(1.0 - clamp(abs(dot(dir, h.normal)), 0.0, 1.0), 3.0);
    e = e + fill * (2.5 * graze * clamp(nl.z + 0.4, 0.0, 1.0));
    // Road bounce. The single most useful term on the whole car: a vertical
    // flank at night reflects the sodium wash it is parked on, and it does
    // so hardest at grazing incidence and lowest on the body. That is what
    // draws the bright outline around the wheel arch, along the rocker and
    // over the shoulder crease — the specular lobe cannot, because the lamp
    // is overhead and a flank never reflects it toward the camera.
    e = e + pool * (cc_streetlife_ROAD_BOUNCE * graze
                    * clamp(0.55 - 0.75 * nl.z, 0.0, 1.0));

    // Head and tail lamps, in the housings the SDF cut for them.
    let facing = nl.x;
    if (abs(facing) > 0.35) {
        let fwd_face = facing > 0.0;
        let dot_e = cc_streetlife_dot(ay, q.z, 0.50, 0.71, 1.2, fpd);
        // A parked car's lamps are standing lights, not driving beams: white
        // forward, red aft, and both a good deal under the sodium luminaire
        // overhead (radiance 6) rather than clipped alongside it. Tails run
        // brighter than heads because a red lens at this exposure loses two
        // of its three channels.
        let col_l = select(vec3<f32>(1.00, 0.06, 0.03),
                           vec3<f32>(1.00, 0.93, 0.82), fwd_face);
        let rad_l = cc_streetlife_LAMP_RAD * select(1.15, 0.72, fwd_face);
        e = e + col_l * (rad_l * dot_e * fade);
        // A tail light bar on the cars that carry one — the cheapest possible
        // cyberpunk signature, and it survives to a distance the dots do not.
        if (!fwd_face && r.z > 0.55) {
            let bar = (1.0 - smoothstep(0.020, 0.055 + 0.5 * fpd,
                                        abs(q.z - 0.74)))
                    * (1.0 - smoothstep(0.55, 0.72, ay));
            e = e + vec3<f32>(1.00, 0.06, 0.03)
                    * (1.3 * mix(bar, 0.10, smoothstep(0.05, 0.30, fpd))
                       * fade);
        }
    }

    // Underglow: a strip under the sill, or the whole plenum on a hover car.
    let glow_on = r.w < cc_streetlife_GLOW_FRAC;
    if (glow_on) {
        let gc = cc_streetlife_glow_color(fract(r.y * 3.77 + r.z * 0.13));
        let hi_z = select(0.34, 0.30, hover);
        let strip = (1.0 - smoothstep(hi_z - 0.10, hi_z + 0.06, q.z))
                  * clamp(1.0 - abs(nl.z), 0.12, 1.0);
        let amp = select(1.0, 1.7, hover);
        e = e + gc * (cc_streetlife_GLOW_RAD * amp * strip * fade);
    }
    return e;
}

fn cc_streetlife_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    if (h.kind == 110) {
        return cc_streetlife_kerb_shade(h, dir, fp);
    }
    if (h.kind <= 101) {
        return cc_streetlife_pole_shade(h, dir, fp);
    }
    if (h.kind >= 106) {
        return cc_streetlife_under_shade(h, cc, dir, fp);
    }
    return cc_streetlife_car_shade(h, cc, dir, fp);
}

// --- component: adscreens (adscreens.wgsl) ---
// adscreens — the big screens, and the weird things they are selling.
//
// About one building in twelve over 50 m carries screens — but weighted by
// the cascade, so downtown runs nearer one in five and the outskirts one in
// forty, because advertising clusters where the crowds are and a uniform
// sprinkle left the megatower district (which is the shot) with almost none.
// A chosen building offers each of its vertical box facades to a second draw,
// and the ones that take it get ONE screen — 30-70% of the facade wide (up to
// 86% on a merged superblock, which is where the giants live), aspect
// anywhere from 4:3 to 1:2.5. That is a 10-50 m rectangle on an ordinary
// tower and a 140 m one on a superblock: the loudest thing on the wall.
//
// Content features are sized in METRES, not in fractions of the panel —
// character cells 3-6 m, dead-channel pixel pitch 0.7-1.6 m, test-card bars
// 1.6-4 m. Sizing them as panel fractions instead (which is what this file
// did first) gives a small screen 10 cm noise that is sub-pixel from across
// the street and a superblock 30 m characters, so the same archetype read as
// flat grey on one wall and as three enormous blobs on another.
//
// Six content archetypes, all pure math in screen-local uv, all static:
//   FACE     a giant face suggestion — two eye blobs and a mouth bar over a
//            skin vignette, with a neon pinprick in each eye. Abstracted
//            enough that it reads as a face without ever being one.
//   PRODUCT  a capsule silhouette, luminous, rimmed, on a saturated gradient
//            with a halo bleeding off it. The object is never named.
//   GLYPH    rows of pseudo-ideograms: three axis-aligned strokes per cell,
//            endpoints snapped to a 3x3 lattice out of one pcg2d draw, so the
//            characters have the regularity of writing without being any
//            writing. No real text — the calibration forbids it and it would
//            be worse if it were legible.
//   STRIPES  a test card. Bar count a multiple of three, colours cycling
//            through the screen's three-neon scheme, dark foot band.
//   STATIC   a dead channel: hash noise, a few rows shear-glitched, a few
//            more torn bright. Frozen — this is a broken screen, not a
//            playing one.
//   EYE      iris rings and radial spokes around a black pupil, one glint.
//
// Each screen draws a 3-colour scheme from an 8-hue neon family, and every
// archetype is written as three scalar FIELDS against those three colours:
// content = qa*f.x + qb*f.y + qc*f.z. That factoring is what makes the LOD
// honest — the screen's mean is qa*m.x + qb*m.y + qc*m.z with m the fields'
// own means, so the far-field colour is computed, not guessed.
//
// THE SCREEN IS OPAQUE. The facade hook is additive, so a bright emitter
// dropped on the wall leaves the wall's own lit windows punching through it —
// which is exactly what the first cut of this file did, and it read as a
// projection rather than a panel. So the panel reports its outer rectangle
// through the facade_cover hook, and the core takes its windows (and, up
// close, the facade shell's relief) out from under it; this file then adds
// only the panel's own emission. The bezel adds nothing, so it is a
// genuinely dark frame rather than a strip of bare wall, and the screen sits
// ON the building.
//
// BRIGHTNESS, and why it is not the brief's 2.5. At exposure 6 against a
// white point of 15, radiance 2.5 lands at display 1.0 EXACTLY: a screen
// normalised to a mean radiance of 2.5 is a wall-sized white rectangle with
// no hue and no content, which is what it rendered as. The tone map is what
// sets this scale, so the normalisation targets the mean colour's LARGEST
// channel (the one that clips first) rather than its luminance, and puts it
// near 0.6-1.4. The content's own contrast then carries highlights — glints,
// hot cores, torn static rows — up past 4, where they clip to white on
// purpose, the way a real LED wall photographs: a white-hot core in a field
// that still has colour.
//
// LOD. Content dissolves into the screen's mean over fp in [0.055, 0.33] x
// the screen's short side: full detail while the short side is wider than
// ~18 px, gone by ~3. The screen itself NEVER goes — past the dissolve it is
// a flat rectangle of exactly the colour its content averaged to, which is
// what a city mega-screen is at two kilometres. Inside that window the four
// periodic generators (glyph strokes, test-card bars, noise cells, iris
// rings) each blend to their OWN mean over their OWN feature size, which is
// far finer than the screen's, and the point highlights are gaussians
// widened by the pixel with their integral held. Nothing aliases on the way
// down and nothing vanishes at the bottom.
//
// THE MEANS ARE PER-SCREEN, NOT ENSEMBLE. A single-feature archetype's mean
// depends strongly on its own hash draw — a fat capsule covers three times
// the panel a thin one does — so an ensemble constant is wrong by 15-25% for
// any particular screen, and that error IS the brightness step between the
// resolved screen and the flat one. Every compact feature here therefore
// carries a closed form in its own draw: capsule and annulus areas, Steiner
// offsets for the rim and halo bands, exact gaussian integrals for the
// glints. The two panel-filling gradients (FACE's vignette, EYE's radial)
// are cubics in the aspect fitted to their erf integrals (max error 0.02%).
// The many-cell archetypes (GLYPH, STRIPES, STATIC) need no per-screen form:
// a screen holds dozens of cells, so the ensemble mean IS the screen's mean —
// except STRIPES' bar brightness, which is drawn per colour index rather than
// per bar so that its per-screen mean stays exact with only 2-5 bars a colour.
//
// Validation, twice over. On the CPU: a numpy port of these functions,
// integrated on a 192^2 quadrature grid per screen over 120 screens x 6
// aspects, against the closed forms. Per-screen error is under 1% on every
// dominant field for aspects 0.55 and wider, rising to ~7% of the panel mean
// at the narrowest 1:2.5 banner, where compact features clip against the
// panel edge and the unclipped areas overstate them. (For contrast, the
// ensemble constants this file started with were off by 2.8x on GLYPH and 3x
// on PRODUCT's halo, and gave FACE's glint a NEGATIVE mean.)
//
// And on the GPU, which is the claim that matters: fp is inversely
// proportional to render width at fixed fov, so rendering one parked camera
// at widths from 1920 down to 120 walks every screen in the frame through
// the entire LOD ladder with the geometry, the occlusion and the hash draws
// all held fixed. Over that 16x sweep the panels' mean displayed colour
// moves by at most 1.3% between adjacent steps and 2.6% end to end, with no
// step at either hand-off. That is the no-pops-on-a-dolly claim, measured
// rather than asserted.

const cc_adscreens_MIN_H: f32 = 50.0;      // shorter buildings get no screen
const cc_adscreens_BLDG_FRAC: f32 = 0.085; // of tall buildings
const cc_adscreens_FACE_FRAC: f32 = 0.55;  // of a chosen building's facades
const cc_adscreens_MIN_FACADE_W: f32 = 14.0;
const cc_adscreens_MIN_SCREEN: f32 = 6.0;
const cc_adscreens_BASE_LO: f32 = 8.0;     // lower edge above the tier base
const cc_adscreens_BASE_HI: f32 = 25.0;
const cc_adscreens_BEZEL_FRAC: f32 = 0.028;
const cc_adscreens_BEZEL_MIN: f32 = 0.40;
// Content -> mean, as a fraction of the screen's short side (m/px).
const cc_adscreens_LOD_LO: f32 = 0.055;
const cc_adscreens_LOD_HI: f32 = 0.33;
// Peak-channel radiance of the screen's MEAN colour (see the header): the
// band a screen's overall level is drawn from.
const cc_adscreens_WANT_LO: f32 = 0.60;
const cc_adscreens_WANT_HI: f32 = 1.40;
// Light the screen throws on the wall around it. A screen this bright with a
// perfectly sharp edge reads as a decal; a little spill is what puts it in
// front of the masonry.
const cc_adscreens_SPILL: f32 = 0.055;
const cc_adscreens_SPILL_SIG: f32 = 1.6;   // metres, scaled by screen size

// --- field means -----------------------------------------------------------
// The panel-filling gradients, as cubics in the aspect ratio: the mean of
// exp(-(a x^2 + b y^2)) over the panel, which is an erf product WGSL has no
// erf for. Fitted over ar in [0.40, 1.34]; max relative error 0.02%.
// FACE's vignette, exp(-3 x^2 - 4.05 y^2):
const cc_adscreens_VIGN_C: vec4<f32> =
    vec4<f32>(0.743370, 0.012539, -0.231555, 0.069387);
// EYE's background, exp(-2.2 (x^2 + y^2)):
const cc_adscreens_EYEBG_C: vec4<f32> =
    vec4<f32>(0.840833, 0.016997, -0.198110, 0.051518);
// GLYPH: mean ink of the 3-stroke alphabet, blanks (1 cell in 8) included.
// Measured over 3000 alphabet draws on a 96^2 grid: 0.1388.
const cc_adscreens_M_GLYPH: f32 = 0.1388;
// STRIPES: the bottom 18% of the panel dimmed to 0.15 -> 0.82 + 0.18*0.15.
const cc_adscreens_STRIPE_FOOT: f32 = 0.847;
// STATIC: a uniform hash averages to a half; 6% of rows are torn bright.
const cc_adscreens_M_STATIC: vec2<f32> = vec2<f32>(0.5, 0.06);
// EYE: E[(0.45 + 0.75*rings)(0.70 + 0.55*spokes)] at rings = spokes = 1/2.
const cc_adscreens_IRIS_MEAN: f32 = 0.80438;
const cc_adscreens_TAU: f32 = 6.2831853;
const cc_adscreens_SQRT_HALF_PI: f32 = 1.2533141;

fn cc_adscreens_cubic(c: vec4<f32>, x: f32) -> f32 {
    return c.x + x * (c.y + x * (c.z + x * c.w));
}

// The advertising palette: saturated where the windows are not. Deliberately
// louder than city_window_color — a screen that shares the facade's spectrum
// stops being a screen.
fn cc_adscreens_neon(k: f32) -> vec3<f32> {
    let i = i32(clamp(k, 0.0, 0.9999) * 8.0);
    if (i == 0) { return vec3<f32>(1.00, 0.13, 0.42); }  // rose
    if (i == 1) { return vec3<f32>(0.10, 0.90, 1.00); }  // cyan
    if (i == 2) { return vec3<f32>(1.00, 0.60, 0.10); }  // amber
    if (i == 3) { return vec3<f32>(0.52, 1.00, 0.20); }  // acid green
    if (i == 4) { return vec3<f32>(0.60, 0.30, 1.00); }  // violet
    if (i == 5) { return vec3<f32>(1.00, 0.22, 0.10); }  // hot red
    if (i == 6) { return vec3<f32>(0.82, 0.90, 1.00); }  // cold white
    return vec3<f32>(1.00, 0.84, 0.32);                  // warm yellow
}

fn cc_adscreens_sd_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {
    let pa = p - a;
    let ba = b - a;
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * t);
}

// Area of a disc of radius r centred in a strip of half-width w: the iris of
// a narrow vertical banner runs off both sides of it, and an unclipped pi r^2
// would overstate its mean by half.
fn cc_adscreens_disc_clip(r: f32, w: f32) -> f32 {
    let full = 3.14159265 * r * r;
    if (r <= w) {
        return full;
    }
    let seg = r * r * acos(clamp(w / r, -1.0, 1.0))
            - w * sqrt(max(r * r - w * w, 0.0));
    return full - 2.0 * seg;
}

// --- the archetypes --------------------------------------------------------
//
// All of them take screen-local coordinates and return the three scalar
// fields that multiply the screen's three colours, plus — where the mean
// depends on the screen's own draw — the closed form of those fields' means.
// px and py are in units of the screen HEIGHT (px = (su - 0.5) * ar), so a
// circle drawn in them is round on the wall whatever the panel's shape. aa is
// half a pixel in those units; ps is the pixel's own half-width, for the
// gaussians that have to conserve their integral rather than shrink out of
// existence.

// A giant face. The eyes are blobs and the mouth is a bar, because a face
// assembled from parts you can name is a cartoon; what makes this one land is
// that the parts are just dark masses in the right places, over a vignette
// that could as easily be a light. The neon pinpricks in the eyes are the
// wrongness: nobody's eyes do that.
fn cc_adscreens_face(ch: vec4<f32>, px: f32, py: f32, aa: f32,
                     ps: f32) -> vec3<f32> {
    let sep = 0.13 + 0.07 * ch.x;
    let ey = 0.10 + 0.06 * ch.y;
    let er = 0.055 + 0.030 * ch.z;
    let my = -0.14 - 0.09 * ch.w;
    let mhw = 0.13 + 0.08 * ch.x;
    let mhh = 0.016 + 0.022 * ch.y;
    // Eyes are a little taller than wide, and the mouth is a slab.
    let d1 = length(vec2<f32>(px + sep, (py - ey) * 0.82));
    let d2 = length(vec2<f32>(px - sep, (py - ey) * 0.82));
    let e1 = 1.0 - smoothstep(er * 0.70, er * 1.15 + aa, d1);
    let e2 = 1.0 - smoothstep(er * 0.70, er * 1.15 + aa, d2);
    let mo = (1.0 - smoothstep(mhw - 0.02 - aa, mhw + 0.02 + aa, abs(px)))
           * (1.0 - smoothstep(mhh - aa, mhh + 0.012 + aa, abs(py - my)));
    let mask = clamp(max(max(e1, e2), mo), 0.0, 1.0);
    let vign = 0.42 + 0.58 * exp(-3.0 * (px * px + 1.35 * py * py));
    let skin = vign * (1.0 - 0.90 * mask);
    // Two point highlights, set off-centre in the eyes so the gaze is not
    // straight out. Widened by the pixel with the integral held, so they dim
    // honestly instead of flickering.
    let s0 = er * 0.26;
    let s = sqrt(s0 * s0 + ps * ps);
    let amp = 3.2 * (s0 * s0) / (s * s);
    let k = -0.5 / (s * s);
    let o = er * 0.28;
    let g1 = vec2<f32>(px + sep - o, py - ey - er * 0.18);
    let g2 = vec2<f32>(px - sep - o, py - ey - er * 0.18);
    let glint = amp * (exp(k * dot(g1, g1)) + exp(k * dot(g2, g2)));
    return vec3<f32>(skin, glint, 0.0);
}

fn cc_adscreens_face_mean(ch: vec4<f32>, ar: f32) -> vec3<f32> {
    let sep = 0.13 + 0.07 * ch.x;
    let ey = 0.10 + 0.06 * ch.y;
    let er = 0.055 + 0.030 * ch.z;
    let my = -0.14 - 0.09 * ch.w;
    let mhw = 0.13 + 0.08 * ch.x;
    let mhh = 0.016 + 0.022 * ch.y;
    let vign = 0.42 + 0.58 * cc_adscreens_cubic(cc_adscreens_VIGN_C, ar);
    // The blobs cut the vignette where they sit, so each area is weighted by
    // the vignette at its own centre, not by the panel average.
    let re = 0.925 * er;
    let a_eye = 3.14159265 * re * re / 0.82;
    let a_mouth = 4.0 * mhw * (mhh + 0.006);
    let ve = 0.42 + 0.58 * exp(-3.0 * (sep * sep + 1.35 * ey * ey));
    let vm = 0.42 + 0.58 * exp(-3.0 * (1.35 * my * my));
    let skin = vign - 0.90 * (2.0 * a_eye * ve + a_mouth * vm) / ar;
    let s0 = er * 0.26;
    let glint = 3.2 * cc_adscreens_TAU * s0 * s0 * 2.0 / ar;
    return vec3<f32>(skin, glint, 0.0);
}

// A product: one luminous capsule, a rim where the silhouette turns away,
// and a halo bleeding into a saturated gradient. Bottle, ampoule, pill,
// canister — the point is that it is never quite any of them.
fn cc_adscreens_product(ch: vec4<f32>, sv: f32, px: f32, py: f32,
                        aa: f32) -> vec3<f32> {
    let th = (ch.x - 0.5) * 0.9;
    let ln = 0.10 + 0.11 * ch.y;
    let r = 0.055 + 0.050 * ch.z;
    let ax = vec2<f32>(sin(th), cos(th));
    let p = vec2<f32>(px, py + 0.02);
    let d = cc_adscreens_sd_seg(p, -ax * ln, ax * ln) - r;
    let body = 1.0 - smoothstep(-aa - 0.004, aa + 0.004, d);
    let rim = exp(-abs(d) * 22.0);
    // The backdrop's gradient is the panel's, sv in [0, 1]. The facade hook
    // evaluates the content beyond the panel too (the spill ring above it,
    // where sv > 1) and masks it with `panel` = 0 — but pow() of a negative
    // base is NaN, and NaN * 0 is NaN: far screens reached by a jittered
    // ray left NaN pixels that stuck through the whole accumulation.
    let bg = (0.18 + 0.82 * pow(clamp(1.0 - sv, 0.0, 1.0), 1.3)) * 0.55;
    let dh = max(d, 0.0);
    let halo = 1.1 * exp(-dh * dh / (2.0 * 0.075 * 0.075));
    return vec3<f32>(bg, body * 2.4 + rim * 1.1, halo);
}

// Areas by Steiner: a convex body's offset region at distance s has area
// (perimeter + 2 pi s) ds, which integrates the rim's exponential and the
// halo's gaussian in closed form. The inward rim saturates at the inradius.
fn cc_adscreens_product_mean(ch: vec4<f32>, ar: f32) -> vec3<f32> {
    let ln = 0.10 + 0.11 * ch.y;
    let r = 0.055 + 0.050 * ch.z;
    let area = 4.0 * ln * r + 3.14159265 * r * r;
    let peri = 4.0 * ln + 2.0 * 3.14159265 * r;
    let k = 22.0;
    let ekr = exp(-k * r);
    let rim_out = peri / k + 2.0 * 3.14159265 / (k * k);
    let rim_in = peri * (1.0 - ekr) / k
               - 2.0 * 3.14159265 * (1.0 - ekr * (1.0 + k * r)) / (k * k);
    let sig = 0.075;
    let halo = 1.1 * (area + peri * sig * cc_adscreens_SQRT_HALF_PI
                      + 2.0 * 3.14159265 * sig * sig);
    // The background gradient is exact: mean of (0.18 + 0.82 (1-sv)^1.3)*0.55.
    return vec3<f32>(0.29509,
                     (2.4 * area + 1.1 * (rim_out + rim_in)) / ar,
                     halo / ar);
}

// A wall of writing that is not writing. Three axis-aligned strokes per cell
// with endpoints snapped to a 3x3 lattice: that quantization is the whole
// trick — free-floating segments read as scribble, snapped ones read as
// characters, and a character set you cannot read is more unsettling than
// one you can. One cell in eight is blank, which is what gives the rows
// their rhythm.
fn cc_adscreens_glyph_cell(bits: vec2<u32>, cu: f32, cv: f32,
                           aa: f32) -> f32 {
    if ((bits.y & 7u) == 0u) {
        return 0.0;
    }
    let p = vec2<f32>(cu, cv);
    let t = 0.075;
    var m = 0.0;
    for (var k: u32 = 0u; k < 3u; k = k + 1u) {
        let sft = k * 8u;
        let horiz = ((bits.x >> sft) & 1u) == 0u;
        let c = 0.14 + 0.72 * f32((bits.x >> (sft + 1u)) & 3u) / 3.0;
        let s = 0.14 + 0.72 * f32((bits.x >> (sft + 3u)) & 3u) / 3.0;
        let e = min(0.86, s + 0.72 * (0.30 + 0.60
                    * f32((bits.x >> (sft + 5u)) & 3u) / 3.0));
        var a: vec2<f32>;
        var b: vec2<f32>;
        if (horiz) {
            a = vec2<f32>(s, c);
            b = vec2<f32>(e, c);
        } else {
            a = vec2<f32>(c, s);
            b = vec2<f32>(c, e);
        }
        let d = cc_adscreens_sd_seg(p, a, b);
        m = max(m, 1.0 - smoothstep(t - aa, t + aa, d));
    }
    return m;
}

// Iris rings around a black pupil. The staple, and it earns its place: an
// eye at forty metres across is the one image on this wall that looks back.
fn cc_adscreens_eye(ch: vec4<f32>, px: f32, py: f32, aa: f32, ps: f32,
                    damp: f32) -> vec3<f32> {
    let rr = 0.28 + 0.12 * ch.x;
    let pu = rr * (0.24 + 0.14 * ch.y);
    let cx = (ch.z - 0.5) * 0.10;
    let cy = (ch.w - 0.5) * 0.08;
    let q = vec2<f32>(px - cx, py - cy);
    let d = length(q);
    let bg = 0.12 + 0.55 * exp(-2.2 * d * d);
    let nr = 14.0 + 10.0 * ch.y;
    let ns = 14.0 + floor(ch.x * 14.0);
    // Rings and spokes are the finest periodic structure on this screen and
    // blend to their own means (1/2 and 1/2) well before the panel does.
    let rings = mix(0.5 + 0.5 * sin(nr * cc_adscreens_TAU * (d / rr)
                                    + ch.z * cc_adscreens_TAU), 0.5, damp);
    let spokes = mix(0.5 + 0.5 * sin(atan2(q.y, q.x) * ns), 0.5, damp);
    let shape = (1.0 - smoothstep(rr * 0.90, rr + aa, d))
              * smoothstep(pu * 0.85, pu * 1.15 + aa, d);
    let iris = shape * (0.45 + 0.75 * rings) * (0.70 + 0.55 * spokes);
    let s0 = rr * 0.10;
    let s = sqrt(s0 * s0 + ps * ps);
    let amp = 5.0 * (s0 * s0) / (s * s);
    let g = vec2<f32>(q.x + rr * 0.30, q.y - rr * 0.34);
    let glint = amp * exp(-0.5 * dot(g, g) / (s * s));
    return vec3<f32>(bg, iris, glint);
}

fn cc_adscreens_eye_mean(ch: vec4<f32>, ar: f32) -> vec3<f32> {
    let rr = 0.28 + 0.12 * ch.x;
    let pu = rr * (0.24 + 0.14 * ch.y);
    let bg = 0.12 + 0.55 * cc_adscreens_cubic(cc_adscreens_EYEBG_C, ar);
    // The annulus between the two smoothstep midpoints, clipped by the panel
    // sides — a tall banner cuts the iris off well inside its radius.
    let a_ann = cc_adscreens_disc_clip(0.95 * rr, 0.5 * ar)
              - 3.14159265 * pu * pu;
    let s0 = rr * 0.10;
    return vec3<f32>(bg,
                     cc_adscreens_IRIS_MEAN * a_ann / ar,
                     5.0 * cc_adscreens_TAU * s0 * s0 / ar);
}

// --- the hook --------------------------------------------------------------

// Where this wall's screen hangs, if it has one, and where (uc, vc) falls on
// it: the placement the emission and the cover both read.
struct cc_adscreens_Place {
    on: bool,
    su: f32,
    sv: f32,
    sw: f32,
    sz: f32,
    ar: f32,
    ph: vec4<f32>,
    ph2: vec4<f32>,
    key: vec2<u32>,
    spill_sig: f32,
}

fn cc_adscreens_none() -> cc_adscreens_Place {
    return cc_adscreens_Place(false, 0.0, 0.0, 1.0, 1.0, 1.0, vec4<f32>(0.0),
                              vec4<f32>(0.0), vec2<u32>(0u), 1.0);
}

fn cc_adscreens_place(cc: CityCell, h: CityHit, uc: f32,
                      vc: f32) -> cc_adscreens_Place {
    // No screens on a warehouse: the industry component owns its walls.
    if (!cc.built || cc.height < cc_adscreens_MIN_H
        || cc.land_use == CITY_USE_INDUSTRIAL) {
        return cc_adscreens_none();
    }
    // Screens hang on flat vertical wall. A tapered shaft's skin is neither,
    // and the same rule that keeps antennas off a spire keeps screens off it.
    if (abs(h.normal.z) > 0.02) {
        return cc_adscreens_none();
    }
    // Which buildings. The base rate is one tall building in twelve, but not
    // spread evenly: screens CLUSTER. A uniform sprinkle put a handful on the
    // whole skyline and none at all in either canyon the harness frames, and
    // that is also not how a city works — the walls that carry advertising
    // are the ones a crowd walks past. So the draw is weighted by the
    // cascade percentile that already sets height and occupancy: downtown
    // runs about 2.5x the base rate, the outskirts a quarter of it, and the
    // megatower district (which is the shot) reliably carries screens.
    let dens_w = 0.30 + 2.20 * smoothstep(0.50, 0.95, cc.rank);
    let bd = city_rand4(cc.seed ^ vec2<u32>(0x1f83d9abu, 0x5be0cd19u));
    if (bd.x >= cc_adscreens_BLDG_FRAC * dens_w) {
        return cc_adscreens_none();
    }

    // The core's face: uc runs from its start corner, and the screen is laid
    // out on THAT box's extent.
    let face = city_face_at(cc, h.pos, h.normal);
    if (!face.aligned) {
        return cc_adscreens_none();
    }
    let bmin = vec3<f32>(0.0, face.z0, 0.0);
    let bmax = vec3<f32>(0.0, face.z1, 0.0);
    let tier = u32(face.tier);
    let u0 = 0.0;
    let fw = face.len;
    if (fw < cc_adscreens_MIN_FACADE_W) {
        return cc_adscreens_none();
    }
    let fid = u32(face.side);
    let key = vec2<u32>(cc.seed.x ^ (fid * 0x9e3779b9u) ^ 0x243f6a88u,
                        cc.seed.y ^ (tier * 0x85ebca6bu) ^ 0x13198a2eu);
    let ph = city_rand4(key);
    if (ph.x >= cc_adscreens_FACE_FRAC) {
        return cc_adscreens_none();
    }
    let ph2 = city_rand4(vec2<u32>(key.x ^ 0xa4093822u, key.y ^ 0x299f31d0u));

    // Size. A merged superblock's facade is already twice as wide, and it is
    // allowed a bigger fraction of it on top: those are the giants.
    let wlo = select(0.30, 0.35, cc.merged);
    let whi = select(0.70, 0.86, cc.merged);
    var sw = fw * mix(wlo, whi, ph.y);
    let ar = 0.40 + 0.93 * ph.z;          // width : height, 1:2.5 .. 4:3
    var sz = sw / ar;
    // Where the screen's lower edge sits. A mid-rise takes the plain law —
    // 8 to 25 m above the tier it stands on, which is where a screen goes on
    // a building you walk past. A megatower cannot: its tier-1 wall is
    // hundreds of metres of facade, soar's camera flies well above the
    // street, and a 25-m-high mark on a 400 m shaft is a thing no flight
    // ever sees. So a tall wall places its screen proportionally instead,
    // anywhere in the lower two thirds of itself — the same argument
    // facadeworks makes for signage, and the same crossover.
    let wall_h = bmax.y - bmin.y;
    let z_low = cc_adscreens_BASE_LO
              + (cc_adscreens_BASE_HI - cc_adscreens_BASE_LO) * ph.w;
    let z_tall = wall_h * (0.06 + 0.60 * ph.w);
    let z0 = bmin.y + mix(z_low, max(z_tall, z_low),
                          smoothstep(90.0, 320.0, wall_h));
    let avail = bmax.y - 3.0 - z0;
    if (avail < cc_adscreens_MIN_SCREEN) {
        return cc_adscreens_none();
    }
    if (sz > avail) {                      // keep the aspect, lose the size
        sw = sw * (avail / sz);
        sz = avail;
    }
    if (sw < cc_adscreens_MIN_SCREEN) {
        return cc_adscreens_none();
    }
    let slack = max(fw - 2.0 - sw, 0.0);
    let su = (uc - (u0 + 1.0 + slack * ph2.x)) / sw;
    let sv = (vc - z0) / sz;
    // The spill reaches beyond the panel, so the reject has to as well.
    let spill_sig = clamp(cc_adscreens_SPILL_SIG * (1.0 + 0.02 * min(sw, sz)),
                          0.8, 5.0);
    let mu = 2.6 * spill_sig / sw;
    let mv = 2.6 * spill_sig / sz;
    if (su < -mu || su > 1.0 + mu || sv < -mv || sv > 1.0 + mv) {
        return cc_adscreens_none();
    }
    return cc_adscreens_Place(true, su, sv, sw, sz, ar, ph, ph2, key,
                              spill_sig);
}

// The outer rectangle, antialiased by the footprint: everything inside it
// is panel or bezel.
fn cc_adscreens_outer(p: cc_adscreens_Place, fp: f32) -> f32 {
    let au = clamp(0.6 * fp / p.sw, 0.0015, 0.25);
    let av = clamp(0.6 * fp / p.sz, 0.0015, 0.25);
    return smoothstep(-au, au, p.su)
        * (1.0 - smoothstep(1.0 - au, 1.0 + au, p.su))
        * smoothstep(-av, av, p.sv)
        * (1.0 - smoothstep(1.0 - av, 1.0 + av, p.sv));
}

fn cc_adscreens_cover(cc: CityCell, h: CityHit, uc: f32, vc: f32,
                      fp: f32) -> f32 {
    let p = cc_adscreens_place(cc, h, uc, vc);
    if (!p.on) {
        return 0.0;
    }
    return cc_adscreens_outer(p, fp);
}

fn cc_adscreens_facade(cc: CityCell, h: CityHit, dir: vec3<f32>, uc: f32,
                       vc: f32, fp: f32) -> vec3<f32> {
    let p = cc_adscreens_place(cc, h, uc, vc);
    if (!p.on) {
        return vec3<f32>(0.0);
    }
    let su = p.su;
    let sv = p.sv;
    let sw = p.sw;
    let sz = p.sz;
    let ar = p.ar;
    let ph = p.ph;
    let ph2 = p.ph2;
    let key = p.key;
    let spill_sig = p.spill_sig;

    // The outer rectangle: everything inside it is panel or bezel, and the
    // core has taken the wall out from under all of it (the cover hook).
    let au = clamp(0.6 * fp / sw, 0.0015, 0.25);
    let av = clamp(0.6 * fp / sz, 0.0015, 0.25);
    let outer = cc_adscreens_outer(p, fp);
    // The bezel: a thin dark frame the screen sits inside, so it reads as
    // mounted on the wall rather than painted into it.
    let bez = max(cc_adscreens_BEZEL_MIN,
                  cc_adscreens_BEZEL_FRAC * min(sw, sz));
    let bu = bez / sw;
    let bv = bez / sz;
    let panel =
        smoothstep(bu - au, bu + au, su)
        * (1.0 - smoothstep(1.0 - bu - au, 1.0 - bu + au, su))
        * smoothstep(bv - av, bv + av, sv)
        * (1.0 - smoothstep(1.0 - bv - av, 1.0 - bv + av, sv));

    // Three colours out of the neon family, never the same one twice.
    let qa0 = cc_adscreens_neon(ph2.z);
    let qb0 = cc_adscreens_neon(fract(ph2.z + 0.19 + 0.60 * ph2.w));
    let qc0 = cc_adscreens_neon(fract(ph2.z + 0.44 + 0.30 * ph.y));
    let ch = city_rand4(vec2<u32>(key.x ^ 0x082efa98u, key.y ^ 0xec4e6c89u));

    let px = (su - 0.5) * ar;
    let py = sv - 0.5;
    let aa = clamp(0.6 * fp / sz, 0.0008, 0.20);
    let ps = 0.5 * fp / sz;

    var f: vec3<f32>;
    var m: vec3<f32>;
    var qa: vec3<f32>;
    var qb: vec3<f32>;
    var qc: vec3<f32>;
    // Not every screen runs at the same level. A dead channel is the dimmest
    // thing on the street, not the brightest; a face lit to full white loses
    // the skin it is supposed to have.
    var lvl = 1.0;
    let ad = ph2.y;
    if (ad < 0.17) {                                   // FACE
        f = cc_adscreens_face(ch, px, py, aa, ps);
        m = cc_adscreens_face_mean(ch, ar);
        qa = mix(vec3<f32>(1.00, 0.68, 0.52), qa0, 0.35);
        qb = qb0;
        qc = vec3<f32>(0.0);
        lvl = 0.72;
    } else if (ad < 0.38) {                            // PRODUCT
        f = cc_adscreens_product(ch, sv, px, py, aa);
        m = cc_adscreens_product_mean(ch, ar);
        qa = qa0 * 0.60;
        qb = mix(qb0, vec3<f32>(1.0), 0.55);
        qc = qc0;
    } else if (ad < 0.59) {                            // GLYPH
        // Characters are sized in METRES, not in panel fractions: a shop
        // screen carries three of them and a superblock carries thirty,
        // which is the difference between a sign and a wall of writing.
        // Counting rows as a fixed fraction of the panel instead made every
        // screen three characters tall, so the small ones read as scribble
        // and the giants as three enormous blobs.
        let cell_m = 3.2 + 3.0 * ch.x;
        let nr = clamp(round(sz / cell_m), 2.0, 40.0);
        let nc = clamp(round(sw / (cell_m * (0.85 + 0.35 * ch.y))),
                       1.0, 60.0);
        let gx = su * nc;
        let gy = sv * nr;
        let ix = i32(floor(gx));
        let iy = i32(floor(gy));
        let bits = pcg2d(vec2<u32>(
            key.x ^ (bitcast<u32>(ix) * 0x9e3779b9u),
            key.y ^ (bitcast<u32>(iy) * 0x85ebca6bu)));
        // Cell size on the wall sets when the strokes stop resolving.
        let cs = min(sw / nc, sz / nr);
        let dmp = smoothstep(0.30 * cs, 1.1 * cs, fp);
        let gm = mix(cc_adscreens_glyph_cell(
                         bits, fract(gx), fract(gy),
                         clamp(0.6 * fp / cs, 0.002, 0.25)),
                     cc_adscreens_M_GLYPH, dmp);
        f = vec3<f32>(0.40 + 0.30 * (1.0 - sv), gm * 2.6, 0.0);
        m = vec3<f32>(0.55, cc_adscreens_M_GLYPH * 2.6, 0.0);
        qa = select(vec3<f32>(0.42, 0.03, 0.06), vec3<f32>(0.04, 0.07, 0.42),
                    ch.w > 0.5);
        qb = qa0;
        qc = vec3<f32>(0.0);
    } else if (ad < 0.70) {                            // STRIPES
        // Bars are metres wide too, and their count stays a multiple of
        // three so each colour gets exactly a third of the panel.
        let bar_m = 1.6 + 2.4 * ch.y;
        let nb = 3.0 * clamp(round(sw / (3.0 * bar_m)), 2.0, 12.0);
        let j = floor(clamp(su, 0.0, 0.99999) * nb);
        let idx = i32(j) - 3 * (i32(j) / 3);
        // One brightness per COLOUR, not per bar: with only 2-5 bars to a
        // colour, a per-bar draw would leave the screen's true mean 15% away
        // from any constant we could write down, and that gap is the LOD
        // step. Per colour it is exact.
        let bh = city_rand4(vec2<u32>(key.x ^ 0x27d4eb2fu, key.y ^ 0x165667b1u));
        let brs = vec3<f32>(0.55 + 0.90 * bh.x, 0.55 + 0.90 * bh.y,
                            0.55 + 0.90 * bh.z);
        let br = select(select(brs.z, brs.y, idx == 1), brs.x, idx == 0);
        let foot = mix(0.15, 1.0, smoothstep(0.18 - av, 0.18 + av, sv));
        let v = br * foot;
        m = brs * (cc_adscreens_STRIPE_FOOT / 3.0);
        let dmp = smoothstep(0.45 * sw / nb, 1.4 * sw / nb, fp);
        f = mix(vec3<f32>(select(0.0, v, idx == 0), select(0.0, v, idx == 1),
                          select(0.0, v, idx == 2)), m, dmp);
        qa = qa0;
        qb = qb0;
        qc = qc0;
    } else if (ad < 0.81) {                            // STATIC
        // The dead channel's pixel pitch is a physical size — a coarse LED
        // module, 0.7-1.6 m — so the grain reads at the same distance on
        // every screen instead of vanishing on the small ones.
        let pitch_m = 0.7 + 0.9 * ch.x;
        let ncx = clamp(round(sw / pitch_m), 6.0, 220.0);
        let ncy = max(1.0, round(sz / pitch_m));
        let row = floor(sv * ncy);
        let rh = city_rand4(vec2<u32>(
            key.x ^ (bitcast<u32>(i32(row)) * 0x9e3779b9u),
            key.y ^ 0x51ed270bu));
        // A tenth of the rows are sheared: a frozen glitch, not a moving one.
        let uu = fract(su + select(0.0, (rh.y - 0.5) * 0.35, rh.x < 0.10));
        let nz = city_rand4(vec2<u32>(
            key.x ^ (bitcast<u32>(i32(floor(uu * ncx))) * 0x85ebca6bu),
            key.y ^ (bitcast<u32>(i32(row)) * 0xc2b2ae35u)));
        m = vec3<f32>(cc_adscreens_M_STATIC, 0.0);
        let cs = min(sw / ncx, sz / ncy);
        let dmp = smoothstep(0.35 * cs, 1.3 * cs, fp);
        f = vec3<f32>(mix(nz.x, m.x, dmp),
                      mix(select(0.0, 1.0, rh.z < 0.06), m.y, dmp), 0.0);
        qa = vec3<f32>(0.78, 0.82, 0.92);
        qb = qa0;
        qc = vec3<f32>(0.0);
        lvl = 0.55;
    } else {                                           // EYE
        let rr = 0.28 + 0.12 * ch.x;
        let ring_p = rr * sz / (14.0 + 10.0 * ch.y);
        let dmp = smoothstep(0.40 * ring_p, 1.3 * ring_p, fp);
        f = cc_adscreens_eye(ch, px, py, aa, ps, dmp);
        m = cc_adscreens_eye_mean(ch, ar);
        qa = qa0 * 0.55;
        qb = qb0;
        qc = vec3<f32>(1.0, 0.98, 0.95);
    }

    // The screen's own mean colour: the three colours against the three field
    // means. It is both the far-field asymptote and the yardstick the content
    // is normalized against, so the level a screen was designed to have
    // survives whatever its palette draw turned out to be. Normalising on the
    // LARGEST channel rather than on luminance is what keeps the hue: the
    // tone map clips channels one at a time, and a screen normalised by
    // luminance drives its dominant channel far past the white point and
    // comes back white.
    let mean_c = max(qa * m.x + qb * m.y + qc * m.z, vec3<f32>(0.0));
    let peak = max(max(mean_c.r, mean_c.g), mean_c.b);
    let want = mix(cc_adscreens_WANT_LO, cc_adscreens_WANT_HI, ph2.x);
    let gain = want * lvl / max(peak, 1e-3);

    let lod = smoothstep(cc_adscreens_LOD_LO * min(sw, sz),
                         cc_adscreens_LOD_HI * min(sw, sz), fp);
    let content = mix(qa * f.x + qb * f.y + qc * f.z, mean_c, lod);

    // Spill: the wall around the panel catches its light. Cheap, and it is
    // what stops the screen reading as a decal printed on the masonry.
    let dxu = max(max(-su, su - 1.0), 0.0) * sw;
    let dyv = max(max(-sv, sv - 1.0), 0.0) * sz;
    let dout = length(vec2<f32>(dxu, dyv));
    let spill = cc_adscreens_SPILL
              * exp(-0.5 * dout * dout / (spill_sig * spill_sig));

    // Opaque: the core took the wall out over the whole outer rectangle
    // (cover), so the screen only puts itself back inside the bezel.
    return content * (gain * panel)
         + mean_c * (gain * spill * (1.0 - outer));
}

// --- component: manholesteam (manholesteam.wgsl) ---
// manholesteam — steam rising from the manholes, and the striped stacks
// Con Ed stands over the worst of them.
//
// WHERE. The core's manhole lattice (city_manhole: a site every
// CITY_MH_PITCH along every centreline, present at a hashed share) is the
// only place steam comes from; the ground shader draws a cover at exactly
// those sites, so a plume always rises from a cover. A present site steams
// when its steam draw is under a district fraction (cc_manholesteam_site),
// which puts a steaming cover every block or two downtown and almost none in
// the outskirts. The most vigorous STACK_SHARE of the steaming sites wear a
// stack: an orange-and-white banded tube 3 m tall standing on the cover,
// whose plume starts at its mouth instead of the road.
//
// THE PLUME is a bent-over buoyant plume, written in the plume's own
// coordinates (cc_manholesteam_density). It widens linearly with height (the
// entrainment law of a turbulent plume, r = r0 + SPREAD z), thins as it
// widens, leans downwind along one city-wide WIND, and dissolves over its
// top third. Its lumps are value noise measured in LOCAL RADII — across the
// plume by d / r, up it by the integral of dz / r — so an eddy is always
// the same fraction of the plume that carries it: small and tight at the
// cover, large and soft aloft. The lumps rise on the scene clock
// (scene_time; the live view draws them after its accumulation, so they go
// on rising over a parked view: fs_steam_live) at a fixed rate in zeta:
// in metres that is slow at the cover and faster aloft, where each eddy is
// larger — the plume billows up and opens out rather than scrolling.
//
// THE LIGHT is all it has. Steam is white (single-scattering albedo ~1), so
// its colour is entirely what lights it: the sodium lamp heads through
// city_street_light_g with a forward-peaked Henyey-Greenstein phase (a plume
// with a lamp behind it blazes, the look of every reference photograph),
// the storefront bands on both sides of the street (an infinite emitting
// strip, its solid angle exact, its phase approximated about the strip's
// nearest point), and the two hemispheres — the lit street below, the
// night sky above. Two density taps toward the light give the billows lit
// tops and grey undersides, and a knee on the source keeps a plume inside
// a lamp's reach from clipping to one flat sheet.
//
// By the city's own calibration the lamps light a parcel of steam about
// twenty times harder than a storefront does (a pool of 0.7 on asphalt of
// albedo 0.035 is an irradiance of ~60; a 2.2 storefront filling 1.6 sr is
// ~3.5), so downtown steam is sodium amber, and a storefront's colour shows
// only in plumes standing away from the lamp lines.
//
// THE COST. The medium is marched only where a ray enters a plume's box,
// and finding those boxes is the part every city pixel pays for, so it is
// built as a cascade of rejects (cc_manholesteam_media):
//   1. the ray segment is clipped to the slab z in [0, ZTOP] (the tallest
//      plume top), to the range cap and to the footprint cap. A ray that
//      never gets that low leaves with no work at all;
//   2. per street orientation, only the centrelines whose BAND (every site's
//      lateral offset plus the widest plume's reach) the segment enters are
//      visited, in ray order, and on each only the lattice sites whose
//      along-street extent overlaps the part of the segment inside the band.
//      A ray running along a street stays inside one band for its whole
//      length and walks that street's sites front to back — the eye-level
//      case, designed for; a ray crossing streets meets each band for a few
//      tens of metres and one or two sites;
//   3. one hash per site (present, steam draw) before any texture read;
//   4. one slab test per steaming site's box, and a march of 8-16 run-time
//      steps over the entered interval, jittered by the pixel's stratified
//      uniform so the accumulation integrates what a few steps sample.
// The loops are all rolled with run-time bounds and the density and the
// lighting are single functions called once, in one loop (the shadow taps
// share the sample's call site): the city and the clouds share one kernel,
// and occupancy is every pixel's cost.
//
// Measured (RTX 5080, 768x432, 256 frames at LOD 0.01, min of two
// back-to-back runs, component unregistered vs registered, ms/frame):
//     eye level, two plumes and a stack in view   2.11 -> 2.30   (+9%)
//     aerial                                       4.34 -> 4.38
//     base                                         5.31 -> 5.35
//     street                                       0.98 -> 0.98
//     horizon                                      5.86 -> 5.94
// The wide views pay ~1% — the gates plus the register footprint — and the
// eye-level view pays for its enumeration and its marches.

// --- where steam is ----------------------------------------------------------
// Which present sites steam is the core's (city_manhole_steam, with its
// district shares CITY_MH_STEAM_FRAC_*), which the ground asks too: a
// steaming cover is a dry, pale lid on a wet street.
// The most vigorous share of steaming sites carry a stack.
const cc_manholesteam_STACK_SHARE: f32 = 0.22;

// --- the plume ---------------------------------------------------------------
// One wind for the whole city, blowing toward the north-north-east: a
// diagonal to the grid, so no street sees its plumes lean straight along
// or straight across it.
const cc_manholesteam_WIND: vec2<f32> = vec2<f32>(0.4472136, 0.8944272);
// The source radius of a plume from a bare cover: the radius its body
// grows from (r = R0_COVER + SPREAD z, which the thinning and the lumps
// follow), wider than the iron (CITY_MH_R) because the steam billows out
// within a metre. A stack's leaves its own mouth.
const cc_manholesteam_R0_COVER: f32 = 0.9;
// The first metre of a cover's plume (Thomas, 2026-11-08: a plume "just on
// a random bit of street" — its cover was there, buried in the plume's own
// dense 0.9 m base). Steam leaves through the lid's vent holes and rim gap,
// so the plume's edge starts at the lid (CITY_MH_R) and relaxes onto the
// body's radius over NECK_L; and it leaves as hot vapour, near transparent,
// condensing into the visible plume as it mixes with the cold air — its
// density ramps as 1 - exp(-z / COND_L). The lid shows through the foot of
// its plume from an ordinary viewing angle. Stacks keep their mouths.
const cc_manholesteam_NECK_L: f32 = 0.35;
const cc_manholesteam_COND_L: f32 = 0.10;
const cc_manholesteam_H_MIN: f32 = 6.0;    // plume height above its source
const cc_manholesteam_H_MAX: f32 = 12.0;
// How fast the lumps climb, in zeta per second of scene clock: a lump at
// the cover (radius r0 ~0.3 m) rises ~0.35 m/s, one a metre across ~1.2 m/s.
const cc_manholesteam_RISE_RATE: f32 = 1.2;
// The city's scene clock wraps at its tile meta's clock_period_s, 2600 s,
// and the steam repeats exactly at that period: the lumps' lattice
// coordinate up the plume is 1.3 zeta, which climbs 1.3 * RISE_RATE * 2600
// = 4056 cells per period, so the lattice wraps in z at exactly that many
// cells (ZWRAP) and every octave steps up by exactly 2 in z (a whole
// multiple of it) — the wrap lands every octave on the lattice point it
// left, and no plume pops. Change RISE_RATE, the 1.3, or the period
// together, keeping 1.3 * RISE_RATE * CLOCK_PERIOD_S an integer.
const cc_manholesteam_CLOCK_PERIOD_S: f32 = 2600.0;
const cc_manholesteam_ZWRAP: f32 = 4056.0;
// Radius growth per metre of rise. 0.12 is a pure plume in still air; a
// plume bent over by a crosswind entrains faster, and steam also sheds
// visible mass as it mixes, which the thinning law below carries.
const cc_manholesteam_SPREAD: f32 = 0.24;
// Density falls as (R0_COVER / r)^THIN: 2 would conserve the steam mass of a
// plume of constant speed, but condensate evaporates as it mixes AND the
// plume decelerates, and the two roughly cancel in what the eye sees — a
// plume that stays readable to its top. 1.4 is set against the references.
const cc_manholesteam_THIN: f32 = 1.4;
// Downwind drift of the top, as a fraction of the plume height; the
// centreline bends as the square of the rise (it leaves the source
// vertical, which is what a jet does, and bends over as it slows).
const cc_manholesteam_LEAN_LO: f32 = 0.35;
const cc_manholesteam_LEAN_HI: f32 = 0.80;
const cc_manholesteam_LEAN_STACK: f32 = 0.95; // a stack's plume lies over
// Extinction at a cover's source core (m^-1): a metre of it takes four
// fifths of the light. A stack's mouth is denser still (see the density).
const cc_manholesteam_SIGMA: f32 = 1.6;
// The billows. n, the noise centred on zero, lies in [-0.5, 0.5]; the
// plume's edge sits at EDGE + BILLOW n radii from the axis, with a soft
// shoulder SOFT radii wide, and the density inside is scaled by
// 1 + LUMP n. CUT = EDGE + BILLOW / 2 is the farthest a billow can reach,
// so the profile is zero there by construction — a bound, never a visible
// edge. (The first pass cut a noise-displaced edge at a fixed radius, and
// every plume showed the straight silhouette of that cone.)
const cc_manholesteam_EDGE: f32 = 1.0;
const cc_manholesteam_BILLOW: f32 = 2.2;
const cc_manholesteam_SOFT: f32 = 0.3;
const cc_manholesteam_LUMP: f32 = 4.0;
const cc_manholesteam_CUT: f32 = 2.1;
// Light that has crossed the plume's own steam keeps this share even when
// the single-scattering estimate says it is gone: multiple scattering is
// what makes a dense cloud grey inside rather than black.
const cc_manholesteam_MS_FLOOR: f32 = 0.30;
// Self-shadowing: two density taps toward the light, at these distances in
// local radii, each weighted by SHADOW_SEG radii of path. This is what
// gives the billows lit tops and grey undersides.
const cc_manholesteam_SHADOW_TAP: vec2<f32> = vec2<f32>(0.4, 1.2);
const cc_manholesteam_SHADOW_SEG: f32 = 0.8;

// --- the stack ---------------------------------------------------------------
const cc_manholesteam_STACK_R: f32 = 0.45;
const cc_manholesteam_STACK_H: f32 = 3.0;
// Reflective sheeting, banded: an orange band of ORANGE_W every BAND_P,
// white between, the lowest band starting at the foot. The albedos are
// DIFFUSE albedos, about half what the white looks like in a headlight:
// retroreflective sheeting sends most of what it returns back toward its
// source. At the paint's full 0.6 the lamp light (in asphalt-relative
// units, divided by 0.035) clipped both bands to one cream colour.
const cc_manholesteam_BAND_P: f32 = 0.42;
const cc_manholesteam_ORANGE_W: f32 = 0.24;
const cc_manholesteam_ORANGE: vec3<f32> = vec3<f32>(0.32, 0.05, 0.006);
const cc_manholesteam_WHITE: vec3<f32> = vec3<f32>(0.30, 0.29, 0.27);
// Wet sheeting: the mirror lobe of the lamp heads, weighted by a Fresnel
// share. g sets the lobe's width.
const cc_manholesteam_SHEEN: f32 = 0.06;
const cc_manholesteam_SHEEN_G: f32 = 0.85;
const cc_manholesteam_INNER: f32 = 0.02;   // the tube's sooty inside

// --- enumeration bounds (derived from the above; restated as numbers because
// WGSL consts cannot call functions) ---------------------------------------
// Tallest plume top: a stack's mouth plus the tallest plume.
const cc_manholesteam_ZTOP: f32 = 15.0;
// Farthest a plume box reaches from its site in xy: the most-bent plume's
// drift, LEAN_STACK x H_MAX = 11.4, plus CUT x (the larger source radius,
// R0_COVER, + SPREAD x H_MAX) = 7.9.
const cc_manholesteam_REACH: f32 = 19.4;
// A site's lateral offset from its centreline (city_manhole): at most
// 1.6 + 3.1 x 2 on an avenue, 1.1 + 0.8 on a minor street; and its along
// jitter, +-3 m about the lattice point.
const cc_manholesteam_LAT_AVE: f32 = 7.8;
const cc_manholesteam_LAT_MINOR: f32 = 1.9;
const cc_manholesteam_ALONG_JIT: f32 = 3.0;

// --- LOD ---------------------------------------------------------------------
// Steam is a near thing. A plume is marched out to RANGE and fades to zero
// density over its last third; independently it fades with footprint, gone
// by FP_END (a plume then spans a few pixels, where it was only ever a faint
// smudge on the road). Whichever comes first ends the march.
const cc_manholesteam_RANGE: f32 = 360.0;
const cc_manholesteam_RANGE_FADE: f32 = 240.0;
const cc_manholesteam_FP_START: f32 = 0.6;
const cc_manholesteam_FP_END: f32 = 1.5;
// Noise octaves by footprint. The base lattice is r / 1.6, so octave k is
// r / (1.6 x 2^k) — at the widest plume (r ~ 3.8 m) 0.3 m for the fourth,
// 0.6 m for the third. Each is dropped once it is under a couple of pixels
// everywhere in the plume, which leaves its mean (the noise is centred).
const cc_manholesteam_OCT4_FP: f32 = 0.05;
const cc_manholesteam_OCT3_FP: f32 = 0.15;
// The march: STEP metres per step, 8 to 16 steps.
const cc_manholesteam_STEP: f32 = 0.7;
const cc_manholesteam_STEPS_MIN: i32 = 8;
const cc_manholesteam_STEPS_MAX: i32 = 16;

// --- lighting ----------------------------------------------------------------
// city_street_light_g is in the GROUND's units: radiance of a surface of
// asphalt's albedo facing the lamp, with its 4 pi phase normalisation making
// an isotropic medium equal to that surface. A white medium scatters
// 1 / (4 pi) of the irradiance per steradian where asphalt returns
// CITY_ASPHALT_ALBEDO / pi, so the conversion is 1 / (4 x 0.035).
const cc_manholesteam_LAMP_REL: f32 = 7.14;
const cc_manholesteam_G: f32 = 0.6;
// The storefront strip is broad, so its phase is taken about its nearest
// point with a gentler g.
const cc_manholesteam_STORE_G: f32 = 0.35;
// The source knee (the ground's CITY_POOL_KNEE, for the medium): the light
// a steam parcel sees within a few metres of a lamp head runs past 20 in
// these units, and uncompressed every plume downtown is one clipped sheet.
// Hue-preserving, and the dim fringes pass through untouched.
const cc_manholesteam_SRC_CAP: f32 = 6.0;

// ---------------------------------------------------------------------------
// A steaming site
// ---------------------------------------------------------------------------

struct cc_manholesteam_Site {
    on: bool,            // a present cover that steams
    stack: bool,         // ... under a stack
    c: vec2<f32>,        // the cover's centre
    z0: f32,             // the plume's source height (road or stack mouth)
    r0: f32,             // its radius there
    h: f32,              // plume height above z0
    lean: f32,           // top drift / h
    vigor: f32,          // density scale
    seed: vec2<f32>,     // noise offset
}

fn cc_manholesteam_site(k: i32, j: i32, along_y: bool) -> cc_manholesteam_Site {
    var s: cc_manholesteam_Site;
    s.on = false;
    s.stack = false;
    let m = city_manhole(k, j, along_y);
    let v = city_manhole_steam(m);   // uniform in [0, 1) over steaming sites
    if (v >= 1.0) {
        return s;
    }
    // Seeded like the site itself (city_manhole): the street and the along
    // index folded at the tile, so a plume keeps its shape across the seam.
    let jn = i32(round(u.ocean_params.y / CITY_MH_PITCH));
    let r = city_rand4(vec2<u32>(
        city_line_seed(k) * 0x2545f491u + select(0x6a09e667u, 0xbb67ae85u,
                                                 along_y),
        bitcast<u32>(((j % jn) + jn) % jn) * 0x9e3779b9u + 0x3c6ef372u));
    s.on = true;
    s.stack = v < cc_manholesteam_STACK_SHARE;
    s.c = m.xy;
    s.z0 = select(0.0, cc_manholesteam_STACK_H, s.stack);
    s.r0 = select(cc_manholesteam_R0_COVER, 0.85 * cc_manholesteam_STACK_R,
                  s.stack);
    s.h = mix(cc_manholesteam_H_MIN, cc_manholesteam_H_MAX, r.x);
    s.lean = select(mix(cc_manholesteam_LEAN_LO, cc_manholesteam_LEAN_HI, r.y),
                    cc_manholesteam_LEAN_STACK, s.stack);
    // The strongest leaks are the ones that got a stack; the weakest
    // barely clear the cover.
    s.vigor = 1.0 - 0.6 * v;
    s.seed = 97.0 * r.zw;
    return s;
}

// The plume's bounding box: the source disc and the top disc, each widened
// to the profile cut at the top radius.
fn cc_manholesteam_box_min(s: cc_manholesteam_Site) -> vec3<f32> {
    let rc = cc_manholesteam_CUT * (s.r0 + cc_manholesteam_SPREAD * s.h);
    let drift = cc_manholesteam_WIND * (s.lean * s.h);
    return vec3<f32>(s.c + min(drift, vec2<f32>(0.0)) - rc, s.z0);
}

fn cc_manholesteam_box_max(s: cc_manholesteam_Site) -> vec3<f32> {
    let rc = cc_manholesteam_CUT * (s.r0 + cc_manholesteam_SPREAD * s.h);
    let drift = cc_manholesteam_WIND * (s.lean * s.h);
    return vec3<f32>(s.c + max(drift, vec2<f32>(0.0)) + rc, s.z0 + s.h);
}

// ---------------------------------------------------------------------------
// The density
// ---------------------------------------------------------------------------

// 3-D value noise, mean 0.5, on the integer lattice.
fn cc_manholesteam_vnoise3(p: vec3<f32>) -> f32 {
    let i = floor(p);
    let f = p - i;
    let w = f * f * (3.0 - 2.0 * f);
    // Two z slices of the 2-D lattice, told apart by a large shift; z wraps
    // at ZWRAP cells, which is what makes the steam periodic in the clock
    // (and keeps the hash's arguments small however long the flight).
    // i.z and ZWRAP are integers held exactly in f32, so the floor-div wrap
    // is exact but for one case: at an exact multiple a reciprocal a ulp
    // off can floor one short and give z0 = ZWRAP (or one long, -ZWRAP) —
    // a seam across the plume. The two selects put that back in [0, ZWRAP).
    // Not the euclidean ((a % n) + n) % n: that is docs/soar-bugs.md bug
    // 22's trigger (NVIDIA's compiler segfaults on it under Firefox).
    var z0 = i.z - cc_manholesteam_ZWRAP * floor(i.z / cc_manholesteam_ZWRAP);
    z0 = select(z0, z0 - cc_manholesteam_ZWRAP, z0 >= cc_manholesteam_ZWRAP);
    z0 = select(z0, z0 + cc_manholesteam_ZWRAP, z0 < 0.0);
    let z1 = select(z0 + 1.0, 0.0, z0 + 1.0 >= cc_manholesteam_ZWRAP);
    let s0 = i.xy + vec2<f32>(37.0, 17.0) * z0;
    let s1 = i.xy + vec2<f32>(37.0, 17.0) * z1;
    let lo = mix(mix(hash12(s0), hash12(s0 + vec2<f32>(1.0, 0.0)), w.x),
                 mix(hash12(s0 + vec2<f32>(0.0, 1.0)),
                     hash12(s0 + vec2<f32>(1.0, 1.0)), w.x), w.y);
    let hi = mix(mix(hash12(s1), hash12(s1 + vec2<f32>(1.0, 0.0)), w.x),
                 mix(hash12(s1 + vec2<f32>(0.0, 1.0)),
                     hash12(s1 + vec2<f32>(1.0, 1.0)), w.x), w.y);
    return mix(lo, hi, w.z);
}

// The plume at p, in its own coordinates: rise z above the source, radius
// r(z), and the offset q from the bent centreline. Returns the density
// relative to a full-vigour source core.
fn cc_manholesteam_density(p: vec3<f32>, s: cc_manholesteam_Site,
                           octaves: i32) -> f32 {
    let z = p.z - s.z0;
    if (z < 0.0 || z > s.h) {
        return 0.0;
    }
    let rise = z / s.h;
    let r = s.r0 + cc_manholesteam_SPREAD * z;
    let q = p.xy - s.c - cc_manholesteam_WIND * (s.lean * s.h * rise * rise);
    // A cover's plume: its edge from the lid's radius, its density from
    // nothing, over its first decimetres (NECK_L, COND_L).
    var r_edge = r;
    var cond = 1.0;
    if (!s.stack) {
        r_edge = r - (s.r0 - CITY_MH_R) * exp(-z / cc_manholesteam_NECK_L);
        cond = 1.0 - exp(-z / cc_manholesteam_COND_L);
    }
    // Distance from the axis in local radii. Past CUT nothing can reach
    // (r_edge <= r, so the box, sized by r, still bounds it).
    let d = length(q) / r_edge;
    if (d >= cc_manholesteam_CUT) {
        return 0.0;
    }
    // Lumps in local radii: across by q / r, up by zeta = integral of
    // dz / r = ln(r / r0) / SPREAD.
    // @domain: r >= r0 > 0: the plume's radius only grows from its source
    let zeta = log(r / s.r0) / cc_manholesteam_SPREAD
             - cc_manholesteam_RISE_RATE * scene_time();
    var x = vec3<f32>(1.6 * q / r + s.seed, 1.3 * zeta);
    var n = 0.0;
    var amp = 0.5;
    var norm = 0.0;
    for (var o: i32 = 0; o < octaves; o = o + 1) {
        n = n + amp * cc_manholesteam_vnoise3(x);
        norm = norm + amp;
        // Exactly 2 in z, so each octave's lattice is periodic with the
        // first's (CLOCK_PERIOD_S); 2.03 across, off the lattice's grain.
        x = vec3<f32>(2.03, 2.03, 2.0) * x + vec3<f32>(19.1, 7.3, 3.7);
        amp = 0.5 * amp;
    }
    n = n / norm - 0.5;
    // The noise moves the boundary (a billow pushes it out, a gap pulls
    // it in) about EDGE radii, and pulls it in to nothing over the top half
    // of the rise, so the top is billowed too; inside, it modulates the
    // density. The steam thins as the plume widens.
    let boundary = (cc_manholesteam_EDGE + cc_manholesteam_BILLOW * n)
                 * (1.0 - smoothstep(0.6, 1.0, rise));
    // The thinning is referred to a cover's source radius for every
    // plume: a stack carries the same leak through a narrower mouth, so it
    // leaves denser — the opaque burst at the top of every stack — and
    // thins to the same plume aloft.
    let cover = smoothstep(0.0, cc_manholesteam_SOFT, boundary - d);
    return s.vigor * cond * cover * max(1.0 + cc_manholesteam_LUMP * n, 0.0)
           // @domain: r >= r0 > 0: the plume's radius only grows from its source
           * pow(cc_manholesteam_R0_COVER / r, cc_manholesteam_THIN);
}

// ---------------------------------------------------------------------------
// The light on it
// ---------------------------------------------------------------------------

// What stands either side of a site's street: the across coordinate of each
// building's storefront face and that storefront's glow. Found once per
// entered plume, not per step.
struct cc_manholesteam_Street {
    along_y: bool,
    face_lo: f32, face_hi: f32,
    glow_lo: vec3<f32>, glow_hi: vec3<f32>,
    fill: vec3<f32>,
}

fn cc_manholesteam_street(s: cc_manholesteam_Site, k: i32, along_y: bool)
        -> cc_manholesteam_Street {
    let cellm = u.ocean_params.x;
    var st: cc_manholesteam_Street;
    st.along_y = along_y;
    let a = i32(floor(select(s.c.x, s.c.y, along_y) / cellm));
    let ci_lo = select(vec2<i32>(a, k - 1), vec2<i32>(k - 1, a), along_y);
    let ci_hi = select(vec2<i32>(a, k), vec2<i32>(k, a), along_y);
    let c_lo = city_cell(ci_lo);
    let c_hi = city_cell(ci_hi);
    st.face_lo = select(c_lo.b1max.y, c_lo.b1max.x, along_y);
    st.face_hi = select(c_hi.b1min.y, c_hi.b1min.x, along_y);
    st.glow_lo = city_storefront_glow(c_lo);
    st.glow_hi = city_storefront_glow(c_hi);
    // The two hemispheres: the lit street below (its measured area mean,
    // CITY_GROUND_FAR_STREET, at this district's lamp scale) and the night
    // sky above. Each fills half the sphere an isotropic parcel sees. The
    // street half is what lights a plume from underneath, and what keeps
    // it from reading darker than the road it veils when seen from above.
    let ls = city_lamp_scale(s.c);
    let street = CITY_LAMP_COLOR * (CITY_GROUND_FAR_STREET.x * ls
                                    / (1.0 + CITY_GROUND_FAR_STREET.y * ls));
    let sky = CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(s.c, 3.0));
    st.fill = 0.5 * (street + sky);
    return st;
}

// In-scattered radiance per unit scattering, at p, toward the eye along
// -dir. A storefront band is an emitting strip of height CITY_STORE_H and
// (for these purposes) infinite length at distance d: it subtends 2 theta
// steradians, theta its vertical angle, so an isotropic medium sees
// glow x theta / (2 pi) of it.
fn cc_manholesteam_light(p: vec3<f32>, dir: vec3<f32>,
                         st: cc_manholesteam_Street) -> vec3<f32> {
    var l = cc_manholesteam_LAMP_REL
          * city_street_light_g(p, dir, cc_manholesteam_G) + st.fill;
    let x = select(p.y, p.x, st.along_y);
    for (var side: i32 = 0; side < 2; side = side + 1) {
        let face = select(st.face_lo, st.face_hi, side == 1);
        let glow = select(st.glow_lo, st.glow_hi, side == 1);
        let d = max(abs(face - x), 0.3);
        let theta = atan((CITY_STORE_H - p.z) / d) + atan(p.z / d);
        // Toward the band across the same clamped distance theta uses, so
        // a sample on the facade plane at mid-band height has a direction.
        let dx = select(-d, d, face >= x);
        let toward = select(vec2<f32>(0.0, dx), vec2<f32>(dx, 0.0),
                            st.along_y);
        // @domain: |toward| = d >= 0.3
        let v = normalize(vec3<f32>(toward, 0.5 * CITY_STORE_H - p.z));
        l = l + glow * (theta / 6.2831853)
              * (12.566371 * hg_phase(dot(v, dir), cc_manholesteam_STORE_G));
    }
    let peak = max(l.r, max(l.g, l.b));
    return l / (1.0 + peak / cc_manholesteam_SRC_CAP);
}

// ---------------------------------------------------------------------------
// The media hook
// ---------------------------------------------------------------------------

// March one plume over [ta, tb]: (in-scattered radiance, transmittance).
fn cc_manholesteam_march(o: vec3<f32>, dir: vec3<f32>, ta: f32, tb: f32,
                         s: cc_manholesteam_Site, st: cc_manholesteam_Street,
                         fade: f32, octaves: i32, rnd: f32) -> vec4<f32> {
    let n = clamp(i32(ceil((tb - ta) / cc_manholesteam_STEP)),
                  cc_manholesteam_STEPS_MIN, cc_manholesteam_STEPS_MAX);
    let dt = (tb - ta) / f32(n);
    var rad = vec3<f32>(0.0);
    var trans = 1.0;
    for (var i: i32 = 0; i < n; i = i + 1) {
        let p = o + (ta + (f32(i) + rnd) * dt) * dir;
        // The sample, then two shadow taps toward the light, SHADOW_TAP
        // local radii out, each standing for SHADOW_SEG radii of path. The
        // light comes from above below the lamp heads and from below above
        // them (the heads, then the lit street), so the taps go vertically
        // toward whichever it is, and shrink to nothing through the heads'
        // own height, where the light arrives sideways — continuous, so the
        // plume has no seam there. The lateral offset of the head is what
        // this ignores. Rolled, with one call site for the density.
        let r = s.r0 + cc_manholesteam_SPREAD * max(p.z - s.z0, 0.0);
        let up = clamp(0.5 * (CITY_LAMP_HEAD_Z - p.z), -1.0, 1.0);
        var rho = 0.0;
        var tau_l = 0.0;
        for (var tap: i32 = 0; tap < 3; tap = tap + 1) {
            let off = select(0.0, select(cc_manholesteam_SHADOW_TAP.x,
                                         cc_manholesteam_SHADOW_TAP.y,
                                         tap == 2), tap > 0);
            let d = fade * cc_manholesteam_density(
                p + vec3<f32>(0.0, 0.0, up * off * r), s,
                select(octaves, 2, tap > 0));
            if (tap == 0) {
                rho = d;
                if (rho <= 1e-4) {
                    break;
                }
            } else {
                tau_l = tau_l + cc_manholesteam_SIGMA * d
                              * cc_manholesteam_SHADOW_SEG * r;
            }
        }
        if (rho <= 1e-4) {
            continue;
        }
        // Albedo 1: what the step removes from the beam it scatters in.
        // Multiple scattering keeps a floor under the shadowed light.
        let a = 1.0 - exp(-cc_manholesteam_SIGMA * rho * dt);
        let shadow = mix(exp(-tau_l), 1.0, cc_manholesteam_MS_FLOOR);
        rad = rad + trans * a * shadow * cc_manholesteam_light(p, dir, st);
        trans = trans * (1.0 - a);
        // Opaque enough that nothing behind can show: stop marching.
        if (trans < 0.01) {
            break;
        }
    }
    return vec4<f32>(rad, trans);
}

fn cc_manholesteam_media(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                         t_max: f32, pixel_angle: f32, rnd: f32)
        -> vec4<f32> {
    var acc = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    // 1. The segment that can meet a plume at all: under ZTOP, within the
    //    range, short of the footprint where every plume has faded out.
    var t_lo = 0.0;
    var t_hi = min(min(t_max, cc_manholesteam_RANGE),
                   cc_manholesteam_FP_END / pixel_angle);
    if (abs(dir.z) > 1e-6) {
        let tz = (cc_manholesteam_ZTOP - o.z) / dir.z;
        if (dir.z > 0.0) {
            t_hi = min(t_hi, tz);
        } else {
            t_lo = max(t_lo, tz);
        }
    } else if (o.z > cc_manholesteam_ZTOP) {
        return acc;
    }
    if (t_lo >= t_hi) {
        return acc;
    }
    let cellm = u.ocean_params.x;
    // Plumes are composited as found. Within one street they are found in
    // ray order; between streets, a plume wholly in front of everything so
    // far goes in front, and anything else behind — exact unless two
    // plumes overlap in depth, and then only the order of their colours is
    // approximate, never their transmittance.
    var t_front = 1e30;
    var t_back = 0.0;
    for (var axis: i32 = 0; axis < 2; axis = axis + 1) {
        let along_y = axis == 0;   // the streets x = k cellm, sites along y
        let oc = select(o.y, o.x, along_y);
        let dc = select(dir.y, dir.x, along_y);
        let oa = select(o.x, o.y, along_y);
        let da = select(dir.x, dir.y, along_y);
        // 2. Centrelines whose band the segment enters, in ray order.
        let band_max = cc_manholesteam_LAT_AVE + cc_manholesteam_REACH;
        let c0 = oc + t_lo * dc;
        let c1 = oc + t_hi * dc;
        let k_lo = i32(ceil((min(c0, c1) - band_max) / cellm));
        let k_hi = i32(floor((max(c0, c1) + band_max) / cellm));
        let k_step = select(-1, 1, dc >= 0.0);
        let k_first = select(k_hi, k_lo, dc >= 0.0);
        for (var ik: i32 = 0; ik <= k_hi - k_lo; ik = ik + 1) {
            let k = k_first + k_step * ik;
            let line = f32(k) * cellm;
            let band = cc_manholesteam_REACH + select(
                cc_manholesteam_LAT_MINOR, cc_manholesteam_LAT_AVE,
                city_is_avenue(k));
            var ta = t_lo;
            var tb = t_hi;
            if (abs(dc) > 1e-6) {
                let e0 = (line - band - oc) / dc;
                let e1 = (line + band - oc) / dc;
                ta = max(ta, min(e0, e1));
                tb = min(tb, max(e0, e1));
            } else if (abs(oc - line) > band) {
                continue;
            }
            if (ta >= tb) {
                continue;
            }
            // The lattice sites whose along extent overlaps the segment's
            // along range inside the band, in ray order.
            let a0 = oa + ta * da;
            let a1 = oa + tb * da;
            let slack = cc_manholesteam_REACH + cc_manholesteam_ALONG_JIT;
            let j_lo = i32(ceil((min(a0, a1) - slack) / CITY_MH_PITCH - 0.5));
            let j_hi = i32(floor((max(a0, a1) + slack) / CITY_MH_PITCH - 0.5));
            let j_step = select(-1, 1, da >= 0.0);
            let j_first = select(j_hi, j_lo, da >= 0.0);
            for (var ij: i32 = 0; ij <= j_hi - j_lo; ij = ij + 1) {
                let s = cc_manholesteam_site(k, j_first + j_step * ij,
                                             along_y);
                if (!s.on) {
                    continue;
                }
                // 4. The box, then the march.
                let bt = city_box_hit(o, inv_dir, cc_manholesteam_box_min(s),
                                      cc_manholesteam_box_max(s));
                let pa = max(bt.x, 0.0);
                let pb = min(bt.y, t_max);
                if (pa >= pb) {
                    continue;
                }
                let fp = pixel_angle * pa;
                let fade = (1.0 - smoothstep(cc_manholesteam_RANGE_FADE,
                                             cc_manholesteam_RANGE, pa))
                         * (1.0 - smoothstep(cc_manholesteam_FP_START,
                                             cc_manholesteam_FP_END, fp));
                if (fade <= 0.0) {
                    continue;
                }
                let octaves = 2 + select(0, 1, fp < cc_manholesteam_OCT3_FP)
                              + select(0, 1, fp < cc_manholesteam_OCT4_FP);
                let m = cc_manholesteam_march(
                    o, dir, pa, pb, s, cc_manholesteam_street(s, k, along_y),
                    fade, octaves, rnd);
                if (pb <= t_front && t_back > 0.0) {
                    acc = vec4<f32>(m.rgb + m.a * acc.rgb, acc.a * m.a);
                } else {
                    acc = vec4<f32>(acc.rgb + acc.a * m.rgb, acc.a * m.a);
                }
                t_front = min(t_front, pa);
                t_back = max(t_back, pb);
            }
        }
    }
    return acc;
}

// ---------------------------------------------------------------------------
// The stacks: geometry and shading
// ---------------------------------------------------------------------------

fn cc_manholesteam_miss(ci: vec2<i32>) -> CityHit {
    return CityHit(false, 1e30, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0),
                   0, ci);
}

// The stacks standing in cell ci. A stack's site is on one of the cell's
// four boundary centrelines, offset into the cell by its lateral (always
// more than a stack radius, so no stack straddles two cells); each edge is
// a strip box, and only a ray that enters a strip looks up the few sites
// along the part of it the ray crosses.
fn cc_manholesteam_props_trace(o: vec3<f32>, dir: vec3<f32>,
                               inv_dir: vec3<f32>, t0: f32, t1: f32,
                               ci: vec2<i32>, cc: CityCell) -> CityHit {
    var res = cc_manholesteam_miss(ci);
    // Gate 1: the segment reaches down to the stacks' height.
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    if (min(za, zb) > cc_manholesteam_STACK_H || max(za, zb) < 0.0) {
        return res;
    }
    // Gate 2: past FP_END the plume above a stack has faded out, and the
    // stack is under half a pixel wide.
    let fp = lod_pixel_angle() * max(t0, 0.0);
    if (fp > cc_manholesteam_FP_END) {
        return res;
    }
    let cellm = u.ocean_params.x;
    let lo = vec2<f32>(ci) * cellm;
    let hi = lo + vec2<f32>(cellm);
    var t_end = t1;
    for (var e: i32 = 0; e < 4; e = e + 1) {
        let along_y = e < 2;
        let k = select(ci.y, ci.x, along_y) + (e & 1);
        let line = f32(k) * cellm;
        let lat = select(cc_manholesteam_LAT_MINOR, cc_manholesteam_LAT_AVE,
                         city_is_avenue(k)) + cc_manholesteam_STACK_R;
        // The strip: the edge's centreline +- lat, clipped to the cell.
        let c_lo = max(line - lat, select(lo.y, lo.x, along_y));
        let c_hi = min(line + lat, select(hi.y, hi.x, along_y));
        let a_lo = select(lo.x, lo.y, along_y);
        let a_hi = select(hi.x, hi.y, along_y);
        let bmin = select(vec3<f32>(a_lo, c_lo, 0.0), vec3<f32>(c_lo, a_lo, 0.0),
                          along_y);
        let bmax = select(vec3<f32>(a_hi, c_hi, cc_manholesteam_STACK_H),
                          vec3<f32>(c_hi, a_hi, cc_manholesteam_STACK_H),
                          along_y);
        let bt = city_box_hit(o, inv_dir, bmin, bmax);
        let ta = max(bt.x, t0);
        let tb = min(bt.y, t_end);
        if (ta >= tb) {
            continue;
        }
        let oa = select(o.x, o.y, along_y);
        let da = select(dir.x, dir.y, along_y);
        let s0 = oa + ta * da;
        let s1 = oa + tb * da;
        let slack = cc_manholesteam_ALONG_JIT + cc_manholesteam_STACK_R;
        let j_lo = i32(ceil((min(s0, s1) - slack) / CITY_MH_PITCH - 0.5));
        let j_hi = i32(floor((max(s0, s1) + slack) / CITY_MH_PITCH - 0.5));
        for (var j: i32 = j_lo; j <= j_hi; j = j + 1) {
            let s = cc_manholesteam_site(k, j, along_y);
            if (!s.stack || any(s.c < lo) || any(s.c >= hi)) {
                continue;
            }
            // A vertical open tube: the outside wall, or — for a ray that
            // comes in over the rim — the inside wall or the floor.
            let oc = o.xy - s.c;
            let qa = max(dot(dir.xy, dir.xy), 1e-12);
            let qb = dot(oc, dir.xy);
            let qc = dot(oc, oc)
                   - cc_manholesteam_STACK_R * cc_manholesteam_STACK_R;
            let disc = qb * qb - qa * qc;
            if (disc <= 0.0) {
                continue;
            }
            // @domain: the discriminant is tested positive (or non-negative) just above
            let sq = sqrt(disc);
            let tn = (-qb - sq) / qa;
            let tf = (-qb + sq) / qa;
            let zn = o.z + tn * dir.z;
            var th = -1.0;
            var inner = false;
            if (zn >= 0.0 && zn <= cc_manholesteam_STACK_H) {
                th = tn;
            } else if (zn > cc_manholesteam_STACK_H) {
                // In over the rim — but only if the far wall is met below
                // it: a ray that crosses the whole circle above 3 m passes
                // clean over the mouth.
                let zf = o.z + tf * dir.z;
                if (zf > cc_manholesteam_STACK_H) {
                    continue;
                }
                inner = true;
                th = select(tf, -o.z / dir.z, zf < 0.0);
            }
            if (th < t0 || th >= t_end) {
                continue;
            }
            let p = o + th * dir;
            var nrm = vec3<f32>((p.xy - s.c) / cc_manholesteam_STACK_R, 0.0);
            if (inner) {
                nrm = select(-nrm, vec3<f32>(0.0, 0.0, 1.0), p.z < 1e-3);
            }
            res = CityHit(true, th, p, nrm, select(900, 901, inner), ci);
            t_end = th;
        }
    }
    return res;
}

fn cc_manholesteam_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let p = h.pos;
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(p.xy, 3.0));
    if (h.kind == 901) {
        return cc_manholesteam_INNER
               * (city_street_light(p, vec3<f32>(0.0, 0.0, 1.0)) + fill);
    }
    // The bands, box-filtered in height (they dissolve to their duty
    // cycle once they are finer than a pixel).
    let orange = city_stripes(p.z, 0.0, cc_manholesteam_ORANGE_W,
                              cc_manholesteam_BAND_P, fp);
    let alb = mix(cc_manholesteam_WHITE, cc_manholesteam_ORANGE, orange);
    let diffuse = alb * (city_street_light(p, h.normal) / CITY_ASPHALT_ALBEDO
                         + fill);
    // Wet: the lamps' mirror lobe about the reflected view ray.
    let r = reflect(dir, h.normal);
    let sheen = cc_manholesteam_SHEEN
              * city_street_light_g(p, r, cc_manholesteam_SHEEN_G);
    return diffuse + sheen;
}

// --- component: industry (industry.wgsl) ---
// industry — the industrial belt: warehouse roofs, the floodlights, and what
// stands in their light.
//
// Where the cascade thins, the city stops being towers (Thomas: the regions
// with no buildings "would be sort of industrial regions with things like
// forklifts/large warehouses/empty lots with construction refuse"). The core
// already lays that belt out: INDUSTRIAL lots carry one low warehouse box
// pushed against one long side of the plot, the other side being its truck
// court; YARD lots front a street and carry no building; OPEN land is scrub.
// It also already decides where the belt's few lamps are (city_flood) and
// paints their pools on the ground. This component owns everything above
// that ground except the warehouse WALLS (city-facades: cladding, doors,
// docks) and the streets (city-street):
//
//   1. ROOFS. Every warehouse draws one of three: SAWTOOTH (40%) — teeth 8-12
//      m apart and 2.5-3.5 m tall, each a sloped sheet with a vertical glazed
//      face, all facing one way; MONITOR (30%) — a raised clerestory strip
//      down the long axis, glazed along both sides; FLAT (30%) — the core's
//      own roof, carrying rows of translucent skylights. About a third of the
//      buildings are working a night shift, and on those the glazing glows
//      from the high-bays inside: the belt's signature from the air, stripes
//      of cool or amber light ruled across dark roofs.
//   2. FLOOD FIXTURES. The lamp at every city_flood head — a wall-pack on a
//      bracket over the court, or a head on a 10 m pole at a yard corner —
//      with a lens bright enough (~30) to read as the source of its pool,
//      and, through the facade hook, the scallop of light each wall-pack
//      throws down the court wall below it.
//   3. PROPS on courts and yards: semi-trailers backed onto the docks,
//      stacked shipping containers, pallet stacks, rebar bundles, a skip
//      with refuse in it, a forklift, debris mounds, and a chain-link fence
//      (posts and rails) around most yards.
//
// ONE PRIMITIVE CARRIES THE PROPS: a GRID of slots. A container block, a row
// of trailers at a dock, a pallet stack field, a line of rebar bundles, a
// row of skylights, and a single skip or forklift (a 1x1 grid) are all the
// same thing — one bounding box, a 2D DDA over the slots the ray crosses,
// and a per-slot hash that says whether the slot is filled and how high.
// One routine, one call site, so the per-object detail (a trailer's
// undercarriage, a forklift's mast and guard, a skip's cavity) is inlined
// exactly once however many grids a lot has.
//
// LOTS SPAN CELLS. A warehouse lot is 2x1 or 2x2 blocks and a yard may be
// several, but cell_props is called per DDA cell. Everything here is laid
// out per LOT — a pure function of the CityCell every member cell decodes
// identically — and every member cell traces all of it, accepting only hits
// inside its own ray segment [t0, t1]. The segment IS the cell's column, so
// a container straddling two cells is found by whichever cell the ray is
// in when it meets the steel, and nothing need be placed inside a cell.
//
// LIGHT. The belt is dark on purpose, a foil for the neon core. Props are
// lit by the lot's floods — the pool's own Gaussian at the prop, times the
// surface's facing toward the fixture over the ground's — by the street
// lamps where a yard fronts one, and by the core's skyglow fill and moon.
// A yard with no lit fixture stays nearly black. No shadows: the pools are
// Gaussians painted on the ground, and a shadow they do not have would be
// a lie in the other direction.
//
// DETAIL CALIBRATION (SPEC): wiper blades, not tire brands. A container has
// its corrugation, corner posts, rails and door-end locking bars; a trailer
// its bogie, landing legs and rub rail; a forklift its mast, forks and
// overhead guard. Nothing has a logo.
//
// LOD keys on the pixel footprint fp (m/px), never on distance: shading
// bands dissolve into their means as they go sub-pixel; the fence, pallets,
// rebar and forklift stop being traced past FINE_FP (dark, sub-pixel, and
// the ground under them is the same near-black); containers, trailers and
// the roofs are traced to CITY_PROP_RANGE; and the roof hook carries the
// glazing's exact, view-dependent mean beyond that, so no roof ever goes
// out. See cc_industry_roof for that derivation.

// --- kinds (kind_base 700, local 0..15) -------------------------------------
const cc_industry_K_ROOF: i32 = 700;     // sheet roofing, gable ends
const cc_industry_K_GLAZE: i32 = 701;    // sawtooth and clerestory glazing
const cc_industry_K_SKY: i32 = 702;      // flat-roof skylights
const cc_industry_K_HEAD: i32 = 703;     // flood lamp head
const cc_industry_K_STEEL: i32 = 704;    // pole, wall bracket
const cc_industry_K_BOX: i32 = 705;      // shipping container
const cc_industry_K_TRAILER: i32 = 706;
const cc_industry_K_PALLET: i32 = 707;
const cc_industry_K_REBAR: i32 = 708;
const cc_industry_K_SKIP: i32 = 709;
const cc_industry_K_REFUSE: i32 = 710;   // the fill inside a skip
const cc_industry_K_PILE: i32 = 711;     // debris mound
const cc_industry_K_FORK: i32 = 712;     // forklift
const cc_industry_K_FENCE: i32 = 713;
const cc_industry_K_DOCK: i32 = 714;     // dock shelter, bumpers, leveller

// --- roofs ------------------------------------------------------------------
const cc_industry_SAW_FRAC: f32 = 0.40;
const cc_industry_MONITOR_FRAC: f32 = 0.30;   // after the sawtooth draw
const cc_industry_ROOF_TOP: f32 = 3.6;        // tallest roof feature above h
// A working night shift: the glazing is lit from the high-bays inside. Dim
// against a lit window (3.5) — this is light seen through a dirty wired
// pane from across a factory floor — but a whole roof of it.
const cc_industry_NIGHT_SHIFT: f32 = 0.38;
const cc_industry_GLAZE_RAD: f32 = 0.08;
// The high-bays behind the glass: a luminaire every LAMP_P along the ridge,
// each a soft hot spot on the pane over a floor glow. Uniform glass at this
// level read as grey sheet material, not as light.
const cc_industry_LAMP_P: f32 = 6.0;
const cc_industry_LAMP_SIG: f32 = 1.1;
const cc_industry_LAMP_FLOOR: f32 = 0.15;
// Its mean along the ridge, the Gaussian cut at +-P/2 by the next lamp's
// cell: FLOOR + (1 - FLOOR) sqrt(2 pi) SIG / P erf(P / (2 sqrt(2) SIG)).
const cc_industry_LAMP_MEAN: f32 = 0.5381;
const cc_industry_BAY: f32 = 12.0;            // lighting zone along a ridge
const cc_industry_BAY_LIT: f32 = 0.65;
const cc_industry_MULL: f32 = 1.8;            // mullion pitch (m)
const cc_industry_MULL_W: f32 = 0.14;
const cc_industry_TRANSOM_W: f32 = 0.10;      // the bar across mid-pane
const cc_industry_SILL: f32 = 0.35;           // flashing at a pane's foot
const cc_industry_HEAD_BAND: f32 = 0.22;      // and its head
// Glazing's mean emission over a face, as a fraction of GLAZE_RAD: lit bays
// x mean bay level x the glass fraction of the framed face. Kept as one
// function (cc_industry_glaze_mean) because the shader's far field and the
// roof hook must agree on it exactly.
const cc_industry_BAY_MEAN: f32 = 0.9;        // E[0.4 + u] for u ~ U(0,1)
// Tone-map compensation on the far-field mean, the correction the core
// applies to its own window octaves: a mean taken in linear radiance ahead
// of the Reinhard curve renders brighter than the pattern it replaces.
const cc_industry_GLAZE_MEAN_COMP: f32 = 0.55;
const cc_industry_GLAZE_LOD_START: f32 = 1.5;
const cc_industry_GLAZE_LOD_FULL: f32 = 5.0;
// Sheet roofing: standing seams every 0.6 m, sub-pixel past a few cm/px.
const cc_industry_SEAM: f32 = 0.6;
const cc_industry_ROOF_ALB: f32 = 0.10;
const cc_industry_CLAD_ALB: f32 = 0.045;
// Skylights: translucent panels in rows down a flat roof, glowing when the
// shift is on. Past SKY_FP a row of them is sub-pixel relief, and the grid
// is traced as one flat panel carrying their mean.
const cc_industry_SKY_W: f32 = 1.4;
const cc_industry_SKY_L: f32 = 3.0;
const cc_industry_SKY_PITCH: f32 = 6.0;
const cc_industry_SKY_ROW: f32 = 10.0;
const cc_industry_SKY_H: f32 = 0.32;
const cc_industry_SKY_RAD: f32 = 0.35;
const cc_industry_SKY_FP: f32 = 0.45;

// --- flood fixtures ---------------------------------------------------------
// The lens radiance: a sodium or LED flood seen in its beam is a point of
// glare like a beacon (40), not a glowing panel.
const cc_industry_LENS_RAD: f32 = 30.0;
const cc_industry_HEAD_HW_WALL: vec3<f32> = vec3<f32>(0.22, 0.32, 0.14);
const cc_industry_HEAD_HW_POLE: vec3<f32> = vec3<f32>(0.26, 0.40, 0.16);
const cc_industry_POLE_HW: f32 = 0.11;
const cc_industry_POLE_REACH: f32 = 0.35;     // head overhang past the pole
// Energy-preserving widening: past a few metres per pixel a 0.6 m head is a
// fraction of a pixel, so its box grows to a pixel and its emission drops by
// the same area ratio — a far lamp is a steady dim point, never a strobe.
const cc_industry_HEAD_WIDEN: f32 = 0.45;
const cc_industry_HEAD_WIDEN_MAX: f32 = 1.0;
// Wall wash: the scallop a wall-pack throws down the wall under it. Narrow
// at the fixture, widening with depth; rises over the first half metre (the
// housing shades the wall right behind it) and fades over WASH_FADE.
const cc_industry_WASH_GAIN: f32 = 0.6;
const cc_industry_WASH_W0: f32 = 0.7;
const cc_industry_WASH_W1: f32 = 0.45;
const cc_industry_WASH_RISE: f32 = 0.5;
const cc_industry_WASH_FADE: f32 = 5.0;

// --- props ------------------------------------------------------------------
const cc_industry_PROP_TOP: f32 = 7.9;        // three containers high
// A yard's tallest thing: a pole-top flood at its widest.
const cc_industry_YARD_TOP: f32 = CITY_FLOOD_POLE_H + cc_industry_HEAD_WIDEN_MAX
                                  + 0.1;
const cc_industry_EDGE: f32 = 1.5;            // props stay this far inside
const cc_industry_TIER: f32 = 2.59;           // ISO container height
const cc_industry_BOX_L: f32 = 12.19;         // 40 ft
const cc_industry_BOX_W: f32 = 2.44;
const cc_industry_TRL_L: f32 = 13.6;
const cc_industry_TRL_W: f32 = 2.5;
const cc_industry_TRL_H: f32 = 4.0;
const cc_industry_TRL_DECK: f32 = 1.22;       // underside of the box body
const cc_industry_DOCK_PITCH: f32 = 4.2;      // dock door centres (m)
const cc_industry_DOCK_GAP: f32 = 0.25;       // trailer rear off the wall
// The dock doors: sectional doors DOOR_W x DOOR_H standing on the dock
// floor (DOCK_H above the court), one per dock slot; a black shelter frame
// around each on some buildings, bumpers and a leveller lip on all. Relief
// stays inside SHELL_OUT of the wall. (Not mirrored by the flight collider,
// which meets a warehouse at its wall: web/soar/cityprops.js.)
const cc_industry_DOCK_H: f32 = 1.2;
const cc_industry_DOOR_W: f32 = 3.0;
const cc_industry_DOOR_H: f32 = 3.0;
const cc_industry_SHELL_OUT: f32 = 0.60;
const cc_industry_PALLET_H: f32 = 0.144;
const cc_industry_SKIP_L: f32 = 5.8;
const cc_industry_SKIP_W: f32 = 2.3;
const cc_industry_SKIP_H: f32 = 1.7;
const cc_industry_SKIP_WALL: f32 = 0.10;
const cc_industry_FORK_H: f32 = 2.3;
const cc_industry_REBAR_H: f32 = 0.42;
const cc_industry_FENCE_H: f32 = 2.4;
const cc_industry_FENCE_IN: f32 = 0.8;        // fence line inside the plot
const cc_industry_FENCE_POST: f32 = 3.0;
const cc_industry_FENCE_FRAC: f32 = 0.75;
const cc_industry_GATE_W: f32 = 9.0;
// Past this footprint the small, dark props (fence, pallets, rebar, the
// forklift) are under a pixel and near-black on near-black ground; they stop
// being traced. Containers, trailers and the skip keep going: they are big,
// and they catch the floods.
const cc_industry_FINE_FP: f32 = 0.60;
// Detail inside a trailer's or a forklift's envelope, below this footprint.
const cc_industry_PART_FP: f32 = 0.25;
// A surface's response to the flood pools is measured against the ground
// the pools are painted on: a prop of this albedo facing the lamp the way
// the ground does returns the pool's own radiance.
const cc_industry_ALB_REF: f32 = 0.35;
// Where lamp light reflected off a prop starts to roll off: exposure 6 puts
// 0.3 at 1.8, below the Reinhard curve's shoulder.
const cc_industry_LAMP_KNEE: f32 = 0.3;
// Weathering's means over a face (tools: a brute-force average of the
// patterns in cc_industry_weather and the container roof, 4e5 samples).
const cc_industry_WEATHER_MEAN: vec3<f32> = vec3<f32>(0.962, 0.960, 0.959);
const cc_industry_ROOF_MEAN: vec3<f32> = vec3<f32>(0.769, 0.745, 0.728);

// --- the lot's frame ----------------------------------------------------------
// Everything is laid out along the lot's long axis `a` and across it `c`, and
// swizzled to world xy at the end, so one layout serves both orientations.
struct cc_industry_Lot {
    long_x: bool,
    pa: vec2<f32>,    // plot extent along the long axis
    pc: vec2<f32>,    // ... across it
    ba: vec2<f32>,    // warehouse extent along (industrial lots)
    bc: vec2<f32>,    // ... across
    court_hi: bool,   // the truck court is on the +c side of the building
}

fn cc_industry_lot(cc: CityCell) -> cc_industry_Lot {
    var l: cc_industry_Lot;
    let bs = cc.b1max.xy - cc.b1min.xy;
    let ps = cc.plot_max - cc.plot_min;
    // The warehouse's own long axis, by city_flood's rule, so the court the
    // props fill is the court the lamps light.
    l.long_x = select(ps.x >= ps.y, bs.x >= bs.y,
                      cc.land_use == CITY_USE_INDUSTRIAL);
    l.pa = select(vec2<f32>(cc.plot_min.y, cc.plot_max.y),
                  vec2<f32>(cc.plot_min.x, cc.plot_max.x), l.long_x);
    l.pc = select(vec2<f32>(cc.plot_min.x, cc.plot_max.x),
                  vec2<f32>(cc.plot_min.y, cc.plot_max.y), l.long_x);
    l.ba = select(vec2<f32>(cc.b1min.y, cc.b1max.y),
                  vec2<f32>(cc.b1min.x, cc.b1max.x), l.long_x);
    l.bc = select(vec2<f32>(cc.b1min.x, cc.b1max.x),
                  vec2<f32>(cc.b1min.y, cc.b1max.y), l.long_x);
    l.court_hi = (l.pc.y - l.bc.y) >= (l.bc.x - l.pc.x);
    return l;
}

// (a, c) -> world xy. A swizzle, so it preserves min/max order.
fn cc_industry_xy(l: cc_industry_Lot, ac: vec2<f32>) -> vec2<f32> {
    return select(ac.yx, ac, l.long_x);
}

// The dock doors along a warehouse's court wall: (centre of door 0 along
// the lot's long axis, count). Trailers, the forklift, the dock hardware and
// the doors painted on the wall all take their slots from here.
fn cc_industry_docks(l: cc_industry_Lot) -> vec2<f32> {
    let len = l.ba.y - l.ba.x - 8.0;
    let n = floor(len / cc_industry_DOCK_PITCH);
    return vec2<f32>(l.ba.x + 4.0 + 0.5 * (len - n * cc_industry_DOCK_PITCH)
                     + 0.5 * cc_industry_DOCK_PITCH, n);
}

// The truck court's depth, dock wall to the plot edge less the prop margin,
// and whether trailers fit in it.
fn cc_industry_court_depth(l: cc_industry_Lot) -> f32 {
    return select(l.bc.x - l.pc.x, l.pc.y - l.bc.y, l.court_hi)
           - cc_industry_EDGE;
}

fn cc_industry_has_trailers(l: cc_industry_Lot) -> bool {
    return cc_industry_court_depth(l)
           >= cc_industry_TRL_L + 2.0 * cc_industry_DOCK_GAP + 2.0;
}

// A lot-level draw: the same in every member cell, salted per use.
fn cc_industry_draw(cc: CityCell, salt: u32, i: i32, j: i32) -> vec4<f32> {
    return city_rand4(vec2<u32>(
        cc.seed.x ^ (salt * 0x9e3779b9u) ^ (bitcast<u32>(i) * 0x85ebca6bu),
        cc.seed.y ^ (salt * 0x51ed270bu) ^ (bitcast<u32>(j) * 0xc2b2ae35u)));
}

fn cc_industry_miss(ci: vec2<i32>) -> CityHit {
    return CityHit(false, 1e30, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0),
                   0, ci);
}

// Nearest-hit accumulator over one box, with the segment discipline: a hit
// outside [t0, t1] belongs to another cell's visit.
fn cc_industry_box(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                   inv_dir: vec3<f32>, t0: f32, t1: f32,
                   bmin: vec3<f32>, bmax: vec3<f32>, kind: i32,
                   ci: vec2<i32>) -> CityHit {
    let s = city_box_hit(o, inv_dir, bmin, bmax);
    if (s.x <= s.y && s.x > max(t0, 1e-3) && s.x <= t1 && s.x < best.t) {
        let p = o + s.x * dir;
        return CityHit(true, s.x, p, city_box_normal(p, bmin, bmax), kind,
                       ci);
    }
    return best;
}

// The pixel's angular size: the footprint at distance t is px * t (m/px),
// the core's own pixel_angle.
fn cc_industry_px() -> f32 {
    return lod_pixel_angle();
}

// ============================================================================
// ROOFS
// ============================================================================

struct cc_industry_Roof {
    kind: i32,          // 0 flat (+ skylights), 1 sawtooth, 2 monitor
    step_x: bool,       // sawtooth: the teeth step along world x
    face: f32,          // +1: glazing faces +step axis; -1: faces -step
    s0: f32,            // step-axis coordinate where tooth 0 starts (face +1)
    pitch: f32,
    n: i32,             // teeth
    rise: f32,
    mlo: vec3<f32>,     // monitor strip box
    mhi: vec3<f32>,
    lit: bool,
    tint: vec3<f32>,    // the high-bays' colour
}

fn cc_industry_roof_of(cc: CityCell) -> cc_industry_Roof {
    var r: cc_industry_Roof;
    let d = cc_industry_draw(cc, 11u, 0, 0);
    let e = cc_industry_draw(cc, 12u, 0, 0);
    let l = cc_industry_lot(cc);
    r.kind = 0;
    if (d.x < cc_industry_SAW_FRAC) {
        r.kind = 1;
    } else if (d.x < cc_industry_SAW_FRAC + cc_industry_MONITOR_FRAC) {
        r.kind = 2;
    }
    // Most sawtooth sheds step along their long axis — the classic many-
    // toothed profile down a long factory — some across it.
    r.step_x = select(!l.long_x, l.long_x, d.y < 0.70);
    let a0 = select(cc.b1min.y, cc.b1min.x, r.step_x);
    let a1 = select(cc.b1max.y, cc.b1max.x, r.step_x);
    r.n = max(i32(round((a1 - a0) / (8.0 + 4.0 * d.z))), 1);
    r.pitch = (a1 - a0) / f32(r.n);
    r.rise = 2.5 + d.w;
    r.face = select(-1.0, 1.0, e.x < 0.5);
    r.s0 = select(a1, a0, r.face > 0.0);
    // The clerestory: a quarter to a third of the span, centred on the ridge.
    let w = (l.bc.y - l.bc.x) * (0.24 + 0.10 * e.y);
    let cm = 0.5 * (l.bc.x + l.bc.y);
    let lo = cc_industry_xy(l, vec2<f32>(l.ba.x + 3.0, cm - 0.5 * w));
    let hi = cc_industry_xy(l, vec2<f32>(l.ba.y - 3.0, cm + 0.5 * w));
    r.mlo = vec3<f32>(lo, cc.height);
    r.mhi = vec3<f32>(hi, cc.height + 2.6 + 0.9 * e.z);
    r.lit = e.w < cc_industry_NIGHT_SHIFT;
    let tc = fract(e.w * 17.3);
    r.tint = select(select(vec3<f32>(1.00, 0.52, 0.18),     // sodium high-bay
                           vec3<f32>(1.00, 0.84, 0.58), tc < 0.70),  // halide
                    vec3<f32>(0.72, 0.85, 1.00), tc < 0.30);          // LED
    return r;
}

// The skylight grid on a flat roof: rows down the long axis.
struct cc_industry_Grid {
    ok: bool,
    kind: i32,
    lo: vec3<f32>,      // min corner; z is the base the objects stand on
    cell: vec2<f32>,    // slot pitch in world x, y
    n: vec2<i32>,       // slots in x, y
    obj: vec2<f32>,     // object footprint in its slot (centred), world x, y
    zmax: f32,          // tallest object above lo.z
    occ: f32,           // fraction of slots filled
    tiers: i32,         // containers: most stacked; docks: 1 with shelters
    front: i32,         // object's forward axis: 0 +x, 1 -x, 2 +y, 3 -y
    salt: u32,
}

fn cc_industry_no_grid() -> cc_industry_Grid {
    var g: cc_industry_Grid;
    g.ok = false;
    g.kind = 0;
    g.lo = vec3<f32>(0.0);
    g.cell = vec2<f32>(1.0);
    g.n = vec2<i32>(0);
    g.obj = vec2<f32>(0.0);
    g.zmax = 0.0;
    g.occ = 0.0;
    g.tiers = 1;
    g.front = 0;
    g.salt = 0u;
    return g;
}

// A grid from lot-frame (a, c) quantities. `front_ac` names the object's
// forward axis in the lot frame (0 +a, 1 -a, 2 +c, 3 -c).
fn cc_industry_mk_grid(l: cc_industry_Lot, kind: i32, lo_ac: vec2<f32>,
                       cell_ac: vec2<f32>, n_ac: vec2<i32>, obj_ac: vec2<f32>,
                       z0: f32, zmax: f32, occ: f32, tiers: i32,
                       front_ac: i32, salt: u32) -> cc_industry_Grid {
    var g: cc_industry_Grid;
    g.ok = n_ac.x > 0 && n_ac.y > 0;
    g.kind = kind;
    g.lo = vec3<f32>(cc_industry_xy(l, lo_ac), z0);
    g.cell = cc_industry_xy(l, cell_ac);
    g.n = select(n_ac.yx, n_ac, l.long_x);
    g.obj = cc_industry_xy(l, obj_ac);
    g.zmax = zmax;
    g.occ = occ;
    g.tiers = tiers;
    // a -> x and c -> y when the lot runs along x; a -> y and c -> x if not.
    var f = front_ac;
    if (!l.long_x) {
        f = select(select(select(1, 0, front_ac == 2), 2, front_ac == 0),
                   3, front_ac == 1);
    }
    g.front = f;
    g.salt = salt;
    return g;
}

fn cc_industry_sky_grid(cc: CityCell) -> cc_industry_Grid {
    let l = cc_industry_lot(cc);
    let span_a = l.ba.y - l.ba.x - 8.0;
    let span_c = l.bc.y - l.bc.x - 8.0;
    let n_a = i32(floor(span_a / cc_industry_SKY_PITCH));
    let n_c = i32(floor(span_c / cc_industry_SKY_ROW));
    let lo = vec2<f32>(
        l.ba.x + 4.0 + 0.5 * (span_a - f32(n_a) * cc_industry_SKY_PITCH),
        l.bc.x + 4.0 + 0.5 * (span_c - f32(n_c) * cc_industry_SKY_ROW));
    return cc_industry_mk_grid(
        l, cc_industry_K_SKY, lo,
        vec2<f32>(cc_industry_SKY_PITCH, cc_industry_SKY_ROW),
        vec2<i32>(n_a, n_c),
        vec2<f32>(cc_industry_SKY_L, cc_industry_SKY_W),
        cc.height, cc_industry_SKY_H, 1.0, 1, 0, 13u);
}

// Sawtooth: a heightfield along the step axis s, z = h + rise * frac(s / p),
// with a vertical glazed face at every tooth boundary. Walked tooth by tooth
// like a 1D DDA: within a tooth the gap g(t) between the ray and the roof
// plane is linear in t, so the hit is where it changes sign; crossing a
// boundary against the glazing's facing with the ray below the tooth top is
// a hit on the glass. Exact, and a handful of teeth per cell at most.
fn cc_industry_saw_trace(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                         inv_dir: vec3<f32>, t0: f32, t1: f32, cc: CityCell,
                         r: cc_industry_Roof, ci: vec2<i32>) -> CityHit {
    let h = cc.height;
    let bmin = vec3<f32>(cc.b1min.xy, h);
    let bmax = vec3<f32>(cc.b1max.xy, h + r.rise);
    let sb = city_box_hit(o, inv_dir, bmin, bmax);
    let ta = max(max(sb.x, t0), 1e-3);
    let tb = min(min(sb.y, t1), best.t);
    if (sb.x > sb.y || ta >= tb) {
        return best;
    }
    // s increases along the glazing's facing, from 0 at tooth 0's low edge.
    let o_a = select(o.y, o.x, r.step_x);
    let d_a = select(dir.y, dir.x, r.step_x);
    let s_o = r.face * (o_a - r.s0);
    let d_s = r.face * d_a;
    let p = r.pitch;
    let slope = r.rise / p;
    var k = clamp(i32(floor((s_o + d_s * ta) / p)), 0, r.n - 1);
    var t = ta;
    // The walk's bound is a runtime count (a literal one gets unrolled into
    // the core's DDA loop, see streetlife's ITERS note).
    for (var i: i32 = 0; i <= r.n; i = i + 1) {
        var t_next = 1e30;
        if (d_s > 1e-7) {
            t_next = (f32(k + 1) * p - s_o) / d_s;
        } else if (d_s < -1e-7) {
            t_next = (f32(k) * p - s_o) / d_s;
        }
        let t_out = min(t_next, tb);
        let base = f32(k) * p;
        let g_in = (o.z + dir.z * t - h) - slope * (s_o + d_s * t - base);
        let g_out = (o.z + dir.z * t_out - h)
                    - slope * (s_o + d_s * t_out - base);
        if (g_in <= 0.0) {
            // Under the roof at a tooth's entry: the face just crossed.
            // Inside the walk that is always a glazed face (the ray came
            // down-slope, against the facing); at the walk's start it is the
            // box face the ray entered by, if it entered by one rather than
            // by the cell's column boundary.
            if (i > 0 || sb.x > max(t0, 1e-3)) {
                let q = o + t * dir;
                var n = city_box_normal(q, bmin, bmax);
                var kind = cc_industry_K_ROOF;
                if (i > 0 || abs(select(n.y, n.x, r.step_x)) > 0.5) {
                    n = select(vec3<f32>(0.0, r.face, 0.0),
                               vec3<f32>(r.face, 0.0, 0.0), r.step_x);
                    kind = cc_industry_K_GLAZE;
                }
                return CityHit(true, t, q, n, kind, ci);
            }
            return best;
        }
        if (g_out <= 0.0) {
            let th = t + (t_out - t) * g_in / (g_in - g_out);
            let ns = normalize(vec2<f32>(-slope * r.face, 1.0));
            let n = select(vec3<f32>(0.0, ns.x, ns.y),
                           vec3<f32>(ns.x, 0.0, ns.y), r.step_x);
            return CityHit(true, th, o + th * dir, n, cc_industry_K_ROOF, ci);
        }
        if (t_out >= tb) {
            break;
        }
        t = t_out;
        k = k + select(-1, 1, d_s > 0.0);
        if (k < 0 || k >= r.n) {
            break;
        }
    }
    return best;
}

// ============================================================================
// FLOOD FIXTURES
// ============================================================================

// The head box of fixture f: a wall-pack sits on f.head, 0.8 m off the wall;
// a pole head overhangs its pole toward the aim. Half extents are (along the
// aim, across it, vertical), widened toward a pixel as the footprint grows —
// the footprint AT THE HEAD, from the camera's distance to it, which is what
// both the trace and the shader compute, so the box a ray met and the
// dilution it is shaded with always agree. The widening stops at
// HEAD_WIDEN_MAX, which keeps every head inside its own lot and inside the
// trace's fixed z gates; past that (fp ~2.2 m/px) a lamp is a fixed-size
// spark, as a real one is.
fn cc_industry_head_c(cc: CityCell, f: CityFlood) -> vec3<f32> {
    if (cc.land_use == CITY_USE_YARD) {
        return f.head + vec3<f32>(f.aim * cc_industry_POLE_REACH, 0.0);
    }
    return f.head;
}

fn cc_industry_head_real(cc: CityCell) -> vec3<f32> {
    return select(cc_industry_HEAD_HW_WALL, cc_industry_HEAD_HW_POLE,
                  cc.land_use == CITY_USE_YARD);
}

fn cc_industry_head_hw(cc: CityCell, fp: f32) -> vec3<f32> {
    return max(cc_industry_head_real(cc),
               vec3<f32>(min(cc_industry_HEAD_WIDEN * fp,
                             cc_industry_HEAD_WIDEN_MAX)));
}

// World half extents of a head whose aim is `aim` (along x or y).
fn cc_industry_head_box_hw(hw: vec3<f32>, aim: vec2<f32>) -> vec3<f32> {
    let ax = abs(aim.x) >= abs(aim.y);
    return vec3<f32>(select(hw.y, hw.x, ax), select(hw.x, hw.y, ax), hw.z);
}

fn cc_industry_fixtures(best_in: CityHit, o: vec3<f32>, dir: vec3<f32>,
                        inv_dir: vec3<f32>, t0: f32, t1: f32, cc: CityCell,
                        ci: vec2<i32>, px: f32) -> CityHit {
    var best = best_in;
    let yard = cc.land_use == CITY_USE_YARD;
    // A runtime count (always CITY_FLOOD_MAX here: open land never gets this
    // far) keeps the loop rolled.
    let nk = select(CITY_FLOOD_MAX, 0, cc.land_use == CITY_USE_OPEN);
    for (var k: i32 = 0; k < nk; k = k + 1) {
        let f = city_flood(cc, k);
        if (!f.on) {
            continue;
        }
        let c = cc_industry_head_c(cc, f);
        let fp = px * distance(o, c);
        let bh = cc_industry_head_box_hw(cc_industry_head_hw(cc, fp), f.aim);
        best = cc_industry_box(best, o, dir, inv_dir, t0, t1, c - bh, c + bh,
                               cc_industry_K_HEAD, ci);
        // The hardware: dark, 0.2 m, gone under a pixel past FINE_FP.
        if (fp < cc_industry_FINE_FP * 2.0) {
            var lo = vec3<f32>(0.0);
            var hi = vec3<f32>(0.0);
            if (yard) {
                let ph = vec2<f32>(cc_industry_POLE_HW);
                lo = vec3<f32>(f.head.xy - ph, 0.0);
                hi = vec3<f32>(f.head.xy + ph, f.head.z - 0.1);
            } else {
                // The bracket: from the wall out to the head's back.
                let wall = f.head.xy - f.aim * 0.8;
                let back = f.head.xy - f.aim * 0.2;
                let lat = vec2<f32>(abs(f.aim.y), abs(f.aim.x)) * 0.04;
                lo = vec3<f32>(min(wall, back) - lat, f.head.z + 0.05);
                hi = vec3<f32>(max(wall, back) + lat, f.head.z + 0.13);
            }
            best = cc_industry_box(best, o, dir, inv_dir, t0, t1, lo, hi,
                                   cc_industry_K_STEEL, ci);
        }
    }
    return best;
}

// ============================================================================
// PROP LAYOUT
// ============================================================================
//
// Grid i of the lot (i < cc_industry_N_GRIDS; -1 is a flat roof's skylights).
// Everything is sized from the plot and the building, so a narrow court gets
// pallets, a deep one trailers and a row of boxes along its far fence. No
// two grids of a lot overlap: the shader finds a hit's slot by position.
const cc_industry_N_GRIDS: i32 = 7;

fn cc_industry_grid(cc: CityCell, i: i32) -> cc_industry_Grid {
    if (i < 0) {
        return cc_industry_sky_grid(cc);
    }
    let l = cc_industry_lot(cc);
    let E = cc_industry_EDGE;
    let box_cell_l = cc_industry_BOX_L + 0.5;
    let box_cell_w = cc_industry_BOX_W + 0.26;
    let box_obj = vec2<f32>(cc_industry_BOX_L, cc_industry_BOX_W);
    let pal_cell = vec2<f32>(1.6, 1.4);
    let pal_obj = vec2<f32>(1.2, 1.0);
    let fork_cell = vec2<f32>(3.6, 1.4);
    let fork_obj = vec2<f32>(3.3, 1.2);
    let skip_cell = vec2<f32>(cc_industry_SKIP_L + 0.4,
                              cc_industry_SKIP_W + 0.4);
    let skip_obj = vec2<f32>(cc_industry_SKIP_L, cc_industry_SKIP_W);
    let pal_h = cc_industry_PALLET_H * 13.0;

    if (cc.land_use == CITY_USE_INDUSTRIAL) {
        // The court: from the dock wall out to the plot edge.
        let sgn = select(-1.0, 1.0, l.court_hi);
        let wall = select(l.bc.x, l.bc.y, l.court_hi);
        let far = select(l.pc.x, l.pc.y, l.court_hi);
        let depth = cc_industry_court_depth(l);
        let docks = cc_industry_docks(l);
        let n_dock = i32(docks.y);
        let dock_a0 = docks.x - 0.5 * cc_industry_DOCK_PITCH;
        let trl_c = cc_industry_TRL_L + 2.0 * cc_industry_DOCK_GAP;
        let has_docks = cc_industry_has_trailers(l);
        let d = cc_industry_draw(cc, 21u, i, 0);
        if (i == 0 && has_docks) {
            // Trailers backed onto the dock doors, rear to the wall, legs
            // down at the nose.
            let c_lo = select(wall - trl_c, wall, l.court_hi);
            return cc_industry_mk_grid(
                l, cc_industry_K_TRAILER, vec2<f32>(dock_a0, c_lo),
                vec2<f32>(cc_industry_DOCK_PITCH, trl_c), vec2<i32>(n_dock, 1),
                vec2<f32>(cc_industry_TRL_W, cc_industry_TRL_L),
                0.0, cc_industry_TRL_H, 0.45, 1,
                select(3, 2, l.court_hi), 20u);
        }
        if (i == 1) {
            if (depth >= trl_c + 2.0 + 12.0) {
                // A deep court: a line of boxes along its far fence, end to
                // end, one or two high — along the building's own run, so
                // it never reaches into an end yard's grid.
                let n = i32(floor((l.ba.y - l.ba.x) / box_cell_l
                                  * (0.5 + 0.35 * d.y)));
                let c_lo = select(far + E, far - E - box_cell_w, l.court_hi);
                return cc_industry_mk_grid(
                    l, cc_industry_K_BOX, vec2<f32>(l.ba.x, c_lo),
                    vec2<f32>(box_cell_l, box_cell_w), vec2<i32>(n, 1),
                    box_obj, 0.0, 2.0 * cc_industry_TIER, 0.80, 2, 0, 22u);
            }
            if (!has_docks && depth >= 5.0) {
                // A shallow court: pallet stacks along the far edge.
                let n = min(i32(floor((l.pa.y - l.pa.x) * 0.3 / pal_cell.x)),
                            12);
                let c_lo = select(far + E, far - E - pal_cell.y, l.court_hi);
                return cc_industry_mk_grid(
                    l, cc_industry_K_PALLET,
                    vec2<f32>(l.ba.x + 6.0 + 20.0 * d.z, c_lo), pal_cell,
                    vec2<i32>(n, 1), pal_obj, 0.0, pal_h, 0.70, 1, 0, 23u);
            }
            return cc_industry_no_grid();
        }
        if (i == 2 || i == 3) {
            // The end yards, where the building leaves the plot's ends open.
            let lo_end = i == 2;
            let a_lo = select(l.ba.y + E, l.pa.x + E, lo_end);
            let a_hi = select(l.pa.y - E, l.ba.x - E, lo_end);
            let w = a_hi - a_lo;
            let span_c = l.pc.y - l.pc.x - 2.0 * E;
            if (w < 4.0) {
                return cc_industry_no_grid();
            }
            if (d.x < 0.40 && span_c >= box_cell_l) {
                // Containers parked across the end yard, side by side.
                let n_c = min(i32(floor(span_c / box_cell_l)), 3);
                let n_a = min(i32(floor(w / box_cell_w)), 8);
                return cc_industry_mk_grid(
                    l, cc_industry_K_BOX,
                    vec2<f32>(select(a_lo, a_hi - f32(n_a) * box_cell_w,
                                     lo_end),
                              l.pc.x + E),
                    vec2<f32>(box_cell_w, box_cell_l), vec2<i32>(n_a, n_c),
                    box_obj.yx, 0.0, 3.0 * cc_industry_TIER, 0.70, 3, 0,
                    24u + u32(i));
            }
            if (d.x < 0.75) {
                let n_a = min(i32(floor(w / pal_cell.x)), 6);
                let n_c = min(i32(floor(span_c * 0.4 / pal_cell.y)), 9);
                return cc_industry_mk_grid(
                    l, cc_industry_K_PALLET,
                    vec2<f32>(a_lo, select(l.pc.x + E,
                                           l.pc.y - E - f32(n_c) * pal_cell.y,
                                           d.y < 0.5)),
                    pal_cell, vec2<i32>(n_a, n_c), pal_obj, 0.0, pal_h, 0.65,
                    1, 0, 24u + u32(i));
            }
            if (w >= 7.0) {
                // Rebar bundles on dunnage, laid across the end yard.
                let bar = min(w - 0.6, 12.0);
                let n_c = 3 + i32(d.y * 4.0);
                return cc_industry_mk_grid(
                    l, cc_industry_K_REBAR,
                    vec2<f32>(a_lo, l.pc.x + E + span_c * 0.5 * d.z),
                    vec2<f32>(bar + 0.6, 0.7), vec2<i32>(1, n_c),
                    vec2<f32>(bar, 0.45), 0.0, cc_industry_REBAR_H, 0.9, 1, 0,
                    24u + u32(i));
            }
            return cc_industry_no_grid();
        }
        if (i == 4) {
            // A skip against the court's far edge, at the end of the
            // building's run away from the row of boxes (which stops short
            // of it: that row covers at most 85% of a run of 130 m or more).
            let fits = depth >= trl_c + 2.0 + skip_cell.y + 2.0
                       || (!has_docks && depth >= skip_cell.y + 4.0);
            if (!fits || d.x > 0.55) {
                return cc_industry_no_grid();
            }
            let c_lo = select(far + E, far - E - skip_cell.y, l.court_hi);
            return cc_industry_mk_grid(
                l, cc_industry_K_SKIP,
                vec2<f32>(l.ba.y - 2.0 - skip_cell.x - 6.0 * d.y, c_lo),
                skip_cell, vec2<i32>(1, 1), skip_obj, 0.0,
                cc_industry_SKIP_H, 1.0, 1, 0, 25u);
        }
        if (i == 6) {
            // The dock hardware: a slot per door, flush on the wall.
            let c_lo = select(wall - cc_industry_SHELL_OUT, wall, l.court_hi);
            return cc_industry_mk_grid(
                l, cc_industry_K_DOCK,
                vec2<f32>(dock_a0, c_lo),
                vec2<f32>(cc_industry_DOCK_PITCH, cc_industry_SHELL_OUT),
                vec2<i32>(n_dock, 1),
                vec2<f32>(cc_industry_DOCK_PITCH - 0.2, cc_industry_SHELL_OUT),
                0.0, 4.95, 1.0,
                select(0, 1, cc_industry_wall_of(cc).shelter),
                select(3, 2, l.court_hi), 27u);
        }
        if (i == 5 && has_docks && d.x < 0.6) {
            // A forklift working an open door: in a dock slot with no trailer
            // in it, forks toward the wall.
            let j = i32(d.y * f32(n_dock));
            // The dock grid's own slot draw (its slot index is (j, 0) in a lot
            // along x, (0, j) in one along y).
            let slot = cc_industry_draw(cc, 20u, select(0, j, l.long_x),
                                        select(j, 0, l.long_x));
            if (slot.x < 0.45) {
                return cc_industry_no_grid();
            }
            let a = docks.x + f32(j) * cc_industry_DOCK_PITCH;
            let c = wall + sgn * (2.6 + 3.0 * d.z);
            return cc_industry_mk_grid(
                l, cc_industry_K_FORK,
                vec2<f32>(a - 0.5 * fork_cell.y, c - 0.5 * fork_cell.x),
                fork_cell.yx, vec2<i32>(1, 1), fork_obj.yx, 0.0,
                cc_industry_FORK_H, 1.0, 1, select(2, 3, l.court_hi), 26u);
        }
        return cc_industry_no_grid();
    }

    // --- a yard ---------------------------------------------------------------
    let ua = l.pa + vec2<f32>(E, -E);
    let uc = l.pc + vec2<f32>(E, -E);
    let la = ua.y - ua.x;
    let lc = uc.y - uc.x;
    let ty = cc_industry_draw(cc, 30u, 0, 0);
    let d = cc_industry_draw(cc, 31u, i, 0);
    if (ty.x < 0.35) {
        // Container storage: two blocks, boxes along the long axis, stacked
        // up to three, a driving aisle between them.
        if (i < 2) {
            let n_a = i32(floor(la / box_cell_l));
            let n_c = i32(floor((lc - 12.0) * 0.5 / box_cell_w));
            let a0 = ua.x + 0.5 * (la - f32(n_a) * box_cell_l);
            let c0 = select(uc.x, uc.y - f32(n_c) * box_cell_w, i == 1);
            return cc_industry_mk_grid(
                l, cc_industry_K_BOX, vec2<f32>(a0, c0),
                vec2<f32>(box_cell_l, box_cell_w), vec2<i32>(n_a, n_c),
                box_obj, 0.0, 3.0 * cc_industry_TIER, 0.88, 3, 0,
                40u + u32(i));
        }
        if (i == 2) {
            return cc_industry_mk_grid(
                l, cc_industry_K_FORK,
                vec2<f32>(ua.x + la * (0.2 + 0.6 * d.y),
                          0.5 * (uc.x + uc.y) - 0.5 * fork_cell.y),
                fork_cell, vec2<i32>(1, 1), fork_obj, 0.0,
                cc_industry_FORK_H, 1.0, 1, select(0, 1, d.z < 0.5), 42u);
        }
        return cc_industry_no_grid();
    }
    if (ty.x < 0.55) {
        // Trailer storage: two facing rows, noses to the aisle.
        let cell = vec2<f32>(3.7, cc_industry_TRL_L + 0.6);
        if (i < 2 && lc >= 2.0 * cell.y + 8.0) {
            let n_a = i32(floor(la / cell.x));
            let a0 = ua.x + 0.5 * (la - f32(n_a) * cell.x);
            let c0 = select(uc.x, uc.y - cell.y, i == 1);
            return cc_industry_mk_grid(
                l, cc_industry_K_TRAILER, vec2<f32>(a0, c0), cell,
                vec2<i32>(n_a, 1),
                vec2<f32>(cc_industry_TRL_W, cc_industry_TRL_L), 0.0,
                cc_industry_TRL_H, 0.60, 1, select(2, 3, i == 1),
                50u + u32(i));
        }
        return cc_industry_no_grid();
    }
    // Construction refuse, or a vacant lot. Along the long axis: the debris
    // mounds (cc_industry_pile) own the first ~40%; pallets, the skip and
    // the forklift the middle; rebar and a site box or two the far end.
    let refuse = ty.x < 0.87;
    let zb = ua.x + 0.42 * la;
    let zc = ua.x + 0.72 * la;
    if (i == 0 && refuse) {
        let n_a = min(i32(floor(0.26 * la / pal_cell.x)), 7);
        let n_c = min(i32(floor(0.45 * lc / pal_cell.y)), 9);
        return cc_industry_mk_grid(
            l, cc_industry_K_PALLET, vec2<f32>(zb, uc.x), pal_cell,
            vec2<i32>(n_a, n_c), pal_obj, 0.0, pal_h, 0.6, 1, 0, 60u);
    }
    if (i == 1 && (refuse || d.x < 0.4)) {
        return cc_industry_mk_grid(
            l, cc_industry_K_SKIP, vec2<f32>(zb, uc.y - skip_cell.y),
            skip_cell, vec2<i32>(1, 1), skip_obj, 0.0, cc_industry_SKIP_H,
            1.0, 1, 0, 61u);
    }
    if (i == 2 && refuse && d.x < 0.7) {
        return cc_industry_mk_grid(
            l, cc_industry_K_FORK,
            vec2<f32>(zb + 0.5, uc.x + 0.55 * lc), fork_cell,
            vec2<i32>(1, 1), fork_obj, 0.0, cc_industry_FORK_H, 1.0, 1,
            select(0, 1, d.y < 0.5), 62u);
    }
    if (i == 3 && refuse) {
        let bar = min(ua.y - zc - 0.6, 12.0);
        let n_c = 3 + i32(d.y * 5.0);
        return cc_industry_mk_grid(
            l, cc_industry_K_REBAR, vec2<f32>(zc, uc.x), vec2<f32>(bar + 0.6, 0.7),
            vec2<i32>(1, n_c), vec2<f32>(bar, 0.45), 0.0,
            cc_industry_REBAR_H, 0.9, 1, 0, 63u);
    }
    if (i == 4 && refuse && ua.y - zc >= box_cell_l) {
        return cc_industry_mk_grid(
            l, cc_industry_K_BOX, vec2<f32>(zc, uc.y - 2.0 * box_cell_w),
            vec2<f32>(box_cell_l, box_cell_w), vec2<i32>(1, 2), box_obj, 0.0,
            cc_industry_TIER, 0.75, 1, 0, 64u);
    }
    return cc_industry_no_grid();
}

// Per-slot height: 0 for an empty slot.
fn cc_industry_slot_h(g: cc_industry_Grid, d: vec4<f32>) -> f32 {
    if (d.x >= g.occ) {
        return 0.0;
    }
    if (g.kind == cc_industry_K_BOX) {
        // @domain: d is cc_industry_draw: a hash draw, in [0, 1)
        let t = min(1.0 + floor(pow(d.y, 0.8) * f32(g.tiers)), f32(g.tiers));
        return t * cc_industry_TIER;
    }
    if (g.kind == cc_industry_K_PALLET) {
        return cc_industry_PALLET_H * (2.0 + floor(d.y * 11.0));
    }
    return g.zmax;
}

fn cc_industry_slot_draw(cc: CityCell, g: cc_industry_Grid, ij: vec2<i32>)
        -> vec4<f32> {
    return cc_industry_draw(cc, g.salt, ij.x, ij.y);
}

// --- local frames for things with a front -----------------------------------
// (u forward, v to the left, z up) about a centre on the ground.
fn cc_industry_fwd(front: i32) -> vec2<f32> {
    return select(select(select(vec2<f32>(0.0, -1.0), vec2<f32>(0.0, 1.0),
                                front == 2),
                         vec2<f32>(-1.0, 0.0), front == 1),
                  vec2<f32>(1.0, 0.0), front == 0);
}

struct cc_industry_Box {
    lo: vec3<f32>,
    hi: vec3<f32>,
}

fn cc_industry_local_box(c: vec3<f32>, front: i32, lo: vec3<f32>,
                         hi: vec3<f32>) -> cc_industry_Box {
    let f = cc_industry_fwd(front);
    let lft = vec2<f32>(-f.y, f.x);
    let p0 = c.xy + f * lo.x + lft * lo.y;
    let p1 = c.xy + f * hi.x + lft * hi.y;
    return cc_industry_Box(vec3<f32>(min(p0, p1), c.z + lo.z),
                           vec3<f32>(max(p0, p1), c.z + hi.z));
}

// A forklift, as a union of boxes about its footprint centre: body,
// counterweight, overhead guard (roof and four posts), mast uprights and
// carriage, forks, wheels, seat. Part 0-4 is the far-field set.
fn cc_industry_fork_part(i: i32) -> cc_industry_Box {
    var lo = vec3<f32>(0.0);
    var hi = vec3<f32>(0.0);
    switch i {
        case 0: { lo = vec3<f32>(-1.35, -0.55, 0.30); hi = vec3<f32>(0.25, 0.55, 1.10); }
        case 1: { lo = vec3<f32>(-1.65, -0.58, 0.22); hi = vec3<f32>(-1.30, 0.58, 1.22); }
        case 2: { lo = vec3<f32>(-1.25, -0.56, 2.05); hi = vec3<f32>(0.20, 0.56, 2.12); }
        case 3: { lo = vec3<f32>(0.32, 0.26, 0.08); hi = vec3<f32>(0.44, 0.40, 2.30); }
        case 4: { lo = vec3<f32>(0.32, -0.40, 0.08); hi = vec3<f32>(0.44, -0.26, 2.30); }
        case 5: { lo = vec3<f32>(0.44, -0.46, 0.08); hi = vec3<f32>(0.50, 0.46, 1.05); }
        case 6: { lo = vec3<f32>(0.50, 0.22, 0.05); hi = vec3<f32>(1.65, 0.34, 0.10); }
        case 7: { lo = vec3<f32>(0.50, -0.34, 0.05); hi = vec3<f32>(1.65, -0.22, 0.10); }
        case 8: { lo = vec3<f32>(-0.25, -0.60, 0.0); hi = vec3<f32>(0.25, 0.60, 0.55); }
        case 9: { lo = vec3<f32>(-1.30, -0.56, 0.0); hi = vec3<f32>(-0.85, 0.56, 0.48); }
        case 10: { lo = vec3<f32>(0.12, 0.46, 1.10); hi = vec3<f32>(0.20, 0.54, 2.05); }
        case 11: { lo = vec3<f32>(0.12, -0.54, 1.10); hi = vec3<f32>(0.20, -0.46, 2.05); }
        case 12: { lo = vec3<f32>(-1.25, 0.46, 1.20); hi = vec3<f32>(-1.17, 0.54, 2.05); }
        case 13: { lo = vec3<f32>(-1.25, -0.54, 1.20); hi = vec3<f32>(-1.17, -0.46, 2.05); }
        default: { lo = vec3<f32>(-0.95, -0.25, 1.10); hi = vec3<f32>(-0.50, 0.25, 1.50); }
    }
    return cc_industry_Box(lo, hi);
}

// A semi-trailer, rear (doors) at -u: the box body on its deck; under the
// rear the tandem bogie's two tyre banks with the axles between them; under
// the nose the two landing legs; the chassis rails and the under-ride bar.
// Under a trailer you see through to the yard beyond — legs and tyres, not
// a skirt — and that gap is most of what says "trailer" rather than "box".
// Parts 0-2 are the far-field set.
fn cc_industry_trl_part(i: i32) -> cc_industry_Box {
    let hl = 0.5 * cc_industry_TRL_L;
    let hw = 0.5 * cc_industry_TRL_W;
    let dk = cc_industry_TRL_DECK;
    var lo = vec3<f32>(0.0);
    var hi = vec3<f32>(0.0);
    switch i {
        case 0: { lo = vec3<f32>(-hl, -hw, dk); hi = vec3<f32>(hl, hw, cc_industry_TRL_H); }
        case 1: { lo = vec3<f32>(-hl + 0.6, 0.62, 0.0); hi = vec3<f32>(-hl + 4.6, hw - 0.03, 1.05); }
        case 2: { lo = vec3<f32>(-hl + 0.6, -hw + 0.03, 0.0); hi = vec3<f32>(-hl + 4.6, -0.62, 1.05); }
        case 3: { lo = vec3<f32>(hl - 3.40, 0.80, 0.0); hi = vec3<f32>(hl - 3.22, 0.98, dk); }
        case 4: { lo = vec3<f32>(hl - 3.40, -0.98, 0.0); hi = vec3<f32>(hl - 3.22, -0.80, dk); }
        case 5: { lo = vec3<f32>(-hl + 0.4, -0.55, 1.0); hi = vec3<f32>(hl - 0.3, 0.55, dk); }
        case 6: { lo = vec3<f32>(-hl + 0.9, -0.62, 0.38); hi = vec3<f32>(-hl + 4.3, 0.62, 0.62); }
        default: { lo = vec3<f32>(-hl + 0.05, -hw + 0.1, 0.50); hi = vec3<f32>(-hl + 0.20, hw - 0.1, 0.68); }
    }
    return cc_industry_Box(lo, hi);
}

// A dock's hardware, about its slot centre (SHELL_OUT/2 off the wall), u out
// from the wall: the shelter's two side pads and head pad, black fabric over
// a frame, standing proud of the wall around the door; the two rubber
// bumpers either side of the door at trailer-bed height; the leveller's
// steel lip at the dock floor, which a trailer backs under. Parts 0-2 are
// the shelter.
fn cc_industry_dock_part(i: i32) -> cc_industry_Box {
    let w = -0.5 * cc_industry_SHELL_OUT;      // the wall, in u
    let hd = 0.5 * cc_industry_DOOR_W;
    let top = cc_industry_DOCK_H + cc_industry_DOOR_H;
    var lo = vec3<f32>(0.0);
    var hi = vec3<f32>(0.0);
    switch i {
        case 0: { lo = vec3<f32>(w, hd, 1.0); hi = vec3<f32>(w + 0.60, hd + 0.50, top + 0.75); }
        case 1: { lo = vec3<f32>(w, -hd - 0.50, 1.0); hi = vec3<f32>(w + 0.60, -hd, top + 0.75); }
        case 2: { lo = vec3<f32>(w, -hd - 0.50, top + 0.10); hi = vec3<f32>(w + 0.60, hd + 0.50, top + 0.75); }
        case 3: { lo = vec3<f32>(w, 1.05, 0.75); hi = vec3<f32>(w + 0.18, 1.30, 1.20); }
        case 4: { lo = vec3<f32>(w, -1.30, 0.75); hi = vec3<f32>(w + 0.18, -1.05, 1.20); }
        default: { lo = vec3<f32>(w, -1.0, cc_industry_DOCK_H - 0.08); hi = vec3<f32>(w + 0.30, 1.0, cc_industry_DOCK_H); }
    }
    return cc_industry_Box(lo, hi);
}

// One object in its slot, against the segment. Boxes for the simple kinds;
// part unions for trailers and forklifts close up; a hollow for the skip.
fn cc_industry_obj(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                   inv_dir: vec3<f32>, t0: f32, t1: f32, g: cc_industry_Grid,
                   ctr: vec2<f32>, hgt: f32, ci: vec2<i32>, fp: f32)
        -> CityHit {
    let omin = vec3<f32>(ctr - 0.5 * g.obj, g.lo.z);
    let omax = vec3<f32>(ctr + 0.5 * g.obj, g.lo.z + hgt);
    let sb = city_box_hit(o, inv_dir, omin, omax);
    if (sb.x > sb.y || sb.y <= max(t0, 1e-3) || sb.x > min(t1, best.t)) {
        return best;
    }
    if (g.kind == cc_industry_K_TRAILER || g.kind == cc_industry_K_FORK
        || g.kind == cc_industry_K_DOCK) {
        let is_fork = g.kind == cc_industry_K_FORK;
        let is_dock = g.kind == cc_industry_K_DOCK;
        let near = fp < cc_industry_PART_FP;
        var n = select(select(3, 8, near), select(5, 15, near), is_fork);
        var i0 = 0;
        if (is_dock) {
            // The shelter (parts 0-2) where the building has them; the
            // bumpers and leveller lip close in only.
            i0 = select(3, 0, g.tiers > 0);
            n = select(3, 6, near);
        }
        var r = best;
        let c = vec3<f32>(ctr, g.lo.z);
        for (var i: i32 = i0; i < n; i = i + 1) {
            var pb: cc_industry_Box;
            if (is_fork) {
                pb = cc_industry_fork_part(i);
            } else if (is_dock) {
                pb = cc_industry_dock_part(i);
            } else {
                pb = cc_industry_trl_part(i);
            }
            let wb = cc_industry_local_box(c, g.front, pb.lo, pb.hi);
            r = cc_industry_box(r, o, dir, inv_dir, t0, t1, wb.lo, wb.hi,
                                g.kind, ci);
        }
        return r;
    }
    if (g.kind == cc_industry_K_SKIP) {
        // A roll-off skip: walls around a cavity filled to a draw-set level.
        // Entering through the open top inside the walls, the ray meets the
        // cavity's far side — a wall's inner face or the refuse.
        let q = o + sb.x * dir;
        let wl = vec2<f32>(cc_industry_SKIP_WALL);
        let imin = vec3<f32>(omin.xy + wl, g.lo.z + 0.75 + 0.55 * fract(
            ctr.x * 0.37 + ctr.y * 0.61));
        let imax = vec3<f32>(omax.xy - wl, omax.z + 1.0);
        let into = q.z > omax.z - 1e-3 && all(q.xy > imin.xy)
                   && all(q.xy < imax.xy);
        if (!into) {
            return cc_industry_box(best, o, dir, inv_dir, t0, t1, omin, omax,
                                   cc_industry_K_SKIP, ci);
        }
        let si = city_box_hit(o, inv_dir, imin, imax);
        let te = si.y;
        if (te <= max(t0, 1e-3) || te > t1 || te >= best.t) {
            return best;
        }
        let p = o + te * dir;
        let nb = city_box_normal(p, imin, imax);
        let refuse = nb.z < -0.5;
        return CityHit(true, te, p, select(-nb, vec3<f32>(0.0, 0.0, 1.0),
                                           refuse),
                       select(cc_industry_K_SKIP, cc_industry_K_REFUSE,
                              refuse), ci);
    }
    if (sb.x > max(t0, 1e-3) && sb.x <= t1 && sb.x < best.t) {
        let p = o + sb.x * dir;
        return CityHit(true, sb.x, p, city_box_normal(p, omin, omax), g.kind,
                       ci);
    }
    return best;
}

// A grid against the segment: its bounding box, then a 2D DDA over the slots
// the ray crosses in order. Objects stay inside their slots, so the first
// slot that reports a hit holds the nearest one.
//
// LOD is decided here, at the footprint where the ray enters the grid — not
// at the segment's start, which for the camera's own cell is the camera: a
// skylight grid seen from 5 km straight down would otherwise be traced
// skylight by skylight and shaded as their mean, and lose the coverage
// factor twice. `fp0` (the footprint at t0, a lower bound) rejects the
// small, dark props before their box is even tested.
fn cc_industry_grid_hit(best: CityHit, o: vec3<f32>, dir: vec3<f32>,
                        inv_dir: vec3<f32>, t0: f32, t1: f32, cc: CityCell,
                        g: cc_industry_Grid, ci: vec2<i32>, px: f32, fp0: f32)
        -> CityHit {
    let small = g.kind == cc_industry_K_PALLET || g.kind == cc_industry_K_REBAR
                || g.kind == cc_industry_K_FORK || g.kind == cc_industry_K_DOCK;
    if (small && fp0 >= cc_industry_FINE_FP) {
        return best;
    }
    let span = vec2<f32>(g.n) * g.cell;
    let gmin = g.lo;
    let gmax = vec3<f32>(g.lo.xy + span, g.lo.z + g.zmax);
    let sb = city_box_hit(o, inv_dir, gmin, gmax);
    let ta = max(max(sb.x, t0), 1e-3);
    let tb = min(min(sb.y, t1), best.t);
    if (sb.x > sb.y || ta > tb) {
        return best;
    }
    let fp = px * ta;
    if (g.kind == cc_industry_K_SKY && fp >= cc_industry_SKY_FP) {
        // Sub-pixel relief: the whole grid as one thin panel, shaded with
        // the skylights' pattern dissolving into its mean
        // (cc_industry_sky_shade).
        return cc_industry_box(best, o, dir, inv_dir, t0, t1, gmin,
                               vec3<f32>(gmax.xy, gmin.z + 0.02),
                               cc_industry_K_SKY, ci);
    }
    let p = o + ta * dir - g.lo;
    var ij = clamp(vec2<i32>(floor(p.xy / g.cell)), vec2<i32>(0), g.n - 1);
    let stp = vec2<i32>(select(-1, 1, dir.x > 0.0), select(-1, 1, dir.y > 0.0));
    let nxt = vec2<f32>(ij + max(stp, vec2<i32>(0))) * g.cell;
    var tmax = vec2<f32>(
        select(1e30, ta + (nxt.x - p.x) * inv_dir.x, abs(dir.x) > 1e-9),
        select(1e30, ta + (nxt.y - p.y) * inv_dir.y, abs(dir.y) > 1e-9));
    let tdel = g.cell * abs(inv_dir.xy);
    let steps = g.n.x + g.n.y;
    for (var s: i32 = 0; s < steps; s = s + 1) {
        let d = cc_industry_slot_draw(cc, g, ij);
        let hgt = cc_industry_slot_h(g, d);
        if (hgt > 0.0) {
            let ctr = g.lo.xy + (vec2<f32>(ij) + 0.5) * g.cell;
            let r = cc_industry_obj(best, o, dir, inv_dir, t0, t1, g, ctr,
                                    hgt, ci, fp);
            if (r.hit && r.t < best.t) {
                return r;
            }
        }
        if (min(tmax.x, tmax.y) > tb) {
            break;
        }
        if (tmax.x < tmax.y) {
            ij.x = ij.x + stp.x;
            tmax.x = tmax.x + tdel.x;
        } else {
            ij.y = ij.y + stp.y;
            tmax.y = tmax.y + tdel.y;
        }
        if (any(ij < vec2<i32>(0)) || any(ij >= g.n)) {
            break;
        }
    }
    return best;
}

// --- debris mounds (yards) ----------------------------------------------------
// A mound is three to five overlapping half-ellipsoids — a main heap and the
// lobes slumped off it — so the silhouette is lumpy rather than a dome.
struct cc_industry_Pile {
    ok: bool,
    c: vec2<f32>,
    r: f32,
    h: f32,
    seed: vec4<f32>,
}

const cc_industry_N_PILES: i32 = 4;

fn cc_industry_pile(cc: CityCell, i: i32) -> cc_industry_Pile {
    var m: cc_industry_Pile;
    m.ok = false;
    m.c = vec2<f32>(0.0);
    m.r = 1.0;
    m.h = 0.0;
    m.seed = vec4<f32>(0.0);
    if (cc.land_use != CITY_USE_YARD) {
        return m;
    }
    let ty = cc_industry_draw(cc, 30u, 0, 0);
    if (ty.x < 0.55) {
        return m;   // container or trailer storage: kept clear
    }
    let refuse = ty.x < 0.87;
    let n = select(1 + i32(ty.y * 2.99), 2 + i32(ty.y * 2.99), refuse);
    if (i >= n) {
        return m;
    }
    let l = cc_industry_lot(cc);
    let d = cc_industry_draw(cc, 70u, i, 0);
    m.r = 2.0 + 2.5 * d.x;
    m.h = 0.8 + 1.4 * d.y;
    let marg = 1.6 * m.r + cc_industry_EDGE;   // the lobes reach 1.55 r
    let a_hi = select(l.pa.y, l.pa.x + 0.40 * (l.pa.y - l.pa.x), refuse);
    let a = mix(l.pa.x + marg, max(a_hi - marg, l.pa.x + marg), d.z);
    let c = mix(l.pc.x + marg, l.pc.y - marg, d.w);
    m.c = cc_industry_xy(l, vec2<f32>(a, c));
    m.seed = cc_industry_draw(cc, 71u, i, 0);
    m.ok = true;
    return m;
}

// Lobe j of a mound: (centre xy, horizontal radius, height).
fn cc_industry_lobe(m: cc_industry_Pile, j: i32) -> vec4<f32> {
    // The main heap is kept small enough that the lobes break its outline
    // rather than hiding inside it.
    if (j == 0) {
        return vec4<f32>(m.c, 0.8 * m.r, m.h);
    }
    let fj = f32(j);
    let ang = 6.2831853 * m.seed.x + 1.7 * fj;
    let off = vec2<f32>(cos(ang), sin(ang)) * m.r
              * (0.50 + 0.40 * fract(m.seed.y + 0.31 * fj));
    let k = 0.40 + 0.25 * fract(m.seed.z + 0.53 * fj);
    return vec4<f32>(m.c + off, m.r * k,
                     m.h * (0.55 + 0.30 * fract(m.seed.w + 0.71 * fj)));
}

fn cc_industry_piles_hit(best_in: CityHit, o: vec3<f32>, dir: vec3<f32>,
                         t0: f32, t1: f32, cc: CityCell, ci: vec2<i32>)
        -> CityHit {
    var best = best_in;
    let np = select(0, cc_industry_N_PILES, cc.land_use == CITY_USE_YARD);
    for (var i: i32 = 0; i < np; i = i + 1) {
        let m = cc_industry_pile(cc, i);
        if (!m.ok) {
            continue;
        }
        let nl = 3 + i32(m.seed.w * 2.999);
        for (var j: i32 = 0; j < nl; j = j + 1) {
            let e = cc_industry_lobe(m, j);
            let rad = vec3<f32>(e.z, e.z, e.w);
            let qo = (o - vec3<f32>(e.xy, 0.0)) / rad;
            let qd = dir / rad;
            let a = dot(qd, qd);
            let b = dot(qo, qd);
            let c = dot(qo, qo) - 1.0;
            let disc = b * b - a * c;
            if (disc <= 0.0) {
                continue;
            }
            // @domain: the discriminant is tested positive (or non-negative) just above
            let t = (-b - sqrt(disc)) / a;
            if (t > max(t0, 1e-3) && t <= t1 && t < best.t) {
                let p = o + t * dir;
                if (p.z >= 0.0) {
                    // @domain: the hit lies on the dome, never at its centre
                    let n = normalize((p - vec3<f32>(e.xy, 0.0))
                                      / (rad * rad));
                    best = CityHit(true, t, p, n, cc_industry_K_PILE, ci);
                }
            }
        }
    }
    return best;
}

// --- the fence (yards) --------------------------------------------------------
// Chain-link on galvanised posts, around 75% of yards, with a gate gap in
// one side. The mesh itself is not drawn: it has no opaque surface to shade,
// and seen through at night it is invisible against the dark yard. Posts
// every 3 m and a top rail are what reads, and only close in.
//
// Written for the register file, not for generality: a first version found
// its gate by probing the neighbouring lots' land use in a loop, broke the
// rail in two around it and walked the posts over the ray's run, and that
// body alone cost 12% on URBAN vistas that never reach it (inlined into the
// core's DDA, its registers are paid by every city pixel; measured by
// ablation, 2026-09-23). The gate is now a drawn side, the rail one box
// whose hit is refused inside the gap, and the posts the two nearest the
// ray's run through the fence line — a ray is inside that 8 cm slab for a
// post pitch or less unless it runs down the fence, where the nearest post
// hides the rest.
fn cc_industry_fence_on(cc: CityCell) -> vec4<f32> {
    return cc_industry_draw(cc, 80u, 0, 0);
}

// Edge e (0 -x, 1 +x, 2 -y, 3 +y) of the fence line: its axis-aligned line
// as (fixed coordinate, run start, run end) and whether it runs along x.
fn cc_industry_fence_edge(cc: CityCell, e: i32) -> vec4<f32> {
    let lo = cc.plot_min + vec2<f32>(cc_industry_FENCE_IN);
    let hi = cc.plot_max - vec2<f32>(cc_industry_FENCE_IN);
    if (e == 0) { return vec4<f32>(lo.x, lo.y, hi.y, 0.0); }
    if (e == 1) { return vec4<f32>(hi.x, lo.y, hi.y, 0.0); }
    if (e == 2) { return vec4<f32>(lo.y, lo.x, hi.x, 1.0); }
    return vec4<f32>(hi.y, lo.x, hi.x, 1.0);
}

fn cc_industry_fence_hit(best_in: CityHit, o: vec3<f32>, dir: vec3<f32>,
                         inv_dir: vec3<f32>, t0: f32, t1: f32, cc: CityCell,
                         ci: vec2<i32>) -> CityHit {
    var best = best_in;
    let fo = cc_industry_fence_on(cc);
    let gate_e = i32(fo.y * 3.999);
    let pw = 0.04;       // post half-width
    let rw = 0.025;      // rail half-width
    let ne = select(0, 4, fo.x < cc_industry_FENCE_FRAC);
    for (var e: i32 = 0; e < ne; e = e + 1) {
        let ln = cc_industry_fence_edge(cc, e);
        let along_x = ln.w > 0.5;
        // The fence line's slab: a cheap reject for the whole edge.
        let lo = select(vec2<f32>(ln.x - pw, ln.y - pw),
                        vec2<f32>(ln.y - pw, ln.x - pw), along_x);
        let hi = select(vec2<f32>(ln.x + pw, ln.z + pw),
                        vec2<f32>(ln.z + pw, ln.x + pw), along_x);
        let sb = city_box_hit(o, inv_dir, vec3<f32>(lo, 0.0),
                              vec3<f32>(hi, cc_industry_FENCE_H + 0.06));
        let ta = max(max(sb.x, t0), 1e-3);
        let tb = min(min(sb.y, t1), best.t);
        if (sb.x > sb.y || ta > tb) {
            continue;
        }
        let g0 = select(1e30, mix(ln.y + 2.0, ln.z - 2.0 - cc_industry_GATE_W,
                                  fo.z), e == gate_e);
        var cand = best;
        // The top rail.
        let rlo = select(vec2<f32>(ln.x - rw, ln.y), vec2<f32>(ln.y, ln.x - rw),
                         along_x);
        let rhi = select(vec2<f32>(ln.x + rw, ln.z), vec2<f32>(ln.z, ln.x + rw),
                         along_x);
        cand = cc_industry_box(cand, o, dir, inv_dir, t0, t1,
                               vec3<f32>(rlo, cc_industry_FENCE_H - 0.05),
                               vec3<f32>(rhi, cc_industry_FENCE_H),
                               cc_industry_K_FENCE, ci);
        // The two posts nearest the ray's entry and exit of the slab.
        let sa = select((o + ta * dir).y, (o + ta * dir).x, along_x) - ln.y;
        let se = select((o + tb * dir).y, (o + tb * dir).x, along_x) - ln.y;
        let kmax = floor((ln.z - ln.y) / cc_industry_FENCE_POST);
        for (var j: i32 = 0; j < 2; j = j + 1) {
            let k = clamp(round(select(se, sa, j == 0)
                                / cc_industry_FENCE_POST), 0.0, kmax);
            let c = select(vec2<f32>(ln.x, ln.y + k * cc_industry_FENCE_POST),
                           vec2<f32>(ln.y + k * cc_industry_FENCE_POST, ln.x),
                           along_x);
            cand = cc_industry_box(
                cand, o, dir, inv_dir, t0, t1,
                vec3<f32>(c - vec2<f32>(pw), 0.0),
                vec3<f32>(c + vec2<f32>(pw), cc_industry_FENCE_H + 0.06),
                cc_industry_K_FENCE, ci);
        }
        // Nothing stands in the gate.
        if (cand.hit && cand.t < best.t) {
            let s = select(cand.pos.y, cand.pos.x, along_x);
            if (s < g0 || s > g0 + cc_industry_GATE_W) {
                best = cand;
            }
        }
    }
    return best;
}

// ============================================================================
// THE TRACE HOOK
// ============================================================================
fn cc_industry_props_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                           t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    var best = cc_industry_miss(ci);
    // Gate 0, no arithmetic: most of the tile is urban, and open scrub
    // carries nothing of ours.
    let ind = cc.land_use == CITY_USE_INDUSTRIAL;
    if (!ind && cc.land_use != CITY_USE_YARD) {
        return best;
    }
    // Gate 1: the segment's z range against the tallest thing we own here.
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    let z_lo = min(za, zb);
    let z_hi = max(za, zb);
    let top = select(cc_industry_YARD_TOP, cc.height + cc_industry_ROOF_TOP,
                     ind);
    if (z_lo > top) {
        return best;
    }
    // LOD decisions take the footprint at the thing they decide about (see
    // cc_industry_grid_hit, cc_industry_fixtures); fp at the segment's start
    // is only a lower bound, good for rejecting whole families of small
    // props at once.
    let px = cc_industry_px();
    let fp0 = px * max(t0, 0.0);

    // Roofs: the sawtooth and the clerestory here; a flat roof's skylights
    // are a grid, and go through the grid loop below as grid -1.
    var roof_kind = 0;
    if (ind && z_hi >= cc.height - 0.1) {
        let r = cc_industry_roof_of(cc);
        roof_kind = r.kind;
        if (r.kind == 1) {
            best = cc_industry_saw_trace(best, o, dir, inv_dir, t0, t1, cc, r,
                                         ci);
        } else if (r.kind == 2) {
            let sb = city_box_hit(o, inv_dir, r.mlo, r.mhi);
            if (sb.x <= sb.y && sb.x > max(t0, 1e-3) && sb.x <= t1) {
                let p = o + sb.x * dir;
                let n = city_box_normal(p, r.mlo, r.mhi);
                // The long faces are the clerestory glazing.
                let long_x = (r.mhi.x - r.mlo.x) >= (r.mhi.y - r.mlo.y);
                let glazed = abs(select(n.x, n.y, long_x)) > 0.5;
                best = CityHit(true, sb.x, p, n,
                               select(cc_industry_K_ROOF, cc_industry_K_GLAZE,
                                      glazed), ci);
            }
        }
    }

    // Flood fixtures: a wall-pack band on a warehouse, the poles in a yard.
    let fx_lo = select(0.0, CITY_FLOOD_WALL_Z - cc_industry_HEAD_WIDEN_MAX
                            - 0.1, ind);
    let fx_hi = select(cc_industry_YARD_TOP,
                       CITY_FLOOD_WALL_Z + cc_industry_HEAD_WIDEN_MAX + 0.2,
                       ind);
    if (z_hi >= fx_lo && z_lo <= fx_hi) {
        best = cc_industry_fixtures(best, o, dir, inv_dir, t0, t1, cc, ci, px);
    }

    // The grids: -1 is a flat roof's skylights, 0.. the ground props. One
    // loop, one call site, so the per-object detail is inlined once.
    let sky = ind && roof_kind == 0 && z_hi >= cc.height - 0.1
              && z_lo <= cc.height + cc_industry_SKY_H;
    let ground = z_lo <= cc_industry_PROP_TOP;
    let g_first = select(0, -1, sky);
    let g_end = select(0, select(5, cc_industry_N_GRIDS, ind), ground);
    for (var i: i32 = g_first; i < g_end; i = i + 1) {
        let g = cc_industry_grid(cc, i);
        if (g.ok) {
            best = cc_industry_grid_hit(best, o, dir, inv_dir, t0, t1, cc, g,
                                        ci, px, fp0);
        }
    }
    if (ground && !ind) {
        if (z_lo <= 2.4) {
            best = cc_industry_piles_hit(best, o, dir, t0, t1, cc, ci);
        }
        if (fp0 < cc_industry_FINE_FP && z_lo <= cc_industry_FENCE_H + 0.1) {
            best = cc_industry_fence_hit(best, o, dir, inv_dir, t0, t1, cc,
                                         ci);
        }
    }
    return best;
}

// ============================================================================
// LIGHT
// ============================================================================

fn cc_industry_fill(p: vec3<f32>) -> vec3<f32> {
    return CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(p.xy, 3.0));
}

// What lights a prop surface, as the radiance a surface of ALB_REF would
// return: each of the lot's pools at the prop's own ground position — the
// beam's footprint there — times how squarely the surface faces the
// fixture, relative to the ground under it, and never more than the ground
// gets: a surface facing away catches none, one squarely facing catches
// what the ground does. The pools' peaks are calibrated for ground a head's
// height below the lamp; a container top two metres under it, lit with the
// inverse square, would take several times that, and first renders showed
// exactly that as flat white tops (the lead, 2026-09-23). Then the street
// lamps, for the yards that front one, falling mostly on up-facing
// surfaces.
fn cc_industry_light(cc: CityCell, p: vec3<f32>, n: vec3<f32>) -> vec3<f32> {
    var e = vec3<f32>(0.0);
    let nk = select(0, CITY_FLOOD_MAX,
                    cc.land_use == CITY_USE_INDUSTRIAL
                    || cc.land_use == CITY_USE_YARD);
    for (var k: i32 = 0; k < nk; k = k + 1) {
        let f = city_flood(cc, k);
        if (f.on) {
            // @domain: a lamp head in the air minus a point on a surface: never zero
            let l = normalize(f.head - p);
            let facing = min(max(dot(n, l), 0.0) / max(l.z, 0.2), 1.0);
            e = e + f.color * (city_flood_pool(f, p.xy) * facing);
        }
    }
    let district = city_glow_sample(p.xy, 2.0);
    let raw = CITY_LAMP_RADIANCE * (0.20 + 1.3 * smoothstep(0.02, 0.45, district))
              * city_street_pools(p.xy);
    e = e + CITY_LAMP_COLOR * (raw / (1.0 + raw * 0.30))
            * (0.35 + 0.65 * max(n.z, 0.0));
    return e;
}

// The lamp-lit part passes a soft knee before it is returned: a bright
// painted box under a bright pool still keeps its shading instead of
// meeting the tone map's shoulder as a flat white face.
fn cc_industry_lit(cc: CityCell, p: vec3<f32>, n: vec3<f32>, alb: vec3<f32>)
        -> vec3<f32> {
    let moon = u.sun_dir.xyz;
    let lamp = (alb / cc_industry_ALB_REF) * cc_industry_light(cc, p, n);
    return lamp / (vec3<f32>(1.0) + lamp / cc_industry_LAMP_KNEE)
           + alb * (cc_industry_fill(p)
                    + CITY_MOONLIGHT * max(dot(n, moon), 0.0));
}

// A shading band that dissolves: `pattern` while the band is wider than a
// pixel, its own mean `mean` once it is not.
fn cc_industry_band(pattern: f32, mean: f32, width: f32, fp: f32) -> f32 {
    return mix(pattern, mean, smoothstep(0.5 * width, 2.0 * width, fp));
}

// ============================================================================
// ROOF SHADING, AND THE ROOF HOOK
// ============================================================================

// Glazing's mean emission over a whole glazed face of height `hgt`: the lit
// bays at their mean level, the glass between mullions, and the glass band
// between the sill and head flashing. The shader's far field and the roof
// hook both take it from here, so they cannot disagree.
fn cc_industry_glaze_mean(r: cc_industry_Roof, hgt: f32) -> vec3<f32> {
    if (!r.lit) {
        return vec3<f32>(0.0);
    }
    return r.tint * (cc_industry_GLAZE_RAD * cc_industry_BAY_LIT
                     * cc_industry_BAY_MEAN * cc_industry_LAMP_MEAN
                     * cc_industry_glass_frac(hgt));
}

// The fraction of a glazed face that is glass: the band between the sill and
// head flashing, less a transom across it and the mullions down it.
fn cc_industry_glass_frac(hgt: f32) -> f32 {
    let pane = max(hgt - cc_industry_SILL - cc_industry_HEAD_BAND, 0.0);
    return (pane - cc_industry_TRANSOM_W) / hgt
           * (1.0 - cc_industry_MULL_W / cc_industry_MULL);
}

fn cc_industry_glaze_shade(h: CityHit, cc: CityCell, fp: f32) -> vec3<f32> {
    let r = cc_industry_roof_of(cc);
    // @domain: a wall's normal: |xy| = 1
    let nh = normalize(h.normal.xy + vec2<f32>(1e-9, 0.0));
    let uc = dot(h.pos.xy, vec2<f32>(-nh.y, nh.x));
    let v = h.pos.z - cc.height;
    let hgt = select(r.mhi.z - cc.height, r.rise, r.kind == 1);
    // Unlit glass: a dark pane holding a little of the city's glow.
    let base = CITY_SKYGLOW * 0.8 + 0.03 * cc_industry_fill(h.pos);
    if (!r.lit) {
        return base;
    }
    // Which face (a sawtooth's tooth, or a clerestory side) and which
    // lighting bay along it: the high-bays are switched in zones.
    let face_id = i32(round(dot(h.pos.xy, nh) * 0.5));
    let bay = i32(floor(uc / cc_industry_BAY));
    let dl = cc_industry_draw(cc, 14u, face_id, bay);
    let bay_on = select(0.0, 0.4 + dl.y, dl.x < cc_industry_BAY_LIT);
    // The frame, as it was built: flashing bands, a transom, mullions. Each
    // goes to its own mean as it goes sub-pixel, so what is left at range is
    // exactly cc_industry_glass_frac.
    let mid = 0.5 * (cc_industry_SILL + hgt - cc_industry_HEAD_BAND);
    let band = select(0.0, 1.0,
                      v > cc_industry_SILL && v < hgt - cc_industry_HEAD_BAND
                      && abs(v - mid) > 0.5 * cc_industry_TRANSOM_W);
    let band_k = cc_industry_band(
        band, cc_industry_glass_frac(hgt)
              / (1.0 - cc_industry_MULL_W / cc_industry_MULL),
        cc_industry_TRANSOM_W, fp);
    let mull = select(1.0, 0.0,
                      fract(uc / cc_industry_MULL)
                      < cc_industry_MULL_W / cc_industry_MULL);
    let mull_k = cc_industry_band(mull,
                                  1.0 - cc_industry_MULL_W / cc_industry_MULL,
                                  cc_industry_MULL_W, fp);
    let dq = (fract(uc / cc_industry_LAMP_P) - 0.5) * cc_industry_LAMP_P;
    let spot = cc_industry_LAMP_FLOOR + (1.0 - cc_industry_LAMP_FLOOR)
        * exp(-0.5 * dq * dq / (cc_industry_LAMP_SIG * cc_industry_LAMP_SIG));
    let spot_k = cc_industry_band(spot, cc_industry_LAMP_MEAN,
                                  cc_industry_LAMP_SIG, fp);
    let near = r.tint * (cc_industry_GLAZE_RAD * bay_on * band_k * mull_k
                         * spot_k);
    let far = cc_industry_glaze_mean(r, hgt) * cc_industry_GLAZE_MEAN_COMP;
    let k = smoothstep(cc_industry_GLAZE_LOD_START, cc_industry_GLAZE_LOD_FULL,
                       fp);
    return base + mix(near, far, k);
}

fn cc_industry_roof_shade(h: CityHit, cc: CityCell, fp: f32) -> vec3<f32> {
    let moon = u.sun_dir.xyz;
    let light = cc_industry_fill(h.pos)
                + CITY_MOONLIGHT * max(dot(h.normal, moon), 0.0);
    if (abs(h.normal.z) < 0.3) {
        // A gable end or a clerestory's end wall: the cladding carried up.
        return cc_industry_CLAD_ALB * light;
    }
    // Sheet roofing: standing seams running down the slope, and on a
    // sawtooth the dark gutter in every valley.
    let r = cc_industry_roof_of(cc);
    let across = select(h.pos.x, h.pos.y, r.kind == 1 && r.step_x);
    let seam = select(1.0, 1.6, fract(across / cc_industry_SEAM) < 0.08);
    var m = cc_industry_band(seam, 1.048, 0.05, fp);
    if (r.kind == 1) {
        let v = h.pos.z - cc.height;
        m = m * cc_industry_band(select(1.0, 0.35, v < 0.12), 0.97,
                                 0.12 * r.pitch / r.rise, fp);
    }
    return cc_industry_ROOF_ALB * m * light;
}

fn cc_industry_sky_mean(cc: CityCell, g: cc_industry_Grid,
                        r: cc_industry_Roof) -> vec3<f32> {
    let cover = (g.obj.x * g.obj.y) / (g.cell.x * g.cell.y);
    return select(vec3<f32>(0.0), r.tint * (cc_industry_SKY_RAD * cover),
                  r.lit);
}

fn cc_industry_sky_shade(h: CityHit, cc: CityCell, fp: f32) -> vec3<f32> {
    let g = cc_industry_sky_grid(cc);
    let r = cc_industry_roof_of(cc);
    let rel = h.pos.xy - g.lo.xy;
    let ij = vec2<i32>(floor(rel / g.cell));
    let loc = rel - (vec2<f32>(ij) + 0.5) * g.cell;
    let inside = all(abs(loc) < 0.5 * g.obj);
    let light = cc_industry_fill(h.pos)
                + CITY_MOONLIGHT * max(dot(h.normal, u.sun_dir.xyz), 0.0);
    // The pattern: a glowing panel (its level drawn per skylight) inside a
    // skylight's footprint, dark curb on its sides, roof between.
    let dl = cc_industry_draw(cc, 15u, ij.x, ij.y);
    var pat = cc_industry_ROOF_ALB * light;
    if (inside) {
        pat = select(0.04 * light, 0.25 * light, h.normal.z > 0.5);
        if (r.lit && h.normal.z > 0.5) {
            pat = pat + r.tint * (cc_industry_SKY_RAD * (0.6 + 0.8 * dl.y));
        }
    }
    let cover = (g.obj.x * g.obj.y) / (g.cell.x * g.cell.y);
    let mean = cc_industry_sky_mean(cc, g, r) * cc_industry_GLAZE_MEAN_COMP
               + light * (cc_industry_ROOF_ALB * (1.0 - cover) + 0.25 * cover);
    return mix(pat, mean, smoothstep(1.0, 4.0, fp));
}

// The roof hook: a warehouse roof hit by the CORE — which, wherever this
// component's roof geometry is drawn, is never the case on a sawtooth (the
// teeth cover the deck) and is the roof around a clerestory or between
// skylights. So the hook adds nothing where the geometry was drawn, and
// beyond CITY_PROP_RANGE it adds the geometry's exact mean.
//
// "Drawn" is the core's own test: props run for a cell whose ray segment
// starts inside CITY_PROP_RANGE, and that start is where the ray enters the
// hit cell's column, or enters the city slab from above if that is later
// (city_trace's t_cur) — recomputed here from the camera, since the hook is
// not handed the ray.
//
// The sawtooth mean is view-dependent, and exactly so. In the tooth's own
// (s, z) plane a ray descending with slope m = |dz| / |ds| against the
// glazing's facing sees, of each face of height H, the part not hidden by
// the next tooth's rising sheet: min(H, m p). Per tooth pitch p of roof the
// rays that land there span p along s, and those striking glass span that
// visible height over m. So the glass covers a fraction min(H / (m p), 1)
// of the roof as seen along the ray — zero from the facing's back, the whole
// roof at grazing — and the mean emission is that fraction of the face mean.
// A clerestory is the same argument with one long face in view and no
// occluder: its projected strip, length x height x |d_c| / |dz|, over the
// roof's area.
fn cc_industry_roof(cc: CityCell, h: CityHit, fp: f32) -> vec3<f32> {
    if (cc.land_use != CITY_USE_INDUSTRIAL) {
        return vec3<f32>(0.0);
    }
    let r = cc_industry_roof_of(cc);
    if (!r.lit) {
        return vec3<f32>(0.0);
    }
    let o = city_camera_origin();
    let dir = (h.pos - o) / max(h.t, 1e-3);
    let cell = u.ocean_params.x;
    let inv = vec3<f32>(select(1e30, 1.0 / dir.x, abs(dir.x) > 1e-9),
                        select(1e30, 1.0 / dir.y, abs(dir.y) > 1e-9),
                        select(1e30, 1.0 / dir.z, abs(dir.z) > 1e-9));
    let cmin = vec3<f32>(vec2<f32>(h.cell) * cell, -1e6);
    let col = city_box_hit(o, inv, cmin, cmin + vec3<f32>(cell, cell, 2e6));
    var t_slab = 0.0;
    if (o.z > CITY_SLAB_TOP) {
        t_slab = (CITY_SLAB_TOP - o.z) * inv.z;
    }
    if (max(col.x, t_slab) < CITY_PROP_RANGE) {
        return vec3<f32>(0.0);
    }
    let dz = max(abs(dir.z), 1e-3);
    if (r.kind == 1) {
        let d_s = r.face * select(dir.y, dir.x, r.step_x);
        if (d_s >= 0.0) {
            return vec3<f32>(0.0);
        }
        let frac = min(r.rise * (-d_s) / (dz * r.pitch), 1.0);
        return cc_industry_glaze_mean(r, r.rise)
               * (frac * cc_industry_GLAZE_MEAN_COMP);
    }
    if (r.kind == 2) {
        let long_x = (r.mhi.x - r.mlo.x) >= (r.mhi.y - r.mlo.y);
        let len = select(r.mhi.y - r.mlo.y, r.mhi.x - r.mlo.x, long_x);
        let d_c = abs(select(dir.x, dir.y, long_x));
        let hm = r.mhi.z - cc.height;
        let area = (cc.b1max.x - cc.b1min.x) * (cc.b1max.y - cc.b1min.y);
        // Unlike a sawtooth's, a lone clerestory face has no next tooth to
        // hide it, and its projection can outgrow the roof it is averaged
        // over; the cap only stops a grazing ray from turning a sliver of
        // roof into a searchlight.
        let frac = min(len * hm * d_c / (dz * area), 3.0);
        return cc_industry_glaze_mean(r, hm)
               * (frac * cc_industry_GLAZE_MEAN_COMP);
    }
    let g = cc_industry_sky_grid(cc);
    if (!g.ok) {
        return vec3<f32>(0.0);
    }
    let garea = f32(g.n.x * g.n.y) * g.cell.x * g.cell.y;
    let area = (cc.b1max.x - cc.b1min.x) * (cc.b1max.y - cc.b1min.y);
    return cc_industry_sky_mean(cc, g, r)
           * (cc_industry_GLAZE_MEAN_COMP * garea / area);
}

// ============================================================================
// FIXTURE AND WALL-WASH SHADING
// ============================================================================

// The fixture nearest a hit point: the one whose head it is on.
fn cc_industry_nearest_flood(cc: CityCell, p: vec3<f32>) -> CityFlood {
    var best = city_flood(cc, 0);
    var bd = 1e30;
    for (var k: i32 = 0; k < CITY_FLOOD_MAX; k = k + 1) {
        let f = city_flood(cc, k);
        if (f.on) {
            let d = distance(cc_industry_head_c(cc, f), p);
            if (d < bd) {
                bd = d;
                best = f;
            }
        }
    }
    return best;
}

fn cc_industry_head_shade(h: CityHit, cc: CityCell) -> vec3<f32> {
    let f = cc_industry_nearest_flood(cc, h.pos);
    let c = cc_industry_head_c(cc, f);
    // The footprint at the head, exactly as the trace sized the box.
    let fp = cc_industry_px() * distance(city_camera_origin(), c);
    let real = cc_industry_head_real(cc);
    let hw = cc_industry_head_hw(cc, fp);
    // The lens: the underside, and the lower half of the face toward the
    // aim — a flood is tilted down into its pool. Housing everywhere else.
    let fwd = dot(h.normal.xy, f.aim) > 0.5;
    let lens = h.normal.z < -0.5 || (fwd && h.pos.z < c.z);
    let e_lens = f.color * (cc_industry_LENS_RAD
                            / max(max(f.color.r, f.color.g), f.color.b));
    let housing = 0.06 * cc_industry_fill(h.pos) + 0.02 * f.color;
    let near = select(housing, e_lens, lens);
    // Widened toward a pixel: the whole box glows at the lens's mean over
    // the housing (about half of what is seen), diluted by the area it grew
    // — the sum of its three face areas, so the dilution holds from any
    // side.
    let a_real = real.x * real.y + real.y * real.z + real.x * real.z;
    let a_wide = hw.x * hw.y + hw.y * hw.z + hw.x * hw.z;
    let far = e_lens * (0.5 * a_real / a_wide);
    return mix(near, far, smoothstep(0.6 * real.x / cc_industry_HEAD_WIDEN,
                                     real.x / cc_industry_HEAD_WIDEN, fp));
}

// ============================================================================
// THE WAREHOUSE WALLS (the facade hook)
// ============================================================================
//
// city-facades handed the warehouse walls to this component (2026-09-23):
// the core draws no windows in their ground band and adds no reflectance of
// its own on them, so what a warehouse wall looks like is decided here, at
// every range — the facade hook runs wherever a wall is hit. A wall is:
//
//   * CLADDING: corrugated metal sheet (ribs every 0.2 m, as shading bands,
//     over a concrete plinth the bottom metre) on two thirds of buildings,
//     tilt-up concrete panels 7-9 m wide with their joints on the rest. Real
//     albedo, lit by the skyglow fill, the moon, the court's own wall packs
//     (the scallop each throws down the wall under it), the lamp over each
//     personnel door, and the street lamps where a street runs past.
//   * DOCK DOORS on the court wall, one per dock slot (cc_industry_docks),
//     so they line up with the trailers: sectional doors on the dock floor
//     with a row of vision panels, most dark, a few with light leaking
//     through, and some open onto a lit interior — mostly where a trailer
//     is backed in, on a building working a night shift. The shelters,
//     bumpers and leveller are relief geometry (cc_industry_dock_part); the
//     wall under the shelter is painted in its colour, so at range, where
//     the geometry is no longer traced, the frame is still there.
//   * PERSONNEL DOORS, one or two per other wall, each with a small lamp
//     over it and the lamp's own scallop of light.
//   * A painted company band near the top of some buildings, and grime in
//     the bottom metre.
//
// Every sub-pixel pattern (ribs, panel joints, door seams, vision panels)
// dissolves to its own mean; a dock door past a few metres per pixel is its
// cell's mean emission; a lamp is widened toward a pixel at constant energy.
//
// FACE FRAME. `s` below is metres along the wall from the building box's
// min corner (x or y), computed here from b1. When city-facades' city_face_at
// lands, the hook's `uc` becomes metres from the face's start corner and
// replaces cc_industry_wall_s — the only place the frame is taken. Their
// coming `facade_cover` hook is where the dock and personnel doors should
// also clear the windows and relief under them (today the core's door-band
// cut does that for the windows).

struct cc_industry_Wall {
    concrete: bool,
    alb: vec3<f32>,
    panel_w: f32,        // tilt-up panel width
    band: vec2<f32>,     // painted band's z range (empty: none)
    band_col: vec3<f32>,
    door_col: vec3<f32>,
    shelter: bool,
    lamp_col: vec3<f32>, // the personnel doors' lamps
}

fn cc_industry_wall_of(cc: CityCell) -> cc_industry_Wall {
    var w: cc_industry_Wall;
    let d = cc_industry_draw(cc, 91u, 0, 0);
    let e = cc_industry_draw(cc, 92u, 0, 0);
    w.concrete = d.x < 0.35;
    // Cladding colours, dimmed as they read under a night sky: galvanised
    // grey, beige, the blue-grey and green of profiled sheet, off-white.
    var c = vec3<f32>(0.34, 0.35, 0.36);
    if (d.y > 0.30) { c = vec3<f32>(0.36, 0.33, 0.27); }
    if (d.y > 0.50) { c = vec3<f32>(0.22, 0.27, 0.33); }
    if (d.y > 0.70) { c = vec3<f32>(0.14, 0.21, 0.16); }
    if (d.y > 0.85) { c = vec3<f32>(0.45, 0.45, 0.44); }
    w.alb = select(c, vec3<f32>(0.30, 0.29, 0.27), w.concrete);
    w.panel_w = 7.0 + 2.0 * d.z;
    let top = cc.height - (0.6 + 1.2 * e.x);
    w.band = select(vec2<f32>(1e3, -1e3), vec2<f32>(top - 1.0 - e.y, top),
                    d.w < 0.45);
    var b = vec3<f32>(0.30, 0.05, 0.04);                         // red
    if (e.z > 0.30) { b = vec3<f32>(0.05, 0.12, 0.30); }         // blue
    if (e.z > 0.55) { b = vec3<f32>(0.06, 0.20, 0.09); }         // green
    if (e.z > 0.75) { b = vec3<f32>(0.42, 0.18, 0.03); }         // orange
    if (e.z > 0.90) { b = vec3<f32>(0.45, 0.35, 0.04); }         // yellow
    w.band_col = b;
    var dc = vec3<f32>(0.42, 0.42, 0.41);                        // white
    if (e.w > 0.40) { dc = vec3<f32>(0.24, 0.24, 0.25); }        // grey
    if (e.w > 0.70) { dc = vec3<f32>(0.07, 0.13, 0.28); }        // blue
    if (e.w > 0.90) { dc = vec3<f32>(0.42, 0.30, 0.05); }        // yellow
    w.door_col = dc;
    w.shelter = fract(d.w * 7.13) < 0.60;
    w.lamp_col = select(vec3<f32>(0.80, 0.90, 1.00), vec3<f32>(1.0, 0.60, 0.28),
                        fract(e.x * 5.31) < 0.55);
    return w;
}

// (metres along the wall from the box's min corner, the wall's length) —
// see FACE FRAME above.
fn cc_industry_wall_s(cc: CityCell, p: vec3<f32>, n: vec3<f32>) -> vec2<f32> {
    let ext = cc.b1max.xy - cc.b1min.xy;
    if (abs(n.x) > abs(n.y)) {
        return vec2<f32>(p.y - cc.b1min.y, ext.y);
    }
    return vec2<f32>(p.x - cc.b1min.x, ext.x);
}

// A lamp's scallop of light on the wall below it: narrow at the lamp,
// widening with the drop d; rising over `rise` (the housing shades the wall
// right behind it) and fading over `fade`.
fn cc_industry_wash(d: f32, du: f32, w0: f32, w1: f32, rise: f32,
                    fade: f32) -> f32 {
    if (d <= 0.0) {
        return 0.0;
    }
    let w = w0 + w1 * d;
    return (1.0 - exp(-d / rise)) * exp(-d / fade)
           * exp(-0.5 * du * du / (w * w));
}

// The integral of e^{-k d} (w0 + w1 d) over d in [0, z].
fn cc_industry_wash_int(k: f32, z: f32, w0: f32, w1: f32) -> f32 {
    let e = exp(-k * z);
    return w0 * (1.0 - e) / k + w1 * (1.0 - e * (1.0 + k * z)) / (k * k);
}

// cc_industry_wash's integral over the wall, from a lamp at height z.
fn cc_industry_wash_flux(z: f32, w0: f32, w1: f32, rise: f32, fade: f32)
        -> f32 {
    let kf = 1.0 / fade;
    return 2.5066283 * (cc_industry_wash_int(kf, z, w0, w1)
                        - cc_industry_wash_int(kf + 1.0 / rise, z, w0, w1));
}

// Street light on a wall, in ground-pool units: the core's pools at the
// wall's foot, and past the pools' own footprint LOD their mean along the
// wall — a periodic trapezoid rule over one lamp spacing, which for these
// Gaussians (sigma 3.2 m, 4 samples 6.5 m apart) is good to 2%. Lamp lines
// crossing the wall's line do not vary along it, so the rule holds for
// them trivially.
fn cc_industry_street_wall(p: vec2<f32>, tang: vec2<f32>, fp: f32) -> f32 {
    let near = city_street_pools(p);
    let k = smoothstep(CITY_STREET_LOD_START, CITY_STREET_LOD_FULL, fp);
    let nq = select(0, 4, k > 0.0);
    var m = 0.0;
    for (var q: i32 = 0; q < nq; q = q + 1) {
        m = m + city_street_pools(
            p + tang * (f32(q) * 0.25 * CITY_LAMP_SPACING));
    }
    return mix(near, 0.25 * m, k);
}

// A personnel door on wall `face` (0 -x, 1 +x, 2 -y, 3 +y): (position along
// the wall, lamp on (1) or not (0), present (1) or not (0)).
fn cc_industry_pdoor(cc: CityCell, face: i32, k: i32, len: f32) -> vec3<f32> {
    let dk = cc_industry_draw(cc, 93u, face, k);
    let present = select(len > 12.0, len > 40.0 && dk.x < 0.5, k == 1);
    // Two doors keep to their own halves of the wall.
    let lo = select(3.0, 0.5 * len + 1.0, k == 1);
    let hi = select(select(len - 3.0, 0.5 * len - 1.0, len > 40.0),
                    len - 3.0, k == 1);
    return vec3<f32>(mix(lo, hi, dk.y), select(0.0, 1.0, dk.z < 0.8),
                     select(0.0, 1.0, present));
}

const cc_industry_PDOOR_W: f32 = 1.0;
const cc_industry_PDOOR_H: f32 = 2.1;
const cc_industry_PLAMP_Z: f32 = 2.45;
const cc_industry_PLAMP_R: f32 = 0.10;       // lens radius
const cc_industry_PLAMP_RAD: f32 = 12.0;
const cc_industry_PLAMP_GAIN: f32 = 0.35;    // its wash, in pool units
const cc_industry_OPEN_RAD: f32 = 1.0;       // an open dock door's interior
const cc_industry_LEAK_RAD: f32 = 0.8;       // a vision panel, lit inside
const cc_industry_SEAM_RAD: f32 = 0.25;      // light through a door seam

// A dock door's state: .x open, .y leaking light, .z its level draw.
fn cc_industry_door_state(cc: CityCell, l: cc_industry_Lot, j: i32,
                          lit: bool) -> vec3<f32> {
    let dd = cc_industry_draw(cc, 90u, j, 0);
    // The trailer backed onto this door, by the dock grid's own draw.
    let ts = cc_industry_draw(cc, 20u, select(0, j, l.long_x),
                              select(j, 0, l.long_x));
    let trailer = cc_industry_has_trailers(l) && ts.x < 0.45;
    let open = (lit && trailer && dd.x < 0.55) || dd.x < 0.04;
    let leak = !open && dd.y < select(0.08, 0.35, lit);
    return vec3<f32>(select(0.0, 1.0, open), select(0.0, 1.0, leak), dd.z);
}

// Vision panels in a sectional door: four, 0.4 m square, in the fourth
// section.
fn cc_industry_vision(dv: f32, dz: f32) -> bool {
    let a = abs(dv);
    return dz > 1.90 && dz < 2.30
           && (abs(a - 0.35) < 0.20 || abs(a - 1.05) < 0.20);
}
// Their share of a door's face, and the seams' (5 of 0.03 m).
const cc_industry_VISION_FRAC: f32 = 0.0711;   // 4 x 0.4 x 0.4 / 9
const cc_industry_SEAM_FRAC: f32 = 0.05;       // 5 x 0.03 / 3

// GRAFFITI (city_graffiti_paint). Each wall of a warehouse is a run, u from
// its left end as you stand facing it, v from the ground: the court wall
// (CITY_GRAFFITI_WALL_COURT) and the others (WALL_STREET), the personnel
// doors and the dock wall under the dock doors painted with the wall they
// are in. A closed dock door is a run of its own (CITY_GRAFFITI_DOOR), v
// from the dock floor its painter stands on; an open one is rolled up, and
// its paint with it.
fn cc_industry_wall_run(cc: CityCell, face: i32, len: f32, court: bool)
        -> CityGraffitiRun {
    var run: CityGraffitiRun;
    run.seed = pcg2d(cc.seed ^ vec2<u32>(0x5bd1e995u,
                                         u32(face) * 0x9e3779b9u + 0x27d4eb2fu));
    run.len = len;
    run.kind = select(CITY_GRAFFITI_WALL_STREET, CITY_GRAFFITI_WALL_COURT,
                      court);
    return run;
}

fn cc_industry_door_run(cc: CityCell, j: i32) -> CityGraffitiRun {
    var run: CityGraffitiRun;
    run.seed = pcg2d(cc.seed ^ vec2<u32>(u32(j) * 0x85ebca6bu + 0x68e31da4u,
                                         0xb5297a4du));
    run.len = cc_industry_DOOR_W;
    run.kind = CITY_GRAFFITI_DOOR;
    return run;
}

fn cc_industry_paint(alb: vec3<f32>, g: CityGraffitiPaint) -> vec3<f32> {
    return alb * g.keep + g.add;
}

// Whether there is paint here at all. Off the paint a surface is what it
// was before graffiti, to the bit: where folding the paint in reorders the
// surface's own products, the owner keeps its old expression for the
// unpainted case (alb * 1 + 0 is exact; a regrouped sum is not).
fn cc_industry_painted(g: CityGraffitiPaint) -> bool {
    return g.keep != 1.0 || any(g.add != vec3<f32>(0.0));
}

// The frame a wall's paint is taken in: (u from its left end, its length).
fn cc_industry_wall_u(cc: CityCell, p: vec3<f32>, n: vec3<f32>) -> vec2<f32> {
    let ws = cc_industry_wall_s(cc, p, n);
    let along = select(vec2<f32>(1.0, 0.0), vec2<f32>(0.0, 1.0),
                       abs(n.x) > abs(n.y));
    return vec2<f32>(select(ws.y - ws.x, ws.x,
                            dot(vec2<f32>(-n.y, n.x), along) > 0.0), ws.y);
}

// A dock door on the court wall at p: (door index, offset from its centre
// along the wall's u, in its face (1) or not (0)) — the doors' own test in
// cc_industry_facade, and their state's, so the paint picks the run the
// door section will show.
fn cc_industry_door_at(cc: CityCell, l: cc_industry_Lot, p: vec3<f32>,
                       vc: f32, tang: vec2<f32>) -> vec3<f32> {
    let docks = cc_industry_docks(l);
    let a = select(p.y, p.x, l.long_x);
    let jf = round((a - docks.x) / cc_industry_DOCK_PITCH);
    let j = i32(jf);
    let dv = a - (docks.x + jf * cc_industry_DOCK_PITCH);
    let du = dot(tang, select(vec2<f32>(0.0, 1.0), vec2<f32>(1.0, 0.0),
                              l.long_x)) * dv;
    let in_face = j >= 0 && j < i32(docks.y)
        && abs(dv) < 0.5 * cc_industry_DOOR_W && vc > cc_industry_DOCK_H
        && vc < cc_industry_DOCK_H + cc_industry_DOOR_H;
    return vec3<f32>(jf, du, select(0.0, 1.0, in_face));
}

// The pixel's paint: a closed dock door's own where the pixel is on one,
// the wall's everywhere else. Taken first thing in cc_industry_facade, one
// paint a pixel, while little else is live: taken after the wall's look
// and the doors', it raised the city's first stage from 128 registers
// (16 warps an SM, some spilled) to 168 (12 warps) in the binary wgpu builds
// (perf's tools/soar_regcount.py, 2026-11-09), which cost every city pixel.
fn cc_industry_wall_graffiti(cc: CityCell, h: CityHit, dir: vec3<f32>,
                             vc: f32, fp: f32, court: bool, face: i32)
        -> CityGraffitiPaint {
    let n = h.normal;
    let tang = vec2<f32>(-n.y, n.x);
    let fuv = city_graffiti_footprint(fp, n, dir, vec3<f32>(tang, 0.0),
                                      vec3<f32>(0.0, 0.0, 1.0));
    let wu = cc_industry_wall_u(cc, h.pos, n);
    var run = cc_industry_wall_run(cc, face, wu.y, court);
    var u = wu.x;
    var v = vc;
    if (court) {
        let l = cc_industry_lot(cc);
        let dd = cc_industry_door_at(cc, l, h.pos, vc, tang);
        if (dd.z > 0.5) {
            let j = i32(dd.x);
            let st = cc_industry_door_state(cc, l, j,
                                            cc_industry_roof_of(cc).lit);
            if (st.x < 0.5) {
                run = cc_industry_door_run(cc, j);
                u = dd.y + 0.5 * cc_industry_DOOR_W;
                v = vc - cc_industry_DOCK_H;
            }
        }
    }
    return city_graffiti_paint(run, u, v, fuv);
}

fn cc_industry_facade(cc: CityCell, h: CityHit, dir: vec3<f32>, uc: f32,
                      vc: f32, fp: f32) -> vec3<f32> {
    if (cc.land_use != CITY_USE_INDUSTRIAL) {
        return vec3<f32>(0.0);
    }
    let n = h.normal;
    let l = cc_industry_lot(cc);
    let out = cc_industry_xy(l, vec2<f32>(0.0, select(-1.0, 1.0, l.court_hi)));
    let court = dot(n.xy, out) > 0.9;
    let face = select(select(2, 3, n.y > 0.0), select(0, 1, n.x > 0.0),
                      abs(n.x) > abs(n.y));
    // The paint first (cc_industry_wall_graffiti): applied below, over the
    // wall's grime or a closed door's face.
    let pnt = cc_industry_wall_graffiti(cc, h, dir, vc, fp, court, face);
    let w = cc_industry_wall_of(cc);
    let tang = vec2<f32>(-n.y, n.x);
    let ws = cc_industry_wall_s(cc, h.pos, n);
    let sw = ws.x;

    // --- cladding ------------------------------------------------------------
    var alb = w.alb;
    if (w.concrete) {
        let pi = floor(sw / w.panel_w);
        let tone = 0.90 + 0.20 * hash12(vec2<f32>(pi, f32(face) * 17.0
                                                   + f32(cc.seed.x & 1023u)));
        let fj = fract(sw / w.panel_w) * w.panel_w;
        let joint = select(1.0, 0.45, fj < 0.025 || fj > w.panel_w - 0.025);
        alb = alb * (tone * cc_industry_band(
            joint, 1.0 - 0.05 / w.panel_w * 0.55, 0.05, fp));
    } else {
        let rib = 0.78 + 0.44 * (0.5 + 0.5 * cos(6.2831853 * sw / 0.2));
        alb = alb * cc_industry_band(rib, 1.0, 0.1, fp);
        // The sheets' side laps, one per 1 m cover width: the rhythm that
        // still reads once the ribs have gone to their mean.
        let lap = select(1.0, 0.55, fract(sw) < 0.04);
        alb = alb * cc_industry_band(lap, 1.0 - 0.04 * 0.45, 0.04, fp);
        if (vc < 1.0) {
            alb = vec3<f32>(0.26, 0.25, 0.23);          // concrete plinth
        }
    }
    if (vc > w.band.x && vc < w.band.y) {
        alb = w.band_col * (alb / max(w.alb, vec3<f32>(1e-3)));
    }
    alb = alb * (0.6 + 0.4 * smoothstep(0.0, 1.0, vc));   // grime
    // The eave flashing: a 0.3 m band of trim along the top of the wall.
    if (vc > cc.height - 0.3) {
        alb = alb * 0.55;
    }

    // --- doors ---------------------------------------------------------------
    var emit = vec3<f32>(0.0);
    var light = vec3<f32>(0.0);
    let r = cc_industry_roof_of(cc);
    if (court) {
        let docks = cc_industry_docks(l);
        let a = select(h.pos.y, h.pos.x, l.long_x);
        let jf = round((a - docks.x) / cc_industry_DOCK_PITCH);
        let j = i32(jf);
        let dv = a - (docks.x + jf * cc_industry_DOCK_PITCH);
        let top = cc_industry_DOCK_H + cc_industry_DOOR_H;
        let hd = 0.5 * cc_industry_DOOR_W;
        if (j >= 0 && j < i32(docks.y)) {
            let st = cc_industry_door_state(cc, l, j, r.lit);
            let in_door = abs(dv) < hd && vc > cc_industry_DOCK_H && vc < top;
            let dz = vc - cc_industry_DOCK_H;
            // The door's own look, and its emission.
            var d_alb = w.door_col;
            var d_emit = vec3<f32>(0.0);
            let seam = fract(dz / 0.6) * 0.6 < 0.03;
            let vis = cc_industry_vision(dv, dz);
            let level = 0.55 + 0.45 * st.z;
            if (st.x > 0.5) {
                // Open: the lit interior, the dock floor's lip at its foot.
                d_alb = vec3<f32>(0.02);
                d_emit = r.tint * (cc_industry_OPEN_RAD * level
                                   * smoothstep(0.0, 0.3, dz));
            } else {
                d_alb = d_alb * cc_industry_band(
                    select(1.0, 0.45, seam), 1.0 - 0.55 * cc_industry_SEAM_FRAC,
                    0.03, fp);
                if (vis) {
                    d_alb = vec3<f32>(0.04);
                }
                if (st.y > 0.5) {
                    let pat = select(0.0, cc_industry_LEAK_RAD, vis)
                        + cc_industry_band(select(0.0, cc_industry_SEAM_RAD,
                                                  seam),
                                           cc_industry_SEAM_RAD
                                           * cc_industry_SEAM_FRAC, 0.03, fp);
                    d_emit = r.tint * (level * pat);
                }
            }
            // The door's mean over its face, for the far field below.
            let d_mean = select(
                r.tint * (level * st.y * (cc_industry_LEAK_RAD
                                          * cc_industry_VISION_FRAC
                                          + cc_industry_SEAM_RAD
                                          * cc_industry_SEAM_FRAC)),
                r.tint * (cc_industry_OPEN_RAD * level * 0.95), st.x > 0.5);
            // The frame around it: the shelter's fabric where there is one
            // (under its geometry close in, standing in for it far out), a
            // steel jamb where not; the dock wall under the door.
            let rim = select(0.15, 0.50, w.shelter);
            let in_rim = abs(dv) < hd + rim && vc > 1.0
                         && vc < top + select(0.15, 0.75, w.shelter);
            var p_alb = alb;
            if (in_rim) {
                p_alb = select(vec3<f32>(0.10), vec3<f32>(0.035), w.shelter);
            }
            if (abs(dv) < hd + rim && vc <= cc_industry_DOCK_H) {
                p_alb = vec3<f32>(0.12);
            }
            var p_emit = vec3<f32>(0.0);
            // The paint: a closed door's own on its face (an open door is
            // rolled up, and its paint with it), the wall's on everything
            // else, the shelter and the dock wall included.
            let closed = st.x < 0.5;
            if (in_door) {
                p_alb = select(d_alb, cc_industry_paint(d_alb, pnt), closed);
                p_emit = d_emit;
            } else {
                p_alb = cc_industry_paint(p_alb, pnt);
            }
            // Past a few metres per pixel a door is its dock cell's mean.
            let k = smoothstep(1.0, 3.0, fp);
            if (vc > cc_industry_DOCK_H && vc < top) {
                let fd = cc_industry_DOOR_W / cc_industry_DOCK_PITCH;
                let fr = 2.0 * rim / cc_industry_DOCK_PITCH;
                let rim_alb = select(vec3<f32>(0.10), vec3<f32>(0.035),
                                     w.shelter);
                var far_alb = w.door_col * fd + rim_alb * fr
                              + alb * (1.0 - fd - fr);
                if (k > 0.0) {
                    // The paint over the cell: the door's mean over its
                    // share (a closed door's), and over the rest the wall's
                    // — the pixel's own where it is on the wall, so the
                    // band and the wall under it carry the same paint, and
                    // the wall run's mean where the pixel is on a closed
                    // door and has none of the wall's to give.
                    let fv = city_graffiti_footprint(
                        fp, n, dir, vec3<f32>(tang, 0.0),
                        vec3<f32>(0.0, 0.0, 1.0)).y;
                    var dm = CityGraffitiPaint(1.0, vec3<f32>(0.0));
                    var pm = pnt;
                    if (closed) {
                        dm = city_graffiti_mean(cc_industry_door_run(cc, j),
                                                dz, fv);
                        if (in_door) {
                            pm = city_graffiti_mean(
                                cc_industry_wall_run(cc, face, ws.y, court),
                                vc, fv);
                        }
                    }
                    if (cc_industry_painted(dm) || cc_industry_painted(pm)) {
                        far_alb = cc_industry_paint(w.door_col, dm) * fd
                            + (rim_alb * fr + alb * (1.0 - fd - fr)) * pm.keep
                            + pm.add * (1.0 - fd);
                    }
                }
                alb = mix(p_alb, far_alb, k);
                emit = mix(p_emit, d_mean * fd, k);
            } else {
                alb = p_alb;
            }
        } else {
            alb = cc_industry_paint(alb, pnt);
        }
        // The court's wall packs, each washing the wall under it.
        let k_far = smoothstep(CITY_STREET_LOD_START, CITY_STREET_LOD_FULL, fp);
        var near = vec3<f32>(0.0);
        var flux = vec3<f32>(0.0);
        for (var q: i32 = 0; q < CITY_FLOOD_MAX; q = q + 1) {
            let f = city_flood(cc, q);
            if (!f.on) {
                continue;
            }
            let gain = f.color * cc_industry_WASH_GAIN;
            near = near + gain * cc_industry_wash(
                f.head.z - vc, dot(h.pos.xy - f.head.xy, tang),
                cc_industry_WASH_W0, cc_industry_WASH_W1,
                cc_industry_WASH_RISE, cc_industry_WASH_FADE);
            flux = flux + gain * cc_industry_wash_flux(
                f.head.z, cc_industry_WASH_W0, cc_industry_WASH_W1,
                cc_industry_WASH_RISE, cc_industry_WASH_FADE);
        }
        light = mix(near, flux / (ws.y * cc.height), k_far);
    } else {
        // Personnel doors, each with its lamp and the lamp's own wash.
        let k_far = smoothstep(CITY_STREET_LOD_START, CITY_STREET_LOD_FULL, fp);
        var near = vec3<f32>(0.0);
        var flux = vec3<f32>(0.0);
        let np = select(0, 2, ws.y > 12.0);
        for (var q: i32 = 0; q < np; q = q + 1) {
            let pd = cc_industry_pdoor(cc, face, q, ws.y);
            if (pd.z < 0.5) {
                continue;
            }
            let ds = sw - pd.x;
            let hw = 0.5 * cc_industry_PDOOR_W;
            if (abs(ds) < hw && vc < cc_industry_PDOOR_H) {
                alb = vec3<f32>(0.10) * select(1.0, 0.6,
                                               abs(ds) > hw - 0.06);
            } else if (abs(ds) < hw + 0.08 && vc < cc_industry_PDOOR_H + 0.08) {
                alb = vec3<f32>(0.06);                     // the frame
            }
            if (pd.y > 0.5) {
                let col = w.lamp_col;
                // The lens, widened toward a pixel at constant energy.
                let sg = max(cc_industry_PLAMP_R, 0.35 * fp);
                let kk = (cc_industry_PLAMP_R * cc_industry_PLAMP_R)
                         / (sg * sg);
                let dz = vc - cc_industry_PLAMP_Z;
                emit = emit + col * (cc_industry_PLAMP_RAD * kk
                    * exp(-0.5 * (ds * ds + dz * dz) / (sg * sg)));
                let gain = col * cc_industry_PLAMP_GAIN;
                near = near + gain * cc_industry_wash(
                    cc_industry_PLAMP_Z - vc, ds, 0.3, 0.5, 0.15, 1.6);
                flux = flux + gain * cc_industry_wash_flux(
                    cc_industry_PLAMP_Z, 0.3, 0.5, 0.15, 1.6);
            }
        }
        light = mix(near, flux / (ws.y * cc.height), k_far);
        alb = cc_industry_paint(alb, pnt);
    }

    // --- light ---------------------------------------------------------------
    let district = city_glow_sample(h.pos.xy, 2.0);
    let raw = CITY_LAMP_RADIANCE * (0.20 + 1.3 * smoothstep(0.02, 0.45, district))
              * cc_industry_street_wall(h.pos.xy, tang, fp);
    // Street lamps stand 9 m tall and throw down: their light on a wall
    // fades out above their heads rather than running up to the eaves.
    light = light + CITY_LAMP_COLOR * (0.35 * raw / (1.0 + raw * 0.30)
                                       * smoothstep(11.0, 5.0, vc));
    let lamp = (alb / cc_industry_ALB_REF) * light;
    let refl = lamp / (vec3<f32>(1.0) + lamp / cc_industry_LAMP_KNEE)
               + alb * (cc_industry_fill(h.pos)
                        + CITY_MOONLIGHT * max(dot(n, u.sun_dir.xyz), 0.0));
    return refl + emit;
}

// Dock hardware: black fabric shelters, black rubber bumpers, a steel lip.
fn cc_industry_dock_shade(h: CityHit, cc: CityCell, s: cc_industry_Slot)
        -> vec3<f32> {
    let fwd = cc_industry_fwd(s.front);
    let v = abs(fwd.x * (h.pos.y - s.ctr.y) - fwd.y * (h.pos.x - s.ctr.x));
    var alb = vec3<f32>(0.035);
    if (h.pos.z <= cc_industry_DOCK_H + 0.001 && v < 1.0) {
        alb = vec3<f32>(0.14);
    }
    return cc_industry_lit(cc, h.pos, h.normal, alb);
}

// ============================================================================
// PROP SHADING
// ============================================================================

// The object a hit landed on: its grid's slot, re-derived from the lot so
// nothing is smuggled through CityHit. A grid of the right kind must hold a
// filled slot whose object contains the point — grids may share ground (a
// forklift works an empty dock slot), objects never do. The dispatcher
// finds it once and hands it to whichever shader needs it.
struct cc_industry_Slot {
    ok: bool,
    ctr: vec2<f32>,
    d: vec4<f32>,
    obj: vec2<f32>,
    front: i32,
}

fn cc_industry_find(cc: CityCell, p: vec3<f32>, kind: i32)
        -> cc_industry_Slot {
    var s: cc_industry_Slot;
    s.ok = false;
    s.ctr = p.xy;
    s.d = vec4<f32>(0.0);
    s.obj = vec2<f32>(1.0);
    s.front = 0;
    let ng = select(0, cc_industry_N_GRIDS,
                    cc.land_use == CITY_USE_INDUSTRIAL
                    || cc.land_use == CITY_USE_YARD);
    for (var i: i32 = 0; i < ng; i = i + 1) {
        let g = cc_industry_grid(cc, i);
        if (!g.ok || g.kind != kind) {
            continue;
        }
        let rel = p.xy - g.lo.xy;
        let ij = clamp(vec2<i32>(floor(rel / g.cell)), vec2<i32>(0), g.n - 1);
        let ctr = g.lo.xy + (vec2<f32>(ij) + 0.5) * g.cell;
        let d = cc_industry_slot_draw(cc, g, ij);
        let hgt = cc_industry_slot_h(g, d);
        if (hgt > 0.0 && all(abs(p.xy - ctr) < 0.5 * g.obj + 0.05)
            && p.z < g.lo.z + hgt + 0.05) {
            s.ok = true;
            s.ctr = ctr;
            s.d = d;
            s.obj = g.obj;
            s.front = g.front;
            return s;
        }
    }
    return s;
}

fn cc_industry_box_color(x: f32) -> vec3<f32> {
    // Weathered container liveries, dimmed: rust red and the shipping
    // lines' blues most, then grey, green, white, orange, brown.
    if (x < 0.24) { return vec3<f32>(0.30, 0.08, 0.05); }
    if (x < 0.44) { return vec3<f32>(0.07, 0.13, 0.28); }
    if (x < 0.58) { return vec3<f32>(0.20, 0.20, 0.20); }
    if (x < 0.70) { return vec3<f32>(0.08, 0.20, 0.11); }
    if (x < 0.82) { return vec3<f32>(0.45, 0.45, 0.42); }
    if (x < 0.92) { return vec3<f32>(0.40, 0.16, 0.04); }
    return vec3<f32>(0.20, 0.11, 0.06);
}

// Weathering on a painted steel side, as an albedo multiplier: rust
// streaks bleeding down from the roof rail (a third of the 0.9 m cells, of
// hashed width and length, redder than the paint), grime darkening the
// bottom 0.9 m where the yard's dust sits, and a paint level that varies
// panel to panel (2.4 m). `u` runs along the face, `zt` is height in the
// box, `hgt` its height, `seed` the box's own draw. Dissolves to
// WEATHER_MEAN, the pattern's own average, as the streaks go sub-pixel.
fn cc_industry_weather(u: f32, zt: f32, hgt: f32, seed: f32, fp: f32)
        -> vec3<f32> {
    let r = hash22(vec2<f32>(floor(u / 0.9), seed * 97.0));
    let x = fract(u / 0.9);
    let w = 0.15 + 0.35 * r.y;
    let len = 0.4 + 1.8 * r.x;
    let depth = hgt - zt;
    var streak = 0.0;
    if (r.x < 0.35 && abs(x - 0.5) < 0.5 * w && depth < len) {
        streak = (1.0 - depth / len) * (0.5 + 0.5 * r.x);
    }
    let rust = vec3<f32>(1.0) - streak * 0.6
               * (vec3<f32>(1.0) - vec3<f32>(1.0, 0.62, 0.45));
    let dirt = 0.78 + 0.22 * smoothstep(0.0, 0.9, zt);
    let panel = 0.88 + 0.24 * hash12(vec2<f32>(floor(u / 2.4), seed * 53.0));
    return mix(rust * (dirt * panel), cc_industry_WEATHER_MEAN,
               smoothstep(0.08, 0.4, fp));
}

// A container roof: shallow transverse corrugation every 0.5 m, two dents
// as local shading hollows at spots the box's draw picks (periodic swells
// read as stripes, not dents), and a fifth of its 1.2 m panels carrying a
// dark wet rust patch; the whole deck dirtier than the sides. Dissolves to
// ROOF_MEAN.
fn cc_industry_box_roof(lu: f32, lv: f32, seed: f32, fp: f32) -> vec3<f32> {
    let rib = 0.85 + 0.30 * (0.5 + 0.5 * cos(6.2831853 * lu / 0.5));
    let rib_k = cc_industry_band(rib, 1.0, 0.25, fp);
    let span = vec2<f32>(cc_industry_BOX_L - 2.0, cc_industry_BOX_W - 1.0);
    let c1 = (fract(seed * vec2<f32>(13.7, 29.1)) - 0.5) * span;
    let c2 = (fract(seed * vec2<f32>(41.3, 57.9)) - 0.5) * span;
    let q = vec2<f32>(lu, lv);
    let d1 = dot(q - c1, q - c1) / (2.0 * 0.8 * 0.8);
    let d2 = dot(q - c2, q - c2) / (2.0 * 0.6 * 0.6);
    let dent = (1.0 - 0.25 * exp(-d1)) * (1.0 - 0.18 * exp(-d2));
    let pr = hash12(vec2<f32>(floor(lu / 1.2), seed * 71.0));
    let rust = select(vec3<f32>(1.0), vec3<f32>(0.70, 0.55, 0.45), pr < 0.2);
    let pat = rust * (rib_k * dent * 0.85);
    return mix(pat, cc_industry_ROOF_MEAN, smoothstep(0.3, 1.2, fp));
}

// Graffiti on a container side (city_graffiti_paint): each face of a box
// standing on the yard is a run of its own, u from the face's left end as
// you stand facing it, v from the yard; a box up the stack is out of reach.
fn cc_industry_box_graffiti(h: CityHit, cc: CityCell, s: cc_industry_Slot,
                            dir: vec3<f32>, fp: f32, zt: f32)
        -> CityGraffitiPaint {
    let n = h.normal.xy;
    let tang = vec2<f32>(-n.y, n.x);
    let half = 0.5 * dot(abs(tang), s.obj);
    let face = select(select(2u, 3u, n.y > 0.0), select(0u, 1u, n.x > 0.0),
                      abs(n.x) > abs(n.y));
    var run: CityGraffitiRun;
    run.seed = pcg2d(cc.seed ^ vec2<u32>(bitcast<u32>(s.ctr.x),
                                         bitcast<u32>(s.ctr.y)
                                         + face * 0x9e3779b9u));
    run.len = 2.0 * half;
    run.kind = CITY_GRAFFITI_CONTAINER;
    let fuv = city_graffiti_footprint(fp, h.normal, dir, vec3<f32>(tang, 0.0),
                                      vec3<f32>(0.0, 0.0, 1.0));
    return city_graffiti_paint(run, dot(h.pos.xy - s.ctr, tang) + half, zt,
                               fuv);
}

fn cc_industry_container_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let tier = floor(max(h.pos.z - 1e-3, 0.0) / cc_industry_TIER);
    let zt = h.pos.z - tier * cc_industry_TIER;
    // The paint first, while little else is live (see
    // cc_industry_wall_graffiti): a side of a box on the yard.
    var g = CityGraffitiPaint(1.0, vec3<f32>(0.0));
    if (tier < 0.5 && abs(h.normal.z) < 0.5) {
        g = cc_industry_box_graffiti(h, cc, s, dir, fp, zt);
    }
    let hc = fract(s.d.w * 7.31 + tier * 0.618);
    let col = cc_industry_box_color(hc);
    let long_x = s.obj.x > s.obj.y;
    let lu = select(h.pos.y - s.ctr.y, h.pos.x - s.ctr.x, long_x);
    let lv = select(h.pos.x - s.ctr.x, h.pos.y - s.ctr.y, long_x);
    let n_long = select(h.normal.y, h.normal.x, long_x);
    var m = 1.0;
    if (abs(h.normal.z) < 0.5) {
        if (abs(n_long) < 0.5) {
            // A long side: trapezoidal corrugation, and the corner posts.
            let rib = 0.78 + 0.44 * (0.5 + 0.5 * cos(6.2831853 * lu / 0.28));
            m = cc_industry_band(rib, 1.0, 0.14, fp);
            m = m * cc_industry_band(
                select(1.0, 0.70,
                       abs(lu) > 0.5 * cc_industry_BOX_L - 0.16),
                0.99, 0.16, fp);
        } else if ((n_long > 0.0) == (hc < 0.5)) {
            // The door end: centre seam and four locking bars.
            var p = select(1.0, 0.25, abs(lv) < 0.02);
            let b = min(abs(abs(lv) - 0.30), abs(abs(lv) - 0.90));
            p = select(p, 1.45, b < 0.03);
            p = p * select(1.0, 0.75, zt > cc_industry_TIER - 0.25);
            m = cc_industry_band(p, 0.98, 0.03, fp);
        } else {
            let rib = 0.80 + 0.40 * (0.5 + 0.5 * cos(6.2831853 * lv / 0.28));
            m = cc_industry_band(rib, 1.0, 0.14, fp);
        }
        // Top and bottom rails, and the dark seam between stacked boxes.
        var rail = select(1.0, 0.65,
                          zt < 0.12 || zt > cc_industry_TIER - 0.10);
        rail = select(rail, 0.20, zt < 0.03 && tier > 0.0);
        m = m * cc_industry_band(rail, 0.93, 0.10, fp);
        let wu = select(lu, lv, abs(n_long) > 0.5);
        // The paint goes on over the weathered side, and the corrugation
        // and rails shade through it.
        let wt = cc_industry_weather(wu, zt, cc_industry_TIER, hc, fp);
        var side = col * m * wt;
        if (cc_industry_painted(g)) {
            side = cc_industry_paint(col * wt, g) * m;
        }
        return cc_industry_lit(cc, h.pos, h.normal, side);
    }
    // The top of the stack, or a box seen from above.
    return cc_industry_lit(cc, h.pos, h.normal,
                           col * cc_industry_box_roof(lu, lv, hc, fp));
}

fn cc_industry_trailer_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, fp: f32)
        -> vec3<f32> {
    if (h.pos.z < cc_industry_TRL_DECK - 0.01) {
        // Running gear: tyres, legs, rails — near-black.
        return cc_industry_lit(cc, h.pos, h.normal, vec3<f32>(0.03));
    }
    var col = vec3<f32>(0.38, 0.38, 0.36);             // white box van
    if (s.d.z > 0.55) { col = vec3<f32>(0.24, 0.24, 0.25); }
    if (s.d.z > 0.75) { col = vec3<f32>(0.07, 0.12, 0.26); }
    if (s.d.z > 0.85) { col = vec3<f32>(0.28, 0.06, 0.05); }
    if (s.d.z > 0.95) { col = vec3<f32>(0.08, 0.18, 0.10); }
    let fwd = cc_industry_fwd(s.front);
    let u = dot(h.pos.xy - s.ctr, fwd);
    let z = h.pos.z;
    var m = 1.0;
    if (abs(h.normal.z) < 0.5) {
        // Rub rail along the foot of the body, the roof rail, and the
        // vertical side posts; the rear doors' seam and bars at -u.
        var p = select(1.0, 0.55,
                       z < cc_industry_TRL_DECK + 0.18
                       || z > cc_industry_TRL_H - 0.08);
        if (abs(dot(h.normal.xy, fwd)) < 0.5) {
            p = p * select(1.0, 0.85, fract(u / 1.2) < 0.05);
        } else if (dot(h.normal.xy, fwd) < 0.0) {
            let lv = fwd.x * (h.pos.y - s.ctr.y) - fwd.y * (h.pos.x - s.ctr.x);
            p = p * select(1.0, 0.3, abs(lv) < 0.02);
            p = p * select(1.0, 1.35, abs(abs(lv) - 0.62) < 0.03);
        }
        m = cc_industry_band(p, 0.92, 0.06, fp);
        let wu = u + dot(h.pos.xy - s.ctr, vec2<f32>(-fwd.y, fwd.x));
        return cc_industry_lit(
            cc, h.pos, h.normal,
            col * m * cc_industry_weather(
                wu, z - cc_industry_TRL_DECK,
                cc_industry_TRL_H - cc_industry_TRL_DECK, s.d.w, fp));
    }
    // The roof: bows every 0.6 m under a grey film of road grime, heavier
    // toward the nose where the tractor's exhaust lands.
    let bow = cc_industry_band(select(1.0, 0.8, fract(u / 0.6) < 0.08),
                               0.984, 0.05, fp);
    let grime = 0.72 + 0.12 * smoothstep(-6.8, 6.8, -u);
    return cc_industry_lit(cc, h.pos, h.normal, col * (bow * grime));
}

fn cc_industry_pallet_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, fp: f32) -> vec3<f32> {
    let wood = vec3<f32>(0.34, 0.27, 0.18) * (0.7 + 0.5 * s.d.z);
    var m = 1.0;
    if (abs(h.normal.z) < 0.5) {
        // Each pallet: a deck board over three blocks; between the blocks
        // the dark fork openings.
        let fz = fract(h.pos.z / cc_industry_PALLET_H);
        let lat = select(h.pos.x - s.ctr.x, h.pos.y - s.ctr.y,
                         abs(h.normal.x) > 0.5);
        let half_w = 0.5 * select(s.obj.x, s.obj.y,
                                  abs(h.normal.x) > 0.5);
        let q = abs(lat) / half_w;
        let block = q > 0.84 || q < 0.12;
        let p = select(1.0, 0.12, fz < 0.72 && !block);
        m = cc_industry_band(p, 0.55, 0.08, fp);
    }
    return cc_industry_lit(cc, h.pos, h.normal, wood * m);
}

fn cc_industry_rebar_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, fp: f32) -> vec3<f32> {
    let rust = vec3<f32>(0.20, 0.09, 0.05) * (0.8 + 0.4 * s.d.z);
    // Bars run along the bundle's long axis; across it, the bar pitch.
    let long_x = s.obj.x > s.obj.y;
    let lat = select(h.pos.x, h.pos.y, long_x);
    let along_n = abs(select(h.normal.y, h.normal.x, long_x)) > 0.5;
    var p = 0.75 + 0.5 * (0.5 + 0.5 * cos(6.2831853 * lat / 0.032));
    if (along_n) {
        // A bundle's end: the bar ends, bright dots on shadow.
        let e = fract(vec2<f32>(lat, h.pos.z) / 0.032) - 0.5;
        p = select(0.35, 1.3, dot(e, e) < 0.12);
    }
    let m = cc_industry_band(p, 0.95, 0.03, fp);
    return cc_industry_lit(cc, h.pos, h.normal, rust * m);
}

fn cc_industry_skip_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, fp: f32) -> vec3<f32> {
    var col = vec3<f32>(0.07, 0.16, 0.09);
    if (s.d.w > 0.45) { col = vec3<f32>(0.38, 0.26, 0.03); }
    if (s.d.w > 0.75) { col = vec3<f32>(0.25, 0.07, 0.04); }
    // Vertical stiffening ribs every 0.9 m, and a rolled top rim.
    let along = select(h.pos.y, h.pos.x, abs(h.normal.y) > 0.5);
    var p = select(1.0, 0.65, fract(along / 0.9) < 0.1);
    p = p * select(1.0, 1.25, h.pos.z > cc_industry_SKIP_H - 0.12);
    let m = cc_industry_band(p, 0.97, 0.09, fp);
    return cc_industry_lit(cc, h.pos, h.normal, col * m);
}

// Refuse and rubble share one texture: irregular fragments — the cells of a
// Voronoi lattice, so chunks are polygons, not tiles — each its own material
// (soil, broken concrete, brick, a dark void, or the heap's own tint: timber
// and plaster in a skip) on its own tilted facet, with a dark crack where two
// fragments meet. The lattice is taken in a plane sheared by height so a
// heap's flanks are not stretched. A first cut on a square lattice read as a
// quilted dome; one spanning albedo 0.04 to 0.26 read as a checkerboard.
fn cc_industry_rubble(h: CityHit, cc: CityCell, fp: f32, cell: f32,
                      tint: vec3<f32>) -> vec3<f32> {
    let q = (h.pos.xy + vec2<f32>(0.6, -0.4) * h.pos.z) / cell;
    let qi = floor(q);
    var d1 = 1e9;
    var d2 = 1e9;
    var id = qi;
    // The 3x3 neighbourhood, behind a bound the compiler cannot fold (a
    // literal one is unrolled into the monolithic kernel's register file).
    let nn = select(9, 0, fp > 1e6);
    for (var k: i32 = 0; k < nn; k = k + 1) {
        let c = qi + vec2<f32>(f32(k % 3 - 1), f32(k / 3 - 1));
        let d = distance(q, c + hash22(c));
        if (d < d1) {
            d2 = d1;
            d1 = d;
            id = c;
        } else if (d < d2) {
            d2 = d;
        }
    }
    let r = hash22(id + vec2<f32>(0.37, 0.71));
    var alb_frag = vec3<f32>(0.10, 0.08, 0.06);                 // soil
    if (r.x < 0.62) { alb_frag = vec3<f32>(0.15, 0.14, 0.12); } // concrete
    if (r.x < 0.40) { alb_frag = vec3<f32>(0.16, 0.08, 0.05); } // brick
    if (r.x < 0.25) { alb_frag = tint; }
    if (r.x < 0.10) { alb_frag = vec3<f32>(0.05); }             // voids
    let crack = smoothstep(0.02, 0.10, d2 - d1);
    // The mean of the fragments above (and of the 0.8-1.2 level spread),
    // less the cracks, which cover about a tenth of the surface.
    let alb_mean = (0.15 * tint + vec3<f32>(0.100, 0.078, 0.062)) * 0.93;
    let k = smoothstep(0.5 * cell, 2.0 * cell, fp);
    let tilt = (r - 0.5) * 0.9 * (1.0 - k);
    // @domain: a roof's normal (z = 1) plus a horizontal tilt
    let n = normalize(h.normal + vec3<f32>(tilt, 0.0));
    let frag = alb_frag * ((0.8 + 0.4 * r.y) * (0.35 + 0.65 * crack));
    return cc_industry_lit(cc, h.pos, n, mix(frag, alb_mean, k));
}

fn cc_industry_fork_shade(h: CityHit, cc: CityCell,
        s: cc_industry_Slot, fp: f32) -> vec3<f32> {
    let fwd = cc_industry_fwd(s.front);
    let u = dot(h.pos.xy - s.ctr, fwd);
    let v = abs(fwd.x * (h.pos.y - s.ctr.y) - fwd.y * (h.pos.x - s.ctr.x));
    let z = h.pos.z;
    var paint = vec3<f32>(0.55, 0.38, 0.04);          // yellow
    if (s.d.z > 0.60) { paint = vec3<f32>(0.50, 0.19, 0.03); }   // orange
    if (s.d.z > 0.85) { paint = vec3<f32>(0.36, 0.06, 0.04); }   // red
    var alb = paint;
    let steel = vec3<f32>(0.06);
    if (z > 2.0 || u > 0.30 || (z > 1.1 && v > 0.45)) {
        alb = steel;                      // guard, posts, mast, forks
    }
    if (z < 0.56 && (abs(u) < 0.26 || (u < -0.84 && u > -1.31))) {
        alb = vec3<f32>(0.02);            // tyres
    }
    if (z > 1.1 && z < 1.55 && u < -0.49 && u > -0.96 && v < 0.26) {
        alb = vec3<f32>(0.025);           // seat
    }
    return cc_industry_lit(cc, h.pos, h.normal, alb);
}

// ============================================================================
// THE SHADE HOOK
// ============================================================================
fn cc_industry_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    // Roofs and lamps first; everything else stands in a grid slot, found
    // once here. (The refuse is the skip's.)
    switch h.kind {
        case 700: { return cc_industry_roof_shade(h, cc, fp); }
        case 701: { return cc_industry_glaze_shade(h, cc, fp); }
        case 702: { return cc_industry_sky_shade(h, cc, fp); }
        case 703: { return cc_industry_head_shade(h, cc); }
        case 704: {
            return cc_industry_lit(cc, h.pos, h.normal, vec3<f32>(0.10));
        }
        case 711: {
            return cc_industry_rubble(h, cc, fp, 0.22,
                                      vec3<f32>(0.13, 0.12, 0.11));
        }
        case 713: {
            // The fence: galvanised posts and rail.
            return cc_industry_lit(cc, h.pos, h.normal, vec3<f32>(0.22));
        }
        default: {}
    }
    let s = cc_industry_find(cc, h.pos,
                             select(h.kind, cc_industry_K_SKIP,
                                    h.kind == cc_industry_K_REFUSE));
    switch h.kind {
        case 705: { return cc_industry_container_shade(h, cc, s, dir, fp); }
        case 706: { return cc_industry_trailer_shade(h, cc, s, fp); }
        case 707: { return cc_industry_pallet_shade(h, cc, s, fp); }
        case 708: { return cc_industry_rebar_shade(h, cc, s, fp); }
        case 709: { return cc_industry_skip_shade(h, cc, s, fp); }
        case 710: {
            return cc_industry_rubble(h, cc, fp, 0.28,
                                      vec3<f32>(0.22, 0.17, 0.10));
        }
        case 714: { return cc_industry_dock_shade(h, cc, s); }
        default: { return cc_industry_fork_shade(h, cc, s, fp); }
    }
}

// --- component: streetfurniture (streetfurniture.wgsl) ---
// streetfurniture — what stands on the sidewalk: hydrants, parking meters,
// bollards, litter baskets, newspaper boxes, benches, the black bags heaped
// at the kerb, and the dumpsters and wheelie bins against the building line.
//
// The camera can fly down onto the pavement and stop a metre from any of
// this, so every object is sphere-traced from a real SDF, to wiper-blade
// detail and no further (Thomas): a hydrant has its bonnet, operating nut,
// two hose caps and a pumper cap on their chains; a dumpster has its sloped
// front, fork pockets, casters, hinge knuckles and two lids, propped or
// thrown open over the garbage heaped inside; a bag has its knot. No text,
// no logos, nothing that would be noise at ten metres.
//
// LAYOUT. A built cell's sidewalk runs round its plot (THE STREET SURFACE in
// raymarch.wgsl): CITY_SIDEWALK_W (3 m, 4.5 m on an avenue) from the building
// line to the kerb line, its top at CITY_KERB_H. Each of the four EDGES whose
// city_edge_street is true carries two LANES, each a row of slots on a
// lattice anchored at the cell's corner:
//   * the KERB lane, 0.35-1.1 m in from the kerb line — where cities put
//     their furniture, clear of both the walking path and the car doors.
//     3 m slots. Hydrants (about one per block face), a parking meter every
//     6 m on the kerbs that have parking beside them, litter baskets at the
//     corners, and elsewhere a district-weighted draw of bag piles,
//     newspaper-box clusters, baskets, bollards and (on avenues) benches.
//   * the WALL lane, against the building line. 4.5 m slots. Dumpsters,
//     mostly near the corners where the service doors are; wheelie bins;
//     bags slumped against the wall.
// The lamp poles (streetlife) stand on the core's lattice, CITY_LAMP_OFFSET
// in from the building line every CITY_LAMP_SPACING along the edge — inside
// the kerb lane on a minor street. A kerb slot that a pole falls in holds
// nothing, or a pile of bags heaped round the pole's foot, which is where
// a city leaves them.
// Corners stay clear: every prop keeps CORNER_CLEAR inside the plot's own
// extent along its edge, so the kerb's quarter circles and the crosswalk
// mouths in line with the cross street's sidewalk are never obstructed.
// The wall lane is where city-facades' door positions (city_shell_door_u)
// belong once they land: the test is a rejection in cc_streetfurniture_prop,
// dropping a wall slot whose along extent overlaps a door, beside the
// storefront test that is already there.
//
// Everything is deterministic in (tile-wrapped cell, side, lane, slot), so
// the shader re-derives a prop from its hit position and nothing but the
// lane rides in CityHit: kind 800 + 2 side + lane. Every prop lies strictly
// inside the cell column that draws it, because the DDA tests a cell only
// from the side it enters. Reflected rays off the wet street never see these
// props: the core traces them with props = false (see fs_main).
//
// COST. The wide scene pays gate 1 below (two multiply-adds against the
// tallest thing here) and nothing else. A ray near the ground pays one slab
// test per lane and a hash per slot it passes, walked from the near end and
// stopped at the second box entered. The SDF runs for at most two candidate
// boxes per cell, in ONE rolled sphere-trace loop (streetlife's decision,
// for streetlife's measured reason: the trace written per slot is inlined
// into the core's 512-iteration DDA once per slot, and the register pressure
// of those copies costs occupancy on every city pixel). The march budget and
// the candidate count are run-time values so the driver cannot unroll either.
// There is no box-proxy LOD for the eye: the SDF runs to the far cutoff with
// its own detail ladder, because only pixels whose rays enter a prop's box
// pay for it, and a dumpster at the footprint where a proxy would take over
// is six pixels — the proxy would save six pixels of work and cost a pop.

const cc_streetfurniture_FLOOR: f32 = CITY_KERB_H;  // the sidewalk top
const cc_streetfurniture_Z_GATE: f32 = 2.6;   // an open dumpster lid, + kerb
const cc_streetfurniture_KERB_TOP: f32 = 1.45;  // kerb lane: a meter head
const cc_streetfurniture_WALL_TOP: f32 = 2.30;  // wall lane: lids open

// --- layout -----------------------------------------------------------------
const cc_streetfurniture_KERB_PITCH: f32 = 3.0;   // divides the 90 m block
const cc_streetfurniture_WALL_PITCH: f32 = 4.5;   // so does this
const cc_streetfurniture_KERB_IN: f32 = 0.72;     // kerb lane centre, from kerb
const cc_streetfurniture_CORNER_CLEAR: f32 = 0.9;
const cc_streetfurniture_POLE_CLEAR: f32 = 0.30;  // around a lamp mast
// The slot walk's budget. Enough to cross a whole cell along a lane (30 kerb
// slots, 20 wall slots) — a ray skimming the sidewalk at eye level really
// does pass that many — and a run-time bound, so it stays one rolled loop.
const cc_streetfurniture_MAX_SLOTS: i32 = 32;

// District weighting, the cascade value that streetlife's parking follows:
// downtown sidewalks are cluttered, the outskirts nearly bare.
const cc_streetfurniture_DENS_LO: f32 = 0.22;
const cc_streetfurniture_DENS_HI: f32 = 1.45;
const cc_streetfurniture_DENS_START: f32 = 0.005;
const cc_streetfurniture_DENS_FULL: f32 = 0.080;
const cc_streetfurniture_KERB_OCC: f32 = 0.40;

// --- prop types ---------------------------------------------------------------
const cc_streetfurniture_T_HYDRANT: i32 = 0;
const cc_streetfurniture_T_METER: i32 = 1;
const cc_streetfurniture_T_BOLLARD: i32 = 2;
const cc_streetfurniture_T_BASKET: i32 = 3;   // wire-mesh litter basket
const cc_streetfurniture_T_CAN: i32 = 4;      // solid steel litter can
const cc_streetfurniture_T_NEWS: i32 = 5;     // newspaper boxes, 2-4
const cc_streetfurniture_T_BENCH: i32 = 6;
const cc_streetfurniture_T_BAGS: i32 = 7;
const cc_streetfurniture_T_DUMPSTER: i32 = 8;
const cc_streetfurniture_T_WHEELIE: i32 = 9;

// --- materials (the SDF's second channel) -------------------------------------
const cc_streetfurniture_M_BAG_BLACK: f32 = 1.0;
const cc_streetfurniture_M_BAG_CLEAR: f32 = 2.0;
const cc_streetfurniture_M_BAG_BLUE: f32 = 3.0;
const cc_streetfurniture_M_CARDBOARD: f32 = 4.0;
const cc_streetfurniture_M_BOTTLE: f32 = 5.0;
const cc_streetfurniture_M_CAN: f32 = 6.0;
const cc_streetfurniture_M_RUBBER: f32 = 7.0;
const cc_streetfurniture_M_METAL: f32 = 8.0;
const cc_streetfurniture_M_PAINT: f32 = 9.0;
const cc_streetfurniture_M_LID: f32 = 10.0;
const cc_streetfurniture_M_GLASS: f32 = 11.0;
const cc_streetfurniture_M_INSIDE: f32 = 12.0;
const cc_streetfurniture_M_ACCENT: f32 = 13.0;
const cc_streetfurniture_M_WOOD: f32 = 14.0;
const cc_streetfurniture_M_IRON: f32 = 15.0;
const cc_streetfurniture_M_NEWS0: f32 = 30.0;  // + box index, 0..3

// --- LOD ----------------------------------------------------------------------
// The detail ladder, in the sharpened footprint (cc_streetfurniture_fpx):
// below FINE_FP the features a few millimetres across — the basket's wire
// mesh, a bag's knot ears, a hydrant's cap chain, film creases; below MID_FP
// the centimetre ones — handles, hinges, casters, coin hoods, lumps. Past
// FAR the props are two pixels and gone, faded into the ground beneath
// first so nothing switches off. The kerb lane's things are small (a
// hydrant is 0.3 m across), the wall lane's dumpster is 1.8 m, so each lane
// has its own far edge.
const cc_streetfurniture_FINE_FP: f32 = 0.012;
const cc_streetfurniture_MID_FP: f32 = 0.06;
const cc_streetfurniture_KERB_FAR: vec2<f32> = vec2<f32>(0.18, 0.30);
const cc_streetfurniture_WALL_FAR: vec2<f32> = vec2<f32>(0.45, 0.75);

// The march. Bags carry sine lumps whose gradient runs to ~1.5, so the march
// steps this fraction of the reported distance.
const cc_streetfurniture_STEP: f32 = 0.66;
const cc_streetfurniture_ITERS: i32 = 72;
const cc_streetfurniture_ITERS_FAR: i32 = 28;
const cc_streetfurniture_ITER_FP: f32 = 0.05;

// --- light --------------------------------------------------------------------
// Everything here is lit by city_street_light — the sodium heads as point
// sources, in the ground's radiance units — times an albedo RELATIVE TO
// ASPHALT. A downtown sidewalk under a lamp is already near clipping, so a
// black bag at 0.10 is a dark shape on a bright floor, which is both the
// photometry and the reference photographs. What says "black plastic" is
// not its diffuse at all but the glints: tight, broken highlights of the
// lamp heads on the wrinkled film (london_kerb_trashbags_night.jpg), and on
// a wet night every painted lid and cap carries them too.
// The palettes below are written as plain reflectances, the numbers a paint
// chart would give; ALB_GAIN turns them into the relative albedo the
// lighting wants. It is set by the tone curve, not by physics: the core's
// pavement under a downtown lamp is lit to radiance ~0.7 and rendered near
// white, and at exposure 6 a black bag that is to read as black (display
// ~0.15) must come out near radiance 0.007. At a gain of 1 the first renders
// showed pale grey balloons and white parking meters; 0.35 still left dark
// paint mid-grey beside a clipped pavement.
const cc_streetfurniture_ALB_GAIN: f32 = 0.25;
const cc_streetfurniture_WATER_F0: f32 = 0.02;
const cc_streetfurniture_WATER_N: f32 = 70.0;
// The lit pavement is a light source for anything standing on it: the
// underside and the lower flanks of a prop are lit mostly from below.
const cc_streetfurniture_BOUNCE: f32 = 0.10;
const cc_streetfurniture_WALK_WET: f32 = 1.05;   // CITY_REL_WALK, half-wet
// The pavement as a reflected ray sees it: the mean of wet sidewalk (~1.6
// relative) and wet road (~0.6), and blurred by the paint's roughness, so
// lower than either peak.
const cc_streetfurniture_FLOOR_REFL: f32 = 0.30;

// ---------------------------------------------------------------------------
// SDF primitives
// ---------------------------------------------------------------------------

fn cc_streetfurniture_rbox(p: vec3<f32>, b: vec3<f32>, r: f32) -> f32 {
    let q = abs(p) - b + vec3<f32>(r);
    return length(max(q, vec3<f32>(0.0)))
         + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}

// Capped cylinder, axis z, half-height h.
fn cc_streetfurniture_cylz(p: vec3<f32>, rad: f32, h: f32) -> f32 {
    let d = vec2<f32>(length(p.xy) - rad, abs(p.z) - h);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2<f32>(0.0)));
}

fn cc_streetfurniture_seg(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, rad: f32)
        -> f32 {
    let pa = p - a;
    let ba = b - a;
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * t) - rad;
}

// Ellipsoid, the bounded approximation (exact on the axes, never an
// overestimate by more than the axis ratio).
fn cc_streetfurniture_ell(p: vec3<f32>, r: vec3<f32>) -> f32 {
    let k0 = length(p / r);
    let k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 1e-5);
}

fn cc_streetfurniture_torz(p: vec3<f32>, big: f32, tube: f32) -> f32 {
    return length(vec2<f32>(length(p.xy) - big, p.z)) - tube;
}

fn cc_streetfurniture_smin(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

fn cc_streetfurniture_rot(v: vec2<f32>, a: f32) -> vec2<f32> {
    let c = cos(a);
    let s = sin(a);
    return vec2<f32>(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Nearest of two (distance, material) pairs.
fn cc_streetfurniture_u(a: vec2<f32>, b: vec2<f32>) -> vec2<f32> {
    return select(a, b, b.x < a.x);
}

// Four uniforms per item of a prop (a bag in a pile, a box in a row), from
// the prop's seed. One pcg2d, sixteen bits each: this runs inside the march.
fn cc_streetfurniture_item(seed: u32, i: i32) -> vec4<f32> {
    let h = pcg2d(vec2<u32>(seed, u32(i) * 0x9e3779b9u + 0x7f4a7c15u));
    return vec4<f32>(f32(h.x & 0xffffu), f32(h.x >> 16u),
                     f32(h.y & 0xffffu), f32(h.y >> 16u)) / 65535.0;
}

// ---------------------------------------------------------------------------
// Placement
// ---------------------------------------------------------------------------

struct cc_streetfurniture_Edge {
    ok: bool,
    ax: i32,          // the axis the edge runs along: 0 = x, 1 = y
    out: f32,         // +-1: which way the street lies, across the edge
    bl: f32,          // the building line (plot edge), across coordinate
    w: f32,           // sidewalk width
    a_lo: f32,        // usable along range: the plot's extent less the
    a_hi: f32,        //   corner clearance, clipped to the cell column
    a_cell: f32,      // the slot lattice's origin: the cell's own corner
    avenue: bool,
    park: bool,       // a parking lane runs beside this kerb
    pole_kerb: bool,  // the lamp line falls inside the kerb lane
    line: i32,        // the centreline this edge faces (its lamp lattice)
    wall_ok: bool,    // the building's face stands on the building line
}

fn cc_streetfurniture_edge(ci: vec2<i32>, cc: CityCell, side: i32)
        -> cc_streetfurniture_Edge {
    let cellm = u.ocean_params.x;
    let cmin = vec2<f32>(ci) * cellm;
    let cmax = cmin + vec2<f32>(cellm);
    var e: cc_streetfurniture_Edge;
    e.ax = select(0, 1, side < 2);
    e.out = select(1.0, -1.0, side == 0 || side == 2);
    let hi_side = side == 1 || side == 3;
    let xs = side < 2;
    e.bl = select(select(cc.plot_min.y, cc.plot_max.y, hi_side),
                  select(cc.plot_min.x, cc.plot_max.x, hi_side), xs);
    let c_lo = select(cmin.y, cmin.x, xs);
    let c_hi = select(cmax.y, cmax.x, xs);
    let p_lo = select(cc.plot_min.x, cc.plot_min.y, xs);
    let p_hi = select(cc.plot_max.x, cc.plot_max.y, xs);
    e.a_cell = select(cmin.x, cmin.y, xs);
    let a_top = select(cmax.x, cmax.y, xs);
    e.w = city_sidewalk_w(e.bl);
    let kb = i32(round(e.bl / cellm));
    e.line = kb;
    e.avenue = city_is_avenue(kb);
    // Our kerb sits on the -out side of the centreline; a minor street
    // parks on one side only (city_park_side), an avenue on both.
    e.park = e.avenue || city_park_side(kb) == -e.out;
    e.a_lo = max(p_lo + cc_streetfurniture_CORNER_CLEAR, e.a_cell);
    e.a_hi = min(p_hi - cc_streetfurniture_CORNER_CLEAR, a_top);
    let kerb = e.bl + e.out * e.w;
    // A merged superblock's plot edge can lie in a sibling's column: that
    // sidewalk is the sibling's to furnish.
    let inside = min(e.bl, kerb) >= c_lo && max(e.bl, kerb) <= c_hi;
    let lane_lo = e.w - cc_streetfurniture_KERB_IN - 0.40;
    let lane_hi = e.w - cc_streetfurniture_KERB_IN + 0.40;
    e.pole_kerb = CITY_LAMP_OFFSET > lane_lo - 0.2
               && CITY_LAMP_OFFSET < lane_hi + 0.2;
    e.ok = inside && e.a_hi > e.a_lo + 1.0 && city_edge_street(cc, side);
    // The wall lane stands against a wall only if there is one: where the
    // building is set back into its plot, a dumpster "against the wall" at
    // the plot edge would stand alone in the plaza (the review's M6).
    let face = select(select(cc.b1min.y, cc.b1max.y, hi_side),
                      select(cc.b1min.x, cc.b1max.x, hi_side), xs);
    e.wall_ok = abs(face - e.bl) < 0.6;
    return e;
}

struct cc_streetfurniture_Prop {
    ok: bool,
    typ: i32,
    n: i32,            // how many: bags, boxes, bollards, bins
    ctr: vec3<f32>,    // world position of the local origin, on the floor
    ax: i32,           // local x runs along world axis `ax`
    out: f32,          // local +y is the across axis times `out`
    hb: vec3<f32>,     // local half extents along, across; top z
    r: vec4<f32>,      // shape draws
    seed: u32,
}

fn cc_streetfurniture_none() -> cc_streetfurniture_Prop {
    var v: cc_streetfurniture_Prop;
    v.ok = false;
    v.typ = 0;
    v.n = 0;
    v.ctr = vec3<f32>(0.0);
    v.ax = 0;
    v.out = 1.0;
    v.hb = vec3<f32>(0.0);
    v.r = vec4<f32>(0.0);
    v.seed = 0u;
    return v;
}

// The draws: per slot, and per edge (lane = 2 names the edge itself).
// Tile-wrapped (city_tile_cell), and the slot index is the cell's own, so a
// replayed track meets the same bags on the same kerbs.
fn cc_streetfurniture_draw(ci: vec2<i32>, side: i32, lane: i32, k: i32)
        -> vec4<u32> {
    let cw = city_tile_cell(ci);
    let a = pcg2d(vec2<u32>(
        bitcast<u32>(cw.x) * 0x2c1b3c6du + u32(side) * 0x297a2d39u
            + u32(lane) * 0x68e31da4u + u32(k) * 0x1b56c4e9u + 0x3c6ef372u,
        bitcast<u32>(cw.y) * 0xcf1bbcddu + u32(side) * 0x9e3779b9u
            + u32(lane) * 0x7feb352du + u32(k) * 0x846ca68bu + 0xa54ff53au));
    let b = pcg2d(a);
    return vec4<u32>(a, b);
}

fn cc_streetfurniture_u4(h: vec4<u32>) -> vec4<f32> {
    return vec4<f32>(city_u01(h.x), city_u01(h.y), city_u01(h.z),
                     city_u01(h.w));
}

// Local half extents and top of each type, `n` of them where it counts.
// This is the bounding box the DDA pays for, so it is tight: every SDF below
// stays inside the box its type declares here, yaw jitter included.
fn cc_streetfurniture_extent(typ: i32, n: i32) -> vec3<f32> {
    let nf = f32(n);
    if (typ == cc_streetfurniture_T_HYDRANT) {
        return vec3<f32>(0.31, 0.31, 0.80);
    }
    if (typ == cc_streetfurniture_T_METER) {
        return vec3<f32>(select(0.13, 0.28, n > 1), 0.13, 1.42);
    }
    if (typ == cc_streetfurniture_T_BOLLARD) {
        return vec3<f32>(0.55 * (nf - 1.0) + 0.15, 0.15, 1.00);
    }
    if (typ == cc_streetfurniture_T_BASKET || typ == cc_streetfurniture_T_CAN) {
        return vec3<f32>(0.36, 0.36, 1.22);
    }
    if (typ == cc_streetfurniture_T_NEWS) {
        return vec3<f32>(0.28 * nf + 0.08, 0.31, 1.14);
    }
    if (typ == cc_streetfurniture_T_BENCH) {
        return vec3<f32>(1.00, 0.36, 0.90);
    }
    if (typ == cc_streetfurniture_T_BAGS) {
        let nb = (2 * n + 2) / 3;
        let rows = select(1, 2, nb >= 4);
        let cols = (nb + rows - 1) / rows;
        return vec3<f32>(0.25 * f32(cols) + 0.45, 0.22 * f32(rows) + 0.36,
                         select(0.74, 1.06, n > nb));
    }
    if (typ == cc_streetfurniture_T_DUMPSTER) {
        return vec3<f32>(1.08, 0.62, 2.30);
    }
    // Wheelie bins, 0.66 m apart, and a bag split beside them.
    return vec3<f32>(0.33 * nf + 0.48, 0.62, 1.36);
}

// Whatever stands in slot k of lane `lane` on edge `side`.
fn cc_streetfurniture_prop(ci: vec2<i32>, cc: CityCell,
                           e: cc_streetfurniture_Edge, side: i32, lane: i32,
                           k: i32) -> cc_streetfurniture_Prop {
    let kerb = lane == 0;
    let pitch = select(cc_streetfurniture_WALL_PITCH,
                       cc_streetfurniture_KERB_PITCH, kerb);
    let s0 = max(e.a_cell + f32(k) * pitch, e.a_lo);
    let s1 = min(e.a_cell + f32(k + 1) * pitch, e.a_hi);
    if (s1 - s0 < 0.5) {
        return cc_streetfurniture_none();
    }
    let hsd = cc_streetfurniture_draw(ci, side, lane, k);
    let r = cc_streetfurniture_u4(hsd);
    let er = cc_streetfurniture_u4(cc_streetfurniture_draw(ci, side, 2, 0));
    let dens = mix(cc_streetfurniture_DENS_LO, cc_streetfurniture_DENS_HI,
                   smoothstep(cc_streetfurniture_DENS_START,
                              cc_streetfurniture_DENS_FULL, cc.density));
    let k_lo = i32(floor((e.a_lo - e.a_cell) / pitch));
    let k_hi = i32(floor((e.a_hi - e.a_cell) / pitch - 1e-4));
    let mid = 0.5 * (s0 + s1);
    var typ = -1;
    var n = 1;
    var along = mid;
    var u_c = e.w - cc_streetfurniture_KERB_IN;   // distance from building line
    if (kerb) {
        // The nearest lamp mast, and whether it stands in this slot.
        let pole_a = city_lamp_station(e.line, mid);
        let pole_in = e.pole_kerb && pole_a > s0 - 0.45 && pole_a < s1 + 0.45;
        let from_lo = k - k_lo;
        let from_hi = k_hi - k;
        // One hydrant per block face, most of them, a slot or two in from
        // a corner.
        let k_hyd = select(k_lo + 1 + i32(er.y * 2.99),
                           k_hi - 1 - i32(fract(er.y * 5.3) * 2.99),
                           fract(er.y * 17.1) > 0.5);
        if (pole_in) {
            if (r.x < 0.40 * dens) {
                typ = cc_streetfurniture_T_BAGS;
                n = 3 + i32(r.z * 5.99);
                along = pole_a + select(-0.25, 0.25, r.w > 0.5);
            }
        } else if (k == k_hyd && er.y < 0.85) {
            typ = cc_streetfurniture_T_HYDRANT;
            along = mid + (r.y - 0.5) * 1.2;
        } else if ((from_lo == 0 && er.w < 0.55)
                   || (from_hi == 0 && fract(er.w * 13.7) < 0.55)) {
            // The corner basket: the one piece of furniture every city puts
            // at the corner, where people are waiting to cross.
            typ = select(cc_streetfurniture_T_CAN, cc_streetfurniture_T_BASKET,
                         r.y < 0.68);
            along = select(s1 - 0.45, s0 + 0.45, from_lo == 0);
        } else if (e.park && er.x < 0.55 && (from_lo & 1) == 0) {
            // A meter every 6 m along a parking kerb, at the kerb's own
            // setback: they are for the driver, not the walker.
            typ = cc_streetfurniture_T_METER;
            n = select(1, 2, r.y > 0.72);
            u_c = e.w - 0.45;
        } else if (r.x < cc_streetfurniture_KERB_OCC * dens) {
            let d = r.y;
            if (d < 0.32) {
                typ = cc_streetfurniture_T_BAGS;
                n = 3 + i32(r.z * 9.99);
                u_c = e.w - 0.62;
            } else if (d < 0.50) {
                typ = cc_streetfurniture_T_NEWS;
                n = 2 + i32(r.z * 2.99);
                u_c = e.w - 0.68;
            } else if (d < 0.63) {
                typ = select(cc_streetfurniture_T_CAN,
                             cc_streetfurniture_T_BASKET, r.z < 0.6);
            } else if (d < 0.76) {
                typ = cc_streetfurniture_T_BOLLARD;
                n = select(2, 3, r.z > 0.55);
            } else if (d < 0.90 && e.avenue) {
                typ = cc_streetfurniture_T_BENCH;
                u_c = e.w - 0.85;
            } else {
                typ = cc_streetfurniture_T_NEWS;
                n = 2 + i32(r.z * 2.99);
                u_c = e.w - 0.68;
            }
            along = mid + (r.w - 0.5) * 0.8;
        }
    } else {
        // Dumpsters stand where the service doors are: near the corners,
        // and rarely in front of a shop window. (city-facades' door
        // positions will sharpen both: see the header.)
        let corner = k - k_lo <= 1 || k_hi - k <= 1;
        let store = dot(city_storefront_glow(cc), vec3<f32>(1.0)) > 0.0;
        let p_dump = select(0.05, 0.30, corner) * select(1.0, 0.5, store)
                   * dens;
        let p_wheel = 0.07 * dens;
        let p_bags = 0.09 * dens;
        if (r.x < p_dump) {
            typ = cc_streetfurniture_T_DUMPSTER;
            u_c = 0.60;
        } else if (r.x < p_dump + p_wheel) {
            typ = cc_streetfurniture_T_WHEELIE;
            n = select(1, 2, r.z > 0.45);
            u_c = 0.44;
        } else if (r.x < p_dump + p_wheel + p_bags) {
            typ = cc_streetfurniture_T_BAGS;
            n = 4 + i32(r.z * 8.99);
            u_c = 0.52;
        }
        along = mid + (r.w - 0.5) * 1.2;
    }
    if (typ < 0) {
        return cc_streetfurniture_none();
    }
    let hb = cc_streetfurniture_extent(typ, n);
    // Inside the slot (the shader finds the slot again by floor), inside the
    // usable edge, and clear of the lamp mast where the lane crosses it.
    if (2.0 * hb.x + 0.04 > s1 - s0) {
        return cc_streetfurniture_none();
    }
    along = clamp(along, s0 + hb.x + 0.02, s1 - hb.x - 0.02);
    if (kerb && e.pole_kerb && typ != cc_streetfurniture_T_BAGS) {
        let pole_a = city_lamp_station(e.line, along);
        if (abs(along - pole_a) < hb.x + cc_streetfurniture_POLE_CLEAR) {
            return cc_streetfurniture_none();
        }
    }
    // The building line is solid wall: nothing may stand into it.
    u_c = max(u_c, hb.y + 0.03);
    var v: cc_streetfurniture_Prop;
    v.ok = true;
    v.typ = typ;
    v.n = n;
    let across = e.bl + e.out * u_c;
    v.ctr = vec3<f32>(select(across, along, e.ax == 0),
                      select(along, across, e.ax == 0),
                      cc_streetfurniture_FLOOR);
    v.ax = e.ax;
    v.out = e.out;
    v.hb = hb;
    v.r = r;
    v.seed = hsd.w ^ (hsd.x * 0x9e3779b9u);
    return v;
}

fn cc_streetfurniture_to_local(v: cc_streetfurniture_Prop, w: vec3<f32>)
        -> vec3<f32> {
    let rel = w - v.ctr;
    return select(vec3<f32>(rel.y, v.out * rel.x, rel.z),
                  vec3<f32>(rel.x, v.out * rel.y, rel.z), v.ax == 0);
}

// Direction local -> world (the frame is a signed axis permutation).
fn cc_streetfurniture_to_world(v: cc_streetfurniture_Prop, d: vec3<f32>)
        -> vec3<f32> {
    return select(vec3<f32>(v.out * d.y, d.x, d.z),
                  vec3<f32>(d.x, v.out * d.y, d.z), v.ax == 0);
}

// The world bounding box. A struct and not a two-element array: a CITY-only
// function-local array has moved DAY pixels in this kernel before.
struct cc_streetfurniture_Box {
    lo: vec3<f32>,
    hi: vec3<f32>,
}

fn cc_streetfurniture_box(v: cc_streetfurniture_Prop) -> cc_streetfurniture_Box {
    let hx = select(vec2<f32>(v.hb.y, v.hb.x), v.hb.xy, v.ax == 0);
    return cc_streetfurniture_Box(vec3<f32>(v.ctr.xy - hx, v.ctr.z - 0.03),
                                  vec3<f32>(v.ctr.xy + hx, v.ctr.z + v.hb.z));
}

// ---------------------------------------------------------------------------
// Garbage: the bag, and what is heaped in an open container
// ---------------------------------------------------------------------------

// One bag, q relative to its centre. A bag is a slumped ellipsoid, wider low
// where its load settles, pressed out into lumps by what is inside it, and
// gathered at the top into a neck and a knot with two tied ears — the one
// silhouette feature that says "bag" rather than "boulder". The film's
// creases are what break the lamp's reflection into the scattered sparks the
// London reference shows; smooth, the glint would be one clean highlight and
// the bag would read as a bowling ball.
fn cc_streetfurniture_bag(q: vec3<f32>, rad: vec3<f32>, ph: f32, lod: i32)
        -> f32 {
    let s = clamp(q.z / rad.z, -1.0, 1.0);
    let rr = vec3<f32>(rad.xy * (1.10 - 0.22 * s), rad.z);
    // Half ellipsoid, half rounded box: the film drapes over whatever is
    // inside, and what is inside has corners. A pure ellipsoid rendered as a
    // glossy gourd — a balloon, not a bag.
    var d = mix(cc_streetfurniture_ell(q, rr),
                cc_streetfurniture_rbox(q, 0.86 * rr, 0.14), 0.30);
    if (lod <= 1) {
        d = d + 0.034 * sin(q.x * 8.0 + ph) * sin(q.y * 9.0 + 1.7 * ph)
                      * sin(q.z * 7.0 + 2.3 * ph);
    }
    if (lod == 0) {
        // Creases: V-shaped folds (the abs), which is what breaks the lamp's
        // reflection into separate sparks along the fold lines.
        d = d + 0.009 * abs(sin(q.x * 27.0 + 3.0 * ph) * sin(q.y * 23.0 + ph)
                            + sin(q.z * 25.0 - ph));
    }
    // The gathered neck, short, leaning the way the bag was dropped.
    let lean = vec2<f32>(cos(ph), sin(ph)) * 0.04;
    let knot = vec3<f32>(lean, rad.z + 0.03);
    d = cc_streetfurniture_smin(
        d, cc_streetfurniture_seg(q, vec3<f32>(0.0, 0.0, 0.70 * rad.z), knot,
                                  0.030), 0.07);
    if (lod <= 1) {
        // The tied ears: two flat lobes either side of the knot.
        let kq = q - knot - vec3<f32>(0.0, 0.0, 0.014);
        let ea = vec2<f32>(cos(ph * 1.3), sin(ph * 1.3));
        let side = dot(kq.xy, ea);
        let big = select(0.75, 1.0, side > 0.0);   // one ear longer
        let ax = vec3<f32>(abs(side) - 0.040 * big,
                           dot(kq.xy, vec2<f32>(-ea.y, ea.x)),
                           kq.z - 0.012 - 0.35 * abs(side));
        d = min(d, cc_streetfurniture_ell(
            ax, vec3<f32>(0.048 * big, 0.009, 0.020)));
    }
    return d;
}

fn cc_streetfurniture_bag_mat(h: f32) -> f32 {
    if (h < 0.80) {
        return cc_streetfurniture_M_BAG_BLACK;
    }
    return select(cc_streetfurniture_M_BAG_BLUE, cc_streetfurniture_M_BAG_CLEAR,
                  h < 0.92);
}

// A heap of n bags: a bottom layer in one or two rows along the kerb, the
// rest thrown on top across the joints. Every bag is its own draw, so no
// two heaps agree.
fn cc_streetfurniture_pile(p: vec3<f32>, v: cc_streetfurniture_Prop, lod: i32)
        -> vec2<f32> {
    let n = v.n;
    let nb = (2 * n + 2) / 3;
    let rows = select(1, 2, nb >= 4);
    let cols = (nb + rows - 1) / rows;
    let nt = n - nb;
    let q0 = vec3<f32>(cc_streetfurniture_rot(p.xy, (v.r.w - 0.5) * 0.12), p.z);
    var best = vec2<f32>(1e9, cc_streetfurniture_M_BAG_BLACK);
    for (var i: i32 = 0; i < n; i = i + 1) {
        let h = cc_streetfurniture_item(v.seed, i);
        var c: vec3<f32>;
        var rad: vec3<f32>;
        if (i < nb) {
            let col = i / rows;
            let row = i % rows;
            rad = vec3<f32>(0.22 + 0.07 * h.z, 0.20 + 0.06 * h.w,
                            0.19 + 0.07 * h.x);
            c = vec3<f32>((f32(col) - 0.5 * f32(cols - 1)) * 0.44
                              + (h.x - 0.5) * 0.10 + f32(row) * 0.11,
                          (f32(row) - 0.5 * f32(rows - 1)) * 0.40
                              + (h.y - 0.5) * 0.10,
                          0.70 * rad.z);
        } else {
            let j = i - nb;
            rad = vec3<f32>(0.20 + 0.06 * h.z, 0.18 + 0.05 * h.w,
                            0.18 + 0.06 * h.x);
            c = vec3<f32>((f32(j) - 0.5 * f32(nt - 1)) * 0.46
                              + (h.x - 0.5) * 0.14,
                          (h.y - 0.5) * 0.22,
                          0.36 + 0.50 * rad.z);
        }
        let q = q0 - c;
        // A bag cannot be nearer than its bounding sphere: skip the field
        // for the ones that cannot win.
        if (length(q) - 1.12 * max(rad.x, max(rad.y, rad.z)) - 0.11
            > best.x) {
            continue;
        }
        let d = cc_streetfurniture_bag(q, rad, h.w * 6.2831853 + f32(i), lod);
        let m = cc_streetfurniture_bag_mat(fract(h.z * 7.13 + h.y));
        // Bags pressed together share a crease, not a seam.
        let dd = cc_streetfurniture_smin(best.x, d, 0.06);
        best = vec2<f32>(dd, select(best.y, m, d < best.x));
    }
    return best;
}

// What fills an open container, relative to the rim's centre (z = 0 at the
// rim), clipped to the interior — a rounded rectangle of half extents `hi`
// and corner radius `cr` — and allowed to bulge a little over the rim: a
// couple of bags, a flap of soggy cardboard standing up out of it, a bottle
// and a can on top. `nb` bags spread along the long side.
fn cc_streetfurniture_heap(q: vec3<f32>, hi: vec2<f32>, cr: f32, nb: i32,
                           seed: u32, lod: i32) -> vec2<f32> {
    var best = vec2<f32>(1e9, cc_streetfurniture_M_BAG_BLACK);
    for (var i: i32 = 0; i < nb; i = i + 1) {
        let h = cc_streetfurniture_item(seed, i + 17);
        let fx = (f32(i) + 0.5) / f32(nb) * 2.0 - 1.0;
        let rad = vec3<f32>(min(0.17 + 0.06 * h.z, 0.9 * hi.x),
                            min(0.16 + 0.05 * h.w, 0.9 * hi.y),
                            0.15 + 0.06 * h.x);
        let c = vec3<f32>(fx * max(hi.x - rad.x, 0.0) + (h.y - 0.5) * 0.08,
                          (h.x - 0.5) * max(hi.y - rad.y, 0.0),
                          -0.10 + 0.14 * h.w);
        let qq = q - c;
        if (length(qq) - 1.12 * max(rad.x, rad.z) - 0.11 > best.x) {
            continue;
        }
        let d = cc_streetfurniture_bag(qq, rad, h.z * 6.2831853 + f32(i), lod);
        let dd = cc_streetfurniture_smin(best.x, d, 0.03);
        best = vec2<f32>(dd, select(best.y,
                                    cc_streetfurniture_bag_mat(h.y), d < best.x));
    }
    let g = cc_streetfurniture_item(seed, 3);
    // Cardboard: a flat flap, tilted up out of the heap.
    let cq = q - vec3<f32>((g.x - 0.5) * hi.x, (g.y - 0.5) * 0.4 * hi.y, 0.10);
    let cy = cc_streetfurniture_rot(cq.xy, g.z * 3.14159);
    let ct = cc_streetfurniture_rot(vec2<f32>(cy.y, cq.z), 0.9 + 0.5 * g.w);
    best = cc_streetfurniture_u(best, vec2<f32>(
        cc_streetfurniture_rbox(vec3<f32>(cy.x, ct.x, ct.y),
                                vec3<f32>(0.15, 0.004, 0.12), 0.003),
        cc_streetfurniture_M_CARDBOARD));
    if (lod <= 1) {
        // A bottle lying on the heap, neck up, and a crushed can.
        let bq = q - vec3<f32>((g.w - 0.5) * hi.x, (0.5 - g.x) * 0.5 * hi.y,
                               0.08 + 0.05 * g.z);
        let ba = vec3<f32>(cos(g.y * 6.28), sin(g.y * 6.28), 0.45);
        let bottle = cc_streetfurniture_smin(
            cc_streetfurniture_seg(bq, vec3<f32>(0.0), ba * 0.15, 0.032),
            cc_streetfurniture_seg(bq, ba * 0.15, ba * 0.25, 0.011), 0.025);
        best = cc_streetfurniture_u(best, vec2<f32>(
            bottle, cc_streetfurniture_M_BOTTLE));
        let kq = q - vec3<f32>((0.5 - g.z) * hi.x, (g.w - 0.5) * 0.5 * hi.y,
                               0.12);
        best = cc_streetfurniture_u(best, vec2<f32>(
            cc_streetfurniture_seg(kq, vec3<f32>(-0.05, 0.02, 0.0),
                                   vec3<f32>(0.05, -0.02, 0.02), 0.030),
            cc_streetfurniture_M_CAN));
    }
    // Clip to the container: inside its walls below the rim, a hand's width
    // of overflow above it.
    let grow = 0.05 * smoothstep(0.0, 0.08, q.z);
    let qa = abs(q.xy) - (hi - vec2<f32>(cr)) - vec2<f32>(grow);
    let wall = length(max(qa, vec2<f32>(0.0))) + min(max(qa.x, qa.y), 0.0)
             - cr + 0.012;
    best.x = max(best.x, wall);
    return best;
}

// ---------------------------------------------------------------------------
// The props
// ---------------------------------------------------------------------------
//
// Local frame: x along the kerb, y toward the street, z up from the sidewalk
// top. Each returns (distance, material).

// A fire hydrant: flange, barrel, bonnet with its operating nut, two hose
// outlets with caps and a pumper outlet facing the street, and on the close
// read the chains that keep the caps from walking off.
fn cc_streetfurniture_hydrant(p: vec3<f32>, v: cc_streetfurniture_Prop,
                              lod: i32) -> vec2<f32> {
    let q = vec3<f32>(cc_streetfurniture_rot(p.xy, (v.r.z - 0.5) * 0.8), p.z);
    var d = cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.025), 0.150,
                                    0.035);
    d = min(d, cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.26), 0.112,
                                       0.30));
    d = min(d, cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.555), 0.132,
                                       0.020));
    // Bonnet: a squat dome.
    d = min(d, cc_streetfurniture_ell(q - vec3<f32>(0.0, 0.0, 0.585),
                                      vec3<f32>(0.118, 0.118, 0.095)));
    var res = vec2<f32>(d, cc_streetfurniture_M_PAINT);
    // Operating nut: pentagonal in life, a short cylinder at this scale.
    res = cc_streetfurniture_u(res, vec2<f32>(
        cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.70), 0.030, 0.028),
        cc_streetfurniture_M_ACCENT));
    // Side outlets, mirrored on |x|.
    let sq = vec3<f32>(abs(q.x), q.y, q.z);
    let noz = cc_streetfurniture_cylz(
        vec3<f32>(sq.z - 0.43, q.y, sq.x - 0.16), 0.050, 0.055);
    res = cc_streetfurniture_u(res, vec2<f32>(noz, cc_streetfurniture_M_PAINT));
    var caps = cc_streetfurniture_cylz(
        vec3<f32>(sq.z - 0.43, q.y, sq.x - 0.225), 0.062, 0.022);
    // Pumper outlet, bigger, facing the street.
    res = cc_streetfurniture_u(res, vec2<f32>(
        cc_streetfurniture_cylz(vec3<f32>(q.x, q.z - 0.38, q.y - 0.16), 0.070,
                                0.055),
        cc_streetfurniture_M_PAINT));
    caps = min(caps, cc_streetfurniture_cylz(
        vec3<f32>(q.x, q.z - 0.38, q.y - 0.235), 0.086, 0.026));
    if (lod <= 1) {
        // The cap nuts.
        caps = min(caps, cc_streetfurniture_rbox(
            vec3<f32>(sq.x - 0.255, q.y, q.z - 0.43),
            vec3<f32>(0.012, 0.022, 0.022), 0.003));
        caps = min(caps, cc_streetfurniture_rbox(
            vec3<f32>(q.x, q.y - 0.268, q.z - 0.38),
            vec3<f32>(0.026, 0.012, 0.026), 0.003));
    }
    res = cc_streetfurniture_u(res, vec2<f32>(caps, cc_streetfurniture_M_ACCENT));
    if (lod == 0) {
        // Each side cap hangs a chain back to a lug on the barrel.
        let ch = min(
            cc_streetfurniture_seg(sq, vec3<f32>(0.225, 0.045, 0.40),
                                   vec3<f32>(0.175, 0.085, 0.315), 0.005),
            cc_streetfurniture_seg(sq, vec3<f32>(0.175, 0.085, 0.315),
                                   vec3<f32>(0.105, 0.060, 0.37), 0.005));
        res = cc_streetfurniture_u(res, vec2<f32>(ch, cc_streetfurniture_M_METAL));
    }
    return res;
}

// A parking meter: post, collar, and a head with a domed display window on
// each face and a coin-slot hood under it. Two in five kerbs have twin heads
// on a yoke.
fn cc_streetfurniture_meter(p: vec3<f32>, v: cc_streetfurniture_Prop,
                            lod: i32) -> vec2<f32> {
    var res = vec2<f32>(
        min(cc_streetfurniture_cylz(p - vec3<f32>(0.0, 0.0, 0.52), 0.034, 0.56),
            cc_streetfurniture_cylz(p - vec3<f32>(0.0, 0.0, 0.03), 0.058,
                                    0.045)),
        cc_streetfurniture_M_PAINT);
    var hq = p;
    if (v.n > 1) {
        res = cc_streetfurniture_u(res, vec2<f32>(
            cc_streetfurniture_rbox(p - vec3<f32>(0.0, 0.0, 1.07),
                                    vec3<f32>(0.16, 0.025, 0.025), 0.01),
            cc_streetfurniture_M_METAL));
        hq.x = abs(p.x) - 0.15;
    }
    res = cc_streetfurniture_u(res, vec2<f32>(
        min(cc_streetfurniture_rbox(hq - vec3<f32>(0.0, 0.0, 1.22),
                                    vec3<f32>(0.10, 0.075, 0.14), 0.03),
            cc_streetfurniture_ell(hq - vec3<f32>(0.0, 0.0, 1.35),
                                   vec3<f32>(0.10, 0.075, 0.055))),
        cc_streetfurniture_M_PAINT));
    let fq = vec3<f32>(hq.x, abs(hq.y), hq.z);
    res = cc_streetfurniture_u(res, vec2<f32>(
        cc_streetfurniture_ell(fq - vec3<f32>(0.0, 0.066, 1.27),
                               vec3<f32>(0.068, 0.030, 0.058)),
        cc_streetfurniture_M_GLASS));
    if (lod <= 1) {
        res = cc_streetfurniture_u(res, vec2<f32>(
            cc_streetfurniture_rbox(fq - vec3<f32>(0.0, 0.080, 1.15),
                                    vec3<f32>(0.032, 0.012, 0.018), 0.004),
            cc_streetfurniture_M_METAL));
    }
    return res;
}

// Steel bollards, a row of two or three, domed tops and a cap ring.
fn cc_streetfurniture_bollard(p: vec3<f32>, v: cc_streetfurniture_Prop)
        -> vec2<f32> {
    let half = 0.5 * f32(v.n - 1);
    let i = clamp(round(p.x / 1.1 + half), 0.0, f32(v.n - 1));
    let q = vec3<f32>(p.x - (i - half) * 1.1, p.y, p.z);
    var d = cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.40), 0.105,
                                    0.43);
    d = min(d, cc_streetfurniture_ell(q - vec3<f32>(0.0, 0.0, 0.83),
                                      vec3<f32>(0.105, 0.105, 0.07)));
    let ring = cc_streetfurniture_cylz(q - vec3<f32>(0.0, 0.0, 0.76), 0.118,
                                       0.018);
    return cc_streetfurniture_u(vec2<f32>(d, cc_streetfurniture_M_PAINT),
                                vec2<f32>(ring, cc_streetfurniture_M_ACCENT));
}

// A litter basket. Wire mesh (the green New York one) or a solid steel can
// with ribs and a liner bag folded over the rim; both open-topped, both
// full, the garbage standing proud of the rim. The mesh is real geometry at
// the finest step — the rays pass through its holes and meet the garbage
// inside, which is what makes a wire basket look like one — and a solid
// shell, shaded as its own mesh mean, past it.
fn cc_streetfurniture_basket(p: vec3<f32>, v: cc_streetfurniture_Prop,
                             lod: i32) -> vec2<f32> {
    let wire = v.typ == cc_streetfurniture_T_BASKET;
    let top = 0.84;
    let rz = mix(0.262, 0.298, clamp(p.z / top, 0.0, 1.0));
    let rho = length(p.xy);
    let radial = rho - rz;
    var shell = max(abs(radial) - select(0.011, 0.007, wire),
                    abs(p.z - 0.5 * top) - 0.5 * top);
    if (wire && lod == 0) {
        let ang = atan2(p.y, p.x) * (32.0 / 6.2831853);
        let cu = (fract(ang) - 0.5) * (6.2831853 * 0.28 / 32.0);
        let cz = (fract((p.z - 0.075) / 0.055) - 0.5) * 0.055;
        let hole = max(max(abs(cu), abs(cz)) - 0.019,
                       abs(p.z - 0.43) - 0.33);
        shell = max(shell, -hole);
    }
    // Interior faces are a different material: in shadow down the barrel.
    var res = vec2<f32>(shell, select(cc_streetfurniture_M_PAINT,
                                      cc_streetfurniture_M_INSIDE, radial < 0.0));
    var ring = cc_streetfurniture_torz(p - vec3<f32>(0.0, 0.0, top), 0.298,
                                       0.015);
    ring = min(ring, cc_streetfurniture_cylz(p - vec3<f32>(0.0, 0.0, 0.01),
                                             0.264, 0.022));
    if (wire) {
        ring = min(ring, cc_streetfurniture_torz(
            p - vec3<f32>(0.0, 0.0, 0.29), 0.275, 0.009));
        ring = min(ring, cc_streetfurniture_torz(
            p - vec3<f32>(0.0, 0.0, 0.57), 0.287, 0.009));
    } else {
        ring = min(ring, cc_streetfurniture_torz(
            p - vec3<f32>(0.0, 0.0, 0.22), 0.272, 0.013));
        ring = min(ring, cc_streetfurniture_torz(
            p - vec3<f32>(0.0, 0.0, 0.52), 0.284, 0.013));
    }
    res = cc_streetfurniture_u(res, vec2<f32>(ring, cc_streetfurniture_M_PAINT));
    if (!wire) {
        // The liner, folded down over the rim.
        let lq = vec2<f32>(rho - 0.305, p.z - (top - 0.045));
        let liner = length(max(abs(lq) - vec2<f32>(0.004, 0.045),
                               vec2<f32>(0.0))) - 0.004;
        res = cc_streetfurniture_u(res, vec2<f32>(
            liner, cc_streetfurniture_M_BAG_BLACK));
    }
    return cc_streetfurniture_u(res, cc_streetfurniture_heap(
        p - vec3<f32>(0.0, 0.0, top), vec2<f32>(0.285), 0.285, 2, v.seed, lod));
}

// Newspaper boxes, two to four in a row, each its own colour and a few
// degrees off square: body on four short legs, a chamfered top carrying the
// coin mechanism, a recessed window on the sidewalk face with the paper
// behind it, a pull handle, and the coin slot's hood.
fn cc_streetfurniture_news(p: vec3<f32>, v: cc_streetfurniture_Prop, lod: i32)
        -> vec2<f32> {
    var best = vec2<f32>(1e9, cc_streetfurniture_M_NEWS0);
    let half = 0.5 * f32(v.n - 1);
    for (var i: i32 = 0; i < v.n; i = i + 1) {
        let h = cc_streetfurniture_item(v.seed, i);
        let c = vec2<f32>((f32(i) - half) * 0.56 + (h.x - 0.5) * 0.04,
                          (h.z - 0.5) * 0.05);
        let b = vec3<f32>(cc_streetfurniture_rot(p.xy - c, (h.y - 0.5) * 0.14),
                          p.z);
        if (cc_streetfurniture_rbox(b - vec3<f32>(0.0, 0.0, 0.54),
                                    vec3<f32>(0.26, 0.24, 0.58), 0.0)
            > best.x) {
            continue;
        }
        var body = cc_streetfurniture_rbox(b - vec3<f32>(0.0, 0.0, 0.60),
                                           vec3<f32>(0.245, 0.21, 0.43), 0.022);
        body = max(body, dot(vec2<f32>(b.y + 0.21, b.z - 0.95),
                             vec2<f32>(-0.6, 0.8)));
        // The window, recessed 12 mm into the sidewalk face.
        let win = cc_streetfurniture_rbox(b - vec3<f32>(0.0, -0.225, 0.715),
                                          vec3<f32>(0.19, 0.027, 0.16), 0.012);
        body = max(body, -win);
        let mat = select(cc_streetfurniture_M_NEWS0 + f32(i),
                         cc_streetfurniture_M_GLASS,
                         win < 0.004 && b.y > -0.212);
        var r = vec2<f32>(body, mat);
        r = cc_streetfurniture_u(r, vec2<f32>(
            cc_streetfurniture_rbox(b - vec3<f32>(0.0, 0.03, 1.04),
                                    vec3<f32>(0.11, 0.10, 0.045), 0.015),
            cc_streetfurniture_M_NEWS0 + f32(i)));
        var legs = cc_streetfurniture_rbox(
            vec3<f32>(abs(b.x) - 0.20, abs(b.y) - 0.165, b.z - 0.07),
            vec3<f32>(0.022, 0.022, 0.10), 0.005);
        if (lod <= 1) {
            legs = min(legs, cc_streetfurniture_rbox(
                b - vec3<f32>(0.0, -0.228, 0.50),
                vec3<f32>(0.09, 0.012, 0.012), 0.006));
            legs = min(legs, cc_streetfurniture_rbox(
                b - vec3<f32>(0.05, -0.085, 1.085),
                vec3<f32>(0.03, 0.014, 0.018), 0.004));
        }
        r = cc_streetfurniture_u(r, vec2<f32>(legs, cc_streetfurniture_M_IRON));
        best = cc_streetfurniture_u(best, r);
    }
    return best;
}

// A bench (avenues): cast-iron ends with arms, four seat slats and three
// back slats raked 12 degrees, the gaps real.
fn cc_streetfurniture_bench(p: vec3<f32>, v: cc_streetfurniture_Prop)
        -> vec2<f32> {
    let fs = select(-1.0, 1.0, v.r.z > 0.5);   // which way it faces
    let y = p.y * fs;                          // back at +y
    let e = vec3<f32>(abs(p.x) - 0.82, y, p.z);
    var iron = cc_streetfurniture_rbox(e - vec3<f32>(0.0, -0.20, 0.21),
                                       vec3<f32>(0.024, 0.028, 0.23), 0.008);
    iron = min(iron, cc_streetfurniture_seg(e, vec3<f32>(0.0, 0.17, -0.02),
                                            vec3<f32>(0.0, 0.29, 0.86), 0.026));
    iron = min(iron, cc_streetfurniture_rbox(e - vec3<f32>(0.0, 0.0, 0.42),
                                             vec3<f32>(0.024, 0.23, 0.024),
                                             0.006));
    iron = min(iron, cc_streetfurniture_seg(e, vec3<f32>(0.0, -0.24, 0.64),
                                            vec3<f32>(0.0, 0.22, 0.67), 0.022));
    iron = min(iron, cc_streetfurniture_seg(e, vec3<f32>(0.0, -0.21, 0.43),
                                            vec3<f32>(0.0, -0.24, 0.64), 0.020));
    let si = clamp(round((y + 0.20) / 0.11), 0.0, 3.0);
    var wood = cc_streetfurniture_rbox(
        vec3<f32>(p.x, y + 0.20 - si * 0.11, p.z - 0.455),
        vec3<f32>(0.95, 0.046, 0.017), 0.007);
    let bz = p.z - 0.50;
    let by = (y - 0.215 - 0.2126 * bz) * 0.978;
    let bi = clamp(round((bz - 0.10) / 0.12), 0.0, 2.0);
    wood = min(wood, cc_streetfurniture_rbox(
        vec3<f32>(p.x, by, bz - 0.10 - bi * 0.12),
        vec3<f32>(0.95, 0.016, 0.044), 0.007));
    return cc_streetfurniture_u(vec2<f32>(iron, cc_streetfurniture_M_IRON),
                                vec2<f32>(wood, cc_streetfurniture_M_WOOD));
}

// One dumpster lid in its hinge frame: the point relative to the hinge line,
// turned back through the lid's opening angle about x.
fn cc_streetfurniture_lid_frame(p: vec3<f32>, cx: f32, ang: f32) -> vec3<f32> {
    let q = p - vec3<f32>(cx, -0.50, 1.20);
    let r = cc_streetfurniture_rot(q.yz, -ang);
    return vec3<f32>(q.x, r.x, r.y);
}

// The lid's opening angle, per half. Fully open lids lean against the wall
// (the hinge is 6 cm off it, so past ~92 degrees they would pass into the
// building); propped ones rest on the garbage; closed ones are closed. Never
// both closed — a shut dumpster is a green box.
fn cc_streetfurniture_lid_angle(v: cc_streetfurniture_Prop, side: i32) -> f32 {
    let d = fract(select(v.r.z * 3.7, v.r.z * 7.9 + v.r.y, side == 1));
    let open = 1.40 + 0.18 * fract(d * 11.3);
    let prop = 0.30 + 0.30 * fract(d * 5.1);
    let other_closed = fract(select(v.r.z * 7.9 + v.r.y, v.r.z * 3.7,
                                    side == 1)) >= 0.80;
    if (d < 0.45) {
        return open;
    }
    if (d < 0.80 || other_closed) {
        return prop;
    }
    return 0.0;
}

// A front-load dumpster, 1.8 x 1.05 x 1.2 m: the sloped lower front, the top
// lip, the fork pockets on the ends (hollow — you see into them), four
// casters, two HDPE lids on hinge knuckles along the back edge, and the
// garbage heaped inside up under the propped lids.
fn cc_streetfurniture_dumpster(p: vec3<f32>, v: cc_streetfurniture_Prop,
                               lod: i32) -> vec2<f32> {
    let q = vec3<f32>(cc_streetfurniture_rot(p.xy, (v.r.y - 0.5) * 0.07), p.z);
    let bot = 0.16;
    let top = 1.18;
    var body = cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, 0.5 * (bot + top)),
                                       vec3<f32>(0.90, 0.52, 0.5 * (top - bot)),
                                       0.025);
    // The slope: from the base 0.32 m in from the front up to z ~0.82.
    let slope = dot(vec2<f32>(q.y - 0.20, q.z - bot), vec2<f32>(0.90, -0.436));
    body = max(body, slope);
    let inner = max(cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, 1.20),
                                            vec3<f32>(0.875, 0.495, 1.0), 0.01),
                    slope + 0.025);
    body = max(body, -inner);
    let lip = max(cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, top - 0.02),
                                          vec3<f32>(0.915, 0.535, 0.028), 0.01),
                  -cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, top),
                                           vec3<f32>(0.875, 0.495, 0.2), 0.0));
    var res = vec2<f32>(min(body, lip),
                        select(cc_streetfurniture_M_PAINT,
                               cc_streetfurniture_M_INSIDE, inner < 0.0));
    // Fork pockets: a hollow steel sleeve along each end.
    let fq = vec3<f32>(abs(q.x) - 0.957, q.y + 0.02, q.z - 0.74);
    let pocket = max(cc_streetfurniture_rbox(fq, vec3<f32>(0.055, 0.40, 0.075),
                                             0.008),
                     -cc_streetfurniture_rbox(fq, vec3<f32>(0.040, 0.45, 0.058),
                                              0.0));
    res = cc_streetfurniture_u(res, vec2<f32>(pocket, cc_streetfurniture_M_PAINT));
    // Casters: a swivel plate, a fork, a wheel.
    if (lod <= 1) {
        let cy = select(-0.38, 0.13, q.y > -0.13);
        let wq = vec3<f32>(abs(q.x) - 0.76, q.y - cy, q.z);
        let plate = min(
            cc_streetfurniture_rbox(wq - vec3<f32>(0.0, 0.0, 0.145),
                                    vec3<f32>(0.045, 0.045, 0.010), 0.004),
            cc_streetfurniture_rbox(vec3<f32>(abs(wq.x) - 0.026, wq.y,
                                              wq.z - 0.10),
                                    vec3<f32>(0.005, 0.03, 0.045), 0.003));
        res = cc_streetfurniture_u(res, vec2<f32>(plate,
                                                  cc_streetfurniture_M_METAL));
        let wheel = max(length(wq.yz - vec2<f32>(0.0, 0.065)) - 0.065,
                        abs(wq.x) - 0.018);
        res = cc_streetfurniture_u(res, vec2<f32>(wheel,
                                                  cc_streetfurniture_M_RUBBER));
    } else {
        res = cc_streetfurniture_u(res, vec2<f32>(
            cc_streetfurniture_rbox(vec3<f32>(abs(q.x) - 0.76, q.y + 0.12,
                                              q.z - 0.08),
                                    vec3<f32>(0.04, 0.30, 0.08), 0.0),
            cc_streetfurniture_M_RUBBER));
    }
    // The lids.
    let la = cc_streetfurniture_lid_angle(v, 0);
    let lb = cc_streetfurniture_lid_angle(v, 1);
    let hx = select(-0.455, 0.455, q.x > 0.0);
    let lq = cc_streetfurniture_lid_frame(q, hx, select(lb, la, q.x > 0.0));
    var lid = cc_streetfurniture_rbox(lq - vec3<f32>(0.0, 0.535, 0.02),
                                      vec3<f32>(0.44, 0.535, 0.018), 0.012);
    lid = min(lid, cc_streetfurniture_rbox(lq - vec3<f32>(0.0, 1.058, -0.015),
                                           vec3<f32>(0.44, 0.014, 0.045), 0.008));
    res = cc_streetfurniture_u(res, vec2<f32>(lid, cc_streetfurniture_M_LID));
    if (lod <= 1) {
        // Hinge knuckles, two per lid.
        let kx = abs(abs(q.x) - 0.455) - 0.29;
        let kn = cc_streetfurniture_cylz(
            vec3<f32>(q.y + 0.50, q.z - 1.20, kx), 0.022, 0.045);
        res = cc_streetfurniture_u(res, vec2<f32>(kn, cc_streetfurniture_M_METAL));
    }
    // Garbage heaped in the box, kept under the lid on each half.
    var g = cc_streetfurniture_heap(q - vec3<f32>(0.0, 0.0, top),
                                    vec2<f32>(0.875, 0.495), 0.02, 4, v.seed,
                                    lod);
    g.x = max(g.x, lq.z);
    return cc_streetfurniture_u(res, g);
}

// Wheelie bins (240 l), one or two side by side, handles to the street and
// lids thrown back over them, hanging down the handle side — how bins are
// left on collection night — with bags standing out of the open tops and,
// in half of them, one more split open on the pavement beside.
fn cc_streetfurniture_wheelie(p: vec3<f32>, v: cc_streetfurniture_Prop,
                              lod: i32) -> vec2<f32> {
    let half = 0.5 * f32(v.n - 1);
    let i = clamp(round(p.x / 0.66 + half), 0.0, f32(v.n - 1));
    // The body sits 0.24 m wallward of the local origin, so the box that
    // holds it and the lid hanging out over the handle is symmetric.
    let q = vec3<f32>(p.x - (i - half) * 0.66 + 0.10 * f32(v.n - 1)
                          * select(0.0, 1.0, v.r.w > 0.5),
                      p.y + 0.24, p.z);
    // Tapered body, wider at the top.
    let t = clamp(q.z / 0.97, 0.0, 1.0);
    let hx = vec2<f32>(0.245 + 0.045 * t, 0.30 + 0.06 * t);
    var body = 0.96 * cc_streetfurniture_rbox(
        vec3<f32>(q.x * 0.29 / hx.x, q.y * 0.36 / hx.y, q.z - 0.51),
        vec3<f32>(0.29, 0.36, 0.46), 0.04);
    let inner = cc_streetfurniture_rbox(
        vec3<f32>(q.x * 0.29 / hx.x, q.y * 0.36 / hx.y, q.z - 1.10),
        vec3<f32>(0.275, 0.345, 0.55), 0.03);
    body = max(body, -inner);
    var res = vec2<f32>(body, select(cc_streetfurniture_M_PAINT,
                                     cc_streetfurniture_M_INSIDE, inner < 0.0));
    let lip = max(cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, 0.955),
                                          vec3<f32>(0.30, 0.375, 0.022), 0.01),
                  -cc_streetfurniture_rbox(q - vec3<f32>(0.0, 0.0, 1.0),
                                           vec3<f32>(0.27, 0.34, 0.2), 0.0));
    res = cc_streetfurniture_u(res, vec2<f32>(lip, cc_streetfurniture_M_PAINT));
    // Lid: hinged at the handle, thrown back over it through ~240 degrees
    // (the closed lid points wallward from the hinge; this turns its free
    // edge up, over, and down the street side, 27-33 degrees off vertical).
    let hq = q - vec3<f32>(0.0, 0.385, 0.985);
    let ang = 2.03 + 0.12 * v.r.z;
    let lr = cc_streetfurniture_rot(hq.yz, -ang);
    let lq = vec3<f32>(hq.x, lr.x, lr.y);
    var lid = cc_streetfurniture_rbox(lq - vec3<f32>(0.0, -0.39, 0.016),
                                      vec3<f32>(0.305, 0.39, 0.016), 0.01);
    lid = min(lid, cc_streetfurniture_rbox(lq - vec3<f32>(0.0, -0.765, -0.02),
                                           vec3<f32>(0.305, 0.014, 0.04), 0.008));
    res = cc_streetfurniture_u(res, vec2<f32>(lid, cc_streetfurniture_M_PAINT));
    // Handle bar and wheels.
    var hw = cc_streetfurniture_seg(q, vec3<f32>(-0.20, 0.425, 0.93),
                                    vec3<f32>(0.20, 0.425, 0.93), 0.018);
    let wq = vec3<f32>(abs(q.x) - 0.25, q.y - 0.30, q.z - 0.10);
    res = cc_streetfurniture_u(res, vec2<f32>(hw, cc_streetfurniture_M_PAINT));
    res = cc_streetfurniture_u(res, vec2<f32>(
        max(length(wq.yz) - 0.10, abs(wq.x) - 0.03),
        cc_streetfurniture_M_RUBBER));
    if (lod <= 1) {
        res = cc_streetfurniture_u(res, vec2<f32>(
            cc_streetfurniture_seg(q, vec3<f32>(-0.28, 0.30, 0.10),
                                   vec3<f32>(0.28, 0.30, 0.10), 0.012),
            cc_streetfurniture_M_METAL));
    }
    res = cc_streetfurniture_u(res, cc_streetfurniture_heap(
        q - vec3<f32>(0.0, 0.0, 0.97), vec2<f32>(0.27, 0.34), 0.04, 2,
        v.seed + u32(i), lod));
    if (v.r.y > 0.5) {
        // A bag on the pavement beside the end bin.
        let bq = p - vec3<f32>(0.33 * f32(v.n) + 0.12, -0.12, 0.23);
        let bh = cc_streetfurniture_item(v.seed, 9);
        res = cc_streetfurniture_u(res, vec2<f32>(
            cc_streetfurniture_bag(bq, vec3<f32>(0.24, 0.21, 0.26),
                                   bh.x * 6.28, lod),
            cc_streetfurniture_bag_mat(bh.y)));
    }
    return res;
}

// THE field: one function for every type, so the march, the four gradient
// taps and the shader's material lookup all call the same code once.
fn cc_streetfurniture_sdf(p: vec3<f32>, v: cc_streetfurniture_Prop, lod: i32)
        -> vec2<f32> {
    let t = v.typ;
    if (t == cc_streetfurniture_T_BAGS) {
        return cc_streetfurniture_pile(p, v, lod);
    }
    if (t == cc_streetfurniture_T_HYDRANT) {
        return cc_streetfurniture_hydrant(p, v, lod);
    }
    if (t == cc_streetfurniture_T_METER) {
        return cc_streetfurniture_meter(p, v, lod);
    }
    if (t == cc_streetfurniture_T_BOLLARD) {
        return cc_streetfurniture_bollard(p, v);
    }
    if (t == cc_streetfurniture_T_BASKET || t == cc_streetfurniture_T_CAN) {
        return cc_streetfurniture_basket(p, v, lod);
    }
    if (t == cc_streetfurniture_T_NEWS) {
        return cc_streetfurniture_news(p, v, lod);
    }
    if (t == cc_streetfurniture_T_BENCH) {
        return cc_streetfurniture_bench(p, v);
    }
    if (t == cc_streetfurniture_T_DUMPSTER) {
        return cc_streetfurniture_dumpster(p, v, lod);
    }
    return cc_streetfurniture_wheelie(p, v, lod);
}

fn cc_streetfurniture_lod(fpx: f32) -> i32 {
    return select(select(2, 1, fpx < cc_streetfurniture_MID_FP), 0,
                  fpx < cc_streetfurniture_FINE_FP);
}

// ---------------------------------------------------------------------------
// The trace
// ---------------------------------------------------------------------------

fn cc_streetfurniture_miss(ci: vec2<i32>) -> CityHit {
    return CityHit(false, 1e30, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0), 0, ci);
}

// The footprint the props are resolved at: the core's (which carries the
// app's LOD slider) sharpened toward the true pixel, never below ~1.5 of
// them. streetlife's cc_streetlife_fp_px, for streetlife's reason — a hinge
// is one feature, not a lattice that could moire.
fn cc_streetfurniture_fpx(t: f32) -> f32 {
    let pa = true_pixel_angle();
    return max(0.35 * max(pa, u.periodic.z), pa) * max(t, 0.0);
}

// A candidate: a box the ray entered, named by where it lives, so holding
// one costs five registers across the slot walk and not a whole Prop.
struct cc_streetfurniture_Cand {
    side: i32,
    lane: i32,
    k: i32,
    ta: f32,
    tb: f32,
}

fn cc_streetfurniture_trace(o: vec3<f32>, dir: vec3<f32>, ta: f32, tb: f32,
                            v: cc_streetfurniture_Prop, kind: i32,
                            ci: vec2<i32>) -> CityHit {
    let fpx = cc_streetfurniture_fpx(ta);
    let lod = cc_streetfurniture_lod(fpx);
    let eps = max(0.0012, 0.30 * fpx);
    let iters = select(cc_streetfurniture_ITERS, cc_streetfurniture_ITERS_FAR,
                       fpx > cc_streetfurniture_ITER_FP);
    // The ray into the prop's frame once: a signed permutation, so t stays
    // world distance.
    let ro = cc_streetfurniture_to_local(v, o);
    let rd = select(vec3<f32>(dir.y, v.out * dir.x, dir.z),
                    vec3<f32>(dir.x, v.out * dir.y, dir.z), v.ax == 0);
    var t = ta;
    var got = false;
    for (var i: i32 = 0; i < iters; i = i + 1) {
        let d = cc_streetfurniture_sdf(ro + t * rd, v, lod).x;
        if (d < eps) {
            got = true;
            break;
        }
        t = t + d * cc_streetfurniture_STEP;
        if (t > tb) {
            break;
        }
    }
    if (!got || t > tb) {
        return cc_streetfurniture_miss(ci);
    }
    // Normal: the four tetrahedron taps as a LOOP (four inline copies of
    // the field cost occupancy everywhere; SPEC, "Cost honesty").
    let q = ro + t * rd;
    let hs = max(eps, 0.0015);
    var g = vec3<f32>(0.0);
    for (var k: u32 = 0u; k < 4u; k = k + 1u) {
        let s = 2.0 * vec3<f32>(f32((0x9u >> k) & 1u), f32((0xau >> k) & 1u),
                                f32((0xcu >> k) & 1u)) - 1.0;
        g = g + s * cc_streetfurniture_sdf(q + s * hs, v, lod).x;
    }
    return CityHit(true, t, o + t * dir,
                   // @domain: the SDF's gradient at a surface point: nonzero off the medial axis
                   cc_streetfurniture_to_world(v, normalize(g)), kind, ci);
}

fn cc_streetfurniture_props_trace(o: vec3<f32>, dir: vec3<f32>,
                                  inv_dir: vec3<f32>, t0: f32, t1: f32,
                                  ci: vec2<i32>, cc: CityCell) -> CityHit {
    // Gate 1, no hash and no memory: the segment against the tallest thing
    // here. Every pixel looking at a facade, a roof, a cloud or the sky
    // leaves on this line.
    let za = o.z + t0 * dir.z;
    let zb = o.z + t1 * dir.z;
    if (min(za, zb) > cc_streetfurniture_Z_GATE || max(za, zb) < -0.5
        || !city_has_walk(cc)) {
        return cc_streetfurniture_miss(ci);
    }
    // Gate 2: past the wall lane's far edge nothing here survives.
    let fpx = cc_streetfurniture_fpx(t0);
    if (fpx > cc_streetfurniture_WALL_FAR.y) {
        return cc_streetfurniture_miss(ci);
    }
    var t_end = t1;
    var c0: cc_streetfurniture_Cand;
    var c1: cc_streetfurniture_Cand;
    var nc = 0;
    for (var side: i32 = 0; side < 4; side = side + 1) {
        let e = cc_streetfurniture_edge(ci, cc, side);
        if (!e.ok) {
            continue;
        }
        for (var lane: i32 = 0; lane < 2; lane = lane + 1) {
            let kerb = lane == 0;
            if (kerb && fpx > cc_streetfurniture_KERB_FAR.y) {
                continue;
            }
            if (!kerb && !e.wall_ok) {
                continue;
            }
            // The lane's slab: its across band, the usable along range, and
            // the height of the tallest thing it can hold.
            let u_lo = select(0.0, e.w - 1.45, kerb);
            let u_hi = select(1.30, e.w - 0.02, kerb);
            let c_a = e.bl + e.out * u_lo;
            let c_b = e.bl + e.out * u_hi;
            let ztop = cc_streetfurniture_FLOOR + select(
                cc_streetfurniture_WALL_TOP, cc_streetfurniture_KERB_TOP, kerb);
            let lo2 = vec2<f32>(e.a_lo, min(c_a, c_b));
            let hi2 = vec2<f32>(e.a_hi, max(c_a, c_b));
            let bmin = vec3<f32>(select(lo2.yx, lo2, e.ax == 0), 0.0);
            let bmax = vec3<f32>(select(hi2.yx, hi2, e.ax == 0), ztop);
            let sb = city_box_hit(o, inv_dir, bmin, bmax);
            let la = max(sb.x, t0);
            let lb = min(sb.y, t_end);
            if (sb.x > sb.y || lb <= la) {
                continue;
            }
            let pitch = select(cc_streetfurniture_WALL_PITCH,
                               cc_streetfurniture_KERB_PITCH, kerb);
            let pa = o + la * dir;
            let pb = o + lb * dir;
            let sa = select(pa.y, pa.x, e.ax == 0);
            let sc = select(pb.y, pb.x, e.ax == 0);
            let k0 = i32(floor((min(sa, sc) - e.a_cell) / pitch));
            let k1 = i32(floor((max(sa, sc) - e.a_cell) / pitch));
            let fwd = sc >= sa;
            let count = min(k1 - k0 + 1, cc_streetfurniture_MAX_SLOTS);
            var found = 0;
            // Near end first: the first box entered is the nearest one.
            for (var i: i32 = 0; i < count; i = i + 1) {
                let k = select(k1 - i, k0 + i, fwd);
                let v = cc_streetfurniture_prop(ci, cc, e, side, lane, k);
                if (!v.ok) {
                    continue;
                }
                let bx = cc_streetfurniture_box(v);
                let hb = city_box_hit(o, inv_dir, bx.lo, bx.hi);
                let ta = max(hb.x, la);
                let tb = min(hb.y, t_end);
                if (hb.x > hb.y || tb <= ta) {
                    continue;
                }
                let c = cc_streetfurniture_Cand(side, lane, k, ta, tb);
                // Keep the two nearest boxes of the cell. Boxes are disjoint,
                // so their intervals on the ray are too, and entry order is
                // depth order.
                if (nc == 0) {
                    c0 = c;
                } else if (ta < c0.ta) {
                    c1 = c0;
                    c0 = c;
                } else if (nc == 1 || ta < c1.ta) {
                    c1 = c;
                }
                nc = min(nc + 1, 2);
                if (nc == 2) {
                    t_end = min(t_end, c1.tb);
                }
                found = found + 1;
                if (found == 2) {
                    break;
                }
            }
        }
    }
    // The sphere trace, ONE call site: the nearest candidate first, and the
    // second only if the ray grazed past the first — without it, a ray
    // through the empty corner of a hydrant's box would lose the bench
    // behind it, and a ghost of the hydrant's box would cut the bench.
    for (var j: i32 = 0; j < nc; j = j + 1) {
        var c = c0;
        if (j == 1) {
            c = c1;
        }
        let e = cc_streetfurniture_edge(ci, cc, c.side);
        let v = cc_streetfurniture_prop(ci, cc, e, c.side, c.lane, c.k);
        let h = cc_streetfurniture_trace(o, dir, c.ta, c.tb, v,
                                         800 + 2 * c.side + c.lane, ci);
        if (h.hit) {
            return h;
        }
    }
    return cc_streetfurniture_miss(ci);
}

// ---------------------------------------------------------------------------
// Shading
// ---------------------------------------------------------------------------

struct cc_streetfurniture_Mat {
    alb: vec3<f32>,   // diffuse, relative to dry asphalt
    f0: f32,          // specular at normal incidence
    shine: f32,       // lobe exponent
    metal: bool,      // specular tinted by alb
}

fn cc_streetfurniture_mk(alb: vec3<f32>, f0: f32, shine: f32)
        -> cc_streetfurniture_Mat {
    return cc_streetfurniture_Mat(alb, f0, shine, false);
}

// Paint by type, from the prop's own draw. The palettes are what each thing
// is actually painted in a North American city, and the sodium light sorts
// them for us: red hydrants and yellow boxes stay colours, green bins and
// blue dumpsters go nearly black.
fn cc_streetfurniture_paint(v: cc_streetfurniture_Prop) -> vec3<f32> {
    let d = fract(v.r.w * 7.31 + v.r.z * 0.37);
    let t = v.typ;
    if (t == cc_streetfurniture_T_HYDRANT) {
        if (d < 0.35) { return vec3<f32>(0.55, 0.07, 0.05); }
        if (d < 0.55) { return vec3<f32>(0.85, 0.62, 0.10); }
        if (d < 0.85) { return vec3<f32>(0.42, 0.44, 0.46); }
        return vec3<f32>(0.08, 0.28, 0.12);
    }
    if (t == cc_streetfurniture_T_METER) {
        if (d < 0.45) { return vec3<f32>(0.07, 0.08, 0.10); }
        return vec3<f32>(0.035, 0.035, 0.04);
    }
    if (t == cc_streetfurniture_T_BOLLARD) {
        if (d < 0.45) { return vec3<f32>(0.05, 0.05, 0.055); }
        if (d < 0.75) { return vec3<f32>(0.85, 0.62, 0.10); }
        return vec3<f32>(0.30, 0.31, 0.32);
    }
    if (t == cc_streetfurniture_T_BASKET || t == cc_streetfurniture_T_CAN) {
        if (d < 0.60) { return vec3<f32>(0.07, 0.20, 0.10); }
        if (d < 0.85) { return vec3<f32>(0.05, 0.05, 0.055); }
        return vec3<f32>(0.14, 0.17, 0.22);
    }
    if (t == cc_streetfurniture_T_DUMPSTER) {
        if (d < 0.35) { return vec3<f32>(0.08, 0.20, 0.10); }
        if (d < 0.55) { return vec3<f32>(0.06, 0.12, 0.30); }
        if (d < 0.72) { return vec3<f32>(0.28, 0.12, 0.06); }
        if (d < 0.88) { return vec3<f32>(0.20, 0.21, 0.22); }
        return vec3<f32>(0.05, 0.05, 0.055);
    }
    // Wheelie bins.
    if (d < 0.35) { return vec3<f32>(0.05, 0.22, 0.08); }
    if (d < 0.60) { return vec3<f32>(0.20, 0.21, 0.22); }
    if (d < 0.78) { return vec3<f32>(0.05, 0.05, 0.055); }
    if (d < 0.90) { return vec3<f32>(0.05, 0.12, 0.40); }
    return vec3<f32>(0.20, 0.10, 0.05);
}

fn cc_streetfurniture_news_paint(d: f32) -> vec3<f32> {
    if (d < 0.22) { return vec3<f32>(0.90, 0.70, 0.08); }
    if (d < 0.40) { return vec3<f32>(0.08, 0.22, 0.65); }
    if (d < 0.55) { return vec3<f32>(0.65, 0.06, 0.05); }
    if (d < 0.68) { return vec3<f32>(0.08, 0.40, 0.14); }
    if (d < 0.82) { return vec3<f32>(0.85, 0.85, 0.83); }
    if (d < 0.92) { return vec3<f32>(0.05, 0.05, 0.055); }
    return vec3<f32>(0.90, 0.40, 0.06);
}

fn cc_streetfurniture_material(m: f32, v: cc_streetfurniture_Prop)
        -> cc_streetfurniture_Mat {
    let mi = i32(round(m));
    if (mi >= 30) {
        let h = cc_streetfurniture_item(v.seed, mi - 30);
        return cc_streetfurniture_mk(cc_streetfurniture_news_paint(h.w), 0.04,
                                     110.0);
    }
    switch (mi) {
        case 1: {
            // Black polyethylene: almost no diffuse, and the tightest lobe on
            // the street.
            return cc_streetfurniture_mk(vec3<f32>(0.028, 0.029, 0.032), 0.05,
                                         420.0);
        }
        case 2: {
            // Clear and white bags, the contents dimly showing through.
            return cc_streetfurniture_mk(vec3<f32>(0.52, 0.60, 0.64), 0.045,
                                         260.0);
        }
        case 3: {
            return cc_streetfurniture_mk(vec3<f32>(0.04, 0.09, 0.30), 0.05,
                                         320.0);
        }
        case 4: {
            // Cardboard, rained on: darker than dry and completely matte.
            return cc_streetfurniture_mk(vec3<f32>(0.40, 0.26, 0.14), 0.02,
                                         8.0);
        }
        case 5: {
            // Beer-bottle brown; the green of a wine bottle, at sodium, is
            // the same near-black, and bright green read as a leaf.
            return cc_streetfurniture_mk(vec3<f32>(0.16, 0.08, 0.03), 0.05,
                                         700.0);
        }
        case 6: {
            return cc_streetfurniture_Mat(vec3<f32>(0.75, 0.75, 0.80), 0.55,
                                          90.0, true);
        }
        case 7: {
            return cc_streetfurniture_mk(vec3<f32>(0.02), 0.03, 18.0);
        }
        case 8: {
            return cc_streetfurniture_Mat(vec3<f32>(0.18, 0.18, 0.19), 0.30,
                                          55.0, true);
        }
        case 10: {
            // HDPE lids: black, textured, a broad dull sheen.
            return cc_streetfurniture_mk(vec3<f32>(0.035, 0.037, 0.040), 0.04,
                                         35.0);
        }
        case 11: {
            return cc_streetfurniture_mk(vec3<f32>(0.03), 0.045, 900.0);
        }
        case 12: {
            // Inside a container: the same steel, in its own shadow.
            return cc_streetfurniture_mk(0.22 * cc_streetfurniture_paint(v),
                                         0.02, 20.0);
        }
        case 13: {
            // Hydrant caps and nut: a second colour against the body.
            let d = fract(v.r.y * 5.77);
            let c = select(select(vec3<f32>(0.40, 0.42, 0.44),
                                  vec3<f32>(0.55, 0.07, 0.05), d < 0.6),
                           vec3<f32>(0.05, 0.05, 0.055), d < 0.25);
            let body = cc_streetfurniture_paint(v);
            return cc_streetfurniture_mk(
                select(c, body, v.typ == cc_streetfurniture_T_BOLLARD), 0.04,
                110.0);
        }
        case 14: {
            return cc_streetfurniture_mk(vec3<f32>(0.34, 0.20, 0.10), 0.03,
                                         30.0);
        }
        case 15: {
            return cc_streetfurniture_mk(vec3<f32>(0.035, 0.038, 0.037), 0.04,
                                         60.0);
        }
        default: {
            return cc_streetfurniture_mk(cc_streetfurniture_paint(v), 0.04,
                                         110.0);
        }
    }
}

// The lamp heads' glints: the eight heads city_street_light sums, as point
// sources seen in a lobe of exponent `shine` about the reflected ray — and
// only on the lamp lines city_lamp_lines lights, so a glint never shows a
// lamp that the pools and city_street_light say is not there. The
// lobe is normalised ((n + 2) / 2 pi), so tightening it concentrates the same
// energy into a smaller, brighter spark rather than dimming it — which is
// what black plastic does: the highlight is small and it clips.
fn cc_streetfurniture_glints(p: vec3<f32>, n: vec3<f32>, rf: vec3<f32>,
                             shine: f32) -> f32 {
    let cellm = u.ocean_params.x;
    let h2 = CITY_LAMP_HEAD_Z * CITY_LAMP_HEAD_Z;
    let norm = (shine + 2.0) * 0.15915494;
    let lit = city_lamp_lines(p.xy);
    var e = 0.0;
    for (var dirn: i32 = 0; dirn < 2; dirn = dirn + 1) {
        let along_y = dirn == 0;
        if (!select(lit.y, lit.x, along_y)) {
            continue;
        }
        let c = select(p.y, p.x, along_y);
        let a = select(p.x, p.y, along_y);
        let k = i32(round(c / cellm));
        let amp = select(1.0, 1.6, city_is_avenue(k));
        let inset = city_lamp_inset(k);
        let lat = city_lamp_lattice(k);
        let j0 = floor((a - lat.y) / lat.x);
        for (var sd: i32 = 0; sd < 2; sd = sd + 1) {
            let sg = select(-1.0, 1.0, sd == 1);
            let hc = f32(k) * cellm + sg * (inset - CITY_LAMP_ARM);
            for (var jj: i32 = 0; jj < 2; jj = jj + 1) {
                let ha = lat.y + (j0 + f32(jj)) * lat.x;
                let head = select(vec3<f32>(ha, hc, CITY_LAMP_HEAD_Z),
                                  vec3<f32>(hc, ha, CITY_LAMP_HEAD_Z), along_y);
                let lv = head - p;
                let r2 = max(dot(lv, lv), 0.25);
                let l = lv * inverseSqrt(r2);
                let lobe = pow(max(dot(rf, l), 0.0), shine) * norm;
                e = e + amp * h2 / r2 * max(l.z, 0.0) * lobe
                      * step(0.0, dot(n, l));
            }
        }
    }
    return city_lamp_scale(p.xy) * e;
}

fn cc_streetfurniture_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    let local = (h.kind - 800) % 8;
    let side = local / 2;
    let lane = local % 2;
    let e = cc_streetfurniture_edge(h.cell, cc, side);
    let pitch = select(cc_streetfurniture_WALL_PITCH,
                       cc_streetfurniture_KERB_PITCH, lane == 0);
    let along = select(h.pos.y, h.pos.x, e.ax == 0);
    let k = i32(floor((along - e.a_cell) / pitch));
    let v = cc_streetfurniture_prop(h.cell, cc, e, side, lane, k);
    if (!v.ok) {
        // The slot the hit came from must re-derive; if it does not, the
        // placement and the trace disagree, and that should be seen.
        return vec3<f32>(1.0, 0.0, 1.0);
    }
    let fpx = max(0.35 * fp, true_pixel_angle() * max(h.t, 0.0));
    let pl = cc_streetfurniture_to_local(v, h.pos);
    let n = h.normal;
    let mid = cc_streetfurniture_sdf(pl, v, cc_streetfurniture_lod(fpx)).y;
    let mat = cc_streetfurniture_material(mid, v);
    let rf = reflect(dir, n);
    let cosv = clamp(-dot(dir, n), 0.0, 1.0);
    // @domain: cosv is clamped to [0, 1] just above
    let schlick = pow(1.0 - cosv, 5.0);

    // Diffuse: the sodium heads, the lit pavement from below, the store
    // window behind, and the night fill.
    let lamp = city_street_light(h.pos, n);
    let floor_l = city_street_light(vec3<f32>(h.pos.xy, 0.0),
                                    vec3<f32>(0.0, 0.0, 1.0))
                * cc_streetfurniture_WALK_WET;
    var light = lamp + floor_l * (cc_streetfurniture_BOUNCE
                                  * (0.5 - 0.5 * n.z));
    let store = city_storefront_glow(cc);
    let bq = max(max(cc.b1min.xy - h.pos.xy, h.pos.xy - cc.b1max.xy),
                 vec2<f32>(0.0));
    let bdist = length(bq);
    let to_bldg = -bq / max(bdist, 1e-3);
    let store_w = exp(-bdist / 1.8)
                * (1.0 - smoothstep(CITY_STORE_H - 0.5, CITY_STORE_H + 1.0,
                                    h.pos.z));
    light = light + store * (0.05 * store_w
                             * (0.3 + 0.7 * max(dot(n.xy, to_bldg), 0.0)));
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * city_glow_sample(h.pos.xy, 3.0))
             + CITY_MOONLIGHT * max(u.sun_dir.z, 0.0);
    light = light + fill * (1.5 + n.z);
    var alb = mat.alb;
    if (v.typ == cc_streetfurniture_T_DUMPSTER
        && round(mid) == cc_streetfurniture_M_PAINT) {
        // A dumpster's skin is stiffened by pressed ribs, vertical on the
        // front and ends, and it is grimiest where the truck's forks and the
        // pavement's splash reach. Bands, filtered to their mean past a pixel.
        let nl = select(vec3<f32>(n.y, v.out * n.x, n.z),
                        vec3<f32>(n.x, v.out * n.y, n.z), v.ax == 0);
        let run = select(pl.y, pl.x, abs(nl.y) > abs(nl.x));
        let rib = city_stripes(run + 2.0, 0.0, 0.05, 0.45, fpx);
        let grime = 1.0 - 0.45 * (1.0 - smoothstep(0.15, 0.75, pl.z));
        alb = alb * (1.0 - 0.45 * rib * step(abs(nl.z), 0.5)) * grime;
    }
    let diffuse = (cc_streetfurniture_ALB_GAIN * alb) * light;

    // Wet: a water film over everything, glossier than any paint, and the
    // material's own lobe under it.
    let f_mat = mat.f0 + (1.0 - mat.f0) * schlick;
    let f_wat = cc_streetfurniture_WATER_F0
              + (1.0 - cc_streetfurniture_WATER_F0) * schlick;
    let tint = select(vec3<f32>(1.0), mat.alb / max(mat.alb.g, 1e-3),
                      mat.metal);
    var spec = CITY_LAMP_COLOR * tint
             * (f_mat * cc_streetfurniture_glints(h.pos, n, rf, mat.shine));
    spec = spec + CITY_LAMP_COLOR
         * (f_wat * cc_streetfurniture_glints(h.pos, n, rf,
                                              cc_streetfurniture_WATER_N));
    // What the reflected ray sees when it is not a lamp: the facades and the
    // skyglow at and above the horizon, the storefront if it faces one, and
    // the lit pavement only when it really looks DOWN at it. The first pass
    // blended the pavement in from the horizon up, which gave every flank a
    // floor of radiance 0.03 — display 0.3 — and no black bag could be
    // black.
    // The pavement a downward reflection sees is where that ray lands, not
    // the pool at the prop's own foot: a bag at the kerb reflects the road.
    let land = h.pos.xy + rf.xy * (h.pos.z / max(-rf.z, 0.05));
    let floor_r = city_street_light(vec3<f32>(land, 0.0),
                                    vec3<f32>(0.0, 0.0, 1.0))
                * cc_streetfurniture_FLOOR_REFL;
    let env = mix(floor_r,
                  fill + CITY_PALETTE_MEAN * (0.015 + 0.06 * cc.lit_frac),
                  smoothstep(-0.45, -0.05, rf.z))
            + store * (0.5 * store_w * max(dot(rf.xy, to_bldg), 0.0));
    // The film's own reflection of the scene is left to the lamp glints: rain
    // on a vertical face is a few beads, not a mirror, and carrying it here
    // too put every dark flank at mid-grey (a 20:1 pavement-to-paint ratio
    // is only 0.87 to 0.45 after this tone curve, so a few percent of
    // pavement is all a dark prop has room for).
    spec = spec + env * f_mat * tint;
    // Inside a container the rim hides the lamp heads: no glints there.
    var col = select(diffuse + spec, diffuse,
                     round(mid) == cc_streetfurniture_M_INSIDE);

    // Past the lane's far edge the prop has dissolved into the pavement
    // under it — faded into the ground's own radiance, not switched off.
    let far = select(cc_streetfurniture_WALL_FAR, cc_streetfurniture_KERB_FAR,
                     lane == 0);
    let fade = smoothstep(far.x, far.y, fpx);
    if (fade > 0.0) {
        col = mix(col, city_ground_radiance(vec3<f32>(h.pos.xy, 0.0), h.cell, cc,
                                            dir, fp),
                  fade);
    }
    return col;
}

fn cc_extra_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>)
        -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    let h_skyway = cc_skyway_trace(o, dir, inv_dir);
    if (h_skyway.hit && h_skyway.t < res.t) { res = h_skyway; }
    return res;
}

fn cc_cell_props_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                       t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    let h_rooftopworks = cc_rooftopworks_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_rooftopworks.hit && h_rooftopworks.t < res.t) { res = h_rooftopworks; }
    let h_skybridges = cc_skybridges_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_skybridges.hit && h_skybridges.t < res.t) { res = h_skybridges; }
    let h_streetlife = cc_streetlife_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_streetlife.hit && h_streetlife.t < res.t) { res = h_streetlife; }
    let h_manholesteam = cc_manholesteam_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_manholesteam.hit && h_manholesteam.t < res.t) { res = h_manholesteam; }
    let h_industry = cc_industry_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_industry.hit && h_industry.t < res.t) { res = h_industry; }
    return res;
}

fn cc_component_shade(h: CityHit, cc: CityCell, dir: vec3<f32>, fp: f32)
        -> vec3<f32> {
    if (h.kind >= 200 && h.kind < 300) {
        return cc_skyway_shade(h, cc, dir, fp);
    }
    if (h.kind >= 600 && h.kind < 700) {
        return cc_rooftopworks_shade(h, cc, dir, fp);
    }
    if (h.kind >= 500 && h.kind < 600) {
        return cc_skybridges_shade(h, cc, dir, fp);
    }
    if (h.kind >= 100 && h.kind < 200) {
        return cc_streetlife_shade(h, cc, dir, fp);
    }
    if (h.kind >= 900 && h.kind < 1000) {
        return cc_manholesteam_shade(h, cc, dir, fp);
    }
    if (h.kind >= 700 && h.kind < 800) {
        return cc_industry_shade(h, cc, dir, fp);
    }
    if (h.kind >= 800 && h.kind < 900) {
        return cc_streetfurniture_shade(h, cc, dir, fp);
    }
    // An unclaimed component kind is a bug, and this is its color.
    return vec3<f32>(1.0, 0.0, 1.0);
}

fn cc_facade_detail(cc: CityCell, h: CityHit, dir: vec3<f32>,
                    uc: f32, vc: f32, fp: f32)
        -> vec3<f32> {
    var e = vec3<f32>(0.0);
    e = e + cc_facadeworks_detail(cc, h, dir, uc, vc, fp);
    e = e + cc_adscreens_facade(cc, h, dir, uc, vc, fp);
    e = e + cc_industry_facade(cc, h, dir, uc, vc, fp);
    return e;
}

fn cc_facade_cover(cc: CityCell, h: CityHit, uc: f32, vc: f32, fp: f32)
        -> f32 {
    var m = 0.0;
    m = max(m, cc_facadeworks_cover(cc, h, uc, vc, fp));
    m = max(m, cc_adscreens_cover(cc, h, uc, vc, fp));
    return m;
}

fn cc_window_glyph(cc: CityCell, wh: vec4<f32>, pane_uv: vec2<f32>,
                   deep_uv: vec2<f32>, fp: f32)
        -> vec3<f32> {
    var t = vec3<f32>(1.0);
    t = t * cc_windowlife_glyph(cc, wh, pane_uv, deep_uv, fp);
    return t;
}

fn cc_window_glyph_mean()
        -> vec3<f32> {
    var t = vec3<f32>(1.0);
    t = t * cc_windowlife_glyph_mean();
    return t;
}

fn cc_media(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>, t_max: f32,
            pixel_angle: f32, rnd: f32) -> vec4<f32> {
    var acc = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    let m_manholesteam = cc_manholesteam_media(o, dir, inv_dir, t_max, pixel_angle, rnd);
    acc = vec4<f32>(acc.rgb + acc.a * m_manholesteam.rgb, acc.a * m_manholesteam.a);
    return acc;
}

fn cc_near_props_trace(o: vec3<f32>, dir: vec3<f32>, inv_dir: vec3<f32>,
                       t0: f32, t1: f32, ci: vec2<i32>, cc: CityCell)
        -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    let h_streetlife = cc_streetlife_near_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_streetlife.hit && h_streetlife.t < res.t) { res = h_streetlife; }
    let h_streetfurniture = cc_streetfurniture_props_trace(o, dir, inv_dir, t0, t1, ci, cc);
    if (h_streetfurniture.hit && h_streetfurniture.t < res.t) { res = h_streetfurniture; }
    return res;
}

fn cc_roof_detail(cc: CityCell, h: CityHit, fp: f32)
        -> vec3<f32> {
    var e = vec3<f32>(0.0);
    e = e + cc_industry_roof(cc, h, fp);
    return e;
}
// <<< GENERATED CITY COMPONENTS
// @end city



// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> @builtin(position) vec4<f32> {
    // Full-screen triangle.
    let x = f32(i32(vi) / 2) * 4.0 - 1.0;
    let y = f32(i32(vi) & 1) * 4.0 - 1.0;
    return vec4<f32>(x, y, 0.0, 1.0);
}

// One field-x plane of the sun-tau cache. The host renders this into a 2D
// r16float target of size (cache_nz, cache_ny) for slice u.light_cache.y,
// then copies the target into that depth slice of the light_tau texture —
// 3D textures are not renderable, and r16float is not a storage format, but
// it IS renderable, so the bake is a render pass rather than a compute pass.
// Rendering slice by slice is also what lets the browser spread a bake over
// frames instead of stalling one.
//
// Each texel evaluates the exact live march — light_march_tau through
// sample_level_at, nest included — at the cache texel's own world position,
// with dt_floor = 0 (full quadrature: the bake is paid once, so it takes the
// fine step everywhere) and zero jitter (a static cache cannot average a
// randomized phase away, so it takes the unbiased-enough left-endpoint rule
// the near field always used). Texel i sits AT data coordinate i, matching
// sample_level's convention, so sample_light_tau reads back exactly what was
// baked at texel centers.
// ---------------------------------------------------------------------------
// The surface pre-pass
// ---------------------------------------------------------------------------
//
// The city is an opaque surface traced in closed form — a DDA over the block
// grid — and its tracing is register-hungry. In fs_main it shared a kernel
// with the cloud march, so its registers were the march's too: every surface feature compiled in cost
// every march pixel occupancy, whether its rays ever reached that feature or
// not. So the surface is traced in a pass of its own, fs_surface, one
// fragment per render pixel, before every fs_main pass of a frame, into the
// target fs_main reads at group 1. The march keeps only the composite (the t >= t_surface test,
// the dt clamp and the post-loop fallback), with the same radiance at the
// same t as when it traced the surface itself.
//
// Both entries take their ray from camera_ray, so the pass traces exactly
// the ray the march composites: the same pixel, subpixel stream and frame
// index, which is what keeps sub-pixel surface detail accumulating.
//
// A surface whose full detail is too register-hungry even for its own pass
// splits in two: fs_surface draws what every pixel needs cheaply, and
// fs_surface_refine re-traces only the pixels that need more, reading the
// first stage's result at group 1 binding 1 and writing the final one. The
// second stage's registers are paid only by its own kernel, which most
// pixels leave at once. Each surface decides its own early-out. The city
// marks the pixels its facade shell can touch in the sign bit of red
// (CITY_SHELL_MARK: set by surface_pass_city for a ray that entered a
// building's relief envelope within the shell's reach),
// returns every other one untouched, and clears the mark on the rest; t
// leaves it as t came, sign included, unless the shell replaced the hit.
// Which surfaces have the second stage is the hosts' list
// (soar_host.SURFACE_REFINE_SURFACES, renderer.js _hasRefineStage).
//
// One function per surface, chosen by the scene's specialization. What
// belongs to the surface and sits in front of it along the ray as part of
// its look (city fog) is folded into its rgb here. A semi-transparent layer
// that must also show against the sky, or with a cloud in front of or
// behind it (the city's steam), goes to the VEIL instead (@location(1),
// veil_pack), which fs_main composites at the veil's own depth.

struct CameraRay {
    dir: vec3<f32>,
    frame_index: u32,       // this frame's index in the accumulation
    strat_pixel: vec2<u32>, // the pixel that seeds the stratified scrambles
    pixel_angle: f32,       // the city's resolving angle (rad/px)
    true_pixel_angle: f32,  // one pixel's angle, without the LOD slider
    jitter_amp: f32,        // jitter_on * jitter_scale
}

// One pixel's angular size: the frame's own, before any LOD floor. What a
// surface filters its texture over (a wider footprint only blurs it; the
// view-step LOD angle decides how much work is done, not how sharp).
fn true_pixel_angle() -> f32 {
    return 2.0 * u.cam_origin.w / u.params.x;
}

// The angle a surface's level of detail resolves at: the true pixel's, or
// the view-step LOD angle (u.periodic.z, the app's one LOD slider) when that
// is coarser. See camera_ray.
fn lod_pixel_angle() -> f32 {
    return max(true_pixel_angle(), u.periodic.z);
}

fn camera_ray(frag_pos: vec4<f32>) -> CameraRay {
    var cr: CameraRay;
    let img_w = u.params.x;
    let img_h = u.params.y;
    let tan_half_fov = u.cam_origin.w;
    let aspect = u.cam_forward.w;
    let subpixel_on = u.flags.x;
    let jitter_scale = clamp(u.flags.y, 0.0, 1.0);
    // This frame's index in the accumulation, the sequence coordinate every
    // stratified stream is indexed by, and this pixel, which seeds their
    // scrambles (see the strat1/strat2 block).
    cr.frame_index = u32(max(u.sun_dir.w, 0.0));
    cr.strat_pixel = vec2<u32>(frag_pos.xy);

    // Pixel -> camera ray. Framebuffer y=0 is the image top, matching the
    // witness convention ndc_y = 1 - 2*(py+0.5)/h.
    var sample_pos = frag_pos.xy;
    if (subpixel_on > 0.5) {
        let subpixel_offset = strat2(cr.frame_index, cr.strat_pixel,
                                     STRAT_STREAM_SUBPIXEL,
                                     vec2<f32>(STRAT_ALPHA_1, STRAT_ALPHA_2));
        sample_pos = sample_pos
                     + (subpixel_offset - vec2<f32>(0.5)) * jitter_scale;
    }
    let ndc_x = (2.0 * sample_pos.x / img_w - 1.0) * tan_half_fov;
    let ndc_y = (1.0 - 2.0 * sample_pos.y / img_h) * tan_half_fov / aspect;
    // @domain: forward plus in-plane offsets of the camera's orthonormal basis
    cr.dir = normalize(u.cam_forward.xyz
                       + ndc_x * u.cam_right.xyz
                       + ndc_y * u.cam_up.xyz);
    // The surfaces' LOD angle is the same knob as the cloud march's: the
    // larger of the true pixel angle and the view-step LOD angle
    // (u.periodic.z, the app's one LOD slider). Coarsening the slider cuts
    // the surfaces' work (how far the city's facade shell reaches) exactly
    // as it coarsens the march — one
    // lever, one degrees-not-meters law for the whole scene. What a surface
    // FILTERS its texture over stays the true pixel's footprint: a wider
    // one would only blur it.
    cr.true_pixel_angle = true_pixel_angle();
    cr.pixel_angle = lod_pixel_angle();
    cr.jitter_amp = u.cam_up.w * jitter_scale;
    return cr;
}

// @section city
// The city under this ray: fogged radiance and distance, t = 1e30 on a miss.
fn surface_pass_city(dir: vec3<f32>, pixel_angle: f32) -> vec4<f32> {
    // THE CITY FRAME: world xy minus the row-24 surface offset, folded into
    // the primary tile (city_camera_origin — the one entry). The whole city
    // system — the DDA, every cell index and pcg2d seed, plot slabs, street
    // lines, component routes, hit positions, the fog's glow probe — runs in
    // this frame, and because the city is a pure function of it, the
    // frame's whole-tile ambiguity is invisible. t values are
    // translation-invariant, so depth compositing against the cloud march
    // needs no conversion; the one city input that must STAY world is the
    // uplight probe's cloud sampling (see the city_glow_sample call in the
    // march loop).
    //
    // This stage traces and shades only. What stands on the street and what
    // the street reflects are the street stage's (surface_street_city): kept
    // out of here, this stage stays in master's register tier (128 on the
    // 5080; the wet reflection, the steam and the street furniture compiled
    // in took it to 168, and every city pixel paid for that occupancy). A
    // ground hit is FLAGGED for that stage by a negative t — city-facades'
    // refinement passes it through, sign and all — and the street stage
    // writes it back positive.
    let city_o = city_camera_origin();
    let chit = city_trace(city_o, dir, 0.0, CITY_TRACE_RANGE, CITY_TRACE_ALL);
    // The refinement stage's flag, CITY_SHELL_MARK: the sign bit of red
    // (radiance is never negative) marks a pixel whose ray entered a
    // building's relief envelope within the shell's reach before its plain
    // hit, the only pixels the facade shell can change. surface_refine_city
    // returns every other pixel untouched and clears the bit on every marked
    // one, so no later reader sees it. A bit rather than a negated value: a
    // miss has red 0, and -0.0 only survives as a bit. (t's sign is the
    // street stage's ground flag, below.)
    let t_lim = min(select(1e30, chit.t, chit.hit),
                    city_shell_reach(city_o, dir, pixel_angle));
    let near = city_shell_on_wall(chit, t_lim)
               || city_shell_envelope(city_o, dir, t_lim);
    let mark = select(0u, CITY_SHELL_MARK, near);
    if (!chit.hit) {
        return vec4<f32>(bitcast<f32>(mark), 0.0, 0.0, 1e30);
    }
    let rgb = city_fog(city_shade(chit, dir, pixel_angle * chit.t,
                                  true_pixel_angle() * chit.t, true),
                       city_o, dir, chit.t, chit.pos);
    // Flagged only where a reflection can be traced: past CITY_REFL_LOD the
    // wet street's reflection is its environment mean, measured at under
    // 1e-4 of display brightness on the wide views (base 8e-5, horizon
    // 3e-5), while evaluating the ground material again for every distant
    // ground pixel just to weight it cost the street stage ~12% on the
    // horizon view. So it is left out, and the stand-in only fades the
    // traced reflection out across the hand-off band.
    let flag = chit.kind == 0 && pixel_angle * chit.t < CITY_REFL_LOD.y;
    return vec4<f32>(bitcast<f32>(bitcast<u32>(rgb.x) | mark), rgb.yz,
                     select(chit.t, -chit.t, flag));
}

// The refinement stage: the facade shell, traced where the plain surface
// pass left the camera's view within its reach. The plain pass (city_trace)
// found t_prev, the nearest opaque thing along the ray with every building a
// plain box; this walks the same cells again, but only as far as
// min(t_prev, the shell's reach), testing each building's box inflated by
// its relief. A building that yields a nearer hit — relief standing proud
// of a wall the ray would have missed or met later — replaces t_prev; so
// does the building that OWNED t_prev (its own wall or roof), whose shell
// may put the hit deeper (the glass behind a reveal) or keep it where it was.
// Everything else the plain pass found stands. Returns the hit that
// replaces t_prev, or no hit when t_prev stands.
const CITY_SHELL_REFINE_MAX_CELLS: i32 = 64;
// How far along this ray the block walk reaches before its cell cap: the
// shell's reach ends there too. Only a narrow view at a high resolution
// with the view-step LOD at 0 ever sees it (4K at a 12 degree fov: 90 m
// cells, about 4.8 km); per ray, continuous in direction, since each step
// covers cell / (|dx| + |dy|).
fn city_shell_cap(o: vec3<f32>, dir: vec3<f32>) -> f32 {
    var t0 = 0.0;
    if (o.z > CITY_SLAB_TOP && dir.z < -1e-7) {
        t0 = (CITY_SLAB_TOP - o.z) / dir.z;
    }
    return t0 + f32(CITY_SHELL_REFINE_MAX_CELLS - 2) * u.ocean_params.x
                / max(abs(dir.x) + abs(dir.y), 1e-6);
}

// The relief's fade to flat before the cap: 0 until the last quarter, 1 at it.
fn city_shell_cap_fade(t: f32, t_cap: f32) -> f32 {
    return smoothstep(0.75 * t_cap, t_cap, t);
}

// The shell's reach along a ray: its footprint limit, or the walk's cap.
fn city_shell_reach(o: vec3<f32>, dir: vec3<f32>, pixel_angle: f32) -> f32 {
    return min(CITY_SHELL_FP_FLAT / max(pixel_angle, 1e-9),
               city_shell_cap(o, dir));
}

// surface_pass_city's mark for the refinement: the sign bit of red.
const CITY_SHELL_MARK: u32 = 0x80000000u;

// The block-grid walk the shell's two passes share: the envelope probe and
// the refinement. The same DDA as city_trace, from the slab top.
struct CityWalk {
    ci: vec2<i32>,
    stp: vec2<i32>,
    inv3: vec3<f32>,
    tmax: vec2<f32>,
    tdelta: vec2<f32>,
    t_cur: f32,
}

// `live` false: the ray never enters the slab.
fn city_walk_start(o: vec3<f32>, dir: vec3<f32>, w: ptr<function, CityWalk>)
        -> bool {
    let cell = u.ocean_params.x;
    var t0 = 0.0;
    if (o.z > CITY_SLAB_TOP) {
        if (dir.z >= -1e-7) {
            return false;
        }
        t0 = (CITY_SLAB_TOP - o.z) / dir.z;
    }
    let p0 = o + t0 * dir;
    let ci = vec2<i32>(floor(p0.xy / cell));
    let inv3 = vec3<f32>(
        select(1e30, 1.0 / dir.x, abs(dir.x) > 1e-9),
        select(1e30, 1.0 / dir.y, abs(dir.y) > 1e-9),
        select(1e30, 1.0 / dir.z, abs(dir.z) > 1e-9));
    let cmin0 = vec2<f32>(ci) * cell;
    (*w).ci = ci;
    (*w).stp = vec2<i32>(select(-1, 1, dir.x > 0.0),
                         select(-1, 1, dir.y > 0.0));
    (*w).inv3 = inv3;
    (*w).tmax = vec2<f32>(
        select(1e30, t0 + (select(cmin0.x, cmin0.x + cell, dir.x > 0.0)
                           - p0.x) * inv3.x, abs(dir.x) > 1e-9),
        select(1e30, t0 + (select(cmin0.y, cmin0.y + cell, dir.y > 0.0)
                           - p0.y) * inv3.y, abs(dir.y) > 1e-9));
    (*w).tdelta = vec2<f32>(cell * abs(inv3.x), cell * abs(inv3.y));
    (*w).t_cur = t0;
    return true;
}

fn city_walk_step(w: ptr<function, CityWalk>) {
    if ((*w).tmax.x < (*w).tmax.y) {
        (*w).ci.x = (*w).ci.x + (*w).stp.x;
        (*w).t_cur = (*w).tmax.x;
        (*w).tmax.x = (*w).tmax.x + (*w).tdelta.x;
    } else {
        (*w).ci.y = (*w).ci.y + (*w).stp.y;
        (*w).t_cur = (*w).tmax.y;
        (*w).tmax.y = (*w).tmax.y + (*w).tdelta.y;
    }
}

// Does the ray enter this building's relief envelope (every tier's box grown
// by CITY_SHELL_OUT_MAX) by t_lim? Everything the shell can return for it —
// relief, glass, its plain slab — lies inside.
fn city_shell_enters(o: vec3<f32>, inv3: vec3<f32>, cc: CityCell,
                     t_lim: f32) -> bool {
    let grow = vec3<f32>(CITY_SHELL_OUT_MAX, CITY_SHELL_OUT_MAX, 0.0);
    for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
        let bx = city_tier_box(cc, k);
        let hg = city_box_hit(o, inv3, bx.bmin - grow, bx.bmax + grow);
        if (hg.x <= hg.y && hg.y > 0.0 && max(hg.x, 0.0) <= t_lim) {
            return true;
        }
    }
    return false;
}

// A plain hit on a building's wall, inside the shell's reach, is inside that
// building's envelope, which the ray entered strictly before it: the 1.5 m
// the envelope stands out from the wall. Most marked pixels are these, and
// they need no walk. (The z bounds are open: a hit on a box edge is left to
// the walk.)
fn city_shell_on_wall(h: CityHit, t_lim: f32) -> bool {
    if (!h.hit || h.kind != 1 || h.t >= t_lim) {
        return false;
    }
    let cc = city_cell(h.cell);
    if (!cc.built || cc.land_use == CITY_USE_INDUSTRIAL) {
        return false;
    }
    let grow = CITY_SHELL_OUT_MAX - 0.01;
    for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
        let bx = city_tier_box(cc, k);
        if (all(h.pos.xy > bx.bmin.xy - grow)
            && all(h.pos.xy < bx.bmax.xy + grow)
            && h.pos.z > bx.bmin.z && h.pos.z < bx.bmax.z) {
            return true;
        }
    }
    return false;
}

// Does the ray enter any building's relief envelope (its boxes grown by the
// deepest relief, CITY_SHELL_OUT_MAX) before t_lim? Only such a pixel can
// hold a shell hit. The plain pass asks after its own trace, with a walk of
// its own: carried through city_trace's loop, even one running minimum cost
// that kernel 32 registers.
fn city_shell_envelope(o: vec3<f32>, dir: vec3<f32>, t_lim: f32) -> bool {
    var w: CityWalk;
    if (!city_walk_start(o, dir, &w)) {
        return false;
    }
    for (var i: i32 = 0; i < CITY_SHELL_REFINE_MAX_CELLS; i = i + 1) {
        if (w.t_cur >= t_lim) {
            return false;
        }
        let t_exit = min(w.tmax.x, w.tmax.y);
        let z_lo = min(o.z + w.t_cur * dir.z, o.z + t_exit * dir.z);
        let cc = city_cell(w.ci);
        if (cc.built && cc.land_use != CITY_USE_INDUSTRIAL
            && z_lo < cc.top_z + 1.0
            && city_shell_enters(o, w.inv3, cc, t_lim)) {
            return true;
        }
        city_walk_step(&w);
    }
    return false;
}

fn city_shell_refine(o: vec3<f32>, dir: vec3<f32>, pixel_angle: f32,
                     t_prev: f32) -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    // Past this every box is its plain slab, which the plain pass has done.
    let t_cap = city_shell_cap(o, dir);
    let t_reach = min(t_prev, city_shell_reach(o, dir, pixel_angle));
    var w: CityWalk;
    if (!city_walk_start(o, dir, &w)) {
        return res;
    }
    let inv3 = w.inv3;
    var best = CityBoxHit(1e30, vec3<f32>(0.0), -1);
    var best_cell = w.ci;
    var owns_prev = false;
    for (var i: i32 = 0; i < CITY_SHELL_REFINE_MAX_CELLS; i = i + 1) {
        if (w.t_cur >= t_reach || w.t_cur >= best.t) {
            break;
        }
        let ci = w.ci;
        let t_exit = min(w.tmax.x, w.tmax.y);
        let z_a = o.z + w.t_cur * dir.z;
        let z_b = o.z + t_exit * dir.z;
        let cc = city_cell(ci);
        // Industrial walls are the industry component's (city-layout's):
        // cladding, dock doors and their own relief. The shell leaves them.
        if (cc.built && cc.land_use != CITY_USE_INDUSTRIAL
            && min(z_a, z_b) < cc.top_z + 1.0
            && city_shell_enters(o, inv3, cc, min(best.t, t_reach))) {
            let st = city_shell_style(cc);
            for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
                let bx = city_tier_box(cc, k);
                let bh = city_building_box(o, dir, inv3, t_cap, bx.bmin,
                                           bx.bmax, cc, k, st, pixel_angle);
                if (bh.kind >= 0 && bh.t < best.t) {
                    best = bh;
                    best_cell = ci;
                    // Did this building own the plain pass's hit? Its core
                    // slab entry is computed exactly as the plain pass did.
                    let hc = city_box_hit(o, inv3, bx.bmin, bx.bmax);
                    owns_prev = hc.x <= hc.y && hc.x > 0.0
                                && abs(hc.x - t_prev) <= 1e-5 * t_prev;
                }
            }
        }
        city_walk_step(&w);
    }
    // Only a shell hit changes anything: a plain one is what t_prev already
    // is. A shell hit stands if it is nearer, or if it belongs to the
    // building whose wall t_prev was.
    if (best.kind >= CITY_KIND_SHELL
        && (best.t < t_prev || owns_prev)) {
        res.hit = true;
        res.t = best.t;
        res.pos = o + best.t * dir;
        res.normal = best.normal;
        res.kind = best.kind;
        res.cell = best_cell;
    }
    return res;
}

// The city's second stage: the facade shell over the plain surface. Its
// own kernel, because the shell's registers would otherwise be paid by every
// step of the plain pass's DDA — and this one only walks the few cells
// within the shell's reach.
fn surface_refine_city(cr: CameraRay, plain: vec4<f32>) -> vec4<f32> {
    let red = bitcast<u32>(plain.x);
    if ((red & CITY_SHELL_MARK) == 0u) {
        return plain;   // no relief envelope on this ray (surface_pass_city)
    }
    // t is read by magnitude, and a pixel the shell leaves keeps its sign
    // bit for bit: its sign belongs to whatever stage follows.
    let t_prev = abs(plain.w);
    let city_o = city_camera_origin();
    let h = city_shell_refine(city_o, cr.dir, cr.pixel_angle, t_prev);
    if (!h.hit) {
        return vec4<f32>(bitcast<f32>(red & ~CITY_SHELL_MARK), plain.yzw);
    }
    let cc = city_cell(h.cell);
    let glow = city_glow_sample(h.pos.xy, 3.0);
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * glow);
    return vec4<f32>(city_fog(city_shell_shade(h, cc, cr.dir,
                                               cr.pixel_angle * h.t, fill,
                                               glow),
                              city_o, cr.dir, h.t, h.pos), h.t);
}

// --- the street stage -----------------------------------------------------------
//
// The third city stage (fs_surface_street), after the facade refinement: it
// reads the surface as the first two left it and adds what belongs to the
// street — the furniture standing in front of it, the wet reflection off
// it, and the steam over it, which goes to the VEIL so it shows against the
// sky and in front of any wall. A pixel whose ray never comes down within
// CITY_NEAR_TOP of the street, within its reach (city_near_reach), and did
// not land on the ground, leaves at once with the surface unchanged.
const CITY_NEAR_TOP: f32 = 15.0;     // the tallest near thing: a plume
const CITY_NEAR_RANGE: f32 = 400.0;  // past the steam's cutoff
const CITY_FURNITURE_TOP: f32 = 3.0; // an open dumpster lid on the kerb
// The near_props contract (SPEC.md): no hook draws anything where the props'
// footprint, max(0.35 pixel_angle, true_pixel_angle) * t, exceeds this. The
// wall lane's fade ends there (streetfurniture WALL_FAR), and the parked
// cars the street stage owns (pixel_angle * t < 0.5) end well short of it.
const CITY_NEAR_FP: f32 = 0.75;

// How far along the ray the street stage looks: the steam's fixed range, or
// the props' footprint-bound one, whichever is longer. At high resolution the
// props reach well past CITY_NEAR_RANGE (at 1440p, fov 70, the cars' switch
// to boxes sits ~900 m out and the reach ~1370 m).
fn city_near_reach(cr: CameraRay) -> f32 {
    return max(CITY_NEAR_RANGE,
               CITY_NEAR_FP / max(0.35 * cr.pixel_angle,
                                  cr.true_pixel_angle));
}

fn surface_street_city(cr: CameraRay, prev: vec4<f32>) -> SurfaceOut {
    let dir = cr.dir;
    let pixel_angle = cr.pixel_angle;
    let ground_hit = prev.w < 0.0;
    let t_prev = abs(prev.w);
    var out: SurfaceOut;
    out.surf = vec4<f32>(prev.xyz, t_prev);
    out.veil = veil_none();
    let city_o = city_camera_origin();
    let t_low = city_t_low(city_o, dir);
    let t_near = min(t_prev, city_near_reach(cr));
    let near = t_low < t_near;
    if (!near && !ground_hit) {
        return out;
    }
    var rgb = prev.xyz;
    var t = t_prev;
    var ground = ground_hit;
    // The street furniture (the near_props hooks) stands below
    // CITY_FURNITURE_TOP, so only the stretch of the ray under it is walked:
    // at eye level a ray climbing into the sky leaves it within metres, and
    // one from above enters it just short of the street.
    var t_f0 = 0.0;
    if (city_o.z > CITY_FURNITURE_TOP) {
        t_f0 = select(1e30, (city_o.z - CITY_FURNITURE_TOP) / -dir.z,
                      dir.z < 0.0);
    }
    var t_f1 = t_near;
    if (city_o.z < CITY_FURNITURE_TOP && dir.z > 0.0) {
        t_f1 = min(t_f1, (CITY_FURNITURE_TOP - city_o.z) / dir.z);
    }
    if (t_f0 < t_f1) {
        // From the camera's own origin, so t stays the distance from the eye
        // that the props take their footprint from.
        let hp = city_trace(city_o, dir, t_f0, t_f1, CITY_TRACE_NEAR);
        if (hp.hit) {
            t = hp.t;
            // Always a component's hit (kind >= 100: no near_props hook
            // returns core kinds), so its shader directly — a second whole
            // city_shade beside the reflection's cost registers here.
            rgb = city_fog(cc_component_shade(hp, city_cell(hp.cell), dir,
                                              pixel_angle * t),
                           city_o, dir, t, hp.pos);
            ground = false;
        }
    }
    if (ground) {
        rgb = rgb + city_wet_reflection(city_o, dir, t, pixel_angle,
                                        cr.frame_index, cr.strat_pixel);
    }
    if (near && city_steam_live()) {
        // The live view draws its steam after the accumulation
        // (fs_steam_live); the veil only marks the depth it goes in at, so
        // the march notes the cloud's transmittance there.
        out.veil = veil_pack(vec3<f32>(0.0), 1.0, t_low);
    } else if (near) {
        // The steam in front of whatever is there — or of nothing: over the
        // sky the veil is all that shows of it.
        let med = cc_media(city_o, dir, city_inv_dir(dir), t, pixel_angle,
                           city_frame_rand(cr.strat_pixel, cr.frame_index,
                                           CITY_RAND_MEDIA).x);
        out.veil = veil_pack(med.rgb, med.a, t_low);
    }
    out.surf = vec4<f32>(rgb, t);
    return out;
}

// Where a ray from the camera first comes down to CITY_NEAR_TOP (0 from
// below it, 1e30 for a ray that never does): the depth the veil goes in at.
fn city_t_low(city_o: vec3<f32>, dir: vec3<f32>) -> f32 {
    var t_low = 0.0;
    if (city_o.z > CITY_NEAR_TOP) {
        t_low = select(1e30, (city_o.z - CITY_NEAR_TOP) / -dir.z, dir.z < 0.0);
    }
    return t_low;
}

// The steam's slab tests take 1/dir with an axis-parallel component at 1e30.
fn city_inv_dir(dir: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(select(1e30, 1.0 / dir.x, abs(dir.x) > 1e-9),
                     select(1e30, 1.0 / dir.y, abs(dir.y) > 1e-9),
                     select(1e30, 1.0 / dir.z, abs(dir.z) > 1e-9));
}

// The live view's steam (fs_steam_live), over `acc`, the accumulated image
// (display values; alpha the cloud's transmittance T_f from the camera to
// the veil's depth, as fs_main noted it), for the surface at t_surf. The
// steam is marched at the live clock exactly as the street stage marches it
// (cc_media, to the same surface, from the same depth), but once per
// presented frame, so instead of the accumulation's many offsets of its
// march it averages STEAM_LIVE_SAMPLES, stratified over the offset's range
// from a start fixed per pixel: a parked view shows the steam moving through
// a still, fine dither rather than a fresh grain every frame (one offset
// alone was a coarse grain, 2026-11-08). In linear light, with B the
// accumulated image's radiance and
// S, T_s the steam's in-scattered radiance and transmittance,
//     L = B (1 - T_f (1 - T_s)) + T_f S.
// The exact composite is C_f + T_f S + T_s (B - C_f), C_f the cloud
// radiance in front of the steam; with no cloud in front (T_f = 1, C_f = 0)
// and behind a cloud that hides it (T_f = 0) the two agree. In between this
// takes the share of B arriving from behind the veil's depth to be T_f, as
// though the cloud in front glowed like the scene behind it. What else is
// inexact here, and only here (stills and videos march the steam):
//   - B is tone_unmap of an AVERAGE of tone-mapped samples, not the average
//     radiance: a pixel whose samples differ (a window edge behind the
//     steam) is dimmed through the curve at its mean display value;
//   - T_f is averaged apart from the radiance it belongs to;
//   - a background past the curve's 1 (a lamp head, or a saturated colour
//     in the shoulder) reads as that clip, so steam in front of it dims it
//     more than it should;
//   - under contrast > 1 a background the contrast clipped to black has
//     lost its radiance: a channel displayed at exactly 0 is taken as black
//     (B = 0, the clip's low end, where thin steam then reads as itself)
//     rather than as the clip's edge, which made a plume over the night sky
//     larger and greyer than the still's (loose-ends' review, 2026-11-08);
//     a dark background just above the clip keeps its inverse;
//   - the steam takes the LAST sample's ray and surface depth, so its edge
//     along a silhouette is one sample's, not the average's.
// A pixel with no steam returns acc untouched, bit for bit. That is against
// the live accumulation, not the marched one: the live march adds a step at
// the veil's depth for every near pixel (to note T_f there), so its cloud
// samples there are not the marched view's.
const STEAM_LIVE_SAMPLES: u32 = 4u;
fn steam_live_city(cr: CameraRay, acc: vec4<f32>, t_surf: f32) -> vec4<f32> {
    let dir = cr.dir;
    let city_o = city_camera_origin();
    let t_low = city_t_low(city_o, dir);
    if (!(t_low < min(t_surf, city_near_reach(cr)))) {
        return acc;
    }
    let inv = city_inv_dir(dir);
    let start = city_frame_rand(cr.strat_pixel, 0u, CITY_RAND_MEDIA).x;
    var med = vec4<f32>(0.0);
    for (var k: u32 = 0u; k < STEAM_LIVE_SAMPLES; k = k + 1u) {
        med = med + cc_media(city_o, dir, inv, t_surf, cr.pixel_angle,
                             (f32(k) + start) / f32(STEAM_LIVE_SAMPLES));
    }
    med = med / f32(STEAM_LIVE_SAMPLES);
    if (med.a >= 1.0 && all(med.rgb == vec3<f32>(0.0))) {
        return acc;
    }
    // fs_main's exposure and gamma, read as it reads them (the exposure
    // slider and auto-exposure keep it >= 0.5).
    let exposure = u.cam_right.w;
    let gamma = u.periodic.w;
    let t_front = acc.a;
    let b = select(tone_unmap(acc.rgb, exposure, gamma), vec3<f32>(0.0),
                   acc.rgb <= vec3<f32>(0.0));
    let l = b * (1.0 - t_front * (1.0 - med.a)) + t_front * med.rgb;
    return vec4<f32>(tone_map(l, exposure, gamma), acc.a);
}

// What the wet street at distance t along the view ray reflects, through the
// view path's fog (city_fog is affine, so it enters times that path's
// transmittance). One microfacet sample per frame (city_wet_lobe); the
// reflected ray is traced PLAIN — buildings and ground, no component hooks —
// and a lobe carrying under CITY_REFL_RR is traced only by Russian
// roulette. What the puddles lose is the parked cars, the poles, the skyway
// and the furniture; the lamps they would have shown are city_lamp_glint's,
// analytically, in the ground's own shading.
// The reflection's four draws per pixel and frame — the GGX normal (x, y),
// the lobe (z) and the roulette (w) — as one 4-D R-sequence over the frames
// (Roberts 2018: alpha_k = phi_4^-k, phi_4 the real root of x^5 = x + 1),
// rotated per pixel by an integer hash (strat_seed). A parked view's frames
// then stratify all four together, and the lobe and the roulette stay
// independent of each other, which the estimator's 1/p weights need (two
// draws on one 1-D lattice would not be). White noise (city_frame_rand)
// drew them before; the sky probe's jitter still does.
// Each dimension has a near neighbour among the strat streams the city
// runs, and two Weyl sequences whose steps differ by d move nearly in step
// for ~1/(2d) frames (loose-ends' review): x by the subpixel offset's y
// (STRAT_ALPHA_2, d 0.020, ~25 frames), y by the moon cone's u (ALPHA_5,
// 0.015, ~32), z by its v (ALPHA_6, 0.044, ~11), w by the pre-march jitter
// (ALPHA_9, 0.013, ~37). With eight 1-D streams already on the circle no
// four steps sit much farther (a search of the golden families and of
// integer strides of this lattice found 0.02 at best), and none of these
// pairs shares an integrand (a microfacet normal against a subpixel
// position, the roulette against the cloud pre-march), so early in a
// parked accumulation a pair samples near a diagonal of its square instead
// of all of it and converges regardless — the first 8 frames' error is 8 %
// lower than dev's white draws all the same.
const CITY_REFL_R4: vec4<f32> = vec4<f32>(0.8566748838545029, 0.7338918566271260,
                                          0.6287067210378086, 0.5385972572236101);
const STRAT_STREAM_CITY_REFLECT: u32 = 9u;
fn city_refl_rand(pixel: vec2<u32>, frame: u32) -> vec4<f32> {
    let a = strat_seed(pixel, STRAT_STREAM_CITY_REFLECT);
    let b = pcg2d(a);
    return fract(f32(frame) * CITY_REFL_R4
                 + vec4<f32>(vec2<f32>(a), vec2<f32>(b)) * STRAT_INV_2P32);
}

fn city_wet_reflection(city_o: vec3<f32>, dir: vec3<f32>, t: f32,
                       pixel_angle: f32, frame_index: u32,
                       strat_pixel: vec2<u32>) -> vec3<f32> {
    let pos = city_o + t * dir;
    let cell = vec2<i32>(floor(pos.xy / u.ocean_params.x));
    let cc = city_cell(cell);
    let paved = city_ground_paved(cc, cell, pos.xy);
    if (city_ground_is_lot(paved, cc)) {
        return vec3<f32>(0.0);   // yards and scrub are dry dirt
    }
    let h = CityHit(true, t, pos, vec3<f32>(0.0, 0.0, 1.0), 0, cell);
    let fp = pixel_angle * t;
    let g = city_ground(pos.xy, cell, cc, fp);
    let rnd = city_refl_rand(strat_pixel, frame_index);
    let lobe = city_wet_lobe(h, g, dir, pixel_angle, rnd.xyz);
    if (!lobe.ok) {
        return vec3<f32>(0.0);
    }
    let w = lobe.w * city_fog_trans(city_o, dir, t, pos);
    var add = (w * lobe.blend) * lobe.env;
    // Russian roulette on what is left to trace: a lobe whose weight is
    // under CITY_REFL_RR (a steep view, a damp film, a far pixel) is traced
    // with probability w / RR and counted RR / w times over when it is.
    let wt = w * (1.0 - lobe.blend);
    let p_tr = min(wt / CITY_REFL_RR, 1.0);
    if (wt > 0.0 && rnd.w < p_tr) {
        let ro = vec3<f32>(pos.xy, pos.z + 0.02);
        let hr = city_trace(ro, lobe.r, 0.0, CITY_REFL_RANGE,
                            CITY_TRACE_PLAIN);
        var l = vec3<f32>(0.0);
        if (!hr.hit) {
            // Fogged over the range it searched, as a hit at the range
            // would have been.
            let far = ro + CITY_REFL_RANGE * lobe.r;
            l = city_fog(city_reflect_sky(u.cam_origin.xyz + t * dir, lobe.r,
                                          city_frame_rand(strat_pixel,
                                                          frame_index,
                                                          CITY_RAND_REFLECT).w),
                         ro, lobe.r, CITY_REFL_RANGE, far);
        } else {
            let fp_r = pixel_angle * (t + hr.t) + 0.5 * lobe.alpha * hr.t;
            // The texture under the lobe, filtered over its footprint on the
            // true pixel's terms.
            let fp_f = true_pixel_angle() * (t + hr.t)
                       + 0.5 * lobe.alpha * hr.t;
            l = city_fog(city_shade(hr, lobe.r, fp_r, fp_f, false), ro,
                         lobe.r, hr.t, hr.pos);
        }
        add = add + (wt / p_tr) * l;
    }
    return add;
}
// @end city

// @stub city
fn surface_street_city(cr: CameraRay, prev: vec4<f32>) -> SurfaceOut {
    var o: SurfaceOut;
    o.surf = prev;
    o.veil = veil_none();
    return o;
}
fn steam_live_city(cr: CameraRay, acc: vec4<f32>, t_surf: f32) -> vec4<f32> {
    return acc;
}

// The city's stub twin: every city symbol shared code calls, for a module
// compiled without the city. Reached only under CITY, false there.
fn surface_pass_city(dir: vec3<f32>, pixel_angle: f32) -> vec4<f32> {
    return vec4<f32>(0.0, 0.0, 0.0, 1e30);
}
fn surface_refine_city(cr: CameraRay, plain: vec4<f32>) -> vec4<f32> {
    return plain;
}
fn city_glow_sample(xy: vec2<f32>, lod: f32) -> f32 {
    return 0.0;
}
fn city_fold_xy(xy: vec2<f32>) -> vec2<f32> {
    return xy;
}
fn city_uplight_probe_tau(p: vec3<f32>, jit: f32) -> f32 {
    return 0.0;
}
fn night_sky_radiance(dir: vec3<f32>, moon: vec3<f32>) -> vec3<f32> {
