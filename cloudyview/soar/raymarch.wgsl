// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> @builtin(position) vec4<f32> {
    // Full-screen triangle.
    let x = f32(i32(vi) / 2) * 4.0 - 1.0;
    let y = f32(i32(vi) & 1) * 4.0 - 1.0;
    return vec4<f32>(x, y, 0.0, 1.0);
}

// One field-x plane of the sun-tau cache. The host renders this into a 2D
// r16float target of size (cache_nz, cache_ny) for slice u.light_cache.y,
// then copies the target into that depth slice of the light_tau texture —
// 3D textures are not renderable, and r16float is not a storage format, but
// it IS renderable, so the bake is a render pass rather than a compute pass.
// Rendering slice by slice is also what lets the browser spread a bake over
// frames instead of stalling one.
//
// Each texel evaluates the exact live march — light_march_tau through
// sample_level_at, nest included — at the cache texel's own world position,
// with dt_floor = 0 (full quadrature: the bake is paid once, so it takes the
// fine step everywhere) and zero jitter (a static cache cannot average a
// randomized phase away, so it takes the unbiased-enough left-endpoint rule
// the near field always used). Texel i sits AT data coordinate i, matching
// sample_level's convention, so sample_light_tau reads back exactly what was
// baked at texel centers.
// ---------------------------------------------------------------------------
// The surface pre-pass
// ---------------------------------------------------------------------------
//
// The city and the desert are opaque surfaces traced in closed form — a DDA
// over the block grid, a terrain with its plants — and their tracing is
// register-hungry. In fs_main it shared a kernel with the cloud march, so
// its registers were the march's too: every surface feature compiled in cost
// every march pixel occupancy, whether its rays ever reached that feature or
// not. So the surface is traced in a pass of its own, fs_surface, one
// fragment per render pixel, before every fs_main pass of a frame, into the
// target fs_main reads at group 1. The march keeps only the composite (the t >= t_surface test,
// the dt clamp and the post-loop fallback), with the same radiance at the
// same t as when it traced the surface itself.
//
// Both entries take their ray from camera_ray, so the pass traces exactly
// the ray the march composites: the same pixel, subpixel stream and frame
// index, which is what keeps sub-pixel surface detail accumulating.
//
// A surface whose full detail is too register-hungry even for its own pass
// splits in two: fs_surface draws what every pixel needs cheaply, and
// fs_surface_refine re-traces only the pixels that need more, reading the
// first stage's result at group 1 binding 1 and writing the final one. The
// second stage's registers are paid only by its own kernel, which most
// pixels leave at once. Each surface decides its own early-out. The desert
// needs only the first stage's t: its second stage re-walks the reach its
// near plants live in up to that t, and a pixel whose surface lies beyond is
// returned as it came. The city marks the pixels its facade shell can touch
// in the sign bit of red (CITY_SHELL_MARK: set by surface_pass_city for a
// ray that entered a building's relief envelope within the shell's reach),
// returns every other one untouched, and clears the mark on the rest; t
// leaves it as t came, sign included, unless the shell replaced the hit.
// Which surfaces have the second stage is the hosts' list
// (soar_host.SURFACE_REFINE_SURFACES, renderer.js _hasRefineStage).
//
// One function per surface, chosen by the scene's specialization. What
// belongs to the surface and sits in front of it along the ray as part of
// its look (city fog) is folded into its rgb here. A semi-transparent layer
// that must also show against the sky, or with a cloud in front of or
// behind it (the city's steam), goes to the VEIL instead (@location(1),
// veil_pack), which fs_main composites at the veil's own depth.

struct CameraRay {
    dir: vec3<f32>,
    frame_index: u32,       // this frame's index in the accumulation
    strat_pixel: vec2<u32>, // the pixel that seeds the stratified scrambles
    pixel_angle: f32,       // the city's resolving angle (rad/px)
    true_pixel_angle: f32,  // one pixel's angle, without the LOD slider
    jitter_amp: f32,        // jitter_on * jitter_scale
}

// One pixel's angular size: the frame's own, before any LOD floor. What a
// surface filters its texture over (a wider footprint only blurs it; the
// view-step LOD angle decides how much work is done, not how sharp).
fn true_pixel_angle() -> f32 {
    return 2.0 * u.cam_origin.w / u.params.x;
}

// The angle a surface's level of detail resolves at: the true pixel's, or
// the view-step LOD angle (u.periodic.z, the app's one LOD slider) when that
// is coarser. See camera_ray.
fn lod_pixel_angle() -> f32 {
    return max(true_pixel_angle(), u.periodic.z);
}

fn camera_ray(frag_pos: vec4<f32>) -> CameraRay {
    var cr: CameraRay;
    let img_w = u.params.x;
    let img_h = u.params.y;
    let tan_half_fov = u.cam_origin.w;
    let aspect = u.cam_forward.w;
    let subpixel_on = u.flags.x;
    let jitter_scale = clamp(u.flags.y, 0.0, 1.0);
    // This frame's index in the accumulation, the sequence coordinate every
    // stratified stream is indexed by, and this pixel, which seeds their
    // scrambles (see the strat1/strat2 block).
    cr.frame_index = u32(max(u.sun_dir.w, 0.0));
    cr.strat_pixel = vec2<u32>(frag_pos.xy);

    // Pixel -> camera ray. Framebuffer y=0 is the image top, matching the
    // witness convention ndc_y = 1 - 2*(py+0.5)/h.
    var sample_pos = frag_pos.xy;
    if (subpixel_on > 0.5) {
        let subpixel_offset = strat2(cr.frame_index, cr.strat_pixel,
                                     STRAT_STREAM_SUBPIXEL,
                                     vec2<f32>(STRAT_ALPHA_1, STRAT_ALPHA_2));
        sample_pos = sample_pos
                     + (subpixel_offset - vec2<f32>(0.5)) * jitter_scale;
    }
    let ndc_x = (2.0 * sample_pos.x / img_w - 1.0) * tan_half_fov;
    let ndc_y = (1.0 - 2.0 * sample_pos.y / img_h) * tan_half_fov / aspect;
    // @domain: forward plus in-plane offsets of the camera's orthonormal basis
    cr.dir = normalize(u.cam_forward.xyz
                       + ndc_x * u.cam_right.xyz
                       + ndc_y * u.cam_up.xyz);
    // The surfaces' LOD angle is the same knob as the cloud march's: the
    // larger of the true pixel angle and the view-step LOD angle
    // (u.periodic.z, the app's one LOD slider). Coarsening the slider cuts
    // the surfaces' work (how far the city's facade shell reaches, how
    // finely the desert walks) exactly as it coarsens the march — one
    // lever, one degrees-not-meters law for the whole scene. What a surface
    // FILTERS its texture over stays the true pixel's footprint: a wider
    // one would only blur it.
    cr.true_pixel_angle = true_pixel_angle();
    cr.pixel_angle = lod_pixel_angle();
    cr.jitter_amp = u.cam_up.w * jitter_scale;
    return cr;
}

// @section city
// The city under this ray: fogged radiance and distance, t = 1e30 on a miss.
fn surface_pass_city(dir: vec3<f32>, pixel_angle: f32) -> vec4<f32> {
    // THE CITY FRAME: world xy minus the row-24 surface offset, folded into
    // the primary tile (city_camera_origin — the one entry). The whole city
    // system — the DDA, every cell index and pcg2d seed, plot slabs, street
    // lines, component routes, hit positions, the fog's glow probe — runs in
    // this frame, and because the city is a pure function of it, the
    // frame's whole-tile ambiguity is invisible. t values are
    // translation-invariant, so depth compositing against the cloud march
    // needs no conversion; the one city input that must STAY world is the
    // uplight probe's cloud sampling (see the city_glow_sample call in the
    // march loop).
    //
    // This stage traces and shades only. What stands on the street and what
    // the street reflects are the street stage's (surface_street_city): kept
    // out of here, this stage stays in master's register tier (128 on the
    // 5080; the wet reflection, the steam and the street furniture compiled
    // in took it to 168, and every city pixel paid for that occupancy). A
    // ground hit is FLAGGED for that stage by a negative t — city-facades'
    // refinement passes it through, sign and all — and the street stage
    // writes it back positive.
    let city_o = city_camera_origin();
    let chit = city_trace(city_o, dir, 0.0, CITY_TRACE_RANGE, CITY_TRACE_ALL);
    // The refinement stage's flag, CITY_SHELL_MARK: the sign bit of red
    // (radiance is never negative) marks a pixel whose ray entered a
    // building's relief envelope within the shell's reach before its plain
    // hit, the only pixels the facade shell can change. surface_refine_city
    // returns every other pixel untouched and clears the bit on every marked
    // one, so no later reader sees it. A bit rather than a negated value: a
    // miss has red 0, and -0.0 only survives as a bit. (t's sign is the
    // street stage's ground flag, below.)
    let t_lim = min(select(1e30, chit.t, chit.hit),
                    city_shell_reach(city_o, dir, pixel_angle));
    let near = city_shell_on_wall(chit, t_lim)
               || city_shell_envelope(city_o, dir, t_lim);
    let mark = select(0u, CITY_SHELL_MARK, near);
    if (!chit.hit) {
        return vec4<f32>(bitcast<f32>(mark), 0.0, 0.0, 1e30);
    }
    let rgb = city_fog(city_shade(chit, dir, pixel_angle * chit.t,
                                  true_pixel_angle() * chit.t, true),
                       city_o, dir, chit.t, chit.pos);
    // Flagged only where a reflection can be traced: past CITY_REFL_LOD the
    // wet street's reflection is its environment mean, measured at under
    // 1e-4 of display brightness on the wide views (base 8e-5, horizon
    // 3e-5), while evaluating the ground material again for every distant
    // ground pixel just to weight it cost the street stage ~12% on the
    // horizon view. So it is left out, and the stand-in only fades the
    // traced reflection out across the hand-off band.
    let flag = chit.kind == 0 && pixel_angle * chit.t < CITY_REFL_LOD.y;
    return vec4<f32>(bitcast<f32>(bitcast<u32>(rgb.x) | mark), rgb.yz,
                     select(chit.t, -chit.t, flag));
}

// The refinement stage: the facade shell, traced where the plain surface
// pass left the camera's view within its reach. The plain pass (city_trace)
// found t_prev, the nearest opaque thing along the ray with every building a
// plain box; this walks the same cells again, but only as far as
// min(t_prev, the shell's reach), testing each building's box inflated by
// its relief. A building that yields a nearer hit — relief standing proud
// of a wall the ray would have missed or met later — replaces t_prev; so
// does the building that OWNED t_prev (its own wall or roof), whose shell
// may put the hit deeper (the glass behind a reveal) or keep it where it was.
// Everything else the plain pass found stands. Returns the hit that
// replaces t_prev, or no hit when t_prev stands.
const CITY_SHELL_REFINE_MAX_CELLS: i32 = 64;
// How far along this ray the block walk reaches before its cell cap: the
// shell's reach ends there too. Only a narrow view at a high resolution
// with the view-step LOD at 0 ever sees it (4K at a 12 degree fov: 90 m
// cells, about 4.8 km); per ray, continuous in direction, since each step
// covers cell / (|dx| + |dy|).
fn city_shell_cap(o: vec3<f32>, dir: vec3<f32>) -> f32 {
    var t0 = 0.0;
    if (o.z > CITY_SLAB_TOP && dir.z < -1e-7) {
        t0 = (CITY_SLAB_TOP - o.z) / dir.z;
    }
    return t0 + f32(CITY_SHELL_REFINE_MAX_CELLS - 2) * u.ocean_params.x
                / max(abs(dir.x) + abs(dir.y), 1e-6);
}

// The relief's fade to flat before the cap: 0 until the last quarter, 1 at it.
fn city_shell_cap_fade(t: f32, t_cap: f32) -> f32 {
    return smoothstep(0.75 * t_cap, t_cap, t);
}

// The shell's reach along a ray: its footprint limit, or the walk's cap.
fn city_shell_reach(o: vec3<f32>, dir: vec3<f32>, pixel_angle: f32) -> f32 {
    return min(CITY_SHELL_FP_FLAT / max(pixel_angle, 1e-9),
               city_shell_cap(o, dir));
}

// surface_pass_city's mark for the refinement: the sign bit of red.
const CITY_SHELL_MARK: u32 = 0x80000000u;

// The block-grid walk the shell's two passes share: the envelope probe and
// the refinement. The same DDA as city_trace, from the slab top.
struct CityWalk {
    ci: vec2<i32>,
    stp: vec2<i32>,
    inv3: vec3<f32>,
    tmax: vec2<f32>,
    tdelta: vec2<f32>,
    t_cur: f32,
}

// `live` false: the ray never enters the slab.
fn city_walk_start(o: vec3<f32>, dir: vec3<f32>, w: ptr<function, CityWalk>)
        -> bool {
    let cell = u.ocean_params.x;
    var t0 = 0.0;
    if (o.z > CITY_SLAB_TOP) {
        if (dir.z >= -1e-7) {
            return false;
        }
        t0 = (CITY_SLAB_TOP - o.z) / dir.z;
    }
    let p0 = o + t0 * dir;
    let ci = vec2<i32>(floor(p0.xy / cell));
    let inv3 = vec3<f32>(
        select(1e30, 1.0 / dir.x, abs(dir.x) > 1e-9),
        select(1e30, 1.0 / dir.y, abs(dir.y) > 1e-9),
        select(1e30, 1.0 / dir.z, abs(dir.z) > 1e-9));
    let cmin0 = vec2<f32>(ci) * cell;
    (*w).ci = ci;
    (*w).stp = vec2<i32>(select(-1, 1, dir.x > 0.0),
                         select(-1, 1, dir.y > 0.0));
    (*w).inv3 = inv3;
    (*w).tmax = vec2<f32>(
        select(1e30, t0 + (select(cmin0.x, cmin0.x + cell, dir.x > 0.0)
                           - p0.x) * inv3.x, abs(dir.x) > 1e-9),
        select(1e30, t0 + (select(cmin0.y, cmin0.y + cell, dir.y > 0.0)
                           - p0.y) * inv3.y, abs(dir.y) > 1e-9));
    (*w).tdelta = vec2<f32>(cell * abs(inv3.x), cell * abs(inv3.y));
    (*w).t_cur = t0;
    return true;
}

fn city_walk_step(w: ptr<function, CityWalk>) {
    if ((*w).tmax.x < (*w).tmax.y) {
        (*w).ci.x = (*w).ci.x + (*w).stp.x;
        (*w).t_cur = (*w).tmax.x;
        (*w).tmax.x = (*w).tmax.x + (*w).tdelta.x;
    } else {
        (*w).ci.y = (*w).ci.y + (*w).stp.y;
        (*w).t_cur = (*w).tmax.y;
        (*w).tmax.y = (*w).tmax.y + (*w).tdelta.y;
    }
}

// Does the ray enter this building's relief envelope (every tier's box grown
// by CITY_SHELL_OUT_MAX) by t_lim? Everything the shell can return for it —
// relief, glass, its plain slab — lies inside.
fn city_shell_enters(o: vec3<f32>, inv3: vec3<f32>, cc: CityCell,
                     t_lim: f32) -> bool {
    let grow = vec3<f32>(CITY_SHELL_OUT_MAX, CITY_SHELL_OUT_MAX, 0.0);
    for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
        let bx = city_tier_box(cc, k);
        let hg = city_box_hit(o, inv3, bx.bmin - grow, bx.bmax + grow);
        if (hg.x <= hg.y && hg.y > 0.0 && max(hg.x, 0.0) <= t_lim) {
            return true;
        }
    }
    return false;
}

// A plain hit on a building's wall, inside the shell's reach, is inside that
// building's envelope, which the ray entered strictly before it: the 1.5 m
// the envelope stands out from the wall. Most marked pixels are these, and
// they need no walk. (The z bounds are open: a hit on a box edge is left to
// the walk.)
fn city_shell_on_wall(h: CityHit, t_lim: f32) -> bool {
    if (!h.hit || h.kind != 1 || h.t >= t_lim) {
        return false;
    }
    let cc = city_cell(h.cell);
    if (!cc.built || cc.land_use == CITY_USE_INDUSTRIAL) {
        return false;
    }
    let grow = CITY_SHELL_OUT_MAX - 0.01;
    for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
        let bx = city_tier_box(cc, k);
        if (all(h.pos.xy > bx.bmin.xy - grow)
            && all(h.pos.xy < bx.bmax.xy + grow)
            && h.pos.z > bx.bmin.z && h.pos.z < bx.bmax.z) {
            return true;
        }
    }
    return false;
}

// Does the ray enter any building's relief envelope (its boxes grown by the
// deepest relief, CITY_SHELL_OUT_MAX) before t_lim? Only such a pixel can
// hold a shell hit. The plain pass asks after its own trace, with a walk of
// its own: carried through city_trace's loop, even one running minimum cost
// that kernel 32 registers.
fn city_shell_envelope(o: vec3<f32>, dir: vec3<f32>, t_lim: f32) -> bool {
    var w: CityWalk;
    if (!city_walk_start(o, dir, &w)) {
        return false;
    }
    for (var i: i32 = 0; i < CITY_SHELL_REFINE_MAX_CELLS; i = i + 1) {
        if (w.t_cur >= t_lim) {
            return false;
        }
        let t_exit = min(w.tmax.x, w.tmax.y);
        let z_lo = min(o.z + w.t_cur * dir.z, o.z + t_exit * dir.z);
        let cc = city_cell(w.ci);
        if (cc.built && cc.land_use != CITY_USE_INDUSTRIAL
            && z_lo < cc.top_z + 1.0
            && city_shell_enters(o, w.inv3, cc, t_lim)) {
            return true;
        }
        city_walk_step(&w);
    }
    return false;
}

fn city_shell_refine(o: vec3<f32>, dir: vec3<f32>, pixel_angle: f32,
                     t_prev: f32) -> CityHit {
    var res: CityHit;
    res.hit = false;
    res.t = 1e30;
    // Past this every box is its plain slab, which the plain pass has done.
    let t_cap = city_shell_cap(o, dir);
    let t_reach = min(t_prev, city_shell_reach(o, dir, pixel_angle));
    var w: CityWalk;
    if (!city_walk_start(o, dir, &w)) {
        return res;
    }
    let inv3 = w.inv3;
    var best = CityBoxHit(1e30, vec3<f32>(0.0), -1);
    var best_cell = w.ci;
    var owns_prev = false;
    for (var i: i32 = 0; i < CITY_SHELL_REFINE_MAX_CELLS; i = i + 1) {
        if (w.t_cur >= t_reach || w.t_cur >= best.t) {
            break;
        }
        let ci = w.ci;
        let t_exit = min(w.tmax.x, w.tmax.y);
        let z_a = o.z + w.t_cur * dir.z;
        let z_b = o.z + t_exit * dir.z;
        let cc = city_cell(ci);
        // Industrial walls are the industry component's (city-layout's):
        // cladding, dock doors and their own relief. The shell leaves them.
        if (cc.built && cc.land_use != CITY_USE_INDUSTRIAL
            && min(z_a, z_b) < cc.top_z + 1.0
            && city_shell_enters(o, inv3, cc, min(best.t, t_reach))) {
            let st = city_shell_style(cc);
            for (var k: i32 = 0; k < cc.tiers; k = k + 1) {
                let bx = city_tier_box(cc, k);
                let bh = city_building_box(o, dir, inv3, t_cap, bx.bmin,
                                           bx.bmax, cc, k, st, pixel_angle);
                if (bh.kind >= 0 && bh.t < best.t) {
                    best = bh;
                    best_cell = ci;
                    // Did this building own the plain pass's hit? Its core
                    // slab entry is computed exactly as the plain pass did.
                    let hc = city_box_hit(o, inv3, bx.bmin, bx.bmax);
                    owns_prev = hc.x <= hc.y && hc.x > 0.0
                                && abs(hc.x - t_prev) <= 1e-5 * t_prev;
                }
            }
        }
        city_walk_step(&w);
    }
    // Only a shell hit changes anything: a plain one is what t_prev already
    // is. A shell hit stands if it is nearer, or if it belongs to the
    // building whose wall t_prev was.
    if (best.kind >= CITY_KIND_SHELL
        && (best.t < t_prev || owns_prev)) {
        res.hit = true;
        res.t = best.t;
        res.pos = o + best.t * dir;
        res.normal = best.normal;
        res.kind = best.kind;
        res.cell = best_cell;
    }
    return res;
}

// The city's second stage: the facade shell over the plain surface. Its
// own kernel, because the shell's registers would otherwise be paid by every
// step of the plain pass's DDA — and this one only walks the few cells
// within the shell's reach.
fn surface_refine_city(cr: CameraRay, plain: vec4<f32>) -> vec4<f32> {
    let red = bitcast<u32>(plain.x);
    if ((red & CITY_SHELL_MARK) == 0u) {
        return plain;   // no relief envelope on this ray (surface_pass_city)
    }
    // t is read by magnitude, and a pixel the shell leaves keeps its sign
    // bit for bit: its sign belongs to whatever stage follows.
    let t_prev = abs(plain.w);
    let city_o = city_camera_origin();
    let h = city_shell_refine(city_o, cr.dir, cr.pixel_angle, t_prev);
    if (!h.hit) {
        return vec4<f32>(bitcast<f32>(red & ~CITY_SHELL_MARK), plain.yzw);
    }
    let cc = city_cell(h.cell);
    let glow = city_glow_sample(h.pos.xy, 3.0);
    let fill = CITY_SKYGLOW * (0.5 + 1.5 * glow);
    return vec4<f32>(city_fog(city_shell_shade(h, cc, cr.dir,
                                               cr.pixel_angle * h.t, fill,
                                               glow),
                              city_o, cr.dir, h.t, h.pos), h.t);
}

// --- the street stage -----------------------------------------------------------
//
// The third city stage (fs_surface_street), after the facade refinement: it
// reads the surface as the first two left it and adds what belongs to the
// street — the furniture standing in front of it, the wet reflection off
// it, and the steam over it, which goes to the VEIL so it shows against the
// sky and in front of any wall. A pixel whose ray never comes down within
// CITY_NEAR_TOP of the street, within its reach (city_near_reach), and did
// not land on the ground, leaves at once with the surface unchanged.
const CITY_NEAR_TOP: f32 = 15.0;     // the tallest near thing: a plume
const CITY_NEAR_RANGE: f32 = 400.0;  // past the steam's cutoff
const CITY_FURNITURE_TOP: f32 = 3.0; // an open dumpster lid on the kerb
// The near_props contract (SPEC.md): no hook draws anything where the props'
// footprint, max(0.35 pixel_angle, true_pixel_angle) * t, exceeds this. The
// wall lane's fade ends there (streetfurniture WALL_FAR), and the parked
// cars the street stage owns (pixel_angle * t < 0.5) end well short of it.
const CITY_NEAR_FP: f32 = 0.75;

// How far along the ray the street stage looks: the steam's fixed range, or
// the props' footprint-bound one, whichever is longer. At high resolution the
// props reach well past CITY_NEAR_RANGE (at 1440p, fov 70, the cars' switch
// to boxes sits ~900 m out and the reach ~1370 m).
fn city_near_reach(cr: CameraRay) -> f32 {
    return max(CITY_NEAR_RANGE,
               CITY_NEAR_FP / max(0.35 * cr.pixel_angle,
                                  cr.true_pixel_angle));
}

fn surface_street_city(cr: CameraRay, prev: vec4<f32>) -> SurfaceOut {
    let dir = cr.dir;
    let pixel_angle = cr.pixel_angle;
    let ground_hit = prev.w < 0.0;
    let t_prev = abs(prev.w);
    var out: SurfaceOut;
    out.surf = vec4<f32>(prev.xyz, t_prev);
    out.veil = veil_none();
    let city_o = city_camera_origin();
    let t_low = city_t_low(city_o, dir);
    let t_near = min(t_prev, city_near_reach(cr));
    let near = t_low < t_near;
    if (!near && !ground_hit) {
        return out;
    }
    var rgb = prev.xyz;
    var t = t_prev;
    var ground = ground_hit;
    // The street furniture (the near_props hooks) stands below
    // CITY_FURNITURE_TOP, so only the stretch of the ray under it is walked:
    // at eye level a ray climbing into the sky leaves it within metres, and
    // one from above enters it just short of the street.
    var t_f0 = 0.0;
    if (city_o.z > CITY_FURNITURE_TOP) {
        t_f0 = select(1e30, (city_o.z - CITY_FURNITURE_TOP) / -dir.z,
                      dir.z < 0.0);
    }
    var t_f1 = t_near;
    if (city_o.z < CITY_FURNITURE_TOP && dir.z > 0.0) {
        t_f1 = min(t_f1, (CITY_FURNITURE_TOP - city_o.z) / dir.z);
    }
    if (t_f0 < t_f1) {
        // From the camera's own origin, so t stays the distance from the eye
        // that the props take their footprint from.
        let hp = city_trace(city_o, dir, t_f0, t_f1, CITY_TRACE_NEAR);
        if (hp.hit) {
            t = hp.t;
            // Always a component's hit (kind >= 100: no near_props hook
            // returns core kinds), so its shader directly — a second whole
            // city_shade beside the reflection's cost registers here.
            rgb = city_fog(cc_component_shade(hp, city_cell(hp.cell), dir,
                                              pixel_angle * t),
                           city_o, dir, t, hp.pos);
            ground = false;
        }
    }
    if (ground) {
        rgb = rgb + city_wet_reflection(city_o, dir, t, pixel_angle,
                                        cr.frame_index, cr.strat_pixel);
    }
    if (near && city_steam_live()) {
        // The live view draws its steam after the accumulation
        // (fs_steam_live); the veil only marks the depth it goes in at, so
        // the march notes the cloud's transmittance there.
        out.veil = veil_pack(vec3<f32>(0.0), 1.0, t_low);
    } else if (near) {
        // The steam in front of whatever is there — or of nothing: over the
        // sky the veil is all that shows of it.
        let med = cc_media(city_o, dir, city_inv_dir(dir), t, pixel_angle,
                           city_frame_rand(cr.strat_pixel, cr.frame_index,
                                           CITY_RAND_MEDIA).x);
        out.veil = veil_pack(med.rgb, med.a, t_low);
    }
    out.surf = vec4<f32>(rgb, t);
    return out;
}

// Where a ray from the camera first comes down to CITY_NEAR_TOP (0 from
// below it, 1e30 for a ray that never does): the depth the veil goes in at.
fn city_t_low(city_o: vec3<f32>, dir: vec3<f32>) -> f32 {
    var t_low = 0.0;
    if (city_o.z > CITY_NEAR_TOP) {
        t_low = select(1e30, (city_o.z - CITY_NEAR_TOP) / -dir.z, dir.z < 0.0);
    }
    return t_low;
}

// The steam's slab tests take 1/dir with an axis-parallel component at 1e30.
fn city_inv_dir(dir: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(select(1e30, 1.0 / dir.x, abs(dir.x) > 1e-9),
                     select(1e30, 1.0 / dir.y, abs(dir.y) > 1e-9),
                     select(1e30, 1.0 / dir.z, abs(dir.z) > 1e-9));
}

// The live view's steam (fs_steam_live), over `acc`, the accumulated image
// (display values; alpha the cloud's transmittance T_f from the camera to
// the veil's depth, as fs_main noted it), for the surface at t_surf. The
// steam is marched at the live clock exactly as the street stage marches it
// (cc_media, to the same surface, from the same depth), but once per
// presented frame, so instead of the accumulation's many offsets of its
// march it averages STEAM_LIVE_SAMPLES, stratified over the offset's range
// from a start fixed per pixel: a parked view shows the steam moving through
// a still, fine dither rather than a fresh grain every frame (one offset
// alone was a coarse grain, 2026-11-08). In linear light, with B the
// accumulated image's radiance and
// S, T_s the steam's in-scattered radiance and transmittance,
//     L = B (1 - T_f (1 - T_s)) + T_f S.
// The exact composite is C_f + T_f S + T_s (B - C_f), C_f the cloud
// radiance in front of the steam; with no cloud in front (T_f = 1, C_f = 0)
// and behind a cloud that hides it (T_f = 0) the two agree. In between this
// takes the share of B arriving from behind the veil's depth to be T_f, as
// though the cloud in front glowed like the scene behind it. What else is
// inexact here, and only here (stills and videos march the steam):
//   - B is tone_unmap of an AVERAGE of tone-mapped samples, not the average
//     radiance: a pixel whose samples differ (a window edge behind the
//     steam) is dimmed through the curve at its mean display value;
//   - T_f is averaged apart from the radiance it belongs to;
//   - a background past the curve's 1 (a lamp head, or a saturated colour
//     in the shoulder) reads as that clip, so steam in front of it dims it
//     more than it should;
//   - under contrast > 1 a background the contrast clipped to black has
//     lost its radiance: a channel displayed at exactly 0 is taken as black
//     (B = 0, the clip's low end, where thin steam then reads as itself)
//     rather than as the clip's edge, which made a plume over the night sky
//     larger and greyer than the still's (loose-ends' review, 2026-11-08);
//     a dark background just above the clip keeps its inverse;
//   - the steam takes the LAST sample's ray and surface depth, so its edge
//     along a silhouette is one sample's, not the average's.
// A pixel with no steam returns acc untouched, bit for bit. That is against
// the live accumulation, not the marched one: the live march adds a step at
// the veil's depth for every near pixel (to note T_f there), so its cloud
// samples there are not the marched view's.
const STEAM_LIVE_SAMPLES: u32 = 4u;
fn steam_live_city(cr: CameraRay, acc: vec4<f32>, t_surf: f32) -> vec4<f32> {
    let dir = cr.dir;
    let city_o = city_camera_origin();
    let t_low = city_t_low(city_o, dir);
    if (!(t_low < min(t_surf, city_near_reach(cr)))) {
        return acc;
    }
    let inv = city_inv_dir(dir);
    let start = city_frame_rand(cr.strat_pixel, 0u, CITY_RAND_MEDIA).x;
    var med = vec4<f32>(0.0);
    for (var k: u32 = 0u; k < STEAM_LIVE_SAMPLES; k = k + 1u) {
        med = med + cc_media(city_o, dir, inv, t_surf, cr.pixel_angle,
                             (f32(k) + start) / f32(STEAM_LIVE_SAMPLES));
    }
    med = med / f32(STEAM_LIVE_SAMPLES);
    if (med.a >= 1.0 && all(med.rgb == vec3<f32>(0.0))) {
        return acc;
    }
    // fs_main's exposure and gamma, read as it reads them (the exposure
    // slider and auto-exposure keep it >= 0.5).
    let exposure = u.cam_right.w;
    let gamma = u.periodic.w;
    let t_front = acc.a;
    let b = select(tone_unmap(acc.rgb, exposure, gamma), vec3<f32>(0.0),
                   acc.rgb <= vec3<f32>(0.0));
    let l = b * (1.0 - t_front * (1.0 - med.a)) + t_front * med.rgb;
    return vec4<f32>(tone_map(l, exposure, gamma), acc.a);
}

// What the wet street at distance t along the view ray reflects, through the
// view path's fog (city_fog is affine, so it enters times that path's
// transmittance). One microfacet sample per frame (city_wet_lobe); the
// reflected ray is traced PLAIN — buildings and ground, no component hooks —
// and a lobe carrying under CITY_REFL_RR is traced only by Russian
// roulette. What the puddles lose is the parked cars, the poles, the skyway
// and the furniture; the lamps they would have shown are city_lamp_glint's,
// analytically, in the ground's own shading.
// The reflection's four draws per pixel and frame — the GGX normal (x, y),
// the lobe (z) and the roulette (w) — as one 4-D R-sequence over the frames
// (Roberts 2018: alpha_k = phi_4^-k, phi_4 the real root of x^5 = x + 1),
// rotated per pixel by an integer hash (strat_seed). A parked view's frames
// then stratify all four together, and the lobe and the roulette stay
// independent of each other, which the estimator's 1/p weights need (two
// draws on one 1-D lattice would not be). White noise (city_frame_rand)
// drew them before; the sky probe's jitter still does.
const CITY_REFL_R4: vec4<f32> = vec4<f32>(0.8566748838545029, 0.7338918566271260,
                                          0.6287067210378086, 0.5385972572236101);
const STRAT_STREAM_CITY_REFLECT: u32 = 9u;
fn city_refl_rand(pixel: vec2<u32>, frame: u32) -> vec4<f32> {
    let a = strat_seed(pixel, STRAT_STREAM_CITY_REFLECT);
    let b = pcg2d(a);
    return fract(f32(frame) * CITY_REFL_R4
                 + vec4<f32>(vec2<f32>(a), vec2<f32>(b)) * STRAT_INV_2P32);
}

fn city_wet_reflection(city_o: vec3<f32>, dir: vec3<f32>, t: f32,
                       pixel_angle: f32, frame_index: u32,
                       strat_pixel: vec2<u32>) -> vec3<f32> {
    let pos = city_o + t * dir;
    let cell = vec2<i32>(floor(pos.xy / u.ocean_params.x));
    let cc = city_cell(cell);
    let paved = city_ground_paved(cc, cell, pos.xy);
    if (city_ground_is_lot(paved, cc)) {
        return vec3<f32>(0.0);   // yards and scrub are dry dirt
    }
    let h = CityHit(true, t, pos, vec3<f32>(0.0, 0.0, 1.0), 0, cell);
    let fp = pixel_angle * t;
    let g = city_ground(pos.xy, cell, cc, fp);
    let rnd = city_refl_rand(strat_pixel, frame_index);
    let lobe = city_wet_lobe(h, g, dir, pixel_angle, rnd.xyz);
    if (!lobe.ok) {
        return vec3<f32>(0.0);
    }
    let w = lobe.w * city_fog_trans(city_o, dir, t, pos);
    var add = (w * lobe.blend) * lobe.env;
    // Russian roulette on what is left to trace: a lobe whose weight is
    // under CITY_REFL_RR (a steep view, a damp film, a far pixel) is traced
    // with probability w / RR and counted RR / w times over when it is.
    let wt = w * (1.0 - lobe.blend);
    let p_tr = min(wt / CITY_REFL_RR, 1.0);
    if (wt > 0.0 && rnd.w < p_tr) {
        let ro = vec3<f32>(pos.xy, pos.z + 0.02);
        let hr = city_trace(ro, lobe.r, 0.0, CITY_REFL_RANGE,
                            CITY_TRACE_PLAIN);
        var l = vec3<f32>(0.0);
        if (!hr.hit) {
            // Fogged over the range it searched, as a hit at the range
            // would have been.
            let far = ro + CITY_REFL_RANGE * lobe.r;
            l = city_fog(city_reflect_sky(u.cam_origin.xyz + t * dir, lobe.r,
                                          city_frame_rand(strat_pixel,
                                                          frame_index,
                                                          CITY_RAND_REFLECT).w),
                         ro, lobe.r, CITY_REFL_RANGE, far);
        } else {
            let fp_r = pixel_angle * (t + hr.t) + 0.5 * lobe.alpha * hr.t;
            // The texture under the lobe, filtered over its footprint on the
            // true pixel's terms.
            let fp_f = true_pixel_angle() * (t + hr.t)
                       + 0.5 * lobe.alpha * hr.t;
            l = city_fog(city_shade(hr, lobe.r, fp_r, fp_f, false), ro,
                         lobe.r, hr.t, hr.pos);
        }
        add = add + (wt / p_tr) * l;
    }
    return add;
}
// @end city

// @stub city
fn surface_street_city(cr: CameraRay, prev: vec4<f32>) -> SurfaceOut {
    var o: SurfaceOut;
    o.surf = prev;
    o.veil = veil_none();
    return o;
}
fn steam_live_city(cr: CameraRay, acc: vec4<f32>, t_surf: f32) -> vec4<f32> {
    return acc;
}

// The city's stub twin: every city symbol shared code calls, for a module
// compiled without the city. Reached only under CITY, false there.
fn surface_pass_city(dir: vec3<f32>, pixel_angle: f32) -> vec4<f32> {
    return vec4<f32>(0.0, 0.0, 0.0, 1e30);
}
fn surface_refine_city(cr: CameraRay, plain: vec4<f32>) -> vec4<f32> {
    return plain;
}
fn city_glow_sample(xy: vec2<f32>, lod: f32) -> f32 {
    return 0.0;
}
fn city_fold_xy(xy: vec2<f32>) -> vec2<f32> {
    return xy;
}
fn city_uplight_probe_tau(p: vec3<f32>, jit: f32) -> f32 {
    return 0.0;
}
fn night_sky_radiance(dir: vec3<f32>, moon: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(0.0);
}
// @end-stub city

// --- the veil ------------------------------------------------------------------

// What every surface stage writes to the veil target (@location(1)), and
// what the march reads back at group 1 binding 2: premultiplied radiance
// and opacity (half floats), and the composite depth (a full f32 — up to
// 40 km over the desert). Packed into a uint target so no driver's float
// path ever touches the bits. Opacity, 1 - transmittance, rather than
// transmittance: a half float rounds any transmittance above ~0.99976 to
// exactly 1, which would drop a faint plume's fringe (and its radiance with
// it) at a hard edge; 1 - T keeps its full relative precision down there.
struct SurfaceOut {
    @location(0) surf: vec4<f32>,
    @location(1) veil: vec4<u32>,
}

fn veil_pack(rgb: vec3<f32>, trans: f32, t: f32) -> vec4<u32> {
    return vec4<u32>(pack2x16float(rgb.xy),
                     pack2x16float(vec2<f32>(rgb.z, 1.0 - trans)),
                     bitcast<u32>(t), 0u);
}

// Whether the city's steam is the live view's (row 8.w, which the city's row
// 8 has spare): drawn after the accumulation by fs_steam_live at the live
// clock, so it keeps moving over a parked, converging picture. Off, it is
// marched into the veil as it always was — every still, video and replay,
// and the meter's of a capture.
fn city_steam_live() -> bool {
    return CITY && u.ocean.w > 0.5;
}

// No veil: nothing scattered in, everything let through.
fn veil_none() -> vec4<u32> {
    return veil_pack(vec3<f32>(0.0), 1.0, 1e30);
}

struct Veil {
    rgb: vec3<f32>,
    trans: f32,
    t: f32,
}

fn veil_unpack(v: vec4<u32>) -> Veil {
    let rg = unpack2x16float(v.x);
    let bt = unpack2x16float(v.y);
    return Veil(vec3<f32>(rg, bt.x), 1.0 - bt.y, bitcast<f32>(v.z));
}

// The desert's first stage (desert_surface_pass): its surface, and the
// optical depths it lit the ground with (desert_light_taus).
struct DesertPlain {
    surf: vec4<f32>,
    taus: vec2<f32>,
}

// What fs_surface_desert writes: the surface, and the optical depths to an
// rg32float target the flora stage reads at group 1 binding 3.
struct DesertSurfaceOut {
    @location(0) surf: vec4<f32>,
    @location(1) taus: vec2<f32>,
}

// The pass itself. Only the CITY and DESERT specializations are ever run
// through it; any other scene returns a miss and the host never draws it.
@fragment
fn fs_surface(@builtin(position) frag_pos: vec4<f32>) -> SurfaceOut {
    let cr = camera_ray(frag_pos);
    var out: SurfaceOut;
    out.surf = vec4<f32>(0.0, 0.0, 0.0, 1e30);
    out.veil = veil_none();
    if (CITY) {
        out.surf = surface_pass_city(cr.dir, cr.pixel_angle);
    }
    if (DESERT) {
        // The simplified desert (DESERT_LITE), whose one stage this is; the
        // full desert's first stage is fs_surface_desert. The desert
        // resolves at the true pixel angle: the view-step LOD angle is
        // several pixels wide at the day tiers and would dissolve the stones
        // and plants meant to be seen from a couple of metres (desert-
        // ground's decision; its cost is kept by its own laws).
        out.surf = desert_surface_pass(cr.dir, cr.true_pixel_angle,
                                       cr.frame_index, cr.strat_pixel,
                                       cr.jitter_amp).surf;
    }
    return out;
}

// The full desert's first stage: the ground as fs_surface draws it, and
// beside it, in place of the veil the desert does not have, the optical
// depths the flora stage lights its far cover with.
@fragment
fn fs_surface_desert(@builtin(position) frag_pos: vec4<f32>)
        -> DesertSurfaceOut {
    let cr = camera_ray(frag_pos);
    var out: DesertSurfaceOut;
    out.surf = vec4<f32>(0.0, 0.0, 0.0, 1e30);
    out.taus = vec2<f32>(0.0);
    if (DESERT) {
        let p = desert_surface_pass(cr.dir, cr.true_pixel_angle,
                                    cr.frame_index, cr.strat_pixel,
                                    cr.jitter_amp);
        out.surf = p.surf;
        out.taus = p.taus;
    }
    return out;
}

// The second stage, for a surface that has one. Most pixels leave at once;
// see each surface's refine function for when.
@fragment
fn fs_surface_refine(@builtin(position) frag_pos: vec4<f32>)
        -> @location(0) vec4<f32> {
    let plain = textureLoad(surface_plain, vec2<i32>(frag_pos.xy), 0);
    let cr = camera_ray(frag_pos);
    if (CITY) {
        return surface_refine_city(cr, plain);
    }
    if (DESERT) {
        return desert_surface_refine(cr, plain);
    }
    return plain;
}

// The desert's flora stage: the explicit plants' far-form walk, split out
// of the first stage so its registers stay out of the stage that shades the
// whole ground (desert_surface_flora). It reads the ground the first stage
// traced at group 1 binding 1 and the optical depths it lit it with at
// binding 3, and writes the surface the refinement reads; the desert's
// stages in soar_host.SURFACE_STAGES and web/soar/constants.js
// SURFACE_STAGES, between fs_surface_desert and fs_surface_refine (not
// under DESERT_LITE, which has no walk).
@fragment
fn fs_surface_flora(@builtin(position) frag_pos: vec4<f32>)
        -> @location(0) vec4<f32> {
    let plain = textureLoad(surface_plain, vec2<i32>(frag_pos.xy), 0);
    if (DESERT) {
        let taus = textureLoad(surface_taus, vec2<i32>(frag_pos.xy), 0).xy;
        return desert_surface_flora(camera_ray(frag_pos), plain, taus);
    }
    return plain;
}

// The third stage, for a surface that has one: the city's street
// (surface_street_city). It reads the second stage's surface at group 1
// binding 1, as the second reads the first's, and writes the final surface
// and the veil.
@fragment
fn fs_surface_street(@builtin(position) frag_pos: vec4<f32>) -> SurfaceOut {
    let prev = textureLoad(surface_plain, vec2<i32>(frag_pos.xy), 0);
    let cr = camera_ray(frag_pos);
    if (CITY) {
        return surface_street_city(cr, prev);
    }
    var out: SurfaceOut;
    out.surf = prev;
    out.veil = veil_none();
    return out;
}

// --- lens water: the state ---------------------------------------------------
//
// Water on the camera's lens after it flies through cloud. The look is
// lens.wgsl's, drawn by each host's present (browser) or post pass (Python)
// AFTER accumulation, never into the accumulated image. This is its state,
// one texel, integrated once per presented frame: x = wetness in [0, 1],
// y = w*, the level it is heading for at this extinction (the browser's
// read-back settles the loop on |w - w*|, whatever the frame rate), z, w 0. The host puts the step's dt in row 24.w: the live view's
// wall-clock frame time, parked or not (the lens keeps wetting in cloud and
// drying out of it while you hover; being drawn after accumulation, it does
// not disturb a parked picture's convergence), a video's resampled frame
// interval. Stills pass no state at all and are dry in both hosts.
//
// The wetting law, exact in dt at constant extinction sigma at the camera:
//   dw/dt = K_WET f (1 - w) - k_dry(f) (1 - f) w,  f = 1 - exp(-sigma L_WET),
//   k_dry(f) = K_DRY in cloud, K_DRY_CLEAR in clear air,
// is linear in w at constant f, whatever k_dry(f) is, so one step of any
// length is
//   w(t + dt) = w* + (w - w*) exp(-a dt),
//   a = K_WET f + k_dry(f) (1 - f),  w* = K_WET f / a,
// and one step of 2 dt equals two of dt at constant f: a replay at another
// frame rate sees the same wetness wherever the extinction at the camera
// changes slowly against the frame interval (f is taken at the step's end).
// f is the cloud's alone (the field's extinction; the haze is not in it).
// Clear air is where the first law's level, K_WET f / (K_WET f + K_DRY
// (1 - f)), is under LENS_DRY_FLOOR, the wetness that counts as dry anyway:
// f below ~6.7e-4, sigma below ~2.2e-5 /m. Not where sigma is exactly 0: a
// field's clear air can carry a faint positive tail (the RCE demo's, median
// f ~3e-5, over a third of its volume), and the camera samples sigma
// trilinearly. Dense cloud (f ~ 1) wets the lens in a few seconds, thin
// cloud (f small) only to a low level, slowly; in cloud this is the first
// law, its w* and its rate unchanged. In clear air the lens drains at
// K_DRY_CLEAR, 3x K_DRY (Thomas, 2026-11-08: outside of cloud the drops
// "should disappear 3x faster"), to 5 % in 5 s. The same law in numpy is
// tests/test_lens_water.py's reference.
const LENS_L_WET: f32 = 30.0;       // m of cloud path that fogs the lens
const LENS_K_WET: f32 = 0.6;        // 1/s
const LENS_K_DRY: f32 = 0.2;        // 1/s, in cloud
const LENS_K_DRY_CLEAR: f32 = 0.6;  // 1/s, in clear air
const LENS_DRY_FLOOR: f32 = 0.002;  // below this, and drying: exactly dry

@fragment
fn fs_lens_state(@builtin(position) frag_pos: vec4<f32>)
        -> @location(0) vec4<f32> {
    // The previous state, bound where the refine stages bind surface_plain.
    let prev = textureLoad(surface_plain, vec2<i32>(0, 0), 0);
    let dt = max(u.surface_offset.w, 0.0);
    // A NaN extinction reads as none (a comparison with NaN is false, so
    // this is exact where max(NaN, 0) is left to the implementation).
    let s_raw = sample_sigma(u.cam_origin.xyz);
    let sigma = select(0.0, s_raw, s_raw > 0.0);
    let f = 1.0 - exp(-sigma * LENS_L_WET);
    // Clear air: the first law's level would count as dry. Its denominator
    // is >= min(K_WET, K_DRY) > 0.
    let w_first = LENS_K_WET * f / (LENS_K_WET * f + LENS_K_DRY * (1.0 - f));
    let k_dry = select(LENS_K_DRY_CLEAR, LENS_K_DRY, w_first >= LENS_DRY_FLOOR);
    let a = LENS_K_WET * f + k_dry * (1.0 - f);   // >= min(K_WET, K_DRY) > 0
    let w_star = LENS_K_WET * f / a;
    var w = w_star + (prev.x - w_star) * exp(-a * dt);
    // Dry is exactly 0, so a dry lens draws nothing at all (lens.wgsl); a
    // state that is not a number starts again dry rather than stay NaN.
    w = select(w, 0.0, w < LENS_DRY_FLOOR && w_star < LENS_DRY_FLOOR);
    w = select(0.0, w, w >= 0.0);
    return vec4<f32>(w, w_star, 0.0, 0.0);
}

// --- the live view's steam -------------------------------------------------
//
// Thomas (2026-11-08): the steam "should keep going when the flight is
// paused". A parked view converges by averaging frames of one frozen scene,
// so steam marched into those frames would either freeze with them or, with
// the clock running, smear the average. The live view therefore marches
// the city with the steam left out (city_steam_live: the veil is only its
// depth) and draws it here, once per presented frame, at the live clock
// (row 24.z), onto the accumulated image — the lens water's arrangement.
// Group 1: binding 0 the final surface (t in w), binding 1 the accumulated
// image. The composite and what it gets wrong: steam_live_city (a stub that
// returns the image as it came in a module without the city). The image is
// in display values, as the browser accumulates it: the one host that draws
// this pass always tone-maps (TONE_MAP false is the Python host's linear
// output, render_nested, which has no live view).
@fragment
fn fs_steam_live(@builtin(position) frag_pos: vec4<f32>)
        -> @location(0) vec4<f32> {
    let xy = vec2<i32>(frag_pos.xy);
    let acc = textureLoad(surface_plain, xy, 0);
    return steam_live_city(camera_ray(frag_pos), acc,
                           textureLoad(surface_buf, xy, 0).w);
}

@fragment
fn fs_bake_light(@builtin(position) frag_pos: vec4<f32>)
        -> @location(0) vec4<f32> {
    let tex_dims = vec3<f32>(textureDimensions(light_tau, 0));
    let dims = vec3<f32>(tex_dims.z, tex_dims.y, tex_dims.x);
    // frag_pos.xy = (iz + 0.5, iy + 0.5) over the (nz, ny) target; the slice
    // index is the field-x plane.
    let data_g = vec3<f32>(
        u.light_cache.y,
        frag_pos.y - 0.5,
        frag_pos.x - 0.5
    );
    // Texel i sits at box fraction (i+0.5)/N — the same half-cell-padded
    // convention sample_level and sample_light_tau map with, so the read-back
    // at texel centers returns exactly what was baked.
    let p = u.bmin.xyz
        + ((data_g + 0.5) / dims) * (u.bmax.xyz - u.bmin.xyz);
    let tau = light_march_tau(p, u.sun_dir.xyz, 0.0, 0.0);
    return vec4<f32>(tau, 0.0, 0.0, 1.0);
}

@fragment
fn fs_main(@builtin(position) frag_pos: vec4<f32>) -> @location(0) vec4<f32> {
    let g_hg = u.params.z;
    let ambient_strength = u.params.w;
    let exposure = u.cam_right.w;
    let jitter_on = u.cam_up.w;
    let jitter_scale = clamp(u.flags.y, 0.0, 1.0);
    let sun = u.sun_dir.xyz;
    let gradient_shading_strength = u.cb_realism.x;
    let deep_shadow_ms_suppression = u.cb_realism.y;
    let ambient_occlusion_strength = u.cb_realism.z;
    let bounce_depth_attenuation = u.cb_realism.w;
    let gradient_coarse_weight = u.cb_params.x;
    let gradient_coarse_radius_m = u.cb_params.y;
    let ambient_occlusion_floor = u.cb_params.z;

    // The camera ray, shared with the surface pre-pass (camera_ray), so the
    // surface it traced is the surface this march composites.
    let cr = camera_ray(frag_pos);
    let frame_index = cr.frame_index;
    let strat_pixel = cr.strat_pixel;
    let dir = cr.dir;

    // safe_inv_dir, not 1.0 / dir: an exactly axis-aligned pixel ray would
    // divide by zero, and the infinity makes the slab test below
    // indeterminate (the sun path's same bug, desert-ground 2026-09-24).
    let inv_dir = safe_inv_dir(dir);
    let periodic_on = PERIODIC_DOMAIN;
    var t_near: f32;
    var t_far: f32;
    if (periodic_on) {
        // Tiled domain: only the z slab bounds the march (rays never exit
        // horizontally); the horizontal exit is replaced by the clear-air
        // transmittance / wrap-ceiling cap.
        let tz0 = (u.bmin.z - u.cam_origin.z) * inv_dir.z;
        let tz1 = (u.bmax.z - u.cam_origin.z) * inv_dir.z;
        t_near = max(min(tz0, tz1), 0.0);
        t_far = min(
            max(tz0, tz1),
            periodic_march_cap(u.cam_origin.z, dir)
        );
    } else {
        let hit = ray_box(u.cam_origin.xyz, inv_dir);
        t_near = max(hit.x, 0.0);
        t_far = hit.y;
    }

    // Under CITY the ocean plane is compiled out entirely: the surface below
    // is the traced city, which fills the same role (an opaque floor at
    // t_city) through the same guards.
    // Under DESERT likewise: the traced desert is the floor.
    let ocean_on = !CITY && !DESERT && u.ocean_params.z > 0.5;
    var t_ocean = 1e30;
    if (ocean_on && dir.z < -1e-8) {
        let t_ocean_candidate = (u.ocean.x - u.cam_origin.z) / dir.z;
        if (t_ocean_candidate > 0.0) {
            t_ocean = t_ocean_candidate;
        }
    }

    // The opaque surface below — the traced city or the traced desert — was
    // found by the surface pre-pass (fs_surface) for this very ray: its
    // fogged or hazed radiance and its distance, one texel per pixel. It is
    // composited when the march reaches it, exactly as the ocean plane is,
    // so the march loop only ever multiplies it by transmittance. Reading it
    // rather than tracing it here keeps every surface register out of this
    // kernel (see the surface pre-pass section).
    var t_city = 1e30;
    var city_rgb = vec3<f32>(0.0);
    var t_desert = 1e30;
    var desert_rgb = vec3<f32>(0.0);
    if (CITY || DESERT) {
        let sp = textureLoad(surface_buf, vec2<i32>(frag_pos.xy), 0);
        if (CITY) {
            t_city = sp.w;
            city_rgb = sp.xyz;
        } else {
            t_desert = sp.w;
            desert_rgb = sp.xyz;
        }
    }
    let t_surface = select(select(t_ocean, t_city, CITY), t_desert, DESERT);
    // The veil (the city's steam; the desert has none): composited once,
    // where the march passes its depth — so a cloud in front of it stays in
    // front and a cloud behind it is seen through it — and only if it lies
    // in front of the surface.
    var veil = Veil(vec3<f32>(0.0), 1.0, 1e30);
    if (CITY) {
        veil = veil_unpack(textureLoad(veil_buf, vec2<i32>(frag_pos.xy), 0));
    }
    // Under the live view's steam the veil is only its depth (trans 1), and
    // the march notes the cloud's transmittance there, t_front, in the
    // sample's alpha for fs_steam_live; elsewhere the alpha is 1.
    let steam_live = city_steam_live();
    var veil_pending = CITY && (veil.trans < 1.0 || steam_live)
        && veil.t < t_surface;
    var t_front = 1.0;

    let cos_scatter = dot(dir, sun);
    let phase = hg_phase(cos_scatter, g_hg);
    // Once-scattered diffraction spike (see DIFFRACTION_G). Constant along
    // the ray, like `phase`; the window makes it exactly zero beyond 30 deg
    // from the sun, so any view not containing the near-sun sky is
    // bit-identical.
    let phase_diffraction = DIFFRACTION_WEIGHT
        * hg_phase(cos_scatter, DIFFRACTION_G)
        * smoothstep(DIFFRACTION_WINDOW_COS_START,
                     DIFFRACTION_WINDOW_COS_FULL, cos_scatter);

    // Scattering-geometry weight on the powder term (see POWDER_FWD_*). One
    // value per pixel: cos_scatter is constant along a view ray. 1 keeps the
    // full boundary darkening, 1 - POWDER_FWD_FADE is what survives at exact
    // forward scattering.
    let g2_hg = g_hg * g_hg;
    // clamped short of 1 so the smoothstep below can never be degenerate; the
    // select handles the isotropic case, where no forward cone exists at all
    // and powder must stay whole in every direction.
    let powder_fwd_cos_start = clamp(
        (1.0 + g2_hg - pow(max(1.0 - g2_hg, 1e-6), 2.0 / 3.0))
        / (2.0 * max(g_hg, 1e-4)),
        -1.0, 0.999
    );
    let powder_weight = 1.0 - POWDER_FWD_FADE * select(
        0.0,
        smoothstep(powder_fwd_cos_start, 1.0, cos_scatter),
        g_hg > 1e-4
    );

    // Aerial perspective (witness iter_008): this sightline's horizon sky
    // color (solar disc excluded) — the same asymptotic target the ocean
    // haze uses, so cloud and water converge to one haze color.
    // Ice-detection mode: 0.0 unless research mode has switched it on, and
    // every branch on it below leaves the math bit-identical when off.
    let ice_on = u.light_cache.w > 0.5;
    // In ice mode most of the aerial haze is given up (select is 1.0 with
    // the mode off): full strength converges every distant cloud onto the
    // one horizon color and the phase information drowns in it.
    let aerial_strength = u.sky_horizon.w * select(1.0, 0.3, ice_on);
    var aer = vec3<f32>(0.0);
    if (aerial_strength > 0.0) {
        if (CITY) {
            // At night the horizon asymptote is the host-packed night haze
            // color directly; the daytime sky model has nothing to add.
            aer = u.sky_horizon.xyz;
        } else {
            let ah_len = length(dir.xy);
            var ah = dir.xy;
            if (ah_len > 1e-8) {
                ah = dir.xy / ah_len;
            }
            if (ice_on) {
                // Distance fades into the alien horizon, not the blue one.
                aer = alien_sky(vec3<f32>(ah, 0.0), sun, vec3<f32>(0.0));
            } else {
                aer = sky_radiance(
                    vec3<f32>(ah, 0.0), sun,
                    u.sky_horizon.xyz, u.sky_bloom.xyz, vec3<f32>(0.0),
                    u.cloud_sun.w
                );
            }
        }
    }

    // Jittered first step: decorrelates the sampling shells between
    // neighboring pixels, killing the coherent ring/banding artifact.
    // Stratified over the accumulation (iter_011), so the shells a pixel tests
    // across frames tile its entry interval instead of clumping.
    // The entry step scale is the outer level's: the nest is required to lie
    // strictly inside the outer AABB, so a ray always enters through it.
    let jitter = strat1(frame_index, strat_pixel, STRAT_STREAM_ENTRY,
                        STRAT_ALPHA_3);
    // Independent stream for the sky probe's quadrature offset.
    let probe_jitter = strat1(frame_index, strat_pixel,
                              STRAT_STREAM_SKY_PROBE,
                              STRAT_ALPHA_10) - 0.5;
    // Independent stream for the sun march's quadrature offset (iter_003).
    // Under the same jitter_on switch as the view march: turning jitter off
    // asks for a deterministic march, and this is one, artifact and all.
    let shadow_jitter = jitter_on * jitter_scale
                        * strat1(frame_index, strat_pixel,
                                 STRAT_STREAM_SUN_MARCH,
                                 STRAT_ALPHA_4);
    // Independent stream for the solar-cone draw (iter_007). Two uniforms:
    // squared radius and azimuth on the disc.
    let sun_cone_seed = strat2(frame_index, strat_pixel,
                               STRAT_STREAM_SUN_CONE,
                               vec2<f32>(STRAT_ALPHA_5, STRAT_ALPHA_6));
    let penumbra_tan = SUN_ANGULAR_RADIUS * SUN_CONE_WIDEN
                       * jitter_on * jitter_scale;
    // Built once here, not once per draw: same crosses, same normalize, same
    // order, so every deflected direction is the number it always was.
    let sun_frame = sun_tangent_frame(sun);
    // Independent stream for the ocean's sub-pixel slope draw (iter_008).
    let ocean_slope_seed = strat2(frame_index, strat_pixel,
                                  STRAT_STREAM_OCEAN_SLOPE,
                                  vec2<f32>(STRAT_ALPHA_7, STRAT_ALPHA_8));
    // Independent stream for the forward pre-march's quadrature offset.
    let ahead_jitter = jitter_on * jitter_scale
                       * strat1(frame_index, strat_pixel,
                                STRAT_STREAM_PREMARCH,
                                STRAT_ALPHA_9);
    let entry_dt = u.bmin.w;
    var t = t_near + jitter_on * jitter * jitter_scale * entry_dt;

    var transmittance = 1.0;
    var col = vec3<f32>(0.0);
    var tau_depth = 0.0;
    // Whether the march below shaded the water, tracked rather than inferred
    // (docs/soar-bugs.md 6). The far-water fallback used to decide the same
    // thing from `t_ocean > t_far`, which is only meaningful when the ray hit
    // the box at all: ray_box returns t_near > t_far on a MISS with t_far
    // still a positive finite number — the nearest exit plane of a box the
    // ray never entered. Such a ray skips the march (the guard below wants
    // t_near < t_far) and then failed the fallback too whenever that
    // leftover t_far happened to exceed t_ocean, so the ocean was hit and
    // nothing shaded it. Because t_far varies smoothly with direction that
    // came out as a contiguous region of sky where the water should be,
    // reachable with periodicity off and the camera just outside the domain
    // looking down.
    var ocean_consumed = false;
    // The march reached the water. Shading it is left to the one
    // ocean_shade_dispatch call after the loop rather than done here: the
    // ocean shader carries two sun marches, and inlining it twice into
    // fs_main cost the ocean views 7-9% for nothing (2026-09-23). The two
    // paths computed the same expression on the same values — transmittance
    // is not touched between this break and that call — so it is one call
    // with two ways in.
    var ocean_in_march = false;
    // Optical depth this ray has already crossed, so the pre-march total can
    // be turned into "what is still ahead of this sample". Unlike tau_depth
    // this never resets: it is the ray's own coordinate along its chord.
    var tau_view = 0.0;
    // Whether the previous view sample sat inside the nest, so the march can
    // notice the fine->coarse crossing (docs/soar-bugs.md 4).
    var was_in_nest = false;

    // The periodic march can legitimately cover several domain widths, so
    // it gets more step headroom; the non-periodic bound is untouched.
    let max_view_steps = select(MAX_VIEW_STEPS, MAX_VIEW_STEPS_PERIODIC,
                                periodic_on);

    // How much new hemisphere the sightline probe covers that iter_001's
    // vertical probe did not: the sine of the angle between the two.
    let ahead_novelty = sqrt(max(1.0 - dir.z * dir.z, 0.0));

    // Spectrum of the buried residual of the diffuse fills — per frame, not
    // per sample (it depends only on the two lighting spectra).
    let deep_tint = deep_fill_tint(u.ambient_tint.xyz);

    // One coarse pass over the whole sightline before anything is composited.
    var tau_total = 0.0;
    if (t_near >= 0.0 && t_near < t_far) {
        tau_total = premarch_tau_ahead(
            u.cam_origin.xyz, dir, t_near, min(t_far, t_surface), ahead_jitter
        );
    }

    if (t_near >= 0.0 && t_near < t_far) {
        for (var i: i32 = 0; i < max_view_steps; i = i + 1) {
            // witness.py:621-646 tests ocean before the t_far break so an
            // ocean plane coincident with the box floor is still shaded.
            // The water is shaded after the loop, by the same call that
            // shades water the march never reached (see ocean_in_march).
            if (ocean_on && t >= t_ocean) {
                ocean_in_march = true;
                ocean_consumed = true;
                break;
            }
            if (veil_pending && t >= veil.t) {
                t_front = transmittance;
                col = col + transmittance * veil.rgb;
                transmittance = transmittance * veil.trans;
                veil_pending = false;
            }
            if (CITY && t >= t_city) {
                col = col + transmittance * city_rgb;
                transmittance = 0.0;
                ocean_consumed = true;
                break;
            }
            if (DESERT && t >= t_desert) {
                col = col + ice_recolor(transmittance * desert_rgb,
                                        ICE_OCEAN_TINT, ice_on);
                transmittance = 0.0;
                ocean_consumed = true;
                break;
            }

            if (t >= t_far || transmittance < TRANSMITTANCE_CUTOFF) {
                break;
            }
            let p = u.cam_origin.xyz + t * dir;
            // The active level sets the step scale, so the march refines on
            // entering the nest and coarsens on leaving it. The dt-invariant
            // powder term below is what lets the two levels composite
            // without a brightness seam (witness.py header).
            let level = sample_level_at(p);
            // Crossing OUT of the nest, the step length jumps fine -> coarse,
            // but every ray crosses at the same geometric plane and arrives
            // with at most a fine step's worth of phase — so sample phase
            // past the seam covered barely half the coarse period, and the
            // coherent remainder survived accumulation as stripes parallel
            // to the seam (docs/soar-bugs.md 4; the A/B pinned the view
            // march, not the light march). The cure is the file's usual one:
            // an independent per-pixel-per-frame uniform phase, spanning the
            // FULL effective coarse step — adding a full-period uniform
            // modulo the period is uniform whatever the crossing
            // distribution was, where re-using the entry draw or spanning
            // only the step difference both leave a coherent residual
            // (measured; the first attempt did the former and the stripes
            // survived it). The reverse crossing needs nothing: a coarse
            // period of phase folded into a fine one already covers it.
            if (NESTED && was_in_nest && !level.in_nest) {
                was_in_nest = false;
                let seam_jitter = strat1(frame_index, strat_pixel,
                                         STRAT_STREAM_NEST_SEAM,
                                         STRAT_ALPHA_10);
                let skip = jitter_on * seam_jitter * jitter_scale
                           * max(u.bmin.w, t * u.periodic.z);
                if (skip > 0.0) {
                    t = t + skip;
                    continue;
                }
            }
            was_in_nest = level.in_nest;
            let sigma = level.sigma;

            // Distance LOD: the step floor grows with distance so far
            // wrapped copies march in angular, not metric, resolution
            // (0 = fixed dt). Dense-sigma refinement still applies.
            var dt = step_dt_for_sigma(
                sigma, max(level.dt_view, t * u.periodic.z)
            );
            if (t + dt > t_far) {
                dt = t_far - t;
            }
            if (ocean_on && t + dt > t_ocean) {
                dt = max(0.0001, t_ocean - t);
            }
            if (veil_pending && t + dt > veil.t) {
                dt = max(0.0001, veil.t - t);
            }
            if (CITY && t + dt > t_city) {
                dt = max(0.0001, t_city - t);
            }
            if (DESERT && t + dt > t_desert) {
                dt = max(0.0001, t_desert - t);
            }

            let d_tau = sigma * dt;
            if (d_tau < EMPTY_DTAU_CUTOFF) {
                tau_depth = 0.0;
                t = t + dt;
                continue;
            }

            tau_depth = tau_depth + d_tau;
            tau_view = tau_view + d_tau;

            // Ice-detection tint for this sample's cloud source terms.
            // Exactly 1.0 with the mode off, so the multiplies below are
            // bit-exact no-ops.
            var phase_tint = vec3<f32>(1.0);
            if (ice_on) {
                phase_tint = ice_tint(ice_fraction_at(p));
            }

            // Aerial perspective: clear-air transmittance camera->sample via
            // the closed-form exponential atmosphere (witness._render_image).
            var air_t = 1.0;
            if (aerial_strength > 0.0) {
                let aer_beta0 = u.sky_bloom.w;
                let aer_h = u.sky_disc.w;
                let aer_z0 = max(u.cam_origin.z, 0.0);
                let aer_z1 = max(p.z, 0.0);
                let aer_mu = dir.z;
                var tau_air: f32;
                if (aer_h <= 0.0) {
                    tau_air = aer_beta0 * t;          // uniform: no z profile
                } else if (aer_mu > 1e-6 || aer_mu < -1e-6) {
                    tau_air = aer_beta0 * (aer_h / aer_mu)
                        * (exp(-aer_z0 / aer_h) - exp(-aer_z1 / aer_h));
                } else {
                    tau_air = aer_beta0 * t * exp(-aer_z0 / aer_h);
                }
                air_t = exp(-aerial_strength * tau_air);
            }

            // A view ray takes many steps, so its shadow rays advance the
            // offset by the golden ratio instead of reusing one value: the
            // sequence is low-discrepancy along the march, which averages the
            // quadrature noise down within a single frame rather than leaving
            // it all for temporal accumulation.
            let step_shadow_jitter = fract(
                shadow_jitter + f32(i) * 0.6180339887498949
            );
            // Draw this sample's point on the solar disc (iter_007). The R2
            // additive recurrence advances both coordinates along the view
            // march for the same reason the golden ratio advances the
            // quadrature phase above: the many shadow rays that composite into
            // one pixel then cover the disc low-discrepancy within a single
            // frame, so soar's first frame shows a soft edge with light dither
            // rather than a hard edge that only melts once accumulation
            // settles.
            let sun_shadow = sun_cone_dir(
                sun, sun_frame,
                fract(sun_cone_seed + f32(i) * vec2<f32>(
                    0.7548776662466927, 0.5698402909980532
                )),
                penumbra_tan
            );
            // The cache replaces the march, the disc jitter and the
            // distance-LOD coarsening in one move: it is the central-sun,
            // zero-jitter tau at the cache's own resolution, trilinearly
            // filtered. See Uniforms.light_cache.
            var tau_sun: f32;
            if (LIGHT_CACHE) {
                tau_sun = sample_light_tau(p);
            } else {
                tau_sun = light_march_tau(p, sun_shadow, t * u.periodic.y,
                                          step_shadow_jitter);
            }
            let light_transfer_split_strength = u.ambient_tint.w;
            // Unconditional: the diffuse beam and the high-sun skylight
            // consume this gate too, so computing it only when the storm
            // machinery is enabled would hand a buried storm the full
            // shallow treatment when suppression/AO/split are all zero
            // (codex review 2026-08-11, finding 3).
            // Log-space: per-e-fold travel between tau 15 and 1000 (see the
            // DEEP_SHADOW_TAU constants). The max() guard only matters for
            // tau_sun < 1, which is far below the gate's onset anyway.
            let deep_shadow_gate = smoothstep(
                DEEP_SHADOW_LOG_TAU_START, DEEP_SHADOW_LOG_TAU_FULL,
                log(max(tau_sun, 1e-3))
            );

            // Moderate-shadow gate: where the beam and MS octaves are spent
            // but the deep-shadow machinery has not engaged. This is where
            // the skylight fill lives. Exponential onset — see the
            // SHADOW_SKYLIGHT_TAU_ONSET comment for why not a smoothstep.
            let shadow_gate = 1.0 - exp(-tau_sun / SHADOW_SKYLIGHT_TAU_ONSET);

            // Sky visibility, measured (hoisted from the diffuse block below
            // so the MS floor can use it too). Run for any meaningfully
            // shadowed sample — elsewhere tau_sun still carries the shading
            // and this costs nothing. One probe serves every consumer.
            var t_sky = 1.0;
            var shallow_open = 0.0;
            if (shadow_gate > 0.0 || deep_shadow_gate > 0.0) {
                if (!SKY_PROBE) {
                    // Sky probe disabled (a cost/look toggle, J in the
                    // browser): every consumer sees a fully open sky, which
                    // is the neutral the floors already assume. Buried
                    // samples brighten — that is the look being priced.
                    shallow_open = 1.0;
                } else {
                    t_sky = sky_probe_transmittance(p, g_hg, probe_jitter);
                    shallow_open = smoothstep(
                        SHALLOW_OPEN_TSKY_START, SHALLOW_OPEN_TSKY_FULL, t_sky
                    );
                }
            }
            // A buried storm sample keeps the full tuned suppression; an
            // optically open shallow shadow keeps only a quarter of it.
            let storm_weight = mix(
                SHALLOW_SUPPRESSION_KEEP, 1.0, 1.0 - shallow_open
            );

            // Diffusion depth for the isotropic tail (see MS_TAIL_FLOOR).
            // The knee is what keeps this a *contrast* change rather than a
            // dimming: below it the factor is exactly 1, so thin cloud and
            // the directly lit shoulder of a turret are bit-identical to
            // iter_001 and only the genuinely self-shadowed parts move.
            let ms_tail_factor = MS_TAIL_FLOOR + (1.0 - MS_TAIL_FLOOR)
                * diffuse_transmittance(
                    max(tau_sun - MS_TAIL_TAU_KNEE, 0.0), g_hg
                );

            // Local surface frame. Hoisted above the MS loop (iter_006) so the
            // tail can be weighted by the beam's incidence on the skin; the
            // gradient *shading* below consumes exactly these values in exactly
            // the same way it did, so that term is untouched.
            //
            // The stencil is skipped on the entry skin, where it cannot
            // matter. surface_gate's depth factor is a smoothstep that is
            // exactly 0 at or below GRADIENT_SHADING_TAU_START, and with the
            // gate at exactly 0 every consumer of the gradient is exactly
            // neutral: tail_mu_factor is mix(1, x, 0), gradient_factor is
            // max(0.2, 1 + 0) and fill_shape is mix(1, 1, w). Leaving grad at
            // zero takes the grad_len guards below instead, which leave the
            // same three ones in place. That saves twelve texture reads per
            // sample over the first quarter optical depth after every cloud
            // entry — most of a thin field's samples, a few percent of a
            // thick one's.
            var grad = vec3<f32>(0.0);
            var grad_len = 0.0;
            var surface_gate = 0.0;
            if (gradient_shading_strength > 0.0
                && tau_depth > GRADIENT_SHADING_TAU_START) {
                let grad_conf_v = sigma_gradient(
                    p, sigma, gradient_coarse_weight, gradient_coarse_radius_m,
                    t, u.cb_params.w, level.in_nest
                );
                grad = grad_conf_v.xyz;
                grad_len = length(grad);
                surface_gate = smoothstep(
                    GRADIENT_SHADING_TAU_START,
                    GRADIENT_SHADING_TAU_FULL,
                    tau_depth
                ) * smoothstep(
                    GRADIENT_SHADING_CONF_START,
                    GRADIENT_SHADING_CONF_FULL,
                    grad_conf_v.w
                );
            }

            // Beam incidence on the skin, relative to a horizontal face (see
            // the TAIL_MU_* block). Exactly 1 where the field is level, so it
            // costs no brightness on flat cloud top and only the flanks of
            // turrets and the walls of the crevices between them give the tail
            // up.
            var tail_mu_factor = 1.0;
            if (grad_len > 1e-12) {
                let mu0 = max(-dot(grad, sun) / grad_len, 0.0);
                let mu_ratio = clamp(
                    mu0 / max(sun.z, TAIL_MU_REF_MIN), 0.0, 1.0
                );
                tail_mu_factor = mix(
                    1.0,
                    TAIL_MU_FLOOR + (1.0 - TAIL_MU_FLOOR) * mu_ratio,
                    surface_gate * (1.0 - deep_shadow_gate)
                );
            }

            var ms = vec3<f32>(0.0);
            var ms_atten = 1.0;
            for (var octave: i32 = 0; octave < MS_OCTAVES; octave = octave + 1) {
                let t_sun_ms = exp(-tau_sun * ms_atten);
                let blend = min(1.0, f32(octave) * MS_BLEND_RATE);
                let oct_phase = phase * (1.0 - blend) + ISO_PHASE * blend;
                var contrib = ms_atten * t_sun_ms * oct_phase;
                let iso_gate = smoothstep(0.35, 1.0, blend);
                // Octaves 0-1 still carry the beam and keep their exact
                // baseline value; the tail is put on the diffusion depth in
                // proportion to how isotropic it has already become, so the
                // handover is continuous and nothing is double-counted.
                contrib = contrib
                    * mix(1.0, ms_tail_factor * tail_mu_factor, iso_gate);
                if (deep_shadow_ms_suppression > 0.0) {
                    let ms_floor = max(
                        DEEP_SHADOW_MS_FLOOR,
                        1.0 - deep_shadow_ms_suppression
                              * storm_weight
                              * deep_shadow_gate
                              * iso_gate
                    );
                    contrib = contrib * ms_floor;
                }
                ms = ms + contrib * u.cloud_sun.xyz;
                ms_atten = ms_atten * MS_ATTEN;
            }

            // The diffraction spike joins the ladder as part of the
            // once-scattered term: octave 0's transmittance, no tail or
            // suppression factors (octave 0's iso_gate is 0), and it shares
            // the direct-boost and gradient multipliers below exactly as
            // octave 0 does. The guard is per-pixel-coherent (the window is
            // constant along the ray), so far-from-sun pixels skip the exp.
            if (phase_diffraction > 0.0) {
                ms = ms + phase_diffraction * exp(-tau_sun) * u.cloud_sun.xyz;
            }

            // Light-transfer split, warm side: modest boost of the unoccluded
            // direct/MS source at low sun (witness iter_006).
            if (light_transfer_split_strength > 0.0) {
                let direct_factor = 1.0 + light_transfer_split_strength
                    * LIGHT_TRANSFER_DIRECT_BOOST
                    * exp(-tau_sun);
                ms = ms * direct_factor;
            }

            // fill_shape carries the surface's billow orientation into the
            // diffuse fills below (2026-08-11): once tau_sun saturates, ms
            // is spent and every remaining light source was orientation-
            // blind, so shaded cloud went flat. Real anvil undersides
            // (IMG_7053) keep soft billow definition deep into shadow. The
            // fills take the same measured gradient at reduced weight —
            // diffuse light is directional enough to shade billows, just
            // more softly than the beam.
            var fill_shape = 1.0;
            if (gradient_shading_strength > 0.0) {
                if (grad_len > 1e-12) {
                    var n_dot_sun = -dot(grad, sun) / grad_len;
                    if (n_dot_sun < 0.0) {
                        n_dot_sun = n_dot_sun * GRADIENT_SHADING_SHADOW_SIDE_SCALE;
                    }
                    let gradient_factor = max(
                        0.20,
                        1.0 + gradient_shading_strength
                              * surface_gate
                              * n_dot_sun
                    );
                    ms = ms * gradient_factor;
                    fill_shape = mix(1.0, gradient_factor,
                                     FILL_GRADIENT_WEIGHT);
                }
            }

            // Powder is a function of cumulative optical depth since the current
            // cloud entry, not the current step size (witness.py:729-732).
            // powder_weight is the scattering-geometry dependence powder has
            // always been missing; at weight 1 this is exactly the old
            // expression. Note no extra depth gate is needed: the deficit it
            // scales, exp(-POWDER_COEFF * tau_depth), is already dead by
            // tau_depth ~ 2, so the change is confined to the thin skin and
            // the edges, which is where the physics lives.
            let powder = 1.0 - powder_weight * exp(-POWDER_COEFF * tau_depth);
            let scatter_weight = d_tau * powder * transmittance * air_t;
            col = col + ice_recolor(scatter_weight * ms, phase_tint, ice_on);

            // (t_sky and shallow_open were measured above the MS loop.)

            // Second probe direction, free from the pre-march: how much cloud
            // lies beyond this sample along the sightline. A skin sample on a
            // wisp is open both ways and keeps its full diffuse fill; the
            // same skin on a deep mass is open only backward, toward the
            // camera, and is a poor place for diffuse light to reach. This is
            // the whole of the entry-face thick/thin distinction, and because
            // the direction is the sightline the structure it reports is
            // registered with the silhouette: a luminous fringe around every
            // edge and gap, with the body behind it falling away.
            //
            // It multiplies the diffuse terms rather than feeding t_sky,
            // deliberately. Both consumers of t_sky wrap it in a floor
            // (ambient_occlusion_floor, SKY_PROBE_FILL_FLOOR) that exists so
            // one vertical measurement cannot drive a sample to black; the
            // forward measurement is independent evidence about a different
            // part of the hemisphere and should not be spent inside another
            // term's safety floor. It carries its own.
            //
            // Its weight is the sine of the angle between the two probe
            // directions (ahead_novelty, hoisted out of the loop). A sightline
            // pointing straight up is re-measuring what iter_001 already
            // measured and must not be counted twice; an oblique or horizontal
            // one is genuinely new information about the hemisphere. That is
            // the whole of the two-direction quadrature: coincident samples
            // collapse to one, orthogonal samples both count.
            var ahead_factor = 1.0;
            if (deep_shadow_gate > 0.0) {
                let tau_ahead = max(tau_total - tau_view, 0.0);
                let t_ahead = AHEAD_FLOOR + (1.0 - AHEAD_FLOOR)
                    * diffuse_transmittance(tau_ahead, g_hg);
                ahead_factor = mix(
                    1.0, t_ahead,
                    AHEAD_WEIGHT * ahead_novelty * deep_shadow_gate
                );
            }

            // Ambient: height-based on the outer box (witness._render_image).
            // The ramp floor is by openness: a storm interior keeps the tuned
            // 0.3, an open shallow base — which sees sky sideways and bright
            // surface below — keeps 0.6 of the full fill.
            let h = clamp((p.z - u.bmin.z) / (u.bmax.z - u.bmin.z), 0.0, 1.0);
            let height_floor = mix(
                AMBIENT_HEIGHT_FLOOR, AMBIENT_HEIGHT_FLOOR_SHALLOW,
                shallow_open * deep_shadow_gate
            );
            let height_ramp = height_floor + (1.0 - height_floor) * h;
            let amb = ambient_strength * height_ramp * ahead_factor
                      * fill_shape;
            // The constant deep-shadow floor becomes the T_sky -> 0 limit
            // of a measured factor: fully buried samples land on exactly
            // ambient_occlusion_floor as before, and everything less
            // buried lifts continuously toward unoccluded.
            //
            //   amb_factor = (1 - s) + s*floor + s*(1 - floor)*t_sky
            //
            // written out rather than as a mix() because its three pieces do
            // not share a spectrum. The first two are the fill a buried
            // sample keeps; the third is the part measured to arrive from the
            // sky. Summed, the weights are exactly the old amb_factor, so
            // this is a spectral split at unchanged luminance.
            let ao_s = select(
                0.0,
                clamp(ambient_occlusion_strength, 0.0, 1.0)
                    * storm_weight * deep_shadow_gate,
                ambient_occlusion_strength > 0.0
            );
            // Open shallow shadow is filled by skylight and keeps the
            // ambient's blue; only genuinely buried fill decays to the
            // neutral deep tint (same luminance, storm-tuned chroma).
            let fill_tint = mix(deep_tint, u.ambient_tint.xyz, shallow_open);
            let amb_w_deep = ao_s * ambient_occlusion_floor;
            let amb_w_sky = (1.0 - ao_s)
                + ao_s * (1.0 - ambient_occlusion_floor) * t_sky;
            col = col + ice_recolor(
                transmittance * d_tau * amb * air_t
                * (amb_w_sky * u.ambient_tint.xyz
                   + amb_w_deep * fill_tint), phase_tint, ice_on);

            // Light-transfer split, cool side: a skylight floor restored only
            // in saturated sun shadow; lit faces keep their contrast. The
            // tuned low-sun path, unchanged.
            if (light_transfer_split_strength > 0.0
                && deep_shadow_gate > 0.0) {
                // Same measured visibility: this fill is skylight too, and it
                // is the larger of the two diffuse terms, so leaving it flat
                // would wash the structure back out.
                // Same spectral split as the ambient above: the floor part is
                // sunlight that diffused in, the t_sky part is sky.
                let fill_w_deep = deep_shadow_gate * SKY_PROBE_FILL_FLOOR;
                let fill_w_sky = (1.0 - deep_shadow_gate)
                    + deep_shadow_gate * (1.0 - SKY_PROBE_FILL_FLOOR) * t_sky;
                let sky_fill = light_transfer_split_strength
                    * LIGHT_TRANSFER_SHADOW_SKYLIGHT
                    * height_ramp
                    * deep_shadow_gate * ahead_factor * fill_shape;
                col = col + ice_recolor(
                    transmittance * d_tau * sky_fill * air_t
                    * (fill_w_sky * u.ambient_tint.xyz
                       + fill_w_deep * fill_tint), phase_tint, ice_on);
            }

            // High-sun shadow skylight (2026-08-11): where the split above
            // is gated off, moderately shadowed samples used to get no
            // skylight at all — the beam and the MS octaves are spent by
            // tau_sun ~ 20, so a fair-weather base went from white to dark
            // grey across a few steps. Openness decides the coefficient
            // (a buried storm interior keeps almost nothing, which is what
            // keeps storm bases dark), and the measured sky visibility
            // carves the spatial structure so bases brighten toward their
            // edges and thin spots.
            let high_sun_fill = (1.0 - light_transfer_split_strength)
                * mix(HIGH_SUN_SHADOW_SKYLIGHT_STORM,
                      HIGH_SUN_SHADOW_SKYLIGHT_SHALLOW,
                      shallow_open)
                * shadow_gate * height_ramp * ahead_factor * fill_shape;
            if (high_sun_fill > 0.0) {
                let vis = SKY_PROBE_FILL_FLOOR
                    + (1.0 - SKY_PROBE_FILL_FLOOR) * t_sky;
                col = col + ice_recolor(
                    transmittance * d_tau * high_sun_fill * air_t
                    * vis * u.ambient_tint.xyz, phase_tint, ice_on);
            }

            // Diffused-beam glow (see the constants block): isotropic
            // re-emission of the diffusion tail of the direct beam. The
            // dominant base-lighting term for moderately thick fair-weather
            // cloud; fades to a quarter for buried storm interiors.
            let diffuse_beam = DIFFUSE_BEAM_STRENGTH
                * diffuse_transmittance(tau_sun, g_hg)
                * (1.0 - exp(-tau_sun / DIFFUSE_BEAM_TAU_ONSET))
                * mix(1.0, DIFFUSE_BEAM_STORM_KEEP,
                      deep_shadow_gate * (1.0 - shallow_open))
                * fill_shape;
            if (diffuse_beam > 0.0) {
                col = col + ice_recolor(
                    transmittance * d_tau * diffuse_beam * air_t
                    * ISO_PHASE * DIFFUSE_BEAM_TINT * u.cloud_sun.xyz,
                    phase_tint, ice_on);
            }

            // City uplight: the second light source of the night. The glow
            // mip under the sample at a footprint of its own height (the
            // solid-angle average of the city it actually sees), times the
            // two-stream transmittance of the cloud below, delivered like
            // the ambient fill. Replaces the daytime surface bounce, which
            // is gated off under CITY just below.
            if (CITY) {
                // Never below mip 1: mip 0's r is the density the heights
                // come from, the glow starts at mip 1 (export_web_assets).
                let up_lod = clamp(
                    // @domain: a positive max over u.ocean_params.x, the surface tile's cell size (> 0)
                    log2(max(p.z, u.ocean_params.x) / u.ocean_params.x),
                    1.0, u.ocean_params.w);
                let g_raw = max(
                    // p is a WORLD cloud sample: convert for the glow
                    // (city frame), keep world for the tau probe below.
                    city_glow_sample(city_fold_xy(p.xy), up_lod)
                        - CITY_UPLIGHT_GLOW_BIAS,
                    0.0);
                let g_up = g_raw / (CITY_UPLIGHT_GLOW_HALF + g_raw);
                let tau_dn = city_uplight_probe_tau(p, probe_jitter);
                let t_dn = exp(-tau_dn * CITY_UPLIGHT_TAU_SCALE);
                let up = CITY_UPLIGHT_STRENGTH * g_up
                    * (CITY_UPLIGHT_FLOOR + (1.0 - CITY_UPLIGHT_FLOOR) * t_dn);
                col = col + transmittance * d_tau * up * air_t
                            * fill_shape * CITY_UPLIGHT_COLOR;
            }

            // Surface bounce is anchored at physical z=0, not the AABB floor.
            if (BOUNCE_STRENGTH > 0.0 && !CITY) {
                let bounce_frac = clamp(1.0 - p.z / u.bmax.z, 0.0, 1.0);
                var bounce = BOUNCE_STRENGTH * bounce_frac;
                if (bounce_depth_attenuation > 0.0) {
                    bounce = bounce * exp(-bounce_depth_attenuation * tau_depth);
                }
                // The surface underneath is in this cloud's own shadow. The
                // bounce pedestal only exists in proportion to the sunlight
                // that actually reaches the ground, and under a saturated
                // column that is nearly none — which is why a real storm
                // base is dark and this one was not. tau_depth alone could
                // never see it: every base sample has just entered the
                // cloud, so the existing depth attenuation is the same
                // number everywhere across a base and the term composited
                // as a flat pedestal over the whole frame. Faded in by the
                // saturation gate, so thin cloud keeps its bounce exactly.
                //
                // A lateral floor (iter_001 flagged this as the one thing it
                // would tune): the ground a base sample sees is a hemisphere,
                // not a point, and a cloud shadow is finite. Beyond its edge
                // is sunlit surface, and that light reaches the base without
                // ever passing through the saturated column overhead — so the
                // sunward attenuation must not run to zero. T(80) = 0.10 with
                // no floor; the floor puts it back to a small but nonzero
                // pedestal, and because BOUNCE_TINT is warm it restores
                // warmth exactly at the cloud base, where the accumulated
                // blue collected worst.
                bounce = bounce * mix(
                    1.0,
                    max(diffuse_transmittance(tau_sun, g_hg),
                        BOUNCE_LATERAL_FLOOR),
                    deep_shadow_gate
                );
                // Over the desert the pedestal scales with the ground's own
                // albedo against the water's the constant was tuned over.
                let bounce_tint = select(
                    BOUNCE_TINT,
                    BOUNCE_TINT * desert_bounce_albedo() / OCEAN_BOUNCE_ALBEDO,
                    DESERT);
                col = col + ice_recolor(
                    transmittance * d_tau * bounce * air_t * bounce_tint,
                    phase_tint, ice_on);
            }

            // This step's attenuation, computed once. The aerial in-scatter
            // below and the transmittance update are the same exp of the same
            // operand; the compiler cannot always see that across the branch,
            // and it is one transcendental per view step either way.
            let step_atten = exp(-d_tau);

            // Aerial in-scatter: sky light scattered into the path replaces
            // exactly the radiance this sample occludes.
            if (aerial_strength > 0.0 && air_t < 1.0) {
                let aer_in = transmittance
                    * (1.0 - step_atten)
                    * (1.0 - air_t);
                col = col + aer_in * aer;
            }

            transmittance = transmittance * step_atten;
            t = t + dt;
        }
    }

    // Ocean for rays that exit or MISS the outer box without becoming opaque.
    // The condition is what it always meant to say — the water was hit, the
    // ray still carries light, and the march did not already shade it — with
    // no reference to a t_far that a missing ray never had (see
    // ocean_consumed above).
    //
    // The 50-outer-width clamp below is a second, much larger-scale version
    // of the same shape and is deliberately left alone: past it the water is
    // unshaded and the sky shows through, but at that range the ocean's own
    // aerial haze (ocean_realism_b.y * t_hit) has already carried it onto the
    // horizon sky colour, so the seam is invisible at the shipped settings
    // and only appears with the legacy no-haze ocean. Removing it is a look
    // change — water drawn to the edge of the float — not a bug fix.
    var shade_ocean = ocean_in_march;
    if (ocean_on
        && !ocean_consumed
        && transmittance > TRANSMITTANCE_CUTOFF
        && t_ocean < 1e29) {
        let ocean_hit = u.cam_origin.xyz + t_ocean * dir;
        let outer_size = u.bmax.xyz - u.bmin.xyz;
        let center = 0.5 * (u.bmin.xy + u.bmax.xy);
        shade_ocean = abs(ocean_hit.x - center.x) < outer_size.x * 50.0
            && abs(ocean_hit.y - center.y) < outer_size.y * 50.0;
    }
    if (shade_ocean) {
        let ocean_hit = u.cam_origin.xyz + t_ocean * dir;
        col = col + ice_recolor(transmittance
                    * ocean_shade_dispatch(
                        ocean_hit, dir, sun,
                        sun_cone_dir(sun, sun_frame, sun_cone_seed,
                                     penumbra_tan),
                        t_ocean, shadow_jitter,
                        ocean_slope_seed, jitter_on * jitter_scale),
                    ICE_OCEAN_TINT, ice_on);
        transmittance = 0.0;
    }

    // A veil the march never reached (the ray left the volume first, or
    // never entered it): in front of the surface and the sky, behind every
    // cloud the march did see.
    if (veil_pending) {
        t_front = transmittance;
        col = col + transmittance * veil.rgb;
        transmittance = transmittance * veil.trans;
    }

    // City for rays that exit or miss the volume without becoming opaque —
    // the night twin of the far-water fallback above, minus the range clamp
    // (the city fog has already carried a distant hit onto the haze).
    if (CITY
        && !ocean_consumed
        && transmittance > TRANSMITTANCE_CUTOFF
        && t_city < 1e29) {
        col = col + transmittance * city_rgb;
        transmittance = 0.0;
    }

    // The desert's twin of the same fallback.
    if (DESERT
        && !ocean_consumed
        && transmittance > TRANSMITTANCE_CUTOFF
        && t_desert < 1e29) {
        col = col + ice_recolor(transmittance * desert_rgb, ICE_OCEAN_TINT,
                                ice_on);
        transmittance = 0.0;
    }

    if (transmittance > TRANSMITTANCE_CUTOFF) {
        var sky: vec3<f32>;
        if (CITY) {
            sky = night_sky_radiance(dir, sun);
        } else if (ice_on) {
            sky = alien_sky(dir, sun, u.sky_disc.xyz);
        } else {
            sky = sky_radiance(
                dir, sun,
                u.sky_horizon.xyz, u.sky_bloom.xyz, u.sky_disc.xyz,
                u.cloud_sun.w
            );
        }
        col = col + transmittance * sky;
    }
    if (!TONE_MAP) {
        return vec4<f32>(col, 1.0);
    }
    return vec4<f32>(tone_map(col, exposure, u.periodic.w),
                     select(1.0, t_front, steam_live));
}
