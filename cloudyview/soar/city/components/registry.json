{
 "schema": "cloudyview.city.components.v1",
 "components": [
  {
   "file": "windowlife.wgsl",
   "name": "windowlife",
   "hooks": {
    "window_glyph": "cc_windowlife_glyph",
    "window_glyph_mean": "cc_windowlife_glyph_mean"
   },
   "enabled": true
  },
  {
   "file": "facadeworks.wgsl",
   "name": "facadeworks",
   "hooks": {
    "facade": "cc_facadeworks_detail",
    "facade_cover": "cc_facadeworks_cover"
   },
   "enabled": true
  },
  {
   "file": "skyway.wgsl",
   "name": "skyway",
   "kind_base": 200,
   "hooks": {
    "extra_trace": "cc_skyway_trace",
    "shade": "cc_skyway_shade"
   },
   "enabled": true
  },
  {
   "file": "rooftopworks.wgsl",
   "name": "rooftopworks",
   "kind_base": 600,
   "hooks": {
    "cell_props": "cc_rooftopworks_props_trace",
    "shade": "cc_rooftopworks_shade"
   },
   "enabled": true
  },
  {
   "file": "skybridges.wgsl",
   "name": "skybridges",
   "kind_base": 500,
   "hooks": {
    "cell_props": "cc_skybridges_props_trace",
    "shade": "cc_skybridges_shade"
   },
   "enabled": true
  },
  {
   "file": "streetlife.wgsl",
   "name": "streetlife",
   "kind_base": 100,
   "hooks": {
    "cell_props": "cc_streetlife_props_trace",
    "shade": "cc_streetlife_shade",
    "near_props": "cc_streetlife_near_trace"
   },
   "enabled": true
  },
  {
   "file": "adscreens.wgsl",
   "name": "adscreens",
   "kind_base": 400,
   "hooks": {
    "facade": "cc_adscreens_facade",
    "facade_cover": "cc_adscreens_cover"
   },
   "enabled": true
  },
  {
   "file": "manholesteam.wgsl",
   "name": "manholesteam",
   "kind_base": 900,
   "hooks": {
    "cell_props": "cc_manholesteam_props_trace",
    "shade": "cc_manholesteam_shade",
    "media": "cc_manholesteam_media"
   },
   "enabled": true
  },
  {
   "file": "industry.wgsl",
   "name": "industry",
   "kind_base": 700,
   "hooks": {
    "cell_props": "cc_industry_props_trace",
    "shade": "cc_industry_shade",
    "facade": "cc_industry_facade",
    "roof": "cc_industry_roof"
   },
   "enabled": true,
   "note": "The industrial belt above its ground: warehouse roofs (sawtooth, clerestory, skylights), flood heads and poles, yard and court props. cell_props traces them; facade adds each wall pack's wash to the court wall; roof carries the lit glazing's exact view-dependent mean on core roof hits wherever the roof geometry is not drawn (beyond CITY_PROP_RANGE)."
  },
  {
   "file": "streetfurniture.wgsl",
   "name": "streetfurniture",
   "kind_base": 800,
   "hooks": {
    "shade": "cc_streetfurniture_shade",
    "near_props": "cc_streetfurniture_props_trace"
   },
   "enabled": true
  }
 ]
}
