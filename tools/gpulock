#!/usr/bin/env bash
# Serialize GPU work across concurrent sessions on this box.
#
#   tools/gpulock <command...>
#
# Every render, test run, bench or harness that touches the GPU goes through
# this. It takes one exclusive lock, so a benchmark never shares the card
# with someone else's render (its timings would be fiction) and seven
# sessions never each park a multi-GB field in the 16 GB of VRAM at once.
# Waits up to GPULOCK_WAIT seconds (default 1800) and then fails loudly
# rather than running unlocked.
#
# The command also runs in a memory-capped systemd scope (GPULOCK_MEM,
# default 16G, no swap): on 2026-09-24 one unbounded full-field render grew to
# 25 GB and the kernel's OOM killer took the whole Claude app down with it.
# Over the cap, only the offending command dies.
#
# Keep each locked command short (a few renders, one bench) so others are
# not starved; loop outside the lock, not inside it.
#
# The command gets SOAR_GPULOCK set to the lock's path. The tools that open
# a GPU device check it, and that the lock is held, before they request an
# adapter, and refuse to run without both (tools/gpulock_guard.py and .mjs):
# unlocked tools spoiled four timing runs in two days, 2026-11-08/09.
set -euo pipefail
LOCK=/tmp/soar-gpu.lock
export SOAR_GPULOCK="$LOCK"
if [[ $# -eq 0 ]]; then
    echo "usage: tools/gpulock <command...>" >&2
    exit 2
fi
exec flock -x -w "${GPULOCK_WAIT:-1800}" -E 75 "$LOCK" \
    systemd-run --user --scope --quiet \
    -p MemoryMax="${GPULOCK_MEM:-16G}" -p MemorySwapMax=0 -- "$@"
