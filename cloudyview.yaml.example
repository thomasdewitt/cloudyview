# CloudyView Configuration File
#
# This file demonstrates how to configure CloudyView's witness and behold commands.
# Copy this file to ./cloudyview.yaml or ~/.cloudyview.yaml and modify as needed.
#
# Coordinate System (Meteorological Convention):
#   East  = +x direction
#   North = +y direction
#   Up    = +z direction
#
# Camera positions use relative coordinates where ±1.0 = domain edge in x,y
# (z coordinates are relative to domain height)
#
# Azimuth: 0° = East, 90° = North, 180° = West, 270° = South
#          (measured counterclockwise from +x axis)
# Elevation: Angle above horizon (0° = horizon, 90° = zenith, -90° = nadir)

# Configuration for witness (tier 2 - PyVista isosurface rendering)
witness:
  # Multiple camera views - each view will be rendered
  camera_views:
    # Overhead view looking straight down
    overhead:
      position: [0.0, 0.0, 2.0]  # Above center
      azimuth: 0.0  # Look direction (doesn't matter much when looking down)
      elevation: -85.0  # Almost straight down

    # North oblique - from NW looking toward SE
    north_oblique:
      position: [-0.5, 0.8, 0.8]  # Northwest and elevated
      azimuth: 135.0  # Looking toward SE (135° = South-East)
      elevation: -30.0  # 30° below horizon (looking downward)

    # West oblique - from SW looking toward NE
    west_oblique:
      position: [-0.8, -0.5, 0.8]  # Southwest and elevated
      azimuth: 45.0  # Looking toward NE (45° = North-East)
      elevation: -30.0  # 30° below horizon (looking downward)

  # Sun position for lighting
  sun:
    azimuth: 70.0  # degrees from east (70° = ENE direction)
    elevation: 45.0  # degrees above horizon

# Configuration for behold (tier 3 - Mitsuba photorealistic path tracing)
behold:
  # Camera configuration
  camera:
    position: [0.0, -0.75, -0.5]  # Relative coords: ground level, south of center
    azimuth: 0.0  # Looking east (0° = East)
    elevation: 45.0  # Looking 45° up from horizon
    fov: 100.0  # Field of view in degrees

  # Sun configuration
  sun:
    azimuth: 90.0  # North (90° from east)
    elevation: 45.0  # 45° above horizon (midday sun)

  # Rendering parameters
  rendering:
    max_depth: 128  # Maximum ray bounce depth
    rr_depth: 64  # Russian roulette depth (when to start probabilistic termination)
    exposure: 4.0  # Exposure multiplier for output brightness
    extinction_multiplier: 1.0  # Multiplier for cloud extinction (1.0 = realistic)
    integrator: 'volpathmis'  # Volumetric path tracer with multiple importance sampling
    turbidity: 3.0  # Sky turbidity (1=clear, 10=hazy)
    ground_albedo: 0.5  # Ground reflectance (0=black, 1=white)

    # Ocean surface configuration
    ocean:
      enabled: true  # Add reflective ocean surface
      reflectance: [0.0392, 0.1098, 0.1490]  # RGB ocean color (dark blue)
      height: -0.99  # Ocean height in normalized coordinates (just below ground)
